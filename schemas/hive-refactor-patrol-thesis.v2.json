{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-refactor-patrol-thesis.v2.json",
  "title": "hive refactor patrol thesis record (v2)",
  "description": "Durable refactor thesis with feature-scoped hotspot measurements, anchored code evidence, and proposal-specific leverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "feature_id",
    "feature",
    "problem",
    "cost",
    "evidence",
    "proposed_refactor",
    "feature_boundary",
    "feature_hotspot",
    "expected_leverage",
    "confidence",
    "risk",
    "required_validation",
    "admissible",
    "admissibility_reason",
    "follow_up_approval_state",
    "fingerprint"
  ],
  "properties": {
    "id": { "type": "string" },
    "feature_id": { "type": "string" },
    "feature": { "type": "string" },
    "problem": { "type": "string" },
    "cost": { "type": "string" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Evidence" }
    },
    "proposed_refactor": { "type": "string" },
    "feature_boundary": { "$ref": "#/$defs/FeatureBoundary" },
    "feature_hotspot": { "$ref": "#/$defs/FeatureHotspot" },
    "expected_leverage": { "$ref": "#/$defs/ExpectedLeverage" },
    "confidence": { "enum": ["low", "medium", "high"] },
    "risk": { "$ref": "#/$defs/Risk" },
    "required_validation": { "$ref": "#/$defs/RequiredValidation" },
    "admissible": { "type": "boolean" },
    "admissibility_reason": { "type": "string" },
    "follow_up_approval_state": {
      "enum": ["pending", "not_requested", "approved", "rejected"]
    },
    "fingerprint": { "type": "string" },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "type": "string" },
        "reference": { "type": "string" }
      }
    }
  },
  "$defs": {
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "snippet": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 }
      }
    },
    "FeatureBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owned_files", "entrypoints"],
      "properties": {
        "owned_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "entrypoints": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "SignalValues": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "NormalizedSignalValues": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "FeatureHotspot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "score", "breakdown", "signals", "normalized"],
      "properties": {
        "scope": { "const": "feature" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "breakdown": { "$ref": "#/$defs/NormalizedSignalValues" },
        "signals": { "$ref": "#/$defs/SignalValues" },
        "normalized": { "$ref": "#/$defs/NormalizedSignalValues" }
      }
    },
    "ExpectedLeverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "breakdown", "drivers"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "breakdown": { "$ref": "#/$defs/NormalizedSignalValues" },
        "drivers": {
          "type": "array",
          "items": { "$ref": "#/$defs/LeverageDriver" }
        }
      }
    },
    "LeverageDriver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "relief", "mechanism"],
      "properties": {
        "signal": {
          "enum": ["churn", "fan_in", "complexity", "coupling", "bug_density", "coverage_gap"]
        },
        "relief": { "type": "number", "minimum": 0, "maximum": 1 },
        "mechanism": { "type": "string", "minLength": 1 }
      }
    },
    "Risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caps",
        "public_api_impact",
        "public_api_details",
        "cross_feature_impact",
        "cross_feature_details",
        "flags"
      ],
      "properties": {
        "caps": {
          "type": "object",
          "additionalProperties": true,
          "required": ["est_files", "est_diff_lines", "single_feature"],
          "properties": {
            "est_files": { "type": "integer", "minimum": 0 },
            "est_diff_lines": { "type": "integer", "minimum": 0 },
            "single_feature": { "type": "boolean" }
          }
        },
        "public_api_impact": { "type": "boolean" },
        "public_api_details": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cross_feature_impact": { "type": "boolean" },
        "cross_feature_details": {
          "type": "array",
          "items": { "type": "string" }
        },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "advisories": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "RequiredValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "characterization_first", "notes"],
      "properties": {
        "commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "characterization_first": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
