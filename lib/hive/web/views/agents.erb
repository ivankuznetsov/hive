<section>
  <h1>Agents</h1>
  <div class="cards">
    <% @statuses.each do |agent, status| %>
      <article class="card">
        <h2><%= h(agent) %></h2>
        <p><%= status["logged_in"] ? "Logged in" : "Not logged in" %></p>
        <% if %w[claude codex].include?(agent) %>
          <form method="post" action="/agents/<%= h(agent) %>/login/start">
            <%= csrf_tag %>
            <button type="submit">Start login</button>
          </form>
        <% end %>
      </article>
    <% end %>
  </div>
  <% if defined?(@session) && @session %>
    <% if @session_url.nil? && !@session.done %>
      <%# Native HTML refresh (no JS/Turbo): poll until the authorize URL %>
      <%# prints. Emitted into the document <head> via the layout's @head %>
      <%# yield so the http-equiv refresh is valid HTML (a meta-refresh in %>
      <%# <body> is invalid). @head is read by the layout's <head>. %>
      <% @head = %(<meta http-equiv="refresh" content="2;url=/agents/#{h(@session.agent)}/login/#{h(@session.id)}">) %>
    <% end %>
    <section class="narrow">
      <h2><%= h(@session.agent) %> login</h2>
      <p>Open the provider URL when it appears, then paste the resulting code or callback URL.</p>
      <% if @session_url.nil? && !@session.done %><p>Waiting for the provider URL…</p><% end %>
      <pre><%= h(@session_output) %></pre>
      <% if @session_url %><p><a href="<%= h(@session_url) %>" target="_blank" rel="noreferrer"><%= h(@session_url) %></a></p><% end %>
      <form method="post" action="/agents/<%= h(@session.agent) %>/login/complete">
        <%= csrf_tag %>
        <input type="hidden" name="session_id" value="<%= h(@session.id) %>">
        <textarea name="code" rows="3" required></textarea>
        <button type="submit">Complete login</button>
      </form>
    </section>
  <% end %>
  <section class="narrow">
    <h2>Pi token</h2>
    <form method="post" action="/agents/pi/token">
      <%= csrf_tag %>
      <textarea name="token_json" rows="6" placeholder='{"provider":"..."}' required></textarea>
      <button type="submit">Save token</button>
    </form>
  </section>
</section>
