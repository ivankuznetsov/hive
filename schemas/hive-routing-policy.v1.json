{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-routing-policy.v1.json",
  "title": "Hive immutable provider routing policy snapshot (v1)",
  "description": "Owner-private first-writer-wins explicit routing policy bound to one opaque ownership generation and durable attempt subject.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "ownership_generation", "subject", "policy"],
  "properties": {
    "schema": { "const": "hive-routing-policy" },
    "schema_version": { "const": 1 },
    "ownership_generation": { "$ref": "#/$defs/OpaqueGeneration" },
    "subject": { "$ref": "#/$defs/Subject" },
    "policy": { "$ref": "#/$defs/Policy" }
  },
  "$defs": {
    "OpaqueGeneration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "ShortIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "SymbolicId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "TaskStageSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "task_id", "task_slug", "intended_stage"],
      "properties": {
        "kind": { "const": "task_stage" },
        "task_id": { "type": ["string", "integer", "null"] },
        "task_slug": { "$ref": "#/$defs/Identifier" },
        "intended_stage": { "$ref": "#/$defs/ShortIdentifier" }
      }
    },
    "ModuleHookSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "project_id", "module", "hook", "event_id", "occurrence_id",
        "event_name", "module_generation", "configuration_digest", "grant_digest"
      ],
      "properties": {
        "kind": { "const": "module_hook" },
        "project_id": { "$ref": "#/$defs/Identifier" },
        "module": { "$ref": "#/$defs/ShortIdentifier" },
        "hook": { "$ref": "#/$defs/ShortIdentifier" },
        "event_id": { "$ref": "#/$defs/Identifier" },
        "occurrence_id": { "$ref": "#/$defs/Identifier" },
        "event_name": { "$ref": "#/$defs/ShortIdentifier" },
        "module_generation": { "$ref": "#/$defs/Identifier" },
        "configuration_digest": { "$ref": "#/$defs/Sha256" },
        "grant_digest": { "$ref": "#/$defs/Sha256" }
      }
    },
    "Subject": {
      "oneOf": [
        { "$ref": "#/$defs/TaskStageSubject" },
        { "$ref": "#/$defs/ModuleHookSubject" }
      ]
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "mode", "stage", "digest", "routes", "requirements", "pin", "accounts"],
      "properties": {
        "schema": { "const": "hive-provider-routing-policy/v1" },
        "mode": { "const": "explicit" },
        "stage": { "$ref": "#/$defs/ShortIdentifier" },
        "digest": { "$ref": "#/$defs/Sha256" },
        "routes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Route" }
        },
        "requirements": { "$ref": "#/$defs/Requirements" },
        "pin": {
          "oneOf": [
            { "$ref": "#/$defs/Pin" },
            { "type": "null" }
          ]
        },
        "accounts": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 256,
          "propertyNames": { "$ref": "#/$defs/SymbolicId" },
          "additionalProperties": { "$ref": "#/$defs/Account" }
        }
      }
    },
    "Route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "account", "adapter", "launch_binding", "model", "effort", "order", "capabilities"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "account": { "$ref": "#/$defs/SymbolicId" },
        "adapter": { "$ref": "#/$defs/ShortIdentifier" },
        "launch_binding": { "$ref": "#/$defs/SymbolicId" },
        "model": { "$ref": "#/$defs/Identifier" },
        "effort": {
          "oneOf": [
            { "$ref": "#/$defs/ShortIdentifier" },
            { "type": "null" }
          ]
        },
        "order": { "type": "integer", "minimum": 0 },
        "capabilities": { "$ref": "#/$defs/Capabilities" }
      }
    },
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "quality", "tools", "permissions"],
      "properties": {
        "context": { "enum": ["standard", "large"] },
        "quality": { "enum": ["standard", "high"] },
        "tools": { "$ref": "#/$defs/Tools" },
        "permissions": { "$ref": "#/$defs/Permissions" }
      }
    },
    "Requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "quality", "tools", "permissions"],
      "properties": {
        "context": { "enum": ["standard", "large", null] },
        "quality": { "enum": ["standard", "high", null] },
        "tools": { "$ref": "#/$defs/Tools" },
        "permissions": { "$ref": "#/$defs/Permissions" }
      }
    },
    "Tools": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "enum": ["browser", "filesystem", "mcp", "shell", "web"] }
    },
    "Permissions": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["network", "read", "write"] }
    },
    "Pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": { "$ref": "#/$defs/SymbolicId" },
        "model": {
          "oneOf": [
            { "$ref": "#/$defs/Identifier" },
            { "type": "null" }
          ]
        }
      }
    },
    "Account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "launch_binding", "models", "max_concurrent", "cooldown_sec"],
      "properties": {
        "adapter": { "$ref": "#/$defs/ShortIdentifier" },
        "launch_binding": { "$ref": "#/$defs/SymbolicId" },
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Identifier" }
        },
        "max_concurrent": { "type": "integer", "minimum": 1 },
        "billing_route": { "enum": ["subscription", "api", "unknown"] },
        "billing_evidence_source": {
          "enum": ["provider_account_config", "agent_profile_contract", "unavailable"]
        },
        "cooldown_sec": { "$ref": "#/$defs/Cooldowns" }
      }
    },
    "Cooldowns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authentication", "billing_configuration", "exhausted_credits",
        "account_quota", "provider_rate_limit", "provider_outage"
      ],
      "properties": {
        "authentication": { "$ref": "#/$defs/Cooldown" },
        "billing_configuration": { "$ref": "#/$defs/Cooldown" },
        "exhausted_credits": { "$ref": "#/$defs/Cooldown" },
        "account_quota": { "$ref": "#/$defs/Cooldown" },
        "provider_rate_limit": { "$ref": "#/$defs/Cooldown" },
        "provider_outage": { "$ref": "#/$defs/Cooldown" }
      }
    },
    "Cooldown": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    }
  }
}
