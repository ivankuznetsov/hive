<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || web_product_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= web_product_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <div class="topbar-inner" data-controller="navigation"
           data-action="keydown.esc@window->navigation#dismiss turbo:before-cache@document->navigation#close">
        <%= link_to root_path, class: "brand" do %>
          <%= image_tag "/brand.svg", class: "brand-mark", width: 32, height: 32, alt: "" %>
          <span>Hive</span>
        <% end %>
        <% if operator_access? %>
          <button type="button" class="btn btn-ghost mobile-menu-toggle"
                  aria-label="Menu" aria-expanded="false" aria-controls="primary-menu"
                  data-navigation-target="toggle" data-action="navigation#toggle">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <div id="primary-menu" class="topbar-menu" data-action="click->navigation#navigate">
          <nav aria-label="Primary">
            <%= link_to "Status", root_path, class: nav_class(:status) %>
            <%= link_to "Digest", digest_path("today"), class: nav_class(:digests) %>
            <%= link_to "Repos", repos_path, class: nav_class(:repos) %>
            <%= link_to "Honeycombs", honeycombs_path, class: nav_class(:honeycombs) %>
            <%= link_to "Patrol", patrol_path, class: nav_class(:patrol) %>
            <%= link_to "Agents", agents_path, class: nav_class(:agents) %>
            <%= link_to "Telegram", telegram_path, class: nav_class(:telegram) %>
          </nav>
          <div class="topbar-session">
            <span class="session-identity">
              <% if current_login %>
                <span class="session-avatar" aria-hidden="true">
                  <span><%= current_login.first.upcase %></span>
                  <%= image_tag "https://github.com/#{ERB::Util.url_encode(current_login)}.png?size=64",
                        width: 28, height: 28, alt: "", referrerpolicy: "no-referrer",
                        data: { controller: "avatar", action: "error->avatar#hide" } %>
                </span>
              <% end %>
              <span class="session-login"><%= operator_label %></span>
            </span>
            <% if current_login %>
              <%= button_to "Log out", logout_path, class: "btn btn-ghost btn-sm", form_class: "inline-form" %>
            <% else %>
              <%= link_to "Connect GitHub", login_path, class: "btn btn-ghost btn-sm" %>
            <% end %>
          </div>
          </div>
        <% end %>
      </div>
    </header>
    <main>
      <% if notice %>
        <div class="flash flash-notice" role="status"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="flash flash-alert" role="alert"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
