<%= turbo_frame_tag "task-log" do %>
  <div class="log-pane">
    <% if log %>
      <pre data-log-tail><% log["tail"].each_line do |line| %><span class="<%= log_line_class(line) %>"><%= line %></span><% end %></pre>
      <p class="faint"><%= File.basename(log["path"]) %></p>
    <% else %>
      <p class="muted">No log yet for this task.</p>
    <% end %>
  </div>
<% end %>
