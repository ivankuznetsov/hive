{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-init.v2.json",
  "title": "hive init output (v2)",
  "description": "Stable success contract emitted by `hive init --json`. v2 drops the `patrol_reviewers` field (both from `answers` and the top-level payload) that v1 required; patrol now derives its reviewer set elsewhere. Init precondition failures keep the legacy stderr + exit-code contract because several checks run before project state exists.",
  "$ref": "#/$defs/SuccessPayload",
  "$defs": {
    "LimitMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brainstorm",
        "plan",
        "execute_implementation",
        "open_pr",
        "artifacts",
        "finalize",
        "review_ci",
        "review_triage",
        "review_fix",
        "review_browser"
      ],
      "properties": {
        "brainstorm": { "type": "integer", "minimum": 1 },
        "plan": { "type": "integer", "minimum": 1 },
        "execute_implementation": { "type": "integer", "minimum": 1 },
        "open_pr": { "type": "integer", "minimum": 1 },
        "artifacts": { "type": "integer", "minimum": 1 },
        "finalize": { "type": "integer", "minimum": 1 },
        "review_ci": { "type": "integer", "minimum": 1 },
        "review_triage": { "type": "integer", "minimum": 1 },
        "review_fix": { "type": "integer", "minimum": 1 },
        "review_browser": { "type": "integer", "minimum": 1 }
      }
    },
    "Answers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_agent",
        "claude_mode",
        "claude_permission_mode",
        "development_agent",
        "enabled_reviewers",
        "triage_bias",
        "budgets",
        "timeouts",
        "daemon_enabled",
        "babysitter_enabled",
        "daemon_autostart"
      ],
      "properties": {
        "planning_agent": { "type": "string" },
        "claude_mode": { "type": "string", "enum": ["tmux", "headless"] },
        "claude_permission_mode": { "type": "string", "enum": ["acceptEdits", "auto", "bypassPermissions", "default", "dontAsk", "plan"] },
        "development_agent": { "type": "string" },
        "enabled_reviewers": { "type": "array", "items": { "type": "string" } },
        "triage_bias": { "type": "string", "enum": ["courageous", "safetyist"] },
        "budgets": { "$ref": "#/$defs/LimitMap" },
        "timeouts": { "$ref": "#/$defs/LimitMap" },
        "daemon_enabled": { "type": "boolean" },
        "babysitter_enabled": { "type": "boolean" },
        "daemon_autostart": { "type": "boolean" }
      }
    },
    "SuccessPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "ok",
        "project",
        "path",
        "default_branch",
        "hive_state_path",
        "worktree_root",
        "answers",
        "planning_agent",
        "claude_mode",
        "development_agent",
        "enabled_reviewers",
        "triage_bias",
        "budgets",
        "timeouts",
        "daemon_enabled",
        "babysitter_enabled",
        "daemon_autostart_requested"
      ],
      "properties": {
        "schema": { "const": "hive-init" },
        "schema_version": { "const": 2 },
        "ok": { "const": true },
        "project": { "type": "string" },
        "path": { "type": "string" },
        "default_branch": { "type": "string" },
        "hive_state_path": { "type": "string" },
        "worktree_root": { "type": "string" },
        "answers": { "$ref": "#/$defs/Answers" },
        "planning_agent": { "type": "string" },
        "claude_mode": { "type": "string", "enum": ["tmux", "headless"] },
        "development_agent": { "type": "string" },
        "enabled_reviewers": { "type": "array", "items": { "type": "string" } },
        "triage_bias": { "type": "string", "enum": ["courageous", "safetyist"] },
        "budgets": { "$ref": "#/$defs/LimitMap" },
        "timeouts": { "$ref": "#/$defs/LimitMap" },
        "daemon_enabled": { "type": "boolean" },
        "babysitter_enabled": { "type": "boolean" },
        "daemon_autostart_requested": { "type": "boolean", "description": "Whether init requested global daemon service autostart. This is intent, not proof the host service manager enabled it; check stderr or `hive daemon install --json` for actual service-manager outcome." }
      }
    }
  }
}
