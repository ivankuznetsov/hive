+
+  def test_generate_and_check_one_package_from_another_directory
+    in_tmpdir do |root|
+      package = install_valid_fixture(root)
+      stdout, stderr, status = capture_command(SCRIPT, "--root", root, package,
+                                                chdir: File.dirname(root))
