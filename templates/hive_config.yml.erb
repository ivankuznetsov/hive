---
# Global hive config — auto-managed; edit only if you know what you're doing.
registered_projects: <%= registered_projects.empty? ? "[]" : "" %>
<% registered_projects.each do |p| %>  - name: <%= p["name"] %>
    path: <%= p["path"] %>
    hive_state_path: <%= p["hive_state_path"] %>
<% end %>

# Optional provider-account registry. It is ignored until a project stage
# declares an explicit `routing.pool`; unconfigured projects never load it.
# `launch_binding` is a non-secret adapter-owned context identity, not a token,
# credential path, or environment value. Only one account per adapter may use
# `default`; additional accounts need distinct configured bindings.
#
# providers:
#   codex-primary:
#     adapter: codex
#     launch_binding: default
#     models: [gpt-5.6-sol, gpt-5.6-terra]
#     max_concurrent: 2
#     cooldown_sec:
#       account_quota: 3600
#       provider_rate_limit: 300
#   codex-team:
#     adapter: codex
#     launch_binding: team
#     models: [gpt-5.6-sol]
#     max_concurrent: 1

# Telegram bot global surface. The token is intentionally not stored here:
# set HIVE_TELEGRAM_BOT_TOKEN in the environment before `hive bot start`.
# Uncomment and fill chat_id_allowlist to opt in.
#
# bot:
#   enabled: false
#   pairing_enabled: false # when true, unknown DM /start requests get pairing codes
#   chat_id_allowlist: []   # integers only, e.g. [123456789]
#   poll_interval_sec: 30
#   long_poll_timeout_sec: 25
#   alert_state_file: ~/.local/state/hive/.bot.alert_state.json
#   recovery_reminder_window_sec: 28800
#   conversation_ttl_sec: 3600
#   idea_attachment_max_bytes: 20971520
#   idea_attachment_max_count: 10
#   idea_draft_ttl_sec: 900
#   shutdown_grace_sec: 60
#   pid_file: ~/Dev/hive/.bot.pid
#   log_file: ~/Dev/hive/logs/bot.log
#   log_max_bytes: 10485760
#   log_max_files: 5
#   last_seen_state_file: ~/Dev/hive/.bot.last_seen_update_id

# Daily pending-answer digest. When enabled, the daemon schedules one global
# `hive answer-digest` subprocess at/after the configured local hour. Empty
# snapshots are silent.
#
# answer_digest:
#   enabled: false
#   hour: 9

# Daemon-owned digest children have positive safety bounds even when ordinary
# task children keep the historical unbounded default. `digest` covers both
# record refresh/close and the opt-in Telegram delivery command.
#
# daemon:
#   child_timeout_sec: 0
#   child_kill_grace_sec: 30
#   child_verb_timeouts:
#     answer-digest: 3600
#     digest: 3600

# Hive-owned durable cross-project activity record. Disabled by default. Run
# `hive migrate --all` before enabling so the IANA zone and coverage frontier
# are persisted. Telegram recap delivery is a separate opt-in.
#
# daily_digest:
#   enabled: false
#   materialization_interval_sec: 300
#   freshness_budget_sec: 900
#   telegram:
#     enabled: false
#     hour: 9
