{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hivecli.sh/schemas/hive-module-list.v1.json",
  "title": "Hive module list v1",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "ok", "modules"],
      "properties": {
        "schema": {"const": "hive-module-list"}, "schema_version": {"const": 1}, "ok": {"const": true},
        "modules": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "installed", "enabled", "epoch", "version", "catalog_commit", "source_commit", "manifest_digest", "configuration_digest", "permission_digest", "hooks", "settings", "grants"],
            "properties": {
              "name": {"type": "string"}, "installed": {"type": "boolean"}, "enabled": {"type": "boolean"},
              "epoch": {"type": "integer"}, "version": {"type": "string"},
              "catalog_commit": {"type": "string"}, "source_commit": {"type": "string"},
              "manifest_digest": {"type": "string"}, "configuration_digest": {"type": "string"},
              "permission_digest": {"type": "string"}, "hooks": {"type": "object"},
              "settings": {"type": "object"}, "grants": {"type": "object"}
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["schema", "schema_version", "ok", "error_kind", "exit_code", "message"],
      "properties": {
        "schema": {"const": "hive-module-list"}, "schema_version": {"const": 1}, "ok": {"const": false},
        "error_kind": {"type": "string"}, "exit_code": {"type": "integer"}, "message": {"type": "string"}
      }
    }
  ]
}
