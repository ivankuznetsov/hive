{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:running-status:v1",
  "title": "Bounded Hive running-task status (v1)",
  "description": "Stable compact contract emitted by `hive status --json`. Only tasks with a verified live runner lock or live recorded agent process are returned.",
  "oneOf": [
    { "$ref": "#/$defs/SuccessPayload" },
    { "$ref": "#/$defs/ErrorPayload" }
  ],
  "$defs": {
    "SuccessPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "schema_version", "ok", "generated_at", "daemon",
        "complete", "count", "observed_count", "observed_count_exact",
        "truncated", "omitted_count", "omitted_count_exact", "limits",
        "source", "tasks"
      ],
      "properties": {
        "schema": { "const": "hive-running-status" },
        "schema_version": { "const": 1 },
        "ok": { "const": true },
        "generated_at": { "type": "string", "format": "date-time" },
        "daemon": { "$ref": "#/$defs/Daemon" },
        "complete": {
          "type": "boolean",
          "description": "False when rows were omitted or a project, lock, or transition could not be observed conclusively."
        },
        "count": { "type": "integer", "minimum": 0, "maximum": 32 },
        "observed_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Distinct live tasks found inside the published scan budget. This is a lower bound when observed_count_exact is false."
        },
        "observed_count_exact": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "omitted_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Observed live rows omitted from tasks. Unscanned rows are unknown when omitted_count_exact is false."
        },
        "omitted_count_exact": { "type": "boolean" },
        "limits": { "$ref": "#/$defs/Limits" },
        "source": { "$ref": "#/$defs/Source" },
        "tasks": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/Task" }
        }
      }
    },
    "Daemon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["running", "pid", "uptime_sec"],
      "properties": {
        "running": { "type": "boolean" },
        "pid": { "type": ["integer", "null"], "minimum": 1 },
        "uptime_sec": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "Limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_tasks", "max_output_bytes", "max_string_bytes",
        "max_lock_bytes", "max_metadata_bytes", "max_daemon_pid_bytes",
        "max_projects_scanned", "max_filesystem_entries_scanned"
      ],
      "properties": {
        "max_tasks": { "const": 32 },
        "max_output_bytes": { "const": 65536 },
        "max_string_bytes": { "const": 256 },
        "max_lock_bytes": { "const": 16384 },
        "max_metadata_bytes": { "const": 65536 },
        "max_daemon_pid_bytes": { "const": 4096 },
        "max_projects_scanned": { "const": 256 },
        "max_filesystem_entries_scanned": { "const": 10000 }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projects_total", "projects_scanned", "projects_omitted",
        "projects_unavailable", "filesystem_entries_scanned", "tasks_scanned",
        "malformed_locks", "stale_locks", "transition_skips", "scan_truncated"
      ],
      "properties": {
        "projects_total": { "type": "integer", "minimum": 0 },
        "projects_scanned": { "type": "integer", "minimum": 0 },
        "projects_omitted": { "type": "integer", "minimum": 0 },
        "projects_unavailable": { "type": "integer", "minimum": 0 },
        "filesystem_entries_scanned": { "type": "integer", "minimum": 0 },
        "tasks_scanned": { "type": "integer", "minimum": 0 },
        "malformed_locks": { "type": "integer", "minimum": 0 },
        "stale_locks": { "type": "integer", "minimum": 0 },
        "transition_skips": { "type": "integer", "minimum": 0 },
        "scan_truncated": {
          "type": "boolean",
          "description": "True when a project or filesystem-entry scan budget stopped observation before all registered task entries were inspected."
        }
      }
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project", "slug", "display_name", "stage", "workflow", "status",
        "marker", "action", "metadata_status", "liveness"
      ],
      "properties": {
        "project": { "$ref": "#/$defs/BoundedString" },
        "slug": { "$ref": "#/$defs/BoundedString" },
        "display_name": { "anyOf": [{ "$ref": "#/$defs/BoundedString" }, { "type": "null" }] },
        "stage": { "$ref": "#/$defs/BoundedString" },
        "workflow": { "anyOf": [{ "$ref": "#/$defs/BoundedString" }, { "type": "null" }] },
        "status": { "const": "running" },
        "marker": {
          "type": "null",
          "description": "Reserved for a future bounded marker projection; v1 does not read task state files."
        },
        "action": { "const": "agent_running" },
        "metadata_status": {
          "type": "string",
          "enum": ["ok", "absent", "invalid", "unreadable", "too_large"]
        },
        "liveness": { "$ref": "#/$defs/Liveness" }
      }
    },
    "Liveness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state", "running", "source", "task_lock_alive", "agent_pid_alive",
        "runner_pid", "agent_pid"
      ],
      "properties": {
        "state": { "const": "running" },
        "running": { "const": true },
        "source": {
          "type": "string",
          "enum": ["task_lock", "agent_pid", "task_lock_and_agent_pid"]
        },
        "task_lock_alive": { "type": "boolean" },
        "agent_pid_alive": { "type": ["boolean", "null"] },
        "runner_pid": { "type": ["integer", "null"], "minimum": 1 },
        "agent_pid": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "BoundedString": {
      "type": "string",
      "maxLength": 256
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "schema_version", "ok", "error_class", "error_kind",
        "exit_code", "message"
      ],
      "properties": {
        "schema": { "const": "hive-running-status" },
        "schema_version": { "const": 1 },
        "ok": { "const": false },
        "error_class": { "type": "string" },
        "error_kind": { "type": "string", "enum": ["config", "internal", "error"] },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "message": { "type": "string" },
        "candidates": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "id": { "type": "string" },
        "path": { "type": "string" }
      }
    }
  }
}
