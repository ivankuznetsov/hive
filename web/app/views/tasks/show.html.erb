<% content_for(:title, "hivebox — #{task_title(@row)}") %>

<div class="task-header">
  <h1><%= task_title(@row) %></h1>
  <%= stage_badge(@row["stage"]) %>
  <span class="task-meta"><%= status_dot(@row) %> <%= @row["action_label"].presence || @row["marker"].presence || "idle" %></span>
</div>
<p class="task-slug"><%= @project["name"] %> · <%= @row["slug"] %></p>

<%# The action row stays simple-user friendly: only the state-driven
    primary actions appear (Approve when the gate is passable, Run when the
    operator drives stages manually, Diff when a worktree exists). The
    sharp tools live in the Advanced section at the bottom of the page. %>
<div class="task-actions">
  <% if stage_passable?(@row) %>
    <%= button_to "Approve", task_approve_path(@project["name"], @row["slug"]),
          params: { from: @row["stage"] }, data: { turbo_submits_with: "Approving…" } %>
  <% end %>
  <% if !@daemon_enabled && (dispatch_action = stage_dispatch_action(@row["stage"])) %>
    <%= button_to "Run #{stage_run_verb(@row["stage"])}", task_run_path(@project["name"], @row["slug"]),
          params: { action_name: dispatch_action, stage: @row["stage"] }, class: "btn-secondary",
          data: { turbo_submits_with: "Queueing…" } %>
  <% end %>
  <% if @worktree_exists %>
    <%= link_to "Diff", task_diff_path(@project["name"], @row["slug"]), class: "btn btn-secondary" %>
  <% end %>
</div>


<% if @questions.any? %>
  <section class="qa">
    <h2>Questions from the agent</h2>
    <% if (idea_text = original_idea_text(@row)) %>
      <details class="idea-context" open>
        <summary class="muted">Original idea</summary>
        <p class="idea-text"><%= idea_text %></p>
      </details>
    <% end %>
    <p class="muted">Answer what you can — the daemon resumes the brainstorm once answers land. Unanswered questions stay open.</p>
    <%= form_with url: task_answers_path(@project["name"], @row["slug"]) do |f| %>
      <% @questions.each do |question| %>
        <div class="qa-item">
          <%# Single line: qa-question is pre-wrap, so template indentation
              would render as a first-line indent. %>
          <p class="qa-question"><span class="qa-number">Q<%= question.n %></span><%= question.text %></p>
          <%= text_area_tag "answers[#{question.n}]", "", placeholder: "Your answer…",
                aria: { label: "Answer to question #{question.n}" } %>
        </div>
      <% end %>
      <p><%= f.submit "Send answers", data: { turbo_submits_with: "Sending…" } %></p>
    <% end %>
  </section>

  <details class="intervene">
    <summary class="muted">Free-form steer instead</summary>
    <%= form_with url: task_intervene_path(@project["name"], @row["slug"]) do |f| %>
      <%= f.text_area :message, required: true, placeholder: "Steer the next run…" %>
      <p><%= f.submit "Send", data: { turbo_submits_with: "Sending…" } %></p>
    <% end %>
  </details>
<% else %>
  <%= form_with url: task_intervene_path(@project["name"], @row["slug"]), class: "intervene" do |f| %>
    <%= f.label :message, "Steer or answer the agent" %>
    <%= f.text_area :message, required: true, placeholder: "Answer a brainstorm question, or steer the next run…" %>
    <p><%= f.submit "Send", data: { turbo_submits_with: "Sending…" } %></p>
  <% end %>
<% end %>

<% if @log %>
  <h2>Log</h2>
  <%= turbo_frame_tag "task-log", src: task_log_path(@project["name"], @row["slug"]),
        data: { controller: "poll", poll_interval_value: 3000 } do %>
    <div class="log-pane"><pre>Loading log…</pre></div>
  <% end %>
<% end %>

<% if @files.any? %>
  <h2>Artifacts</h2>
  <% @files.each_with_index do |(name, content), i| %>
    <details class="artifact" <%= "open" if i.zero? %>>
      <summary><%= name %></summary>
      <div class="artifact-body"><pre><%= content %></pre></div>
    </details>
  <% end %>
<% end %>

<details class="advanced">
  <summary>Advanced</summary>
  <div class="advanced-item">
    <div>
      <p class="advanced-title">Send back a stage</p>
      <p class="muted">Move this task to the previous gate. Artifacts are kept — the prior stage resumes where it left off.</p>
    </div>
    <%= button_to "Reject", task_reject_path(@project["name"], @row["slug"]),
          params: { from: @row["stage"] }, class: "btn-danger",
          data: { turbo_confirm: "Send #{@row["slug"]} back a stage?" } %>
  </div>
  <% unless stage_passable?(@row) %>
    <div class="advanced-item">
      <div>
        <p class="advanced-title">Force approve</p>
        <p class="muted">Advance to the next stage even though this one isn't marked complete — the next agent runs with whatever exists now (e.g. unanswered questions stay unanswered).</p>
      </div>
      <%= button_to "Force approve", task_approve_path(@project["name"], @row["slug"]),
            params: { from: @row["stage"], force: "1" }, class: "btn-secondary",
            data: { turbo_confirm: "Advance #{@row["slug"]} even though the stage isn't marked complete?" } %>
    </div>
  <% end %>
</details>
