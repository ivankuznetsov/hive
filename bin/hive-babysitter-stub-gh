#!/usr/bin/env ruby
# frozen_string_literal: true

def log_skip(argv)
  path = ENV.fetch("HIVE_BABYSITTER_DRY_RUN_LOG", ".babysitter-dry-run-skipped.log")
  File.open(path, "a") { |file| file.puts("[dry-run] gh #{argv.join(' ')} skipped") }
rescue SystemCallError
  nil
end

argv = ARGV.dup

def stripped_global_options(argv)
  rest = argv.dup
  loop do
    case rest.first
    when "-R", "--repo", "--hostname"
      rest.shift(2)
    when /\A--repo=/
      rest.shift
    when /\A-/
      rest.shift
    else
      break
    end
  end
  rest
end

# `-F`/`--field name=@file` (and the glued `-Fname=@file` / `--field=name=@file`
# forms) reads the value from a file, which gh sends as a request body even on a
# GET — so it must be treated as an unsafe payload. The `.to_s` guards cover a
# nil value (a trailing `-F` with no argument) and an empty split result, which
# would otherwise raise `NoMethodError` on `nil.start_with?`.
def field_uses_file?(value)
  value.to_s.split("=", 2).last.to_s.start_with?("@")
end

def api_read_only?(rest)
  return false unless rest.first == "api"

  method = nil
  payload = false
  unsafe_payload = false
  cache = false
  index = 1
  while index < rest.length
    arg = rest[index]
    case arg
    when "-X", "--method"
      method = rest[index + 1]
      index += 2
    when /\A--method=(.+)\z/
      method = Regexp.last_match(1)
      index += 1
    when /\A-X=?(.+)\z/
      method = Regexp.last_match(1)
      index += 1
    when "-f", "--raw-field"
      payload = true
      index += 2
    when "-F", "--field"
      payload = true
      unsafe_payload ||= field_uses_file?(rest[index + 1])
      index += 2
    when "--input"
      payload = true
      unsafe_payload = true
      index += 2
    when "--cache"
      cache = true
      index += 2
    when /\A-f.+\z/, /\A--raw-field=.+\z/
      payload = true
      index += 1
    when /\A-F(.+)\z/
      payload = true
      unsafe_payload ||= field_uses_file?(Regexp.last_match(1))
      index += 1
    when /\A--field=(.+)\z/
      payload = true
      unsafe_payload ||= field_uses_file?(Regexp.last_match(1))
      index += 1
    when /\A--input=.+\z/
      payload = true
      unsafe_payload = true
      index += 1
    when /\A--cache=.*\z/
      cache = true
      index += 1
    else
      index += 1
    end
  end

  return method.casecmp("GET").zero? && !unsafe_payload && !cache if method

  !payload && !cache
end

def read_only?(rest)
  case rest[0]
  when "api"
    api_read_only?(rest)
  when "auth"
    rest[1] == "status"
  when "pr"
    %w[checks diff list status view].include?(rest[1])
  when "run"
    %w[list view watch].include?(rest[1])
  when "repo"
    rest[1] == "view"
  when "workflow"
    %w[list view].include?(rest[1])
  else
    false
  end
end

def external_launcher_option?(rest)
  return true if rest.any? { |arg| arg == "--web" || arg.start_with?("--web=") }
  return false unless [%w[pr view], %w[repo view], %w[run view], %w[workflow view]].include?(rest[0, 2])

  rest.drop(2).any? { |arg| arg == "-w" || arg.start_with?("-w") }
end

rest = stripped_global_options(argv)

unless read_only?(rest) && !external_launcher_option?(rest)
  log_skip(argv)
  warn "[dry-run] gh #{argv.join(' ')} skipped"
  exit 0
end

real = ENV["HIVE_BABYSITTER_REAL_GH"].to_s
if real.empty?
  warn "hive-babysitter dry-run: HIVE_BABYSITTER_REAL_GH is unset; refusing to guess a path for the real gh binary"
  exit 127
end

%w[
  GH_PAGER PAGER GH_BROWSER BROWSER GH_EDITOR GIT_EDITOR VISUAL EDITOR GH_FORCE_TTY
  GH_CONFIG_DIR XDG_CONFIG_HOME
].each { |key| ENV.delete(key) }
exec(real, *argv)
