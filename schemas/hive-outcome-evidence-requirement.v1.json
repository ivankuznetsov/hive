{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive.local/schemas/hive-outcome-evidence-requirement.v1.json",
  "title": "Hive Outcome Evidence Requirement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "task", "project", "task_generation",
    "recovery_epoch", "generation", "requirement", "implementation",
    "claims", "exclusions", "traceability", "inference",
    "reviewer_capabilities", "created_at"
  ],
  "properties": {
    "schema": { "const": "hive-outcome-evidence-requirement" },
    "schema_version": { "const": 1 },
    "task": { "type": "string", "minLength": 1, "maxLength": 255 },
    "project": { "type": "string", "minLength": 1, "maxLength": 255 },
    "task_generation": { "type": "string", "minLength": 1, "maxLength": 512 },
    "recovery_epoch": { "type": "integer", "minimum": 0 },
    "generation": { "$ref": "#/$defs/Digest" },
    "requirement": { "const": "outcome_evidence_required" },
    "implementation": { "$ref": "#/$defs/Implementation" },
    "claims": {
      "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
      "items": { "$ref": "#/$defs/Claim" }
    },
    "exclusions": {
      "type": "array", "maxItems": 16, "uniqueItems": true,
      "items": { "$ref": "#/$defs/Exclusion" }
    },
    "traceability": {
      "type": "object", "minProperties": 1, "maxProperties": 10000,
      "propertyNames": { "$ref": "#/$defs/SafePath" },
      "additionalProperties": {
        "type": "array", "minItems": 1, "maxItems": 21, "uniqueItems": true,
        "items": { "$ref": "#/$defs/SafeId" }
      }
    },
    "inference": { "$ref": "#/$defs/Actor" },
    "reviewer_capabilities": { "$ref": "#/$defs/ReviewerCapabilities" },
    "created_at": { "type": "string", "format": "date-time", "maxLength": 64 }
  },
  "$defs": {
    "Digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "Oid": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "SafeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "SafePath": {
      "type": "string", "minLength": 1, "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"
    },
    "Implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository", "branch", "implementation_base", "merge_base",
        "implementation_head", "changed_paths", "changed_paths_digest"
      ],
      "properties": {
        "repository": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "maxLength": 512 }
          ]
        },
        "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "implementation_base": { "$ref": "#/$defs/Oid" },
        "merge_base": { "$ref": "#/$defs/Oid" },
        "implementation_head": { "$ref": "#/$defs/Oid" },
        "changed_paths": {
          "type": "array", "minItems": 1, "maxItems": 10000,
          "uniqueItems": true, "items": { "$ref": "#/$defs/SafePath" }
        },
        "changed_paths_digest": { "$ref": "#/$defs/Digest" }
      }
    },
    "Actor": {
      "type": "object", "additionalProperties": false,
      "required": ["context_id", "agent", "model", "effort"],
      "properties": {
        "context_id": { "$ref": "#/$defs/SafeId" },
        "agent": { "$ref": "#/$defs/SafeId" },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "effort": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "ReviewerCapabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["proof_kinds", "temporal_video"],
      "properties": {
        "proof_kinds": {
          "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
          "items": { "enum": ["screenshot", "video", "terminal", "document"] }
        },
        "temporal_video": { "type": "boolean" }
      }
    },
    "Claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "changed_paths", "proof_kind"],
      "properties": {
        "id": { "$ref": "#/$defs/SafeId" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "changed_paths": { "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": { "$ref": "#/$defs/SafePath" } },
        "proof_kind": { "enum": ["screenshot", "video", "terminal", "document"] }
      }
    },
    "Exclusion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "changed_paths", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/SafeId" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "changed_paths": { "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": { "$ref": "#/$defs/SafePath" } },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    }
  }
}
