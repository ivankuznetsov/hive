#!/usr/bin/env ruby

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "hive"
require "hive/cli"
require "json"

if ARGV == [ "--version" ] || ARGV == [ "-v" ]
  puts Hive::VERSION
  exit 0
end

JSON_TRUE_OPTIONS = %w[--json --json=true --json=TRUE --json=t --json=T].freeze
JSON_FALSE_OPTIONS = %w[--no-json --skip-json --json=false --json=FALSE --json=f --json=F].freeze
JSON_BOOLEAN_OPTIONS = (JSON_TRUE_OPTIONS + JSON_FALSE_OPTIONS).freeze
STAGE_ACTION_USAGE_COMMANDS = %w[brainstorm plan develop open-pr review artifacts finalize archive].freeze
NEW_VALUE_OPTIONS = %w[--depends-on --workflow].freeze
JSON_USAGE_ERROR_CONTRACTS = {
  "run" => { schema: "hive-run", error_kind: "invalid_task_path" },
  "status" => { schema: "hive-status", error_kind: "error" },
  "rebase-status" => { schema: "hive-rebase-status", schema_version: 1, error_kind: "invalid_task_path" },
  "approve" => { schema: "hive-approve", error_kind: "invalid_task_path" },
  "drop" => { schema: "hive-drop", error_kind: "invalid_task_path" },
  "findings" => { schema: "hive-findings", error_kind: "invalid_task_path" },
  "patrol" => { schema: "hive-patrol", error_kind: "error" },
  "accept-finding" => {
    schema: "hive-findings",
    error_kind: "invalid_task_path",
    extras: { "operation" => "accept" }
  },
  "reject-finding" => {
    schema: "hive-findings",
    error_kind: "invalid_task_path",
    extras: { "operation" => "reject" }
  },
  "markers" => { schema: "hive-markers-clear", error_kind: "invalid_task_path" },
  "forget" => { schema: "hive-forget", error_kind: "usage" },
  "prune" => { schema: "hive-prune", error_kind: "usage" },
  "doctor" => { schema: "hive-doctor.v1", schema_version: false, error_kind: "usage" },
  "setup" => { schema: "hive-setup", schema_version: false, error_kind: "usage" },
  "connect" => { format: :screenote },
  "disconnect" => { format: :screenote },
  "metrics" => { schema: "hive-metrics-rollback-rate", error_kind: "error", error_class: false },
  "digest" => { schema: "hive-digest", error_kind: "usage" },
  "answer-digest" => { schema: "hive-answer-digest", error_kind: "usage" },
  # Residual workflow argv-shape errors raised by Thor before command dispatch
  # (for example too many positionals) must ride the same JSON envelope as the
  # command's own UsageError. Bare `hive workflow` is handled in-command.
  "workflow" => { schema: "hive-workflow-new", error_kind: "usage" },
  # `hive bot` takes a single SUBCOMMAND positional and (unlike `daemon`) has no
  # `*targets` splat, so an extra positional such as `hive bot status extra` is
  # rejected by Thor before `Hive::Commands::Bot#call` runs — bypassing the
  # command-level usage-error emitters. Ride the same hive-bot-status envelope
  # those emitters use so every `hive bot ... --json` usage error still produces
  # an ok:false document on stdout instead of bare Thor prose on stderr.
  "bot" => { schema: "hive-bot-status", error_kind: "extra_arguments" },
  "pr" => {
    schema: "hive-stage-action",
    error_kind: "invalid_task_path",
    extras: { "verb" => "open-pr" }
  }
}.merge(
  STAGE_ACTION_USAGE_COMMANDS.to_h do |command|
    [ command, { schema: "hive-stage-action", error_kind: "invalid_task_path", extras: { "verb" => command } } ]
  end
).freeze

# Thor treats a class option before the subcommand as input to its help path.
# Keep `hive --json status` equivalent to `hive status --json`.
def normalize_leading_json_options!(argv)
  leading = []
  leading << argv.shift while JSON_BOOLEAN_OPTIONS.include?(argv.first)
  return if leading.empty?

  cmd_idx = argv.index { |a| !a.start_with?("-") }
  return argv.unshift(*leading) unless cmd_idx

  argv.insert(cmd_idx + 1, *leading)
end

# True for an allow-listed value option in `--name=VALUE` form (e.g.
# `--workflow=content`). Single-sources the predicate shared by
# new_text_start_index and lift_new_options!.
def new_value_assignment?(arg)
  NEW_VALUE_OPTIONS.any? { |name| arg.start_with?("#{name}=") }
end

def new_text_start_index(argv)
  cmd_idx = argv.index { |a| !a.start_with?("-") }
  return nil unless cmd_idx && argv[cmd_idx] == "new"

  idx = cmd_idx + 1
  project_idx = nil
  while idx < argv.length
    arg = argv[idx]
    if JSON_BOOLEAN_OPTIONS.include?(arg)
      idx += 1
      next
    end
    if NEW_VALUE_OPTIONS.include?(arg)
      # Boundary scan only: advance past the value unconditionally. This
      # intentionally diverges from lift_new_options!, which keeps a
      # trailing/option-like value option as literal text (the
      # `!value.start_with?("-")` guard). The two only differ for the
      # out-of-scope "value option before PROJECT with a missing/option-like
      # value" case, and the sole consumer of this index
      # (reject_unsupported_json_assignments!) runs first and inspects only
      # `--json=` tokens, so the divergence is harmless. Keep both guards in
      # sync if a future edit changes the allow-list or that consumer.
      idx += 2
      next
    end
    if new_value_assignment?(arg)
      idx += 1
      next
    end
    unless arg.start_with?("-")
      project_idx = idx
      break
    end

    idx += 1
  end
  return nil unless project_idx

  project_idx + 1
end

# Thor only honours `--help` *before* the subcommand name (`hive help approve`);
# `hive approve --help` would be consumed as the TARGET positional. Intercept
# the help flag before Thor dispatch so the convention agents try first works.
def rewrite_help_flag!(argv)
  return if argv.empty?

  cmd_idx = argv.index { |a| !a.start_with?("-") }
  return unless cmd_idx

  text_start_idx = new_text_start_index(argv)
  help_idx = argv.each_index.find do |idx|
    next false if idx <= cmd_idx
    next false if text_start_idx && idx >= text_start_idx

    argv[idx] == "--help" || argv[idx] == "-h"
  end
  return unless help_idx

  cmd = argv[cmd_idx]
  argv.replace(argv[0...cmd_idx] + [ "help", cmd ])
end

# Thor stops parsing options at the first positional (PROJECT), so allow-listed
# options must be lifted ahead of it before dispatch wherever they appear after
# `new` — before the project, between the project and the task text, or after the
# text.
def lift_new_options!(argv)
  cmd_idx = argv.index { |a| !a.start_with?("-") }
  return unless cmd_idx && argv[cmd_idx] == "new"

  lifted = []
  rest = []
  protected_tail = false
  idx = cmd_idx + 1
  while idx < argv.length
    arg = argv[idx]
    if protected_tail
      rest << arg
    elsif arg == "--"
      protected_tail = true
    elsif JSON_BOOLEAN_OPTIONS.include?(arg)
      lifted << arg
    elsif NEW_VALUE_OPTIONS.include?(arg)
      # Only consume the next token as the value when it exists and does not
      # begin with `-`; otherwise the bare option stays literal text so a trailing
      # or value-less `--workflow`/`--depends-on` cannot eat PROJECT on rebuild.
      # (new_text_start_index's boundary scan intentionally advances past the
      # value unconditionally — see the note there for why the divergence is
      # harmless.)
      value = argv[idx + 1]
      if value && !value.start_with?("-")
        lifted << arg << value
        idx += 1
      else
        rest << arg
      end
    elsif new_value_assignment?(arg)
      lifted << arg
    else
      rest << arg
    end
    idx += 1
  end

  project = rest.shift
  return unless project

  tail = rest.empty? ? [] : [ "--", *rest ]
  argv.replace(argv[0...cmd_idx] + [ "new" ] + lifted + [ project ] + tail)
end

def json_requested?(argv)
  JSON_TRUE_OPTIONS.include?(argv.reverse.find { |arg| JSON_BOOLEAN_OPTIONS.include?(arg) })
end

def reject_invalid_argv_encoding!(argv)
  idx = argv.index { |arg| !arg.valid_encoding? }
  return unless idx

  raise Thor::MalformattedArgumentError, "invalid byte sequence in argument #{idx + 1}"
end

def reject_unsupported_json_assignments!(argv)
  text_start_idx = new_text_start_index(argv)
  arg = argv.each_with_index.find do |candidate, idx|
    next false if text_start_idx && idx >= text_start_idx

    candidate.start_with?("--json=") && !JSON_BOOLEAN_OPTIONS.include?(candidate)
  end&.first
  return unless arg

  raise Thor::MalformattedArgumentError, "invalid boolean value for --json: #{arg.split('=', 2).last.inspect}"
end

DIGEST_MERGED_PRS_SOURCE = "merged-prs".freeze

# Mirror Commands::Digest#normalized_source at the argv level: the merged-PR
# path is selected by `--source merged-prs` or by any `--repo` with no other
# --source. A Thor usage error there (e.g. `hive digest --source merged-prs
# --bad --json`) is raised before the command runs, so without this the static
# "digest" contract would emit the shipped-digest `hive-digest` schema instead
# of the `hive-merged-pr-digest` envelope the command itself emits.
def digest_merged_pr_argv?(argv)
  source = nil
  repo = false
  argv.each_with_index do |arg, idx|
    if arg == "--source"
      source = argv[idx + 1].to_s
    elsif arg.start_with?("--source=")
      source = arg.split("=", 2).last
    elsif arg == "--repo" || arg.start_with?("--repo=")
      repo = true
    end
  end
  return true if source && source.strip == DIGEST_MERGED_PRS_SOURCE

  source.to_s.strip.empty? && repo
end

def json_usage_error_contract(argv)
  command_idx = argv.index { |arg| arg.valid_encoding? && !arg.start_with?("-") }
  return nil unless command_idx

  command = argv[command_idx]
  positionals = argv[(command_idx + 1)..].select { |arg| arg.valid_encoding? && !arg.start_with?("-") }

  if command == "digest" && digest_merged_pr_argv?(argv)
    return { schema: "hive-merged-pr-digest", error_kind: "usage" }
  end
  if command == "status" && argv.any? { |arg| arg.valid_encoding? && (arg == "--diagnose" || arg.start_with?("--diagnose=")) }
    return { schema: "hive-status-diagnose", error_kind: "error" }
  end
  if command == "pairing"
    require "hive/commands/pairing"
    subcommand = positionals.find { |arg| Hive::Commands::Pairing::VALID_SUBCOMMANDS.include?(arg) }
    schema = subcommand == "approve" ? "hive-pairing-approve" : "hive-pairing-list"
    return { schema: schema, error_kind: "invalid_arguments" }
  end
  if command == "daemon"
    require "hive/commands/daemon"
    subcommand_idx = positionals.index { |arg| Hive::Commands::Daemon::VALID_SUBCOMMANDS.include?(arg) }
    subcommand = positionals[subcommand_idx] if subcommand_idx
    if subcommand == "queue"
      return {
        schema: "hive-daemon-queue",
        format: :daemon_queue,
        error_kind: "invalid_arguments",
        extras: { "action" => positionals[subcommand_idx + 1] }
      }
    end

    return { schema: "hive-daemon-enroll", error_kind: "wrong_subcommand_flag" }
  end
  if command == "web"
    require "hive/commands/web"
    subcommand = positionals.find { |arg| Hive::Commands::Web::VALID_SUBCOMMANDS.include?(arg) }
    return nil unless %w[install status].include?(subcommand)

    return { schema: "hive-web-#{subcommand}", schema_version: false, error_kind: "invalid_task_path" }
  end

  JSON_USAGE_ERROR_CONTRACTS[command]
end

def json_usage_error_payload(contract, error)
  if contract[:format] == :screenote
    require "hive/commands/screenote_envelope"
    return Hive::Commands::ScreenoteEnvelope.error_payload(error)
  end
  if contract[:format] == :daemon_queue
    return {
      "schema" => contract.fetch(:schema),
      "schema_version" => Hive::Schemas::SCHEMA_VERSIONS.fetch(contract.fetch(:schema)),
      "ok" => false,
      "action" => contract.fetch(:extras).fetch("action"),
      "error_kind" => contract.fetch(:error_kind),
      "message" => error.message
    }
  end

  schema = contract.fetch(:schema)
  error_kind = contract.fetch(:error_kind)
  extras = contract.fetch(:extras, {})
  if Hive::Schemas::SCHEMA_VERSIONS.key?(schema) && contract.fetch(:error_class, true)
    return Hive::Schemas::ErrorEnvelope.build(
      schema: schema,
      error: error,
      error_kind: error_kind,
      extras: extras
    )
  end

  payload = {
    "schema" => schema,
    "ok" => false,
    "error_kind" => error_kind,
    "exit_code" => error.respond_to?(:exit_code) ? error.exit_code : Hive::ExitCodes::GENERIC,
    "message" => error.message
  }.merge(extras)
  payload["error_class"] = error.class.name.split("::").last if contract.fetch(:error_class, true)
  if Hive::Schemas::SCHEMA_VERSIONS.key?(schema)
    payload["schema_version"] = Hive::Schemas::SCHEMA_VERSIONS.fetch(schema)
  elsif contract[:schema_version] != false
    payload["schema_version"] = contract.fetch(:schema_version, 1)
  end
  payload
end

def emit_json_usage_error(argv, error)
  contract = json_usage_error_contract(argv)
  return false unless contract && json_requested?(argv)

  puts JSON.generate(json_usage_error_payload(contract, error))
  true
rescue Errno::EPIPE, JSON::GeneratorError
  true
end

begin
  reject_invalid_argv_encoding!(ARGV)
  reject_unsupported_json_assignments!(ARGV)
  normalize_leading_json_options!(ARGV)
  rewrite_help_flag!(ARGV)
  lift_new_options!(ARGV)
  Hive::CLI.start(ARGV, debug: true)
rescue Thor::Error => e
  error = Hive::InvalidTaskPath.new(e.message)
  emitted_json = emit_json_usage_error(ARGV, error)
  warn(emitted_json ? "hive: #{error.message}" : error.message)
  exit(error.exit_code)
rescue Hive::Error => e
  warn "hive: #{e.message}"
  exit(e.respond_to?(:exit_code) ? e.exit_code : 1)
end
