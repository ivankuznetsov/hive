<% content_for(:title, "hivebox — #{task_title(@row)}") %>

<div class="task-header">
  <h1><%= task_title(@row) %></h1>
</div>
<p class="task-slug"><%= @project["name"] %> · <%= @row["slug"] %></p>

<%# The live state block: badge, status, actions, Q&A / waiting banner.
    Polled so the page follows the daemon — answers recorded → agent
    resumes → next round's questions or a passable gate appear without a
    manual reload. Forms inside target _top so submits navigate normally. %>
<%= render "tasks/state", with_src: true %>

<% if @log %>
  <h2>Log</h2>
  <%= turbo_frame_tag "task-log", src: task_log_path(@project["name"], @row["slug"]),
        data: { controller: "poll", poll_interval_value: 3000 } do %>
    <div class="log-pane"><pre>Loading log…</pre></div>
  <% end %>
<% end %>

<% if @files.any? %>
  <h2>Artifacts</h2>
  <% @files.each_with_index do |(name, content), i| %>
    <details class="artifact" <%= "open" if i.zero? %>>
      <summary><%= name %></summary>
      <div class="artifact-body"><pre><%= content %></pre></div>
    </details>
  <% end %>
<% end %>

<details class="advanced">
  <summary>Advanced</summary>
  <div class="advanced-item">
    <div>
      <p class="advanced-title">Send back a stage</p>
      <p class="muted">Move this task to the previous gate. Artifacts are kept — the prior stage resumes where it left off.</p>
    </div>
    <%= button_to "Reject", task_reject_path(@project["name"], @row["slug"]),
          params: { from: @row["stage"] }, class: "btn-danger",
          data: { turbo_confirm: "Send #{@row["slug"]} back a stage?" } %>
  </div>
  <% unless stage_passable?(@row) %>
    <div class="advanced-item">
      <div>
        <p class="advanced-title">Force approve</p>
        <p class="muted">Advance to the next stage even though this one isn't marked complete — the next agent runs with whatever exists now (e.g. unanswered questions stay unanswered).</p>
      </div>
      <%= button_to "Force approve", task_approve_path(@project["name"], @row["slug"]),
            params: { from: @row["stage"], force: "1" }, class: "btn-secondary",
            data: { turbo_confirm: "Advance #{@row["slug"]} even though the stage isn't marked complete?" } %>
    </div>
  <% end %>
</details>
