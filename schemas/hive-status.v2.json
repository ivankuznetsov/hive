{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:status:v2",
  "title": "hive status output (v2)",
  "description": "Stable contract emitted by `hive status --json`. Either a SuccessPayload (the projects+tasks snapshot) or an ErrorPayload (a Hive::Error envelope). Discriminate by `ok`.",
  "oneOf": [
    {
      "$ref": "#/$defs/SuccessPayload"
    },
    {
      "$ref": "#/$defs/ErrorPayload"
    }
  ],
  "$defs": {
    "SuccessPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "ok",
        "generated_at",
        "projects"
      ],
      "properties": {
        "schema": {
          "const": "hive-status"
        },
        "schema_version": {
          "const": 2
        },
        "ok": {
          "const": true
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Project"
          }
        }
      }
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "ok",
        "error_class",
        "error_kind",
        "exit_code",
        "message"
      ],
      "description": "Emitted by the top-level rescue in Hive::Commands::Status when an error is raised before json_payload wrote a SuccessPayload. `hive status` doesn't carry slug/stage context — those fields are absent here.",
      "properties": {
        "schema": {
          "const": "hive-status"
        },
        "schema_version": {
          "const": 2
        },
        "ok": {
          "const": false
        },
        "error_class": {
          "type": "string"
        },
        "error_kind": {
          "type": "string",
          "enum": [
            "config",
            "internal",
            "error"
          ]
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "message": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "description": "Present on AmbiguousSlug. Each candidate identifies a project + stage + folder.",
          "items": {
            "type": "object",
            "required": [
              "project",
              "stage",
              "folder"
            ],
            "properties": {
              "project": {
                "type": "string"
              },
              "stage": {
                "type": "string"
              },
              "folder": {
                "type": "string"
              }
            }
          }
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "hive_state_path",
        "tasks"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "hive_state_path": {
          "type": "string"
        },
        "error": {
          "type": "string",
          "enum": [
            "missing_project_path",
            "not_initialised"
          ]
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Task"
          }
        },
        "legacy_stage_dirs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage_dir", "task_count"],
            "properties": {
              "stage_dir": { "type": "string" },
              "task_count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "legacy_migrate_command": {
          "description": "Machine-readable parity of the text-mode `hive migrate` recovery hint. \"hive migrate\" when `legacy_stage_dirs` is non-empty; `null` when the project is clean. Always present (never absent) — the same diagnostic-field-always-present convention `diagnostic` uses on Task.",
          "type": ["string", "null"]
        }
      }
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "slug",
        "folder",
        "state_file",
        "worktree_path",
        "marker",
        "attrs",
        "mtime",
        "age_seconds",
        "claude_pid",
        "claude_pid_alive",
        "action",
        "action_label",
        "suggested_command",
        "next_action",
        "diagnostic"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "1-inbox",
            "2-brainstorm",
            "3-plan",
            "4-execute",
            "5-open-pr",
            "6-review",
            "7-finalize",
            "8-done"
          ]
        },
        "slug": {
          "type": "string"
        },
        "folder": {
          "type": "string"
        },
        "state_file": {
          "type": "string"
        },
        "worktree_path": {
          "description": "Absolute path of the task's git worktree, or null for pre-execute stages (1-inbox, 2-brainstorm, 3-plan) and for tasks whose worktree was never created. Agents that want to open the worktree, edit files, and retry get the path here without re-implementing Hive::Task#worktree_path resolution. See PR #84 review finding #8.",
          "type": [
            "string",
            "null"
          ]
        },
        "marker": {
          "type": "string",
          "enum": [
            "none",
            "waiting",
            "complete",
            "agent_working",
            "execute_waiting",
            "execute_complete",
            "execute_stale",
            "review_working",
            "review_waiting",
            "review_ci_stale",
            "review_stale",
            "review_complete",
            "review_error",
            "error"
          ]
        },
        "attrs": {
          "type": "object",
          "additionalProperties": true
        },
        "mtime": {
          "type": "string",
          "format": "date-time"
        },
        "age_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "claude_pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "claude_pid_alive": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "ready_to_brainstorm",
            "ready_to_plan",
            "ready_to_develop",
            "ready_to_open_pr",
            "ready_for_review",
            "ready_to_finalize",
            "ready_to_archive",
            "needs_input",
            "review_findings",
            "recover_execute",
            "recover_review",
            "agent_running",
            "archived",
            "error"
          ]
        },
        "action_label": {
          "type": "string"
        },
        "suggested_command": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_action": {
          "description": "Optional row-local structured recovery action. Present today for EXECUTE_WAITING reason states; null when the generic action/suggested_command fields are sufficient.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "edit",
                "mv",
                "approve",
                "run",
                "recover_stale",
                "no_op"
              ]
            }
          }
        },
        "diagnostic": {
          "description": "Red-row diagnostic payload for recovery/error states; null for ordinary actionable rows.",
          "oneOf": [
            {
              "$ref": "#/$defs/Diagnostic"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "detail",
        "source",
        "source_path",
        "artifact_paths",
        "generated_by",
        "marker_signature",
        "suggested_next_action",
        "updated_at"
      ],
      "properties": {
        "summary": {
          "description": "Single-line operator summary. Producer caps at 120 chars (TaskAction::DIAGNOSTIC_SUMMARY_MAX); see Hive::TaskAction#diagnostic.",
          "type": "string",
          "maxLength": 120
        },
        "detail": {
          "description": "Multi-line operator detail. Producer caps at 4000 chars (TaskAction::DIAGNOSTIC_DETAIL_MAX); see Hive::TaskAction#diagnostic.",
          "type": "string",
          "maxLength": 4000
        },
        "source": {
          "type": "string",
          "enum": [
            "marker",
            "artifact"
          ]
        },
        "source_path": {
          "description": "Absolute filesystem path of the primary artifact backing this diagnostic, or null when source == marker.",
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_paths": {
          "description": "Absolute paths to the bounded set of artifacts the local extractor inspected. Capped at 20 entries.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        },
        "generated_by": {
          "description": "Origin of the diagnostic body. \"local\" = TaskAction's bounded marker+artifact extraction; agent-profile names (claude / codex / pi) = a headless Hive::DiagnosisAgent run wrote diagnostics/red-status.md. Extending this enum requires registering a new profile in Hive::AgentProfiles AND updating this enum in the same PR (covered by test/unit/schema_files_test.rb).",
          "type": "string",
          "enum": [
            "local",
            "claude",
            "codex",
            "pi"
          ]
        },
        "marker_signature": {
          "description": "SHA256 hex of the marker name + sorted attrs (key=value joined by newline). Pinned freshness key shared by local extraction, TUI live-update gating, and the headless DiagnosisAgent artifact frontmatter. Length 64.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "suggested_next_action": {
          "description": "Optional structured recovery hint for agent consumers. Today populated for recover_review and error rows whose existing suggested_command path applies; null when the operator must edit before retry (max_passes-hit REVIEW_STALE).",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "command"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "retry",
                    "clear_marker",
                    "manual_fix"
                  ]
                },
                "command": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
