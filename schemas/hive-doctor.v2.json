{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hivecli.dev/schemas/hive-doctor.v2.json",
  "title": "hive-doctor.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "managed_skills", "checks", "summary"],
  "properties": {
    "schema": { "const": "hive-doctor.v2" },
    "schema_version": { "const": 2 },
    "managed_skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/ManagedSkill" }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/LegacyCheck" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managed", "legacy_failures", "warnings"],
      "properties": {
        "managed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conflicting", "incompatible", "unavailable", "stale", "missing", "healthy"],
          "properties": {
            "conflicting": { "type": "integer", "minimum": 0 },
            "incompatible": { "type": "integer", "minimum": 0 },
            "unavailable": { "type": "integer", "minimum": 0 },
            "stale": { "type": "integer", "minimum": 0 },
            "missing": { "type": "integer", "minimum": 0 },
            "healthy": { "type": "integer", "minimum": 0 }
          }
        },
        "legacy_failures": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "ManagedSkill": {
      "type": "object",
      "required": ["kind", "stage", "label", "agent", "capability", "managed", "configured_skill", "skill", "status", "health", "severity", "message", "remediation", "expected", "native", "resolution"],
      "properties": {
        "kind": { "const": "managed_skill" },
        "agent": { "type": "string" },
        "capability": { "type": ["string", "null"] },
        "managed": { "type": "boolean" },
        "status": { "enum": ["healthy", "missing", "stale", "incompatible", "conflicting", "unavailable"] },
        "health": { "enum": ["healthy", "missing", "stale", "incompatible", "conflicting", "unavailable"] },
        "severity": { "enum": ["info", "warning", "error"] },
        "remediation": { "type": ["string", "null"] }
      }
    },
    "LegacyCheck": {
      "type": "object",
      "required": ["kind", "stage", "label", "agent", "configured_skill", "skill", "status", "message"],
      "properties": {
        "kind": { "enum": ["dependency", "warning", "runtime_control_plane"] },
        "status": { "enum": ["present", "missing", "version_too_old", "warning", "not_applicable", "ok"] },
        "regime": { "enum": ["plain", "isolated", "managed"] },
        "identity": { "$ref": "#/$defs/ExecutableIdentity" },
        "comparison": { "$ref": "#/$defs/ExecutableComparison" },
        "execution_context": { "$ref": "#/$defs/ExecutionContext" },
        "alias": { "type": "string" },
        "replacement": { "type": "string" },
        "ignored": { "type": "boolean" }
      }
    },
    "ExecutableIdentity": {
      "type": "object",
      "required": ["profile", "regime", "authority", "configured", "launch_path", "effective_target", "version", "version_source", "reason", "version_reason"],
      "properties": {
        "profile": { "type": "string" },
        "regime": { "enum": ["plain", "isolated", "managed"] },
        "authority": { "type": "string" },
        "configured": { "type": "string" },
        "launch_path": { "type": ["string", "null"] },
        "effective_target": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "version_source": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "version_reason": { "type": ["string", "null"] },
        "sandbox_executable": { "type": ["string", "null"] },
        "command_prefix": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ExecutableComparison": {
      "type": "object",
      "required": ["state", "launch_path", "effective_target", "version", "regime_divergence"],
      "properties": {
        "state": { "enum": ["match", "drift", "incomplete", "uninspected"] },
        "launch_path": { "enum": ["same", "different", "unknown"] },
        "effective_target": { "enum": ["same", "different", "unknown"] },
        "version": { "enum": ["same", "older", "newer", "unknown"] },
        "regime_divergence": { "type": "boolean" }
      }
    },
    "ExecutionContext": {
      "type": "object",
      "required": ["installation", "cwd", "cwd_provenance", "complete", "running_currency", "reasons", "sources"],
      "properties": {
        "installation": { "enum": ["installed", "absent", "indeterminate"] },
        "cwd": { "type": "string" },
        "cwd_provenance": { "type": "string" },
        "complete": { "type": "boolean" },
        "running_currency": { "enum": ["current", "stopped", "stale", "unknown"] },
        "reasons": { "type": "array", "items": { "type": "object" } },
        "sources": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
