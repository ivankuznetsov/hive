# See https://help.github.com/articles/ignoring-files for more about ignoring files.
/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules
/config/master.key
/config/credentials/*.key
.env*
