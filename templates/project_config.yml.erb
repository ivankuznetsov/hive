---
project_name: <%= project_name %>
default_branch: <%= default_branch %>
worktree_root: <%= worktree_root %>
hive_state_path: .hive-state
<% unless Hive::Workflows.coding_id?(default_workflow) -%>
default_workflow: <%= default_workflow %>
<% end -%>

claude:
  # tmux uses your logged-in Claude session in an attachable pane.
  # headless keeps the non-interactive `claude -p` path.
  mode: <%= claude_mode %>
  # Applies to every Claude-backed stage, in both tmux and headless mode,
  # EXCEPT where a stage sets a non-yolo `permissions:` scope (below): a
  # read-only/scoped stage runs in "default" permission mode and ignores this
  # value for that stage.
  # bypassPermissions skips permission prompts (maps to
  # --dangerously-skip-permissions); auto uses Claude Code's auto-mode rules.
  permission_mode: <%= claude_permission_mode %>
  # Model for hive-launched claude sessions. "default" tracks whatever
  # Claude Code currently recommends (no hardcoding); "inherit" uses your
  # interactive Claude Code selection (can be expensive); any alias or
  # full model name passes through (sonnet is the budget pick).
  model: <%= claude_model %>
  # Reasoning effort. Unset keeps Claude Code's own default tier; any tier
  # Claude Code accepts passes through verbatim (low/medium/high/xhigh/max
  # as of CC 2.1.x).
<% if claude_effort %>  effort: <%= claude_effort %>
<% else %>  # effort: medium
<% end %>
# Optional per-stage agent tool scopes. Default is yolo, which preserves
# today's stage behavior. Non-yolo scopes are Claude-only and are tool-level
# controls, not an OS sandbox; see docs/permissions.md.
# permissions: yolo
# permissions: read-only
# permissions:
#   preset: scoped
#   tools: [Read, Write, Edit]
#   dirs: [./drafts]

# Stage-level agent for single-agent stages. (6-review uses
# the per-role agent fields under `review.{ci,triage,fix,browser_test}`
# below.) Defaults are claude for planning (deeper reasoning) and codex
# for development (its edit-mode is more efficient for implementation).
#
# `skill` overrides the slash-command the stage's agent invokes inside
# its prompt. Hive ships expecting llm-wiki and compound-engineering to
# be installed alongside your agent CLI. Plan defaults are agent-aware:
# claude → `/plan`, codex → `/llm-wiki:wiki-plan`, pi →
# `/skill:wiki-plan` after profile formatting. Brainstorm defaults to
# `/ce-brainstorm`. Legacy `/compound-engineering:ce-*` values are
# normalized before prompts are rendered. Override here to pin a
# different skill per project.
brainstorm:
  agent: <%= planning_agent %>
  # skill: /ce-brainstorm
  # Brainstorm must WRITE brainstorm.md (its WAITING/COMPLETE marker), so a
  # read-only scope would block it from completing — grant Write/Edit via a
  # scoped block instead. Non-yolo scopes are claude-only, so this stage's
  # agent must be claude to use it.
  # permissions:
  #   preset: scoped
  #   tools: [Read, Write, Edit]
  # Legacy configs may still carry brainstorm.runtime; new projects use
  # the project-global claude.mode setting above.
plan:
  agent: <%= planning_agent %>
  # skill: /plan
  # Plan must WRITE plan.md (its marker), so a read-only scope would block it
  # from completing — grant Write/Edit via a scoped block instead. Non-yolo
  # scopes are claude-only, so this stage's agent must be claude to use it.
  # permissions:
  #   preset: scoped
  #   tools: [Read, Write, Edit]
execute:
  agent: <%= development_agent %>
  # Scoped dirs extend the task folder add-dir list; relative paths are
  # resolved from the task folder. Non-yolo scopes are claude-only: to
  # uncomment this you must also set `agent: claude` here, since the
  # development default is codex, which cannot enforce tool scoping.
  # permissions:
  #   preset: scoped
  #   tools: [Read, Write, Edit]
  #   dirs: [./drafts]
open_pr:
  agent: claude
artifacts:
  agent: claude
finalize:
  agent: claude

# Optional screenshot hosting for artifacts-stage media lives in the global
# hive config (or environment), not in agent prompts:
# screenote:
#   base_url: https://screenote.example
#   api_token: set HIVE_SCREENOTE_API_TOKEN instead of writing a secret here

# Generous sanity caps for runaway agents, not cost targets. Most
# tasks finish well within them; tighten manually only if you hit a
# cap repeatedly. (The deprecated execute_review key from older
# configs has been dropped — review owns reviewer budgets per
# ADR-014.)
budget_usd:
<% Hive::Commands::Init::Prompts::LIMIT_KEYS.each do |key| -%>
  <%= key %>: <%= budgets[key] %>
<% end -%>

timeout_sec:
<% Hive::Commands::Init::Prompts::LIMIT_KEYS.each do |key| -%>
  <%= key %>: <%= timeouts[key] %>
<% end -%>

gh:
  # Deadline for GitHub CLI network calls (`gh auth`, `gh pr view`,
  # `gh pr edit`, `gh pr ready`, etc.).
  network_timeout_sec: 60

rebase:
  enabled: true
  conflict_resolution_timeout_sec: 2700

# 6-review stage configuration. Each role takes an `agent` (one of the
# names registered in Hive::AgentProfiles — claude, codex, pi by default)
# and an optional `prompt_template` path under templates/.
review:
  ci:
    # Path to the project's CI command. `null` skips the CI-fix phase.
    # Example: "bin/ci" for hive itself, "bin/rails test" for a Rails project.
    command: null
    max_attempts: 3
    agent: claude
    prompt_template: ci_fix_prompt.md.erb
  triage:
    enabled: true
    agent: claude
    # Bias presets:
    #   - courageous (default): action-biased — auto-fix polish, clarity,
    #     mechanical findings; escalate only architecture / auth /
    #     contradictions / low-confidence.
    #   - safetyist: escalation-biased — auto-fix only the truly mechanical
    #     (typos, lint); escalate anything else by default.
    bias: <%= triage_bias %>
    # Optional path under <hive-state>/templates/ to override the bias
    # preset's prompt entirely.
    custom_prompt: null
  fix:
    agent: claude
    prompt_template: fix_prompt.md.erb
    auto_commit:
      # inherit preserves the repository's commit signing config. Use
      # bypass to force unsigned automation commits, or fail to pause
      # when commit.gpgsign is enabled.
      sign_policy: inherit
      scope_check:
        # Before Hive auto-commits uncommitted fix-agent edits, it checks
        # the staged paths against default allowed/denied glob lists. Override
        # `allowed_paths` / `denied_paths` here if your project needs a
        # different fallback commit scope.
        enabled: true
  browser_test:
    # Set to true for projects that have a browsable surface (Rails apps,
    # web frontends). Hive itself (CLI tool) leaves this disabled.
    enabled: false
    agent: claude
    prompt_template: browser_test_prompt.md.erb
    max_attempts: 2
  github_publish:
    enabled: true
    max_attempts: 2
  max_passes: 2
  # Aggregate wall-clock cap across all phases of one `hive run` on a
  # 6-review folder. 14400s = 4h, enough for a couple of 1-2h reviewers.
  max_wall_clock_sec: 14400
  # Hive's recommended reviewer set: claude /ce-code-review + codex
  # /ce-code-review + claude /pr-review-toolkit:review-pr. Each entry's
  # `name` becomes part of the output filename (`reviews/<name>-<pass>.md`).
  # The init prompt's reviewer multiselect controls which entries land
  # here; disabled reviewers are omitted from the array entirely. The
  # deep-merge replaces `review.reviewers` wholesale, so editing this
  # list later replaces it (no per-element merge).
  reviewers:
<% if enabled_reviewers.include?("claude-ce-code-review") -%>
    - name: claude-ce-code-review
      kind: agent
      agent: claude
      skill: ce-code-review
      output_basename: claude-ce-code-review
      prompt_template: reviewer_claude_ce_code_review.md.erb
      budget_usd: 50
      timeout_sec: 7200
<% end -%>
<% if enabled_reviewers.include?("codex-ce-code-review") -%>
    - name: codex-ce-code-review
      kind: agent
      agent: codex
      skill: ce-code-review
      output_basename: codex-ce-code-review
      prompt_template: reviewer_codex_ce_code_review.md.erb
      budget_usd: 50
      timeout_sec: 7200
<% end -%>
<% if enabled_reviewers.include?("pr-review-toolkit") -%>
    - name: pr-review-toolkit
      kind: agent
      agent: claude
      skill: pr-review-toolkit:review-pr
      output_basename: pr-review-toolkit
      prompt_template: reviewer_pr_review_toolkit.md.erb
      budget_usd: 50
      timeout_sec: 7200
<% end -%>

# Hive daemon (ADR-024): auto-advances tasks through the pipeline up to
# human-input gates. When `enabled: true`, `hive daemon start` polls
# every project's status and dispatches workflow verbs on tasks ready
# to advance. Stops at `:waiting` / `:review_waiting` / recovery markers
# (where a human is needed) and at 8-finalize while the PR is open on GitHub
# (auto-archives once `gh pr view --json state` returns `MERGED`).
# Disable per-project by flipping this flag and running `hive daemon reload`.
daemon:
  enabled: <%= daemon_enabled %>

# Experimental hive-babysitter: watches open PRs out-of-band and asks
# the development agent to keep them mergeable (rebase, conflicts, red CI).
# This is a separate process from `hive daemon`; start it with
# `hive babysit start`. Disable with `babysitter.enabled: false`.
babysitter:
  enabled: <%= babysitter_enabled %>
  interval: 10m
  max_concurrent_prs: 2
  labels_ignore:
    - wip
    - do-not-merge
    - draft
  dry_run: false
  # Rebase green PRs that have fallen BEHIND the base branch and force-push
  # so strict "branch must be up-to-date" protection can still merge them.
  # Conflicting rebases are left for a human. Set false to disable.
  auto_rebase: true
  budget_minutes: 30
  budget_usd: 50

# Always-on repository patrol. This is separate from the task pipeline:
# the daemon schedules `hive patrol <project>` when enabled, and patrol
# only surfaces validated fixes as GitHub PRs. No findings are written
# to 1-inbox or any stage folder.
patrol:
  # ultrapatrol = every 30m, high = every 2h, medium = every 4h,
  # low = new commits only, off = disabled. Explicit trigger /
  # poll_interval_sec / enabled keys can still override the mode.
  mode: <%= patrol_mode.inspect %>
  agent: claude
  min_confidence_to_fix: medium
  max_findings_per_feature: 10
  max_prs_per_cycle: 3
  # Open ready (non-draft) PRs by default so the babysitter — which skips
  # draft PRs — picks them up. Set true to open draft PRs instead.
  draft_prs: false
  # Hand patrol-opened PRs to the standard 6-review flow.
  review_prs: true
  include: []
  exclude:
    - node_modules
    - dist
    - build
    - vendor
    - .git
  commands:
    format: null
    lint: null
    typecheck: null
    test: null
  # Review handoff for patrol-created PRs uses a cheaper reviewer set
  # than normal feature PRs. The default is the native `codex review`
  # single-pass adapter; optionally add the ce-code-review fan-out or
  # Claude during init when you want broader patrol review coverage.
  review:
    max_context_files: 24
    max_owned_files: 12
    reviewers:
<% if patrol_reviewers.include?("codex-native-review") -%>
      # Native `codex review` — one cheap, tuned, read-only pass whose
      # stdout is captured into the findings file. Needs no CE skill.
      - name: codex-native-review
        kind: codex_review
        agent: codex
        output_basename: codex-native-review
        prompt_template: reviewer_codex_native_review.md.erb
        timeout_sec: 5400
<% end -%>
<% if patrol_reviewers.include?("codex-ce-code-review") -%>
      - name: codex-ce-code-review
        kind: agent
        agent: codex
        skill: ce-code-review
        output_basename: codex-ce-code-review
        prompt_template: reviewer_codex_ce_code_review.md.erb
        budget_usd: 50
        timeout_sec: 5400
<% end -%>
<% if patrol_reviewers.include?("claude-ce-code-review") -%>
      - name: claude-ce-code-review
        kind: agent
        agent: claude
        skill: ce-code-review
        output_basename: claude-ce-code-review
        prompt_template: reviewer_claude_ce_code_review.md.erb
        budget_usd: 50
        timeout_sec: 5400
<% end -%>

# Auto-rebase pre-step for `hive run` (plan
# docs/plans/2026-05-14-001-feat-hive-auto-rebase-stale-worktree-plan.md).
# Before dispatching the stage runner, `hive run` detects whether the
# task's worktree branch is behind `origin/<default_branch>` and, if so,
# fetches, attempts `git rebase`, and dispatches the project's
# execute-stage agent (`cfg.execute.agent`, isolated to the worktree)
# to resolve any conflicts. Fail-soft: any failure aborts the rebase,
# cleans agent-created untracked files, and proceeds with the stale
# base. Originally added to close the REVIEW_STALE drift loop where
# long-running tasks accumulated phantom-deletion escalations after
# main moved forward.
#
# - `enabled` (default true): set false to opt out per-project.
# - `conflict_resolution_timeout_sec` (default 2700, min 60): per-spawn
#   timeout for the conflict-resolution agent. The `MAX_CONFLICT_RESOLUTIONS = 5`
#   cap on total agent dispatches per rebase is a Ruby constant; not
#   configurable.
rebase:
  enabled: true
  conflict_resolution_timeout_sec: 2700
