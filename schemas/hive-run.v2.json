{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:run:v2",
  "title": "hive run output (v2)",
  "description": "Stable contract emitted by `hive run --json`. Either a SuccessPayload (the run's marker + next_action) or an ErrorPayload (a Hive::Error envelope). Discriminate by `ok`. CONSUMER AUDIT (U6): `stage` (bare name) and `stage_index` were relaxed from the closed coding enum/range to a pattern/open-minimum so runtime-registered (generic) workflow stages validate — `hive run` on a generic task emits descriptor stages such as `gather`. The producer only emits stages that pass `validate_workflow_stage!`; the real valid set is the runtime union `Hive::Workflows.all_stage_names`, so downstream readers must close-default on an unknown stage. Backward-compatible widening, no version bump.",
  "oneOf": [
    {
      "$ref": "#/$defs/SuccessPayload"
    },
    {
      "$ref": "#/$defs/ErrorPayload"
    }
  ],
  "$defs": {
    "SuccessPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "ok",
        "slug",
        "stage",
        "stage_index",
        "folder",
        "state_file",
        "marker",
        "attrs",
        "commit_action",
        "next_action",
        "rebase"
      ],
      "properties": {
        "schema": {
          "const": "hive-run"
        },
        "schema_version": {
          "const": 2
        },
        "ok": {
          "const": true
        },
        "slug": {
          "type": "string"
        },
        "stage": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Bare stage name. Pattern relaxed from the closed coding enum so generic workflow stage names validate; the real valid set is the runtime union Hive::Workflows.all_stage_names."
        },
        "stage_index": {
          "type": "integer",
          "minimum": 1
        },
        "folder": {
          "type": "string"
        },
        "state_file": {
          "type": "string"
        },
        "marker": {
          "type": "string",
          "enum": [
            "none",
            "waiting",
            "complete",
            "agent_working",
            "execute_waiting",
            "execute_complete",
            "execute_stale",
            "review_working",
            "review_waiting",
            "review_ci_stale",
            "review_stale",
            "review_complete",
            "review_error",
            "manual_steering",
            "error"
          ]
        },
        "attrs": {
          "type": "object",
          "additionalProperties": true
        },
        "commit_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_action": {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": true,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "edit",
                "mv",
                "approve",
                "run",
                "recover_stale",
                "no_op"
              ]
            }
          }
        },
        "cleanup_instructions": {
          "description": "Human-readable cleanup guidance returned by the terminal `done` stage. Optional: only present when the run finalised a task and the stage emitted instructions (worktree removal, branch deletion, or an 'archived; nothing to clean up' notice). Backwards-compatible additive field; consumers may ignore it.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rebase": {
          "description": "Outcome of the auto-rebase pre-step (Hive::Rebase). Always present. `attempted` is true only when the rebase machinery ran past the disabled/no-worktree guards. `succeeded` is true on clean rebase (or no-op when commits_behind==0). `reason` is null on success and a string (snake_case) naming the skip-or-failure cause otherwise. `post_rebase_warnings` carries non-fatal warnings produced after a successful rebase (e.g., `worktree.yml` execute_base_head write failure); always an array, empty when none.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempted",
            "commits_behind",
            "succeeded",
            "agent_resolutions",
            "resolved_files",
            "reason",
            "post_rebase_warnings"
          ],
          "properties": {
            "attempted": {
              "type": "boolean"
            },
            "commits_behind": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "succeeded": {
              "type": "boolean"
            },
            "agent_resolutions": {
              "type": "integer",
              "minimum": 0
            },
            "resolved_files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason": {
              "description": "Snake-case enum naming the skip-or-failure cause. null on success. The set is closed; producer adding a new reason MUST update this enum.",
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "disabled",
                "cli_override",
                "manual_steering",
                "no_worktree",
                "pre_existing_rebase",
                "dirty_worktree",
                "detached_head",
                "no_default_branch",
                "fetch_failed",
                "no_conflict_agent_configured",
                "agent_failed",
                "markers_remaining",
                "agent_called_continue_itself",
                "max_attempts_exceeded",
                "rebase_failed",
                "rebase_continue_failed",
                "unexpected_io_error"
              ]
            },
            "post_rebase_warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "ok",
        "error_class",
        "error_kind",
        "exit_code",
        "message"
      ],
      "description": "Emitted by the top-level rescue in Hive::Commands::Run when an error is raised before report_json wrote a SuccessPayload. Per-error structured fields (`candidates`, `id`, `path`, `holder`, `lock_path`) appear only on the matching error_kind.",
      "properties": {
        "schema": {
          "const": "hive-run"
        },
        "schema_version": {
          "const": 2
        },
        "ok": {
          "const": false
        },
        "error_class": {
          "type": "string"
        },
        "error_kind": {
          "type": "string",
          "enum": [
            "concurrent_run",
            "task_in_error",
            "wrong_stage",
            "stage",
            "config",
            "agent",
            "git",
            "worktree",
            "ambiguous_slug",
            "invalid_task_path",
            "dependency_wait",
            "admission_error",
            "internal",
            "error"
          ]
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "message": {
          "type": "string"
        },
        "condition_gate": {
          "type": "object",
          "additionalProperties": true
        },
        "next_action": {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind"]
        },
        "slug": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage_filter": {
          "type": [
            "string",
            "null"
          ],
          "description": "User-supplied `--stage` filter value when present, else null. Distinct from the resolved `current_stage`/`target_stage`."
        },
        "current_stage": {
          "type": "string",
          "description": "Present on WrongStage and FinalStageReached: the stage the task is actually at."
        },
        "target_stage": {
          "type": "string",
          "description": "Present on WrongStage when raised by a verb that knows its target stage (approve/develop/review/etc.): the stage the verb expected."
        },
        "candidates": {
          "type": "array",
          "description": "Present on AmbiguousSlug. Each candidate identifies a project + stage + folder.",
          "items": {
            "type": "object",
            "required": [
              "project",
              "stage",
              "folder"
            ],
            "properties": {
              "project": {
                "type": "string"
              },
              "stage": {
                "type": "string"
              },
              "folder": {
                "type": "string"
              }
            }
          }
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "holder": {
          "type": "object",
          "description": "Present on ConcurrentRunError when raised over a live task lock. Carries the existing lock holder's metadata so agents can decide whether to wait, kill, or escalate. Properties are best-effort and additionalProperties is open to allow forward-compatible additions.",
          "additionalProperties": true,
          "properties": {
            "pid": {
              "type": "integer"
            },
            "slug": {
              "type": "string"
            },
            "stage": {
              "type": "string"
            },
            "started_at": {
              "type": "string"
            },
            "process_start_time": {
              "type": "string"
            }
          }
        },
        "lock_path": {
          "type": "string",
          "description": "Filesystem path of the lock file that triggered ConcurrentRunError."
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "dependency_wait",
            "dependency_metadata_unreadable",
            "dependency_metadata_invalid",
            "dependency_reference_invalid",
            "dependency_task_missing",
            "dependency_self_reference",
            "dependency_cycle",
            "dependency_gate_unknown",
            "dependency_gate_unreachable",
            "dependency_project_unknown",
            "dependency_repository_identity_missing",
            "dependency_repository_mismatch",
            "plan_dependency_invalid",
            "plan_dependency_missing",
            "plan_dependency_mismatch",
            "dependency_validation_failed"
          ]
        },
        "offending_ref": {
          "type": "string"
        },
        "safe_correction": {
          "type": "string"
        }
      }
    }
  }
}
