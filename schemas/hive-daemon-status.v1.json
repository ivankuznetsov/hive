{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-daemon-status.v1.json",
  "title": "hive daemon status output (v1)",
  "description": "Stable contract emitted by `hive daemon status --json`. Reports whether the dispatcher daemon is running, its PID, and uptime. Exit code is 0 when running, 1 when not.",
  "oneOf": [
    { "$ref": "#/$defs/SuccessPayload" }
  ],
  "$defs": {
    "SuccessPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "ok",
        "runtime",
        "running",
        "pid",
        "uptime_sec",
        "pid_file",
        "log_file",
        "service_installed",
        "service_enabled",
        "unit_path",
        "installed_binary",
        "expected_binary",
        "installed_binary_version",
        "cli_version",
        "binary_drift",
        "runtime_installation",
        "lifecycle",
        "quiescence_capability",
        "current_version",
        "update_nudge"
      ],
      "properties": {
        "schema": { "const": "hive-daemon-status" },
        "schema_version": { "const": 1 },
        "ok": { "const": true },
        "runtime": { "$ref": "#/$defs/RuntimeIdentity" },
        "running": {
          "type": "boolean",
          "description": "Whether a live, ownership-verified daemon process holds the PID file."
        },
        "pid": {
          "type": ["integer", "null"],
          "description": "PID of the running daemon, or null when running=false."
        },
        "uptime_sec": {
          "type": ["integer", "null"],
          "description": "Seconds since the PID file was written (mtime), or null when running=false."
        },
        "pid_file": {
          "type": "string",
          "description": "Absolute path of the PID file the daemon writes to."
        },
        "log_file": {
          "type": "string",
          "description": "Absolute path of the daemon's JSON-line log file."
        },
        "service_installed": {
          "type": ["boolean", "null"],
          "description": "Whether the per-user autostart unit file exists on disk (non-mutating probe). Always present; null only if the probe itself could not run."
        },
        "service_enabled": {
          "type": ["boolean", "null"],
          "description": "Whether the service manager reports the autostart unit as enabled/loaded (non-mutating probe). Always present; null only if the probe itself could not run."
        },
        "unit_path": {
          "type": ["string", "null"],
          "description": "Absolute path of the autostart unit file; null on unsupported platforms or if the probe could not run."
        },
        "installed_binary": {
          "type": ["string", "null"],
          "description": "Path to the hive binary the installed autostart unit invokes; null when no unit is installed or the probe could not run."
        },
        "expected_binary": {
          "type": ["string", "null"],
          "description": "Path to the hive binary an install/repair would write into the unit (the resolved current binary); null if the probe could not run."
        },
        "installed_binary_version": {
          "type": ["string", "null"],
          "description": "Version string reported by `installed_binary --version`; null when unreadable, the probe timed out, or no unit is installed."
        },
        "cli_version": {
          "type": "string",
          "description": "The version of the hive binary that produced this envelope (same as current_version)."
        },
        "binary_drift": {
          "type": "string",
          "enum": ["none", "path", "version", "unparseable", "unreadable", "not_applicable"],
          "description": "Whether the installed unit's binary diverges from the current one: none (matches), path (different binary path), version (same path, older version), unparseable (unit present but its binary could not be read), not_applicable (no unit installed / probe could not run)."
        },
        "runtime_installation": { "$ref": "#/$defs/RuntimeInstallation" },
        "lifecycle": { "$ref": "#/$defs/Lifecycle" },
        "quiescence_capability": { "$ref": "#/$defs/Capability" },
        "current_version": {
          "type": "string",
          "description": "The running hive version, so a caller can compare against update_nudge.latest itself."
        },
        "update_nudge": {
          "type": ["object", "null"],
          "description": "Available-update nudge written by the daemon, or null when up to date / unknown.",
          "additionalProperties": false,
          "required": ["latest", "channel", "command"],
          "properties": {
            "latest": { "type": "string", "description": "Latest published release version." },
            "channel": { "type": "string", "description": "Detected install channel (brew/aur/bash)." },
            "command": { "type": "string", "description": "Exact command to update on this channel." }
          }
        }
      }
    },
    "RuntimeInstallation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "installation_id", "database_status", "next_action"],
      "properties": {
        "phase": { "enum": ["absent", "active"] },
        "installation_id": { "type": ["string", "null"] },
        "database_status": { "type": "string" },
        "next_action": { "type": ["string", "null"] }
      }
    },
    "Lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase", "durable_phase", "generation", "revision", "mutation_sequence",
        "admission_open", "interrupted_attempt_ids", "proof", "liveness"
      ],
      "properties": {
        "phase": { "enum": ["running", "quiescing", "paused", "resuming", "unknown"] },
        "durable_phase": { "enum": ["running", "quiescing", "paused", "resuming", "unknown"] },
        "generation": { "type": ["integer", "null"], "minimum": 0 },
        "revision": { "type": ["integer", "null"], "minimum": 0 },
        "mutation_sequence": { "type": ["integer", "null"], "minimum": 0 },
        "admission_open": { "type": ["boolean", "null"] },
        "interrupted_attempt_ids": {
          "type": "array", "items": { "type": "string" }, "uniqueItems": true
        },
        "proof": { "$ref": "#/$defs/ProofVerdict" },
        "liveness": { "$ref": "#/$defs/LivenessVerdict" }
      }
    },
    "ProofVerdict": {
      "type": "object", "additionalProperties": false,
      "required": ["valid", "reason"],
      "properties": {
        "valid": { "type": ["boolean", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "LivenessVerdict": {
      "type": "object", "additionalProperties": false,
      "required": ["clear", "reason", "remaining"],
      "properties": {
        "clear": { "type": ["boolean", "null"] },
        "reason": { "type": ["string", "null"] },
        "remaining": {
          "type": "array", "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "Capability": {
      "type": "object", "additionalProperties": false,
      "required": ["eligible", "reason", "ownership_mode", "disqualifying_inventory"],
      "properties": {
        "eligible": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "ownership_mode": { "type": "string" },
        "disqualifying_inventory": {
          "type": "array", "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "RuntimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "release_version", "display_version", "build_sha", "deployment_id"],
      "properties": {
        "channel": { "enum": ["release", "dogfood", "unknown"] },
        "release_version": { "type": "string", "minLength": 1 },
        "display_version": { "type": "string", "minLength": 1 },
        "build_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "deployment_id": { "type": ["string", "null"], "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "channel": { "const": "dogfood" } } },
          "then": {
            "properties": {
              "build_sha": { "type": "string" },
              "deployment_id": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "channel": { "enum": ["release", "unknown"] } } },
          "then": {
            "properties": {
              "build_sha": { "type": "null" },
              "deployment_id": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
