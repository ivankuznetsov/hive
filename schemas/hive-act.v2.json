{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:act:v2",
  "title": "hive act output (v2)",
  "oneOf": [
    {
      "$ref": "#/$defs/SuccessPayload"
    },
    {
      "$ref": "#/$defs/ErrorPayload"
    }
  ],
  "$defs": {
    "SuccessPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "ok",
        "action_id",
        "target",
        "observation_token",
        "result"
      ],
      "properties": {
        "schema": {
          "const": "hive-act"
        },
        "schema_version": {
          "const": 2
        },
        "ok": {
          "const": true
        },
        "action_id": {
          "type": "string",
          "enum": [
            "workflow.advance",
            "workflow.retry"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^.+:.+$"
        },
        "observation_token": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_state",
            "stage",
            "marker"
          ],
          "properties": {
            "task_state": {
              "type": "string"
            },
            "stage": {
              "type": [
                "string",
                "null"
              ]
            },
            "marker": {
              "type": [
                "string",
                "null"
              ]
            },
            "recovery": {
              "$ref": "#/$defs/Recovery"
            }
          }
        },
        "command_receipt": {
          "$ref": "#/$defs/CommandReceipt"
        }
      }
    },
    "Recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "request_id",
        "attempt_id",
        "phase",
        "failure_origin",
        "next_eligible_at",
        "owner",
        "reason",
        "remediation",
        "retry_count",
        "provider_hint",
        "terminal_outcome",
        "terminal_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "cooldown",
            "running",
            "blocked",
            "terminal",
            "unavailable"
          ]
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "admitted",
            "cleared",
            "dispatched",
            "terminal",
            null
          ]
        },
        "failure_origin": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_eligible_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "owner": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "agent",
            "operator",
            "provider",
            "scheduler",
            "hive",
            "none",
            "unknown",
            null
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "remediation": {
          "type": [
            "string",
            "null"
          ]
        },
        "retry_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "failure_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "identical_failure_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "escalation_tier": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "silent_retry",
            "degraded",
            "parked",
            null
          ]
        },
        "terminal_outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminal_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "provider_hint": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "retry_after",
                "display_only"
              ],
              "properties": {
                "retry_after": {
                  "type": "string"
                },
                "display_only": {
                  "const": true
                }
              }
            }
          ]
        }
      }
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "ok",
        "error_class",
        "error_kind",
        "exit_code",
        "message",
        "action_id",
        "target"
      ],
      "properties": {
        "schema": {
          "const": "hive-act"
        },
        "schema_version": {
          "const": 2
        },
        "ok": {
          "const": false
        },
        "error_class": {
          "type": "string"
        },
        "error_kind": {
          "type": "string",
          "enum": [
            "usage",
            "stale_observation",
            "ambiguous_target",
            "concurrent_run",
            "dependency_wait",
            "admission_error",
            "config",
            "internal",
            "error",
            "command_conflict",
            "command_in_progress",
            "command_unresolved_pending",
            "command_pin_horizon_elapsed",
            "command_capacity_exhausted",
            "command_nonterminal_limit",
            "command_concurrency_limit",
            "command_prune_busy",
            "command_prune_storage_unavailable",
            "command_prune_preview_unavailable",
            "command_orphaned_pin",
            "command_original_result_unavailable",
            "command_intake_disabled"
          ]
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "message": {
          "type": "string"
        },
        "action_id": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "current_stage": {
          "type": "string"
        },
        "target_stage": {
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        },
        "offending_ref": {
          "type": "string"
        },
        "safe_correction": {
          "type": "string"
        },
        "holder": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "lock_path": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "enum": [
            "command_conflict",
            "command_in_progress",
            "command_unresolved_pending",
            "command_pin_horizon_elapsed",
            "command_capacity_exhausted",
            "command_nonterminal_limit",
            "command_concurrency_limit",
            "command_prune_busy",
            "command_prune_storage_unavailable",
            "command_prune_preview_unavailable",
            "command_orphaned_pin",
            "command_original_result_unavailable",
            "command_intake_disabled"
          ]
        },
        "state": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "namespace",
            "installation"
          ]
        },
        "command_receipt": {
          "$ref": "#/$defs/CommandReceipt"
        }
      }
    },
    "CommandReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "generation",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "prepared",
            "executing",
            "unresolved",
            "succeeded",
            "failed",
            "settled",
            "aborted"
          ]
        }
      }
    }
  }
}
