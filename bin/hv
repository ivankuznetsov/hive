#!/usr/bin/env bash
set -euo pipefail

# `hv` is the fallback launcher when Apache Hive shadows our binary
# earlier on PATH. We refuse to `exec hive` via `command -v`, because
# on the exact collision this script exists to solve, `command -v
# hive` resolves to Apache Hive. Instead, probe known install
# locations in priority order.

self="$(readlink -f "$0" 2>/dev/null || echo "$0")"

# A misbehaving candidate must not hang `hv`: one that blocks reading
# stdin, or a slow/JVM-based Apache Hive that takes seconds to boot,
# would otherwise stall the probe indefinitely with no fallback. We
# always close the probe's stdin (</dev/null) and, when `timeout` is
# available, cap each probe so a slow candidate falls through to the
# next instead of hanging. `timeout` is absent on stock macOS, so the
# cap is best-effort — stdin redirection covers the common blocking case
# even without it.
timeout_bin="$(command -v timeout 2>/dev/null || true)"

probe_version() {
  if [[ -n "$timeout_bin" ]]; then
    "$timeout_bin" 5 "$1" --version </dev/null 2>/dev/null
  else
    "$1" --version </dev/null 2>/dev/null
  fi
}

candidates=(
  "${HIVE_BIN_OVERRIDE:-}"
  "${XDG_BIN_HOME:-${HOME}/.local/bin}/hive"
  "${HOMEBREW_PREFIX:-/opt/homebrew}/bin/hive"
  "/usr/local/bin/hive"
)

for candidate in "${candidates[@]}"; do
  [[ -n "$candidate" ]] || continue
  [[ -x "$candidate" ]] || continue

  resolved="$(readlink -f "$candidate" 2>/dev/null || echo "$candidate")"
  # Guard against `hv -> hv` chains: never exec into our own script.
  [[ "$resolved" != "$self" ]] || continue

  if ! version="$(probe_version "$candidate")" || [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    continue
  fi

  exec "$candidate" "$@"
done

echo "hv: hive binary not found in ${XDG_BIN_HOME:-${HOME}/.local/bin}, ${HOMEBREW_PREFIX:-/opt/homebrew}/bin, or /usr/local/bin" >&2
echo "hv: set HIVE_BIN_OVERRIDE=<path> to point at a custom install location" >&2
echo "hv: install with 'brew install ivankuznetsov/hive/hive', 'yay -S hive-bin', or the pinned install.sh from install.md" >&2
exit 127
