{
  "name": "hivedev-demo",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/waitlist"],
    "not_found_handling": "404-page"
  },
  // Local-only placeholder. Before an explicitly authorized deployment,
  // configure separate real database bindings and origin for each environment.
  "d1_databases": [{
    "binding": "DB",
    "database_name": "hivedev-demo-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "SITE_ORIGIN": "http://127.0.0.1:8791",
    "SIGNUP_COPY_REVISION": "2026-09-13"
  },
  "env": {
    "production": {
      "name": "hivedev-demo-production",
      "account_id": "45e29ccf07419c62fd1dea71220f40dd",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "traces": { "enabled": true }
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "hivedev-demo-production",
        "database_id": "490d30f3-338e-422a-8d77-8270b712132f",
        "migrations_dir": "migrations"
      }],
      "routes": [{ "pattern": "hivedev.ai", "custom_domain": true }],
      "vars": {
        "SITE_ORIGIN": "https://hivedev.ai",
        "SIGNUP_COPY_REVISION": "2026-09-16"
      }
    }
  }
}
