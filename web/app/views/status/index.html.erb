<% content_for(:title, "hivebox — grid") %>
<%# The status channel delivers BOTH a targeted #projects replace and a page
    refresh signal (task pages need the latter). Without these metas the
    refresh falls back to a full-body replace — which resets window scroll to
    the top mid-read. Morph + preserve keeps the grid updating in place. %>
<% content_for(:head) do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>
<%= turbo_stream_from StatusBroadcaster::CHANNEL %>

<%# TUI left-pane parity: the rail filters the grid client-side (buttons,
    not links — a navigation would discard the permanent composer's typed
    text). The controller wraps rail AND grid; it re-applies the filter
    after every broadcast replace / morph via a MutationObserver. %>
<div class="status-layout" data-controller="project-filter">
  <aside class="project-nav" aria-label="Project filter">
    <button type="button" class="project-nav-item" data-project-filter-target="button"
            data-action="project-filter#choose" data-project-filter-name-param="">All projects</button>
    <% registered_project_names.each do |name| %>
      <button type="button" class="project-nav-item" data-project-filter-target="button"
              data-action="project-filter#choose" data-project-filter-name-param="<%= name %>"><%= name %></button>
    <% end %>
    <%# A link, not a filter button — adding a project IS a navigation. %>
    <%= link_to "+ Add project", repos_path, class: "project-nav-item project-nav-add" %>
  </aside>
  <div class="status-main">

<%= render "status/view_switch" %>

<%# data-turbo-permanent: a morph must never touch the composer — it holds
    typed-but-unsent idea text and staged image attachments (Stimulus state
    the server can't re-render). %>
<%= render "status/composer" %>

<%= render "status/daemon", daemon_status: @daemon_status %>

<%= render "status/projects", projects: @projects %>
  </div>
</div>
