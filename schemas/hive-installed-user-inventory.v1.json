{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/schemas/hive-installed-user-inventory.v1.json",
  "title": "Hive installed-user inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "discovery_closed",
    "profiles"
  ],
  "properties": {
    "schema": { "const": "hive-installed-user-inventory" },
    "schema_version": { "const": 1 },
    "discovery_closed": { "type": "boolean" },
    "profiles": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["username", "uid", "home", "environment"],
        "properties": {
          "username": { "type": "string", "minLength": 1 },
          "uid": { "type": "integer", "minimum": 0 },
          "home": { "type": "string", "pattern": "^/" },
          "environment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "HIVE_HOME": { "type": "string", "pattern": "^/" },
              "XDG_CACHE_HOME": { "type": "string", "pattern": "^/" },
              "XDG_CONFIG_HOME": { "type": "string", "pattern": "^/" },
              "XDG_DATA_HOME": { "type": "string", "pattern": "^/" },
              "XDG_STATE_HOME": { "type": "string", "pattern": "^/" }
            }
          }
        }
      }
    }
  }
}
