{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/schemas/hive-installed-users-job-schema-migration.v1.json",
  "title": "Hive install-wide JobStore schema migration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "target_schema_version",
    "status",
    "discovery_closed",
    "attempted_users",
    "failed_users",
    "retryable_users",
    "attempted_profiles",
    "failed_profiles",
    "retryable_profiles",
    "completed_at",
    "candidate",
    "inventory",
    "profiles",
    "discovery_issues"
  ],
  "properties": {
    "schema": { "const": "hive-installed-users-job-schema-migration" },
    "schema_version": { "const": 1 },
    "target_schema_version": { "const": 3 },
    "status": { "enum": ["complete", "partial", "failed"] },
    "discovery_closed": { "type": "boolean" },
    "attempted_users": { "type": "integer", "minimum": 0 },
    "failed_users": { "type": "integer", "minimum": 0 },
    "retryable_users": { "type": "integer", "minimum": 0 },
    "attempted_profiles": { "type": "integer", "minimum": 0 },
    "failed_profiles": { "type": "integer", "minimum": 0 },
    "retryable_profiles": { "type": "integer", "minimum": 0 },
    "completed_at": { "type": "string", "format": "date-time" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "mode", "uid", "gid", "sha256", "version"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "size": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "mode": { "type": "integer", "minimum": 0 },
        "uid": { "type": "integer", "minimum": 0 },
        "gid": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "discovery_closed"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "discovery_closed": { "type": "boolean" }
      }
    },
    "profiles": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_digest",
          "status",
          "retryable",
          "registry_digest",
          "receipt_sha256",
          "receipt_bytes",
          "project_count",
          "failed_project_count",
          "retryable_project_count",
          "daemon_restart_pending",
          "error"
        ],
        "properties": {
          "profile_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": { "enum": ["completed", "failed"] },
          "retryable": { "type": "boolean" },
          "registry_digest": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "receipt_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "receipt_bytes": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 2097152
          },
          "project_count": { "type": "integer", "minimum": 0 },
          "failed_project_count": { "type": "integer", "minimum": 0 },
          "retryable_project_count": {
            "type": "integer",
            "minimum": 0
          },
          "daemon_restart_pending": { "type": "boolean" },
          "error": {
            "type": ["string", "null"],
            "maxLength": 256
          }
        }
      }
    },
    "discovery_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "username", "uid", "detail"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "username": { "type": ["string", "null"] },
          "uid": { "type": ["integer", "null"], "minimum": 0 },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
