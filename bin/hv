#!/usr/bin/env bash
set -euo pipefail

# `hv` is the fallback launcher when Apache Hive shadows our binary
# earlier on PATH. We refuse to `exec hive` via `command -v`, because
# on the exact collision this script exists to solve, `command -v
# hive` resolves to Apache Hive. Instead, probe known install
# locations in priority order.

canonical_path() {
  realpath "$1" 2>/dev/null && return
  ruby -e 'puts File.realpath(ARGV.fetch(0))' "$1" 2>/dev/null && return
  python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$1" 2>/dev/null && return
  readlink -f "$1" 2>/dev/null && return
  # All canonicalizers absent (rare): fall back to the raw path, but warn
  # — an unresolved path can defeat the hv->hv self-recursion guard, and
  # under `set -euo pipefail` a silent runaway re-exec would otherwise
  # leave no diagnostic.
  echo "hv: warning: could not canonicalize '$1'; using it unresolved (self-recursion guard may be unreliable)" >&2
  echo "$1"
}

self="$(canonical_path "$0")"
xdg_bin_home="${XDG_BIN_HOME:-${HOME:+$HOME/.local/bin}}"

# A misbehaving candidate must not hang `hv`: one that blocks reading
# stdin, or a slow/JVM-based Apache Hive that takes seconds to boot,
# would otherwise stall the probe indefinitely with no fallback. We
# always close the probe's stdin (</dev/null) and cap each probe so a
# slow candidate falls through to the next instead of hanging. Probe stdout is
# captured through a temp file, not through this function's stdout, so forked
# helpers cannot keep the caller's command substitution pipe open.

probe_version() {
  local output_file pid status watchdog
  output_file="$(mktemp "${TMPDIR:-/tmp}/hv-version.XXXXXX")" || return

  # Launch the probe in its own process group so the watchdog can signal the
  # whole probe tree, not just the direct child. A candidate that forks a child
  # without `exec` — e.g. a wrapper that boots a JVM/helper and `wait`s on it —
  # would otherwise survive: TERMing only the wrapper PID leaves the JVM
  # orphaned, so repeated probes accrete stray processes. Monitor mode
  # (`set -m`) places the next background job in a fresh process group whose
  # PGID equals its PID, so `kill -TERM -"$pid"` reaches every descendant. We
  # restore `set +m` immediately to suppress job-control chatter; the
  # already-forked job keeps its process group regardless.
  set -m
  "$1" --version </dev/null >"$output_file" 2>/dev/null &
  pid=$!
  set +m
  (
    # As soon as the probe finishes, the cleanup below TERMs this watchdog so
    # a fast candidate is never made to wait out the full timeout. Run each
    # delay as a background job we `wait` on, with a TERM trap that kills the
    # sleeping grandchild and exits. The `wait` builtin is interruptible by a
    # trapped signal, so teardown is immediate. A foreground `sleep` would
    # not be: on bash 3.2 (stock macOS) the watchdog cannot be torn down
    # until the sleep elapses, leaving the cleanup `wait` below to block for
    # the entire five seconds on every fast probe.
    nap=""
    trap 'kill "$nap" 2>/dev/null || true; exit 0' TERM
    sleep 5 &
    nap=$!
    wait "$nap" 2>/dev/null
    # Signal the probe's whole process group (negative PID). Fall back to the
    # bare PID if the group is gone; `exit 0` only when both miss, i.e. the
    # probe already finished and there is nothing left to escalate against.
    kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || exit 0
    sleep 1 &
    nap=$!
    wait "$nap" 2>/dev/null
    kill -KILL "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
  ) &
  watchdog=$!

  if wait "$pid"; then
    status=0
  else
    status=$?
  fi

  kill "$watchdog" 2>/dev/null || true
  wait "$watchdog" 2>/dev/null || true
  # The watchdog's KILL escalation only fires if it survives to run it. A
  # wrapper that exits on TERM releases the `wait "$pid"` above, so we tear the
  # watchdog down before it reaches that escalation — leaving a TERM-ignoring or
  # TERM-delaying helper in the probe's process group orphaned. Sweep the group
  # ourselves. On the fast path the probe (and its group) is already gone, so
  # this KILL matches nothing and is a no-op.
  kill -KILL "-$pid" 2>/dev/null || true
  if [[ "$status" -eq 0 ]]; then
    cat "$output_file" || status=$?
  fi
  rm -f "$output_file"
  return "$status"
}

candidates=(
  "${HIVE_BIN_OVERRIDE:-}"
  "${xdg_bin_home:+$xdg_bin_home/hive}"
  "${HOMEBREW_PREFIX:-/opt/homebrew}/bin/hive"
  "/usr/local/bin/hive"
)

for candidate in "${candidates[@]}"; do
  [[ -n "$candidate" ]] || continue
  [[ -x "$candidate" ]] || continue

  resolved="$(canonical_path "$candidate")"
  # Guard against `hv -> hv` chains: never exec into our own script.
  [[ "$resolved" != "$self" ]] || continue

  if ! version="$(probe_version "$candidate")" || [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    continue
  fi

  exec "$candidate" "$@"
done

echo "hv: hive binary not found in ${xdg_bin_home:-<unset XDG_BIN_HOME/HOME>}, ${HOMEBREW_PREFIX:-/opt/homebrew}/bin, or /usr/local/bin" >&2
echo "hv: set HIVE_BIN_OVERRIDE=<path> to point at a custom install location" >&2
echo "hv: install with 'brew install ivankuznetsov/hive/hive', 'yay -S hive-bin', or the pinned install.sh from install.md" >&2
exit 127
