{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hive-patrol-fix-dogfood-report.v1.json",
  "type": "object",
  "required": ["schema", "schema_version", "run_id", "generated_at", "project", "source", "task", "stages", "validation", "review", "publication", "replay"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "hive-patrol-fix-dogfood-report"},
    "schema_version": {"const": 1},
    "run_id": {"$ref": "#/$defs/text256"},
    "generated_at": {"$ref": "#/$defs/utc"},
    "project": {"$ref": "#/$defs/text256"},
    "source": {
      "type": "object",
      "required": ["engine", "identity", "occurrence_id", "source_digest"],
      "additionalProperties": false,
      "properties": {
        "engine": {"enum": ["ordinary_patrol", "architecture_patrol"]},
        "identity": {"$ref": "#/$defs/text512"},
        "occurrence_id": {"$ref": "#/$defs/text512"},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "task": {
      "type": "object",
      "required": ["slug", "generation", "evidence_digest"],
      "additionalProperties": false,
      "properties": {
        "slug": {"$ref": "#/$defs/text256"},
        "generation": {"type": "integer", "minimum": 1},
        "evidence_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "stages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"$ref": "#/$defs/inboxStage"},
        {"$ref": "#/$defs/fixStage"},
        {"$ref": "#/$defs/validateStage"},
        {"$ref": "#/$defs/reviewStage"},
        {"$ref": "#/$defs/publishStage"},
        {"$ref": "#/$defs/doneStage"}
      ],
      "items": false
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["command", "exit_code", "evidence_digest"],
        "additionalProperties": false,
        "properties": {
          "command": {"type": "string", "minLength": 1, "maxLength": 4096},
          "exit_code": {"type": "integer"},
          "evidence_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["decision", "evidence_digest", "model_receipt"],
      "additionalProperties": false,
      "properties": {
        "decision": {"enum": ["approve", "rework", "escalate", "reject"]},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "model_receipt": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "publication": {
      "type": "object",
      "required": ["phase", "pr_number", "url", "base_revision", "head_revision", "receipt_digest"],
      "additionalProperties": false,
      "properties": {
        "phase": {"const": "pr_created"},
        "pr_number": {"type": "integer", "minimum": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
        "base_revision": {"$ref": "#/$defs/revision"},
        "head_revision": {"$ref": "#/$defs/revision"},
        "receipt_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "replay": {
      "type": "object",
      "required": ["source_occurrence_id", "task_slug", "pr_number", "duplicate_task_count", "duplicate_pr_count"],
      "additionalProperties": false,
      "properties": {
        "source_occurrence_id": {"$ref": "#/$defs/text512"},
        "task_slug": {"$ref": "#/$defs/text256"},
        "pr_number": {"type": "integer", "minimum": 1},
        "duplicate_task_count": {"const": 0},
        "duplicate_pr_count": {"const": 0}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "text256": {"type": "string", "minLength": 1, "maxLength": 256},
    "text512": {"type": "string", "minLength": 1, "maxLength": 512},
    "stage": {
      "type": "object",
      "required": ["stage", "status", "journal_digest", "observed_at"],
      "additionalProperties": false,
      "properties": {
        "stage": {"type": "string"},
        "status": {"type": "string", "minLength": 1, "maxLength": 64},
        "journal_digest": {"$ref": "#/$defs/digest"},
        "observed_at": {"$ref": "#/$defs/utc"}
      }
    },
    "inboxStage": {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage": {"const": "inbox"}}}]},
    "fixStage": {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage": {"const": "fix"}}}]},
    "validateStage": {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage": {"const": "validate"}}}]},
    "reviewStage": {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage": {"const": "review"}}}]},
    "publishStage": {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage": {"const": "publish"}}}]},
    "doneStage": {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage": {"const": "done"}}}]}
  }
}
