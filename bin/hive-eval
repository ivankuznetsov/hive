#!/usr/bin/env ruby

require "fileutils"
require "English"
require "json"
require "optparse"
require "tempfile"

root = File.expand_path("..", __dir__)
SAFE_SCENARIO_BASENAME = /\A[A-Za-z0-9_-]+\z/
default_report = File.join(root, "tmp", "hive-eval-report.json")
options = {
  report: default_report,
  scenario: nil,
  no_judge: false
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/hive-eval [--scenario NAME] [--report PATH] [--no-judge]"
  opts.on("--scenario NAME", "Run one scenario by basename, e.g. s1_status") do |value|
    options[:scenario] = value
  end
  opts.on("--report PATH", "Write JSON report to PATH") do |value|
    options[:report] = value
  end
  opts.on("--no-judge", "Skip Codex judge assertions") do
    options[:no_judge] = true
  end
  # Define help explicitly so it survives require_exact below; the officious -h
  # is otherwise rejected once exact matching is on. Printing to stdout and
  # exiting 0 inside parse! keeps --help/-h a read-only path.
  opts.on("-h", "--help", "Show this message") do
    puts opts
    exit
  end
end
# Reject abbreviated long options (e.g. --rep for --report).
parser.require_exact = true

def expanded_report_path(root, value)
  return nil if value.to_s.empty?

  File.expand_path(value, root)
end

def option_value_missing?(value)
  value.to_s.empty? || value.start_with?("-")
end

def hive_eval_report?(path)
  document = JSON.parse(File.read(path))
  document.is_a?(Hash) && document["schema"] == "hive-eval-report"
rescue JSON::ParserError, SystemCallError
  false
end

begin
  remaining = parser.parse!
  raise OptionParser::MissingArgument, "--report" if option_value_missing?(options[:report])
  raise OptionParser::MissingArgument, "--scenario" if options[:scenario] && option_value_missing?(options[:scenario])
rescue OptionParser::ParseError, ArgumentError => e
  raise if e.is_a?(ArgumentError) && !e.message.include?("invalid byte sequence")

  warn "hive-eval: #{e.message}"
  warn parser
  exit 64
end

report_path = expanded_report_path(root, options.fetch(:report))

unless remaining.empty?
  unexpected = remaining.join(" ")
  label = remaining.length == 1 ? "argument" : "arguments"
  warn "hive-eval: unexpected #{label}: #{unexpected}"
  warn parser
  exit 64
end

def scenario_path(scenario_root, value)
  return nil if value.nil?
  raise ArgumentError, "scenario basename must not contain path separators: #{value}" if value.match?(%r{[\\/]})

  basename = value.sub(/_test\z/, "")
  unless basename.match?(SAFE_SCENARIO_BASENAME)
    raise ArgumentError, "scenario must be a safe basename under test/eval/scenarios"
  end

  File.join(scenario_root, "#{basename}_test.rb")
end

scenario_root = File.expand_path(
  ENV.fetch("HIVE_EVAL_SCENARIO_ROOT", File.join(root, "test", "eval", "scenarios")),
  root
)

env = {
  "HIVE_EVAL_SCENARIOS_ONLY" => "1",
  "HIVE_EVAL_NO_JUDGE" => (options[:no_judge] ? "1" : nil),
  "TEST" => nil
}

begin
  path = scenario_path(scenario_root, options[:scenario])
rescue ArgumentError => e
  warn "hive-eval: #{e.message}"
  exit 64
end

if path
  unless File.exist?(path)
    warn "hive-eval: scenario not found: #{path}"
    exit 64
  end
  env["TEST"] = path
end

FileUtils.mkdir_p(File.dirname(report_path))
exit_status = nil
Tempfile.create([ ".hive-eval-report-", ".json" ], File.dirname(report_path)) do |temp_report|
  temp_report_path = temp_report.path
  temp_report.close
  env["HIVE_EVAL_REPORT"] = temp_report_path

  ok = system(env, "bundle", "exec", "rake", "test:eval", chdir: root)
  exit_status = $CHILD_STATUS&.exitstatus || (ok ? 0 : 1)
  File.rename(temp_report_path, report_path) if hive_eval_report?(temp_report_path)
end
exit(exit_status)
