<div id="projects">
  <% if projects.empty? %>
    <div class="empty-state">
      <p>No projects yet.</p>
      <p class="hint"><%= link_to "Add a repository", repos_path %> to start the pipeline.</p>
    </div>
  <% else %>
    <% projects.each do |project| %>
      <section class="project-section">
        <div class="project-title">
          <h2><%= project["name"] %></h2>
          <span class="muted"><%= project.fetch("tasks", []).size %> active</span>
        </div>
        <% tasks = project.fetch("tasks", []) %>
        <% if tasks.empty? %>
          <div class="empty-state">
            <p>Nothing in flight.</p>
            <p class="hint">Drop an idea above to start a task.</p>
          </div>
        <% else %>
          <div class="task-list">
            <% tasks.each do |task| %>
              <article class="task-row">
                <div class="task-name">
                  <%= link_to task_title(task), task_path(project["name"], task["slug"]) %>
                  <span class="task-slug"><%= task["slug"] %></span>
                </div>
                <%= stage_badge(task["stage"]) %>
                <span class="task-meta">
                  <%= status_dot(task) %>
                  <%= task["action_label"].presence || task["marker"].presence || "idle" %>
                </span>
                <span class="task-meta faint"><%= relative_age(task["age_seconds"]) %></span>
              </article>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>
  <% end %>
</div>
