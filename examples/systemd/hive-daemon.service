# Sample systemd-user unit for `hive daemon` (Linux).
#
# BEFORE INSTALLING: edit ExecStart= to match where YOUR `hive` binary
# lives. `which hive` shows it. Common paths:
#
#   %h/.local/bin/hive                           ← README dev-clone symlink
#                                                  (ln -sf ~/Dev/hive/bin/hive ~/.local/bin/hive)
#   %h/Dev/hive/bin/hive                         ← direct from a clone, no symlink
#   /usr/local/bin/hive                          ← system gem install
#   %h/.local/share/mise/shims/hive              ← mise / rbenv / asdf / chruby shim
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp examples/systemd/hive-daemon.service ~/.config/systemd/user/
#   $EDITOR ~/.config/systemd/user/hive-daemon.service   # confirm ExecStart=
#   systemctl --user daemon-reload
#   systemctl --user enable --now hive-daemon
#
# Verify it actually started (catches a wrong ExecStart= path before the
# StartLimitBurst kicks in):
#   systemctl --user status hive-daemon
#   journalctl --user -u hive-daemon -n 50
#
# View logs:
#   journalctl --user -u hive-daemon -f      # systemd's stderr capture
#   hive daemon tail                         # the daemon's own JSON-line log
#
# Stop / restart:
#   systemctl --user stop hive-daemon
#   systemctl --user restart hive-daemon
#
# To survive logout (run when no user session is active):
#   sudo loginctl enable-linger $USER
#
# This unit runs in the foreground (no --detach). systemd is the
# supervisor; Restart=on-failure brings the daemon back if it crashes.
# StartLimit* below caps the respawn loop so a wrong ExecStart= path
# stops cleanly with `failed` instead of relaunching forever.

[Unit]
Description=Hive auto-advancing dispatcher (ADR-024)
# Do not order this unit after default.target: enabling it adds the inverse
# target dependency, and the two edges form an ordering cycle. WantedBy below
# is sufficient to start the daemon with the user default target.
# Hard cap on the auto-restart loop. If `hive daemon start` exits non-zero
# 3 times within 5 minutes, systemd marks the unit `failed` instead of
# respawning forever. This is the safety net for a misconfigured ExecStart=
# (binary not on PATH, typo, missing rbenv shim) — `systemctl --user status`
# will show `failed` rather than silently churning every 30 s.
StartLimitBurst=3
StartLimitIntervalSec=300

[Service]
Type=simple
# `hive daemon` shells out to `hive status --json` once per tick.
# systemd user services do NOT inherit your interactive shell's
# PATH, so:
#   1. HIVE_BIN — absolute path to the binary; the daemon reads
#      this directly (lib/hive/daemon/status_consumer.rb) instead
#      of resolving "hive" via PATH.
#   2. PATH — covers (a) any incidental shell-outs the daemon
#      performs (git, etc.) and (b) the gem's bin/hive wrapper
#      whose `#!/usr/bin/env ruby` shebang needs to find a Ruby
#      with the gem's dependencies. `hive daemon install` detects
#      mise/rbenv/asdf and prepends the matching shim directory
#      automatically; otherwise the minimal PATH below covers
#      system-Ruby installs.
# `hive init` and `hive daemon install` rewrite HIVE_BIN= and
# Environment=PATH= to match the resolved binary + Ruby manager
# detected on the host. If you copy this template verbatim, the
# default %h/.local/bin/hive is the option-A install location and
# system Ruby is assumed.
Environment=HIVE_BIN=%h/.local/bin/hive
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/hive daemon start
Restart=on-failure
RestartSec=30s
# Stop or restart only the supervised daemon process. Accepted stage attempts
# have durable lease owners in detached wrapper/worker processes; they must
# survive daemon replacement so the new daemon can adopt them without replay.
KillMode=process
TimeoutStopSec=900

[Install]
WantedBy=default.target
