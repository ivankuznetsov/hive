{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hive-patrol-fix-operational-projection.v1.json",
  "title": "Hive Patrol Fix Operational Projection (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "project", "generated_at", "completeness", "diagnostics", "discovery", "admission", "workflow", "delivery", "tokens"],
  "properties": {
    "schema": {"const": "hive-patrol-fix-operational-projection"},
    "schema_version": {"const": 1},
    "project": {"type": "string", "minLength": 1, "maxLength": 256},
    "generated_at": {"type": "string", "format": "date-time"},
    "completeness": {"enum": ["complete", "partial"]},
    "diagnostics": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/diagnostic"}},
    "discovery": {"$ref": "#/$defs/discovery"},
    "admission": {"$ref": "#/$defs/admission"},
    "workflow": {"$ref": "#/$defs/workflow"},
    "delivery": {"$ref": "#/$defs/delivery"},
    "tokens": {"$ref": "#/$defs/tokens"}
  },
  "$defs": {
    "nullableTime": {"type": ["string", "null"], "format": "date-time"},
    "nullableCount": {"type": ["integer", "null"], "minimum": 0},
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "code", "summary"],
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 128},
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "summary": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "discovery": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinary", "architecture", "post_merge", "coverage"],
      "properties": {
        "ordinary": {"$ref": "#/$defs/lane"},
        "architecture": {"$ref": "#/$defs/lane"},
        "post_merge": {
          "type": "object", "additionalProperties": false,
          "required": ["queued", "in_flight", "blocked", "batches"],
          "properties": {
            "queued": {"type": "integer", "minimum": 0},
            "in_flight": {"type": "integer", "minimum": 0},
            "blocked": {"type": "integer", "minimum": 0},
            "batches": {"type": "integer", "minimum": 0}
          }
        },
        "coverage": {
          "type": "object", "additionalProperties": false,
          "required": ["ordinary", "architecture"],
          "properties": {
            "ordinary": {"$ref": "#/$defs/coverage"},
            "architecture": {"$ref": "#/$defs/coverage"}
          }
        }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_at", "age_seconds"],
      "properties": {
        "observed_at": {"$ref": "#/$defs/nullableTime"},
        "age_seconds": {"$ref": "#/$defs/nullableCount"}
      }
    },
    "lane": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "health", "total", "counts", "last_run_at", "truncated", "allowance", "items"],
      "properties": {
        "enabled": {"type": "boolean"},
        "health": {"enum": ["disabled", "idle", "healthy", "running", "attention", "unavailable"]},
        "total": {"type": "integer", "minimum": 0},
        "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "last_run_at": {"$ref": "#/$defs/nullableTime"},
        "truncated": {"type": "boolean"},
        "allowance": {"$ref": "#/$defs/allowance"},
        "items": {"type": "array", "maxItems": 25, "items": {"$ref": "#/$defs/item"}}
      }
    },
    "allowance": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "utc_date", "limit", "used", "remaining", "status", "retry_at"],
      "properties": {
        "engine": {"type": "string", "minLength": 1, "maxLength": 64},
        "utc_date": {"type": ["string", "null"], "maxLength": 10},
        "limit": {"$ref": "#/$defs/nullableCount"},
        "used": {"$ref": "#/$defs/nullableCount"},
        "remaining": {"$ref": "#/$defs/nullableCount"},
        "status": {"type": "string", "minLength": 1, "maxLength": 128},
        "retry_at": {"$ref": "#/$defs/nullableTime"}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "identity", "state", "title", "summary", "route", "severity", "confidence", "feature_id", "target_revision", "source", "updated_at", "evidence", "blocker"],
      "properties": {
        "engine": {"type": "string", "minLength": 1, "maxLength": 64},
        "identity": {"type": "string", "minLength": 1, "maxLength": 2048},
        "state": {"type": "string", "minLength": 1, "maxLength": 128},
        "title": {"type": ["string", "null"], "maxLength": 1024},
        "summary": {"type": ["string", "null"], "maxLength": 1024},
        "route": {"type": ["string", "null"], "maxLength": 128},
        "severity": {"type": ["string", "null"], "maxLength": 128},
        "confidence": {"type": ["string", "null"], "maxLength": 128},
        "feature_id": {"type": ["string", "null"], "maxLength": 1024},
        "target_revision": {"type": ["string", "null"], "maxLength": 128},
        "source": {"anyOf": [{"$ref": "#/$defs/source"}, {"type": "null"}]},
        "updated_at": {"$ref": "#/$defs/nullableTime"},
        "evidence": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "blocker": {"type": ["string", "null"], "maxLength": 1024}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "url", "number"],
      "properties": {
        "kind": {"type": ["string", "null"], "maxLength": 64},
        "id": {"type": ["string", "null"], "maxLength": 2048},
        "url": {"type": ["string", "null"], "maxLength": 4096},
        "number": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "admission": {
      "type": "object", "additionalProperties": false,
      "required": ["total_occurrences", "unique_roots", "unresolved", "counts", "next_retry_at"],
      "properties": {
        "total_occurrences": {"type": "integer", "minimum": 0},
        "unique_roots": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0},
        "counts": {
          "type": "object", "additionalProperties": false,
          "required": ["pending", "deciding", "decided", "blocked", "materializing", "bound", "acknowledged", "retry_wait"],
          "properties": {
            "pending": {"type": "integer", "minimum": 0}, "deciding": {"type": "integer", "minimum": 0},
            "decided": {"type": "integer", "minimum": 0}, "blocked": {"type": "integer", "minimum": 0},
            "materializing": {"type": "integer", "minimum": 0}, "bound": {"type": "integer", "minimum": 0},
            "acknowledged": {"type": "integer", "minimum": 0}, "retry_wait": {"type": "integer", "minimum": 0}
          }
        },
        "next_retry_at": {"$ref": "#/$defs/nullableTime"}
      }
    },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["stages", "counts", "latency"],
      "properties": {
        "stages": {"$ref": "#/$defs/stageCounts"},
        "counts": {"$ref": "#/$defs/workflowCounts"},
        "latency": {"$ref": "#/$defs/latency"}
      }
    },
    "stageCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["1-inbox", "2-fix", "3-validate", "4-review", "5-publish", "6-done"],
      "properties": {
        "1-inbox": {"type": "integer", "minimum": 0}, "2-fix": {"type": "integer", "minimum": 0},
        "3-validate": {"type": "integer", "minimum": 0}, "4-review": {"type": "integer", "minimum": 0},
        "5-publish": {"type": "integer", "minimum": 0}, "6-done": {"type": "integer", "minimum": 0}
      }
    },
    "workflowCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "active", "parked", "provider", "rework", "rejected", "blocked", "escalated", "successors"],
      "properties": {
        "total": {"type": "integer", "minimum": 0}, "active": {"type": "integer", "minimum": 0},
        "parked": {"type": "integer", "minimum": 0}, "provider": {"type": "integer", "minimum": 0},
        "rework": {"type": "integer", "minimum": 0}, "rejected": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0}, "escalated": {"type": "integer", "minimum": 0},
        "successors": {"type": "integer", "minimum": 0}
      }
    },
    "latency": {
      "type": "object", "additionalProperties": false,
      "required": ["total_seconds", "active_seconds", "parked_seconds", "provider_seconds", "provider_history", "sample_count", "unavailable_count", "current_provider", "by_stage"],
      "properties": {
        "total_seconds": {"type": "integer", "minimum": 0},
        "active_seconds": {"type": "null"},
        "parked_seconds": {"type": "integer", "minimum": 0},
        "provider_seconds": {"type": "null"},
        "provider_history": {"const": "unavailable"},
        "sample_count": {"type": "integer", "minimum": 0},
        "unavailable_count": {"type": "integer", "minimum": 0},
        "current_provider": {
          "type": "object", "additionalProperties": false,
          "required": ["tasks", "next_retry_at"],
          "properties": {"tasks": {"type": "integer", "minimum": 0}, "next_retry_at": {"$ref": "#/$defs/nullableTime"}}
        },
        "by_stage": {"$ref": "#/$defs/stageLatencies"}
      }
    },
    "stageLatencies": {
      "type": "object", "additionalProperties": false,
      "required": ["1-inbox", "2-fix", "3-validate", "4-review", "5-publish", "6-done"],
      "properties": {
        "1-inbox": {"$ref": "#/$defs/stageLatency"}, "2-fix": {"$ref": "#/$defs/stageLatency"},
        "3-validate": {"$ref": "#/$defs/stageLatency"}, "4-review": {"$ref": "#/$defs/stageLatency"},
        "5-publish": {"$ref": "#/$defs/stageLatency"}, "6-done": {"$ref": "#/$defs/stageLatency"}
      }
    },
    "stageLatency": {
      "type": "object", "additionalProperties": false,
      "required": ["tasks", "total_seconds", "active_seconds", "parked_seconds", "provider_seconds"],
      "properties": {
        "tasks": {"type": "integer", "minimum": 0}, "total_seconds": {"type": "integer", "minimum": 0},
        "active_seconds": {"type": "null"}, "parked_seconds": {"type": "integer", "minimum": 0},
        "provider_seconds": {"type": "null"}
      }
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["cohorts", "task_conversion", "pr_conversion", "pr_created", "pr_open"],
      "properties": {
        "cohorts": {"type": "array", "maxItems": 8192, "items": {"$ref": "#/$defs/cohort"}},
        "task_conversion": {"$ref": "#/$defs/conversion"},
        "pr_conversion": {"$ref": "#/$defs/conversion"},
        "pr_created": {"type": "integer", "minimum": 0},
        "pr_open": {"type": "integer", "minimum": 0}
      }
    },
    "cohort": {
      "type": "object", "additionalProperties": false,
      "required": ["utc_date", "roots", "tasks", "pr_created", "pr_open"],
      "properties": {
        "utc_date": {"type": "string", "maxLength": 10}, "roots": {"type": "integer", "minimum": 0},
        "tasks": {"type": "integer", "minimum": 0}, "pr_created": {"type": "integer", "minimum": 0},
        "pr_open": {"type": "integer", "minimum": 0}
      }
    },
    "conversion": {
      "type": "object", "additionalProperties": false,
      "required": ["converted", "denominator", "rate"],
      "properties": {
        "converted": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 0},
        "rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "tokens": {
      "type": "object", "additionalProperties": false,
      "required": ["available", "utc_date", "input", "output", "cached", "total", "launches", "unmetered_launches"],
      "properties": {
        "available": {"type": "boolean"},
        "utc_date": {"type": "string", "maxLength": 10},
        "input": {"$ref": "#/$defs/nullableCount"},
        "output": {"$ref": "#/$defs/nullableCount"},
        "cached": {"$ref": "#/$defs/nullableCount"},
        "total": {"$ref": "#/$defs/nullableCount"},
        "launches": {"$ref": "#/$defs/nullableCount"},
        "unmetered_launches": {"$ref": "#/$defs/nullableCount"}
      },
      "allOf": [
        {
          "if": {"properties": {"available": {"const": true}}},
          "then": {"properties": {
            "input": {"type": "integer", "minimum": 0},
            "output": {"type": "integer", "minimum": 0},
            "cached": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 0},
            "launches": {"type": "integer", "minimum": 0},
            "unmetered_launches": {"type": "integer", "minimum": 0}
          }},
          "else": {"properties": {
            "input": {"type": "null"}, "output": {"type": "null"},
            "cached": {"type": "null"}, "total": {"type": "null"},
            "launches": {"type": "null"}, "unmetered_launches": {"type": "null"}
          }}
        }
      ]
    }
  }
}
