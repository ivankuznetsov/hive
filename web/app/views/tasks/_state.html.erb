<%# Updated by Turbo 8 morph-refresh (pushed from StatusBroadcaster) —
    no frame, no polling. The answers controller carries typed-but-unsent
    text and the caret across each morph (forms morph freely; permanence
    would make a new round's form unable to replace the old one). %>
<% operator = @workspace.fetch("operator") %>
<% questions = operator.fetch("questions") %>
<% recovery = operator["recovery"] %>
<section id="task-state" data-controller="answers">
  <%= render "tasks/workspace_summary", workspace: @semantic_workspace %>

  <%# Only the state-driven primary actions appear (Approve when the gate is
      passable, Run when the operator drives stages manually, Diff when a
      worktree exists). The sharp tools live in the Advanced section. %>
  <% if @daemon_enabled && !@daemon_running && !@task.terminal? %>
    <div class="state-banner daemon-blocker">
      <span class="status-dot status-dot-waiting"></span>
      <span>
        <strong>Auto-advance is paused.</strong>
        The daemon is not running. Run <code>hive daemon start --detach</code>;
        this task will continue automatically when it is ready.
      </span>
    </div>
  <% end %>

  <%# The bot's Autofix, web-shaped, and every other primary task action are
      shared with board cards so both surfaces submit the same native forms. %>
  <%= render "tasks/primary_actions", task: @task, daemon_enabled: @daemon_enabled,
        recovery: recovery,
        mutations_enabled: @status_fresh && @workspace_action_evidence_current %>


  <% if questions.any? %>
    <section id="task-questions" class="qa">
      <h2>Questions from the agent</h2>
      <% if (idea_text = @task.original_idea_text) %>
        <details class="idea-context" open>
          <summary class="muted">Original idea</summary>
          <p class="idea-text"><%= idea_text %></p>
        </details>
      <% end %>
      <p class="muted">Answer what you can — the daemon resumes the brainstorm once answers land. Unanswered questions stay open.</p>
      <%# The id is round-keyed for tests/inspection; typing survival across
        morphs is the answers controller's job (see its header for why
        data-turbo-permanent must NOT be used here). %>
    <%= form_with url: task_answers_path(
          @project.name, @task["slug"], source: @task_source
        ),
            id: "qa-form-#{questions.map { |question| question.fetch("ordinal") }.join("-")}" do |f| %>
        <% questions.each do |question| %>
          <div class="qa-item">
            <%# Single line: qa-question is pre-wrap, so template indentation
                would render as a first-line indent. %>
            <p class="qa-question"><span class="qa-number">Q<%= question.fetch("n") %></span><%= question.fetch("text") %></p>
            <%= text_area_tag "answers[#{question.fetch("binding")}]", "", placeholder: "Your answer…",
                  disabled: !@answer_input_enabled,
                  data: {
                    question_number: question.fetch("n"),
                    action: "input->answers#recordField select->answers#recordField"
                  },
                  aria: { label: "Answer to question #{question.fetch("n")}" } %>
          </div>
        <% end %>
        <p><%= f.submit "Send answers", disabled: !@answer_input_enabled,
              data: { turbo_submits_with: "Sending…" } %></p>
      <% end %>
    </section>

    <%# Honest framing: intervene can ONLY fill the next open brainstorm
        question (the bot's free-text parity path) — it does not steer
        arbitrary stages, and without an open question it always fails. %>
    <details class="intervene">
      <summary class="muted">Reply free-form instead (fills Q<%= questions.first.fetch("n") %>)</summary>
      <%= form_with url: task_intervene_path(
            @project.name, @task["slug"], source: @task_source
          ),
            id: "intervene-form" do |f| %>
        <%= hidden_field_tag :binding, questions.first.fetch("binding") %>
        <%= f.text_area :message, required: true,
              disabled: !@answer_input_enabled,
              data: {
                action: "input->answers#recordField select->answers#recordField",
                draft_key: questions.first.fetch("binding")
              },
              placeholder: "Written verbatim as the answer to Q#{questions.first.fetch("n")}…" %>
        <p><%= f.submit "Send", disabled: !@answer_input_enabled,
              data: { turbo_submits_with: "Sending…" } %></p>
      <% end %>
    </details>
  <% elsif @task["stage"] == "2-brainstorm" && @task["marker"].to_s == "waiting" && !@task.passable? %>
    <%# Post-answer limbo: everything answered, daemon not done yet. The
        page morph-refreshes on every status push, so the banner hands off
        to the next round's questions, a running dot, or a passable gate
        on its own. %>
    <div class="state-banner">
      <span class="status-dot status-dot-waiting"></span>
      <% if @task["claude_pid_alive"] %>
        The agent is working — this page follows along automatically.
      <% else %>
        All questions answered — waiting for the daemon to resume this stage.
        This page updates automatically.
      <% end %>
    </div>
  <% end %>
</section>
