---
# Global hive config — auto-managed; edit only if you know what you're doing.
registered_projects: <%= registered_projects.empty? ? "[]" : "" %>
<% registered_projects.each do |p| %>  - name: <%= p["name"] %>
    path: <%= p["path"] %>
    hive_state_path: <%= p["hive_state_path"] %>
<% end %>

# Telegram bot global surface. The token is intentionally not stored here:
# set HIVE_TELEGRAM_BOT_TOKEN in the environment before `hive bot start`.
# Uncomment and fill chat_id_allowlist to opt in.
#
# bot:
#   enabled: false
#   pairing_enabled: false # when true, unknown DM /start requests get pairing codes
#   chat_id_allowlist: []   # integers only, e.g. [123456789]
#   poll_interval_sec: 30
#   long_poll_timeout_sec: 25
#   alert_state_file: ~/.local/state/hive/.bot.alert_state.json
#   recovery_reminder_window_sec: 28800
#   conversation_ttl_sec: 3600
#   idea_attachment_max_bytes: 20971520
#   idea_attachment_max_count: 10
#   idea_draft_ttl_sec: 900
#   shutdown_grace_sec: 60
#   pid_file: ~/Dev/hive/.bot.pid
#   log_file: ~/Dev/hive/logs/bot.log
#   log_max_bytes: 10485760
#   log_max_files: 5
#   last_seen_state_file: ~/Dev/hive/.bot.last_seen_update_id

# Daily digest. Merged PRs are the default source; set source: shipped to use
# the agent-written completed-task digest instead. Defaults ON whenever the
# Telegram bot is enabled with at least one allowlisted chat — the daemon then
# schedules one global child after local midnight with the resolved source and
# sends Telegram MarkdownV2 to the first allowlisted chat. Set enabled: false
# to opt out. Merged-PR repository scope comes from registered_projects unless
# a manual invocation supplies --repo; there is no digest-specific repo list.
#
# digest:
#   enabled: false         # only needed to opt OUT; otherwise auto-on with the bot
#   source: merged-prs     # merged-prs (default) or shipped
#   agent: ~               # defaults to patrol.agent, then claude
#   max_catchup_days: 7

# Daily pending-answer digest. When enabled, the daemon schedules one global
# `hive answer-digest` subprocess at/after the configured local hour. Empty
# snapshots are silent.
#
# answer_digest:
#   enabled: false
#   hour: 9
