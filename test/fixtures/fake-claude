#!/usr/bin/env bash
# Minimal fake claude for tests. Captures argv, optionally writes content
# to the state file, exits with HIVE_FAKE_CLAUDE_EXIT (default 0).
set -u

# Hive::Agent.check_version! probes `claude --version` before spawning.
# Emit a parseable version line so the runtime check passes by default.
# Override with HIVE_FAKE_CLAUDE_VERSION (e.g. "1.0.0" to simulate too-old).
if [[ "${1:-}" == "--version" ]]; then
  printf '%s (Claude Code)\n' "${HIVE_FAKE_CLAUDE_VERSION:-2.1.118}"
  exit 0
fi

LOG_DIR="${HIVE_FAKE_CLAUDE_LOG_DIR:-/tmp}"
mkdir -p "$LOG_DIR"
ARGV_LOG="${LOG_DIR}/fake-claude-argv.log"
{
  echo "---"
  date -u +"%Y-%m-%dT%H:%M:%SZ"
  echo "cwd=$(pwd)"
  printf 'env_ANTHROPIC_API_KEY=%s\n' "${ANTHROPIC_API_KEY-__unset__}"
  printf 'env_CLAUDE_API_KEY=%s\n' "${CLAUDE_API_KEY-__unset__}"
  printf 'env_HIVE_SCREENOTE_BASE_URL=%s\n' "${HIVE_SCREENOTE_BASE_URL-__unset__}"
  for a in "$@"; do
    printf 'arg=%s\n' "$a"
  done
} >> "$ARGV_LOG"

if [[ -n "${HIVE_FAKE_CLAUDE_OUTPUT:-}" ]]; then
  printf '%s\n' "${HIVE_FAKE_CLAUDE_OUTPUT}"
fi

if [[ -n "${HIVE_FAKE_CLAUDE_DELAY_BEFORE_WRITE:-}" ]]; then
  sleep "${HIVE_FAKE_CLAUDE_DELAY_BEFORE_WRITE}"
fi

if [[ -n "${HIVE_FAKE_CLAUDE_WRITE_FILE:-}" && -n "${HIVE_FAKE_CLAUDE_WRITE_CONTENT:-}" ]]; then
  printf '%s' "${HIVE_FAKE_CLAUDE_WRITE_CONTENT}" > "${HIVE_FAKE_CLAUDE_WRITE_FILE}"
fi

if [[ -n "${HIVE_FAKE_CLAUDE_OUTPUT_AFTER_WRITE:-}" ]]; then
  printf '%s\n' "${HIVE_FAKE_CLAUDE_OUTPUT_AFTER_WRITE}"
fi

if [[ -n "${HIVE_FAKE_CLAUDE_DELAY_AFTER_WRITE_OUTPUT:-}" ]]; then
  sleep "${HIVE_FAKE_CLAUDE_DELAY_AFTER_WRITE_OUTPUT}"
fi

if [[ -n "${HIVE_FAKE_CLAUDE_FINAL_OUTPUT:-}" ]]; then
  printf '%s\n' "${HIVE_FAKE_CLAUDE_FINAL_OUTPUT}"
fi

if [[ -n "${HIVE_FAKE_CLAUDE_COMMIT_FILE:-}" ]]; then
  printf '%s' "${HIVE_FAKE_CLAUDE_COMMIT_CONTENT:-implemented\n}" > "${HIVE_FAKE_CLAUDE_COMMIT_FILE}"
  git add -- "${HIVE_FAKE_CLAUDE_COMMIT_FILE}"
  if ! git diff --cached --quiet; then
    git commit -m "${HIVE_FAKE_CLAUDE_COMMIT_MESSAGE:-test: fake agent commit}" --quiet
  fi
fi

# Durable-attempt acceptance fixture. Create a deterministic sequence of
# commits, publish a readiness sentinel, then wait on a release sentinel.
# This lets the e2e harness terminate the temporary CLI attachment after
# useful work exists while proving the detached wrapper continues ownership.
if [[ -n "${HIVE_FAKE_CLAUDE_MULTI_COMMIT_COUNT:-}" ]]; then
  count="${HIVE_FAKE_CLAUDE_MULTI_COMMIT_COUNT}"
  prefix="${HIVE_FAKE_CLAUDE_MULTI_COMMIT_PREFIX:-durable-attempt-progress}"
  if [[ -n "${HIVE_FAKE_CLAUDE_BASE_REVISION_FILE:-}" ]]; then
    mkdir -p "$(dirname "${HIVE_FAKE_CLAUDE_BASE_REVISION_FILE}")"
    git rev-parse HEAD > "${HIVE_FAKE_CLAUDE_BASE_REVISION_FILE}"
  fi
  for ((i = 1; i <= count; i++)); do
    file="${prefix}-${i}.txt"
    printf 'durable attempt progress %s\n' "$i" > "$file"
    git add -- "$file"
    git commit -m "test: durable attempt progress ${i}" --quiet
  done
  if [[ -n "${HIVE_FAKE_CLAUDE_PROGRESS_FILE:-}" ]]; then
    mkdir -p "$(dirname "${HIVE_FAKE_CLAUDE_PROGRESS_FILE}")"
    : > "${HIVE_FAKE_CLAUDE_PROGRESS_FILE}"
  fi
  if [[ -n "${HIVE_FAKE_CLAUDE_RELEASE_FILE:-}" ]]; then
    deadline=$((SECONDS + ${HIVE_FAKE_CLAUDE_RELEASE_TIMEOUT_SEC:-60}))
    until [[ -e "${HIVE_FAKE_CLAUDE_RELEASE_FILE}" ]]; do
      if ((SECONDS >= deadline)); then
        printf 'fake-claude: timed out waiting for release sentinel %s\n' \
          "${HIVE_FAKE_CLAUDE_RELEASE_FILE}" >&2
        exit 124
      fi
      sleep 0.05
    done
  fi
fi

# Simulate the side-effect of `gh pr create` on a subsequent `gh pr
# list`: when HIVE_FAKE_GH_PR_EXISTS_FILE is set, mark the file so
# fake-gh's `pr list` claims the PR exists. Tests for the open-pr
# post-spawn validation path use this to switch the lookup result
# from "no PR" to "PR exists" across the agent invocation.
if [[ -n "${HIVE_FAKE_GH_PR_EXISTS_FILE:-}" ]]; then
  mkdir -p "$(dirname "${HIVE_FAKE_GH_PR_EXISTS_FILE}")"
  : > "${HIVE_FAKE_GH_PR_EXISTS_FILE}"
fi

if [[ -n "${HIVE_FAKE_CLAUDE_HANG:-}" ]]; then
  if [[ "${HIVE_FAKE_CLAUDE_IGNORE_TERM:-}" == "1" ]]; then
    trap '' TERM
  fi
  sleep "${HIVE_FAKE_CLAUDE_HANG}"
fi

exit "${HIVE_FAKE_CLAUDE_EXIT:-0}"
