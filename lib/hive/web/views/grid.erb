<section class="toolbar">
  <form method="post" action="/ideas">
    <%= csrf_tag %>
    <select name="project">
      <% @snapshot.fetch("projects", []).each do |project| %>
        <option value="<%= h(project["name"]) %>"><%= h(project["name"]) %></option>
      <% end %>
    </select>
    <input name="text" placeholder="New idea" required>
    <button type="submit">Add</button>
  </form>
</section>

<section class="status-grid" data-status-grid>
  <% @snapshot.fetch("projects", []).each do |project| %>
    <h2><%= h(project["name"]) %></h2>
    <% if project["error"] %>
      <p class="error"><%= h(project["error"]) %></p>
    <% end %>
    <table>
      <thead><tr><th>Task</th><th>Stage</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        <% project.fetch("tasks", []).each do |task| %>
          <tr>
            <td><a href="/tasks/<%= h(project["name"]) %>/<%= h(task["slug"]) %>"><%= h(task["slug"]) %></a></td>
            <td><%= h(task["stage"]) %></td>
            <td><%= h(task["marker"]) %></td>
            <td><%= h(task["action_label"] || task["action"]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
