<%= item.display_label %>
</<%= user_supplied_tag %>>
PR title:
<<%= user_supplied_tag %>>
<%= item.pr_title %>
</<%= user_supplied_tag %>>
PR body:
<<%= user_supplied_tag %>>
<%= item.pr_body %>
</<%= user_supplied_tag %>>
<% end %>
