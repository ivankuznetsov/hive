<div id="status-board" class="kanban-board">
  <% if board.empty? %>
    <div class="empty-state">
      <p>No projects yet.</p>
      <p class="hint"><%= link_to "Add a repository", repos_path %> to start the pipeline.</p>
    </div>
  <% else %>
    <% board.bands.each do |band| %>
      <% band_id = stable_dom_id("kanban-band", band.project.name, band.workflow_id) %>
      <section id="<%= band_id %>" class="kanban-band project-section"
               data-project-name="<%= band.project.name %>"
               data-workflow="<%= band.workflow_id %>">
        <header class="kanban-band-header">
          <div>
            <h2><%= band.project.name %></h2>
            <span class="kanban-workflow"><%= band.workflow_id %> workflow</span>
          </div>
          <span class="muted"><%= pluralize(band.task_count, "task") %></span>
        </header>

        <% if band.hidden_archived_task_count.positive? %>
          <p class="archive-summary">
            <%= link_to hidden_archive_summary(band.hidden_archived_task_count),
                  archive_path(project: band.project.name) %>
          </p>
        <% end %>

        <% if band.unavailable? %>
          <div class="state-banner state-banner-error kanban-band-warning" role="status">
            <%= band.availability_message %>
          </div>
        <% end %>

        <div class="kanban-columns" aria-label="<%= band.project.name %> <%= band.workflow_id %> workflow">
          <% band.columns.each do |column| %>
            <% column_id = stable_dom_id("kanban-column", band.project.name, band.workflow_id, column.stage) %>
            <% heading_id = "#{column_id}-heading" %>
            <section id="<%= column_id %>" class="kanban-column <%= "is-folded" if column.folded_by_default? %>"
                     data-stage="<%= column.stage %>" aria-labelledby="<%= heading_id %>"
                     data-controller="kanban-column" data-action="turbo:morph-element->kanban-column#restore"
                     data-kanban-column-default-folded-value="<%= column.folded_by_default? %>"
                     data-kanban-column-label-value="<%= column.label %>">
              <header class="kanban-column-header">
                <h3 id="<%= heading_id %>">
                  <button type="button" class="kanban-column-toggle" data-kanban-column-target="toggle"
                          data-action="kanban-column#toggle" aria-controls="<%= column_id %>-cards"
                          aria-expanded="<%= !column.folded_by_default? %>"
                          aria-label="<%= column.folded_by_default? ? "Expand" : "Fold" %> <%= column.label %> column">
                    <span class="kanban-column-label"><%= column.label %></span>
                    <span class="kanban-count" aria-label="<%= pluralize(column.tasks.size, "task") %>"><%= column.tasks.size %></span>
                    <span class="kanban-fold-icon" aria-hidden="true">‹</span>
                  </button>
                </h3>
              </header>

              <div id="<%= column_id %>-cards" class="kanban-cards" data-kanban-column-target="cards" <%= "hidden" if column.folded_by_default? %>>
                <% if column.tasks.empty? %>
                  <p class="kanban-empty">No tasks</p>
                <% else %>
                  <% column.tasks.each do |task| %>
                    <article id="<%= stable_dom_id("kanban-card", band.project.name, task.slug) %>"
                             class="kanban-card" data-task-slug="<%= task.slug %>">
                      <div class="kanban-card-heading">
                        <%= status_dot(task, fresh: status_fresh) %>
                        <%= link_to task.title, task_path(band.project.name, task.slug) %>
                      </div>
                      <% display = TaskDisplay.new(task, fresh: status_fresh) %>
                      <div class="kanban-card-meta">
                        <span><%= display.label %></span>
                        <span class="faint"><%= "Updated #{relative_age(task["age_seconds"])}" %></span>
                      </div>
                      <% if display.detail.present? && !%w[running completed paused].include?(display.state) %>
                        <p class="task-state-detail"><%= truncate(display.detail, length: 180) %></p>
                      <% end %>
                      <%= render "tasks/primary_actions", task:,
                            daemon_enabled: band.daemon_enabled, compact: true,
                            mutations_enabled: status_fresh %>
                    </article>
                  <% end %>
                <% end %>
              </div>
            </section>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
