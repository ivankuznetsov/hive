{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive.local/schemas/hive-patrol-decision-projection.v1.json",
  "title": "Hive Patrol Decision Projection v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "rationale", "job_id", "phase"],
      "properties": {
        "module": {"const": "patrol"},
        "rationale": {"enum": ["disabled", "not_due", "due"]},
        "job_id": {"type": "null"},
        "phase": {"type": "null"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "rationale", "job_id", "phase"],
      "properties": {
        "module": {"const": "architecture-patrol"},
        "rationale": {"const": "due"},
        "job_id": {"type": "string", "minLength": 1},
        "phase": {"enum": ["discovery", "action"]}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "rationale", "job_id", "phase"],
      "properties": {
        "module": {"const": "architecture-patrol"},
        "rationale": {"const": "not_due"},
        "job_id": {"type": "null"},
        "phase": {"type": "null"}
      }
    }
  ]
}
