<% content_for(:title, "#{web_product_name} — #{@task.title}") %>

<div id="status-stream-owner" data-controller="status-refresh task-workspace"
     data-status-version="<%= @status_version %>"
     data-task-workspace-key-value="<%= stable_dom_id("task-workspace", @project.name, @task["slug"]) %>"
     data-task-workspace-signature-value="<%= stable_dom_id(
       "workspace-material",
       @semantic_workspace.dig("headline", "state"),
       @semantic_workspace.dig("headline", "explanation"),
       @semantic_workspace.dig("action", "kind"),
       @semantic_workspace.dig("result", "primary", "reference"),
       @semantic_workspace.dig("usage", "coverage")
     ) %>">
<div class="task-header">
  <h1><%= @task.title %></h1>
</div>
<p class="muted"><%= link_to @project.name, grid_path(project: @project.name) %><% if @task["id"] %> · #<%= @task["id"] %><% end %> · <%= @task["workflow"].to_s.humanize %></p>

<%# Live by PUSH, not poll: the page subscribes to the status channel and
    morph-refreshes when StatusBroadcaster signals a change — answers
    recorded → agent resumes → next round's questions or a passable gate
    appear instantly. Morphing (vs replace) plus the data-turbo-permanent
    Q&A form means typing is never disturbed. %>
<% content_for(:head) do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>
  <%= status_stream_source id: "status-stream-source",
        hidden: true, data: { turbo_permanent: true } %>
<%= render "status/freshness_warning",
      availability: @status_availability,
      last_success_at: @status_last_success_at,
      error: @status_error %>
<%= render "tasks/state" %>
<%= render "tasks/diagnostic", diagnostic: @semantic_workspace.fetch("diagnostic") %>
<%= render "tasks/primary_result", result: @semantic_workspace.fetch("result") %>
<% if @semantic_workspace.dig("usage", "tokens") %>
  <details class="task-secondary" data-workspace-disclosure-key="task-usage">
    <summary>Usage · <%= number_with_delimiter(@semantic_workspace.dig("usage", "tokens", "input_output")) %> tokens</summary>
    <%= render "tasks/usage", usage: @semantic_workspace.fetch("usage") %>
  </details>
<% end %>

<% if (closure = @task["closure"]).is_a?(Hash) && closure["schema"] == Hive::TaskClosure::SCHEMA %>
  <section class="task-closure" aria-labelledby="task-closure-title">
    <h2 id="task-closure-title">Closure evidence</h2>
    <p>
      Archived as <strong><%= closure.fetch("reason").tr("_", " ") %></strong>
      via <%= closure.fetch("authority").tr("_", " ") %>.
    </p>
    <ul>
      <% Array(closure["evidence"]).each do |item| %>
        <li><%= link_to "#{item.fetch("repository")} #{item["number"] ? "PR ##{item["number"]}" : item.fetch("oid")[0, 12]}",
                      item.fetch("url"), rel: "noopener noreferrer" %></li>
      <% end %>
    </ul>
  </section>
<% end %>

<%= render "tasks/plan_review", plan_review: @plan_review, task: @task,
      status_fresh: @status_fresh, task_source: @task_source if @plan_review %>

<%= render "tasks/outcome_evidence", evidence: @outcome_evidence, project: @project, task: @task %>

<div class="task-workspace" aria-label="Task evidence workspace">
  <div class="task-workspace-grid">
    <% if @semantic_workspace.dig("applicability", "supporting_artifacts") ||
          @semantic_workspace.dig("evidence", "supporting_artifacts", "state") == "current" %>
      <%= render "tasks/supporting_artifacts", result: @semantic_workspace.fetch("result") %>
    <% end %>

    <% if @task["depends_on"].present? || Array(@workspace.dig("panels", "dependencies", "edges")).any? %>
      <%= render "tasks/dependencies", workspace: @workspace %>
    <% end %>

    <% show_diff = @task.worktree? %>
    <% show_publication = @task["pr_url"].present? || @task.worktree? %>
    <% if show_diff || show_publication %>
      <div class="workspace-wide workspace-change-grid" aria-label="Change and publication evidence">
        <% if show_diff %>
          <%= render "tasks/diff_frame",
                project: @project, task: @task, task_source: @task_source %>
        <% end %>
        <% if show_publication %>
          <%= turbo_frame_tag stable_dom_id("task-publication", @project.name, @task.slug),
                refresh: "morph" do %>
            <%= render "tasks/publication",
                  publication: @workspace.dig("panels", "publication"),
                  refresh_available: @publication_refresh_available,
                  refresh_notice: nil %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if @media && (@media["status"] == "failed" || Array(@media["items"]).any?) %>
      <div class="workspace-wide">
        <%= render "tasks/media", media: @media, project: @project, task: @task %>
      </div>
    <% end %>
  </div>
</div>

<details class="advanced" data-workspace-disclosure-key="advanced">
  <summary>Advanced</summary>
  <p class="muted">Task reference: <code><%= @task.slug %></code></p>
  <% unless @task.terminal? || @task_source == "archive" %>
    <p><%= link_to "Close with evidence", new_task_closure_path(@project.name, @task.slug) %></p>
  <% end %>
  <div class="advanced-item">
    <div>
      <p class="advanced-title">Send back a stage</p>
      <p class="muted">Move this task to the previous gate. Artifacts are kept — the prior stage resumes where it left off.</p>
    </div>
    <%= button_to "Reject",
          task_reject_path(@project.name, @task["slug"], source: @task_source),
          params: { from: @task["stage"] }, class: "btn-danger",
          disabled: !@status_fresh || !@workspace_action_evidence_current,
          aria: { disabled: (!@status_fresh || !@workspace_action_evidence_current).to_s },
          data: { turbo_confirm: "Send #{@task["slug"]} back a stage?" } %>
  </div>
  <% unless @task.passable? || (@task["stage"] == "3-plan" && @task.plan_review) %>
    <div class="advanced-item">
      <div>
        <p class="advanced-title">Force approve</p>
        <p class="muted">Advance to the next stage even though this one isn't marked complete — the next agent runs with whatever exists now (e.g. unanswered questions stay unanswered).</p>
      </div>
      <%= button_to "Force approve",
            task_approve_path(@project.name, @task["slug"], source: @task_source),
            params: { from: @task["stage"], force: "1" }, class: "btn-secondary",
            disabled: !@status_fresh || !@workspace_action_evidence_current,
            aria: { disabled: (!@status_fresh || !@workspace_action_evidence_current).to_s },
            data: { turbo_confirm: "Advance #{@task["slug"]} even though the stage isn't marked complete?" } %>
    </div>
  <% end %>
  <div class="advanced-item">
    <div>
      <p class="advanced-title">Drop task</p>
      <p class="muted">Permanently delete this idea — kills any running agent, removes the task folder, worktree, and branch, and closes a draft PR. The TUI's Shift+X. There is no undo.</p>
    </div>
    <%= button_to "Drop",
          task_drop_path(@project.name, @task["slug"], source: @task_source),
          params: { from: @task["stage"] }, class: "btn-danger",
          disabled: !@status_fresh || !@workspace_action_evidence_current,
          aria: { disabled: (!@status_fresh || !@workspace_action_evidence_current).to_s },
          data: { turbo_confirm: "Permanently delete #{@task["slug"]}? This cannot be undone." } %>
  </div>
</details>

<p id="task-workspace-announcement" class="visually-hidden" role="status"
   aria-live="polite" aria-atomic="true"
   data-task-workspace-target="announcement"></p>
</div>
