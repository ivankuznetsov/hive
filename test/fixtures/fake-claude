#!/usr/bin/env bash
# Minimal fake claude for tests. Captures argv, optionally writes content
# to the state file, exits with HIVE_FAKE_CLAUDE_EXIT (default 0).
set -u

# Hive::Agent.check_version! probes `claude --version` before spawning.
# Emit a parseable version line so the runtime check passes by default.
# Override with HIVE_FAKE_CLAUDE_VERSION (e.g. "1.0.0" to simulate too-old).
if [[ "${1:-}" == "--version" ]]; then
  printf '%s (Claude Code)\n' "${HIVE_FAKE_CLAUDE_VERSION:-2.1.118}"
  exit 0
fi

LOG_DIR="${HIVE_FAKE_CLAUDE_LOG_DIR:-/tmp}"
mkdir -p "$LOG_DIR"
ARGV_LOG="${LOG_DIR}/fake-claude-argv.log"
{
  echo "---"
  date -u +"%Y-%m-%dT%H:%M:%SZ"
  echo "cwd=$(pwd)"
  printf 'env_ANTHROPIC_API_KEY=%s\n' "${ANTHROPIC_API_KEY-__unset__}"
  printf 'env_ANTHROPIC_AUTH_TOKEN=%s\n' "${ANTHROPIC_AUTH_TOKEN-__unset__}"
  printf 'env_CLAUDE_API_KEY=%s\n' "${CLAUDE_API_KEY-__unset__}"
  printf 'env_HIVE_SCREENOTE_BASE_URL=%s\n' "${HIVE_SCREENOTE_BASE_URL-__unset__}"
  printf 'env_AWS_ACCESS_KEY_ID=%s\n' "${AWS_ACCESS_KEY_ID-__unset__}"
  printf 'env_DATABASE_URL=%s\n' "${DATABASE_URL-__unset__}"
  printf 'env_GITHUB_TOKEN=%s\n' "${GITHUB_TOKEN-__unset__}"
  printf 'env_DISPLAY=%s\n' "${DISPLAY-__unset__}"
  for a in "$@"; do
    printf 'arg=%s\n' "$a"
  done
} >> "$ARGV_LOG"

# Real-CLI outcome-evidence fixture. One `hive artifacts` invocation launches
# three independent roles, so a single static fake response cannot exercise
# the controller contract. Route only the controller-owned role prompts and
# produce a tiny, real two-file document package whose sizes and hashes are
# checked by production code.
# Role detection is prompt-based because production intentionally launches
# these agents with an isolated environment that drops harness-only variables.
prompt_blob=$(printf '%s\n' "$@")
if [[ "${!#:-}" == "-" ]]; then
  stdin_prompt=$(cat)
  prompt_blob=$(printf '%s\n%s' "$prompt_blob" "$stdin_prompt")
fi

emit_final_message() {
  ruby -rjson -e 'puts JSON.generate({ "type" => "result", "result" => ARGV.fetch(0) })' "$1"
}

sha256_file() {
  ruby -rdigest -e 'puts Digest::SHA256.file(ARGV.fetch(0)).hexdigest' "$1"
}

sha256_line() {
  ruby -rdigest -e 'puts Digest::SHA256.hexdigest(ARGV.fetch(0) + "\n")' "$1"
}

if [[ "$prompt_blob" == *"outcome-evidence inference role"* ||
      "$prompt_blob" == *"outcome-evidence producer"* ||
      "$prompt_blob" == *"independent outcome-evidence reviewer"* ]]; then
  if [[ "$prompt_blob" == *"outcome-evidence inference role"* ]]; then
    emit_final_message '{"claims":[{"id":"implemented-demo-pipeline","statement":"The requested demo pipeline implementation is present in the frozen source range.","proof_kind":"document","changed_paths":["implementation.txt"]}],"exclusions":[]}'
    exit 0
  fi

  if [[ "$prompt_blob" == *"outcome-evidence producer"* ]]; then
    writable_root=$(printf '%s\n' "$prompt_blob" | sed -n 's/^Controller-owned evidence-write root: //p' | head -n 1)
    relative_root=$(printf '%s\n' "$prompt_blob" | sed -n 's|^Required task-relative representation path prefix: \(.*\)/$|\1|p' | head -n 1)
    source_worktree=$(printf '%s\n' "$prompt_blob" | sed -n 's/^Frozen source worktree (read only): //p' | head -n 1)
    if [[ -z "$writable_root" || -z "$relative_root" || -z "$source_worktree" ]]; then
      printf '%s\n' 'fake-claude: outcome-evidence producer prompt is missing controller paths' >&2
      exit 64
    fi

    mkdir -p "$writable_root"
    printf '%s\n' 'The frozen implementation adds implementation.txt with the requested demo behavior.' > "$writable_root/original.md"
    printf '%s\n' 'Reviewed implementation.txt: it contains the committed demo implementation marker.' > "$writable_root/review.txt"
    original_sha=$(sha256_file "$writable_root/original.md")
    review_sha=$(sha256_file "$writable_root/review.txt")
    original_bytes=$(wc -c < "$writable_root/original.md" | tr -d ' ')
    review_bytes=$(wc -c < "$writable_root/review.txt" | tr -d ' ')
    source_sha=$(git -C "$source_worktree" rev-parse HEAD)
    printf -v final_message '{"evidence":[{"kind":"document","summary":"Committed document evidence for the demo pipeline implementation.","claims":["implemented-demo-pipeline"],"source":{"type":"task","name":"artifact-agent","source_sha":"%s"},"representations":[{"role":"original","media_type":"text/markdown","rendering":"original","path":"%s/original.md","sha256":"%s","bytes":%s},{"role":"review","media_type":"text/plain","rendering":"escaped_text","path":"%s/review.txt","sha256":"%s","bytes":%s}]}]}' \
      "$source_sha" "$relative_root" "$original_sha" "$original_bytes" \
      "$relative_root" "$review_sha" "$review_bytes"
    emit_final_message "$final_message"
    exit 0
  fi

  if [[ "$prompt_blob" == *"independent outcome-evidence reviewer"* ]]; then
    printf -v final_message '{"verdicts":[{"target_id":"implemented-demo-pipeline","verdict":"accepted","reason":"Both retained representations match the frozen committed implementation and directly support the requested outcome."}]}'
    emit_final_message "$final_message"
    exit 0
  fi
fi

if [[ -n "${HIVE_FAKE_CLAUDE_OUTPUT:-}" ]]; then
  printf '%s\n' "${HIVE_FAKE_CLAUDE_OUTPUT}"
fi

if [[ -n "${HIVE_FAKE_CLAUDE_DELAY_BEFORE_WRITE:-}" ]]; then
  sleep "${HIVE_FAKE_CLAUDE_DELAY_BEFORE_WRITE}"
fi

if [[ -n "${HIVE_FAKE_CLAUDE_WRITE_FILE:-}" && -n "${HIVE_FAKE_CLAUDE_WRITE_CONTENT:-}" ]]; then
  printf '%s' "${HIVE_FAKE_CLAUDE_WRITE_CONTENT}" > "${HIVE_FAKE_CLAUDE_WRITE_FILE}"
fi

if [[ -n "${HIVE_FAKE_CLAUDE_OUTPUT_AFTER_WRITE:-}" ]]; then
  printf '%s\n' "${HIVE_FAKE_CLAUDE_OUTPUT_AFTER_WRITE}"
fi

if [[ -n "${HIVE_FAKE_CLAUDE_DELAY_AFTER_WRITE_OUTPUT:-}" ]]; then
  sleep "${HIVE_FAKE_CLAUDE_DELAY_AFTER_WRITE_OUTPUT}"
fi

if [[ -n "${HIVE_FAKE_CLAUDE_FINAL_OUTPUT:-}" ]]; then
  printf '%s\n' "${HIVE_FAKE_CLAUDE_FINAL_OUTPUT}"
fi

if [[ -n "${HIVE_FAKE_CLAUDE_COMMIT_FILE:-}" ]]; then
  printf '%s' "${HIVE_FAKE_CLAUDE_COMMIT_CONTENT:-implemented\n}" > "${HIVE_FAKE_CLAUDE_COMMIT_FILE}"
  git add -- "${HIVE_FAKE_CLAUDE_COMMIT_FILE}"
  if ! git diff --cached --quiet; then
    git commit -m "${HIVE_FAKE_CLAUDE_COMMIT_MESSAGE:-test: fake agent commit}" --quiet
  fi
fi

# Durable-attempt acceptance fixture. Create a deterministic sequence of
# commits, publish a readiness sentinel, then wait on a release sentinel.
# This lets the e2e harness terminate the temporary CLI attachment after
# useful work exists while proving the detached wrapper continues ownership.
if [[ -n "${HIVE_FAKE_CLAUDE_MULTI_COMMIT_COUNT:-}" ]]; then
  count="${HIVE_FAKE_CLAUDE_MULTI_COMMIT_COUNT}"
  prefix="${HIVE_FAKE_CLAUDE_MULTI_COMMIT_PREFIX:-durable-attempt-progress}"
  if [[ -n "${HIVE_FAKE_CLAUDE_BASE_REVISION_FILE:-}" ]]; then
    mkdir -p "$(dirname "${HIVE_FAKE_CLAUDE_BASE_REVISION_FILE}")"
    git rev-parse HEAD > "${HIVE_FAKE_CLAUDE_BASE_REVISION_FILE}"
  fi
  for ((i = 1; i <= count; i++)); do
    file="${prefix}-${i}.txt"
    printf 'durable attempt progress %s\n' "$i" > "$file"
    git add -- "$file"
    git commit -m "test: durable attempt progress ${i}" --quiet
  done
  if [[ -n "${HIVE_FAKE_CLAUDE_PROGRESS_FILE:-}" ]]; then
    mkdir -p "$(dirname "${HIVE_FAKE_CLAUDE_PROGRESS_FILE}")"
    : > "${HIVE_FAKE_CLAUDE_PROGRESS_FILE}"
  fi
  if [[ -n "${HIVE_FAKE_CLAUDE_RELEASE_FILE:-}" ]]; then
    deadline=$((SECONDS + ${HIVE_FAKE_CLAUDE_RELEASE_TIMEOUT_SEC:-60}))
    until [[ -e "${HIVE_FAKE_CLAUDE_RELEASE_FILE}" ]]; do
      if ((SECONDS >= deadline)); then
        printf 'fake-claude: timed out waiting for release sentinel %s\n' \
          "${HIVE_FAKE_CLAUDE_RELEASE_FILE}" >&2
        exit 124
      fi
      sleep 0.05
    done
  fi
fi

# Simulate the side-effect of `gh pr create` on a subsequent `gh pr
# list`: when HIVE_FAKE_GH_PR_EXISTS_FILE is set, mark the file so
# fake-gh's `pr list` claims the PR exists. Tests for the open-pr
# post-spawn validation path use this to switch the lookup result
# from "no PR" to "PR exists" across the agent invocation.
if [[ -n "${HIVE_FAKE_GH_PR_EXISTS_FILE:-}" ]]; then
  mkdir -p "$(dirname "${HIVE_FAKE_GH_PR_EXISTS_FILE}")"
  : > "${HIVE_FAKE_GH_PR_EXISTS_FILE}"
fi

# Condition-driven barrier for cross-process e2e races. Publish readiness
# atomically, then remain live until the release file exists. The harness
# owns the timeout and process-group teardown, so this fixture needs no fixed
# duration and cannot leak after a failed assertion.
if [[ -n "${HIVE_FAKE_CLAUDE_READY_FILE:-}" ]]; then
  mkdir -p "$(dirname "${HIVE_FAKE_CLAUDE_READY_FILE}")"
  ready_tmp="${HIVE_FAKE_CLAUDE_READY_FILE}.tmp.$$"
  printf '%s\n' "$$" > "$ready_tmp"
  mv -f -- "$ready_tmp" "${HIVE_FAKE_CLAUDE_READY_FILE}"
fi

if [[ -n "${HIVE_FAKE_CLAUDE_RELEASE_FILE:-}" ]]; then
  while [[ ! -e "${HIVE_FAKE_CLAUDE_RELEASE_FILE}" ]]; do
    sleep 0.02
  done
fi

if [[ -n "${HIVE_FAKE_CLAUDE_HANG:-}" ]]; then
  if [[ "${HIVE_FAKE_CLAUDE_IGNORE_TERM:-}" == "1" ]]; then
    trap '' TERM
  fi
  sleep "${HIVE_FAKE_CLAUDE_HANG}"
fi

exit "${HIVE_FAKE_CLAUDE_EXIT:-0}"
