{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-dispatch-request.v5.json",
  "title": "hive dispatch request (v5)",
  "description": "Delivery request for the shared durable task-attempt dispatcher. v5 distinguishes marker-bound and markerless admission-failure recovery and carries only bounded provider-routing admission observations and terminal-receipt identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "request_id", "created_at", "project", "slug",
    "argv", "requestor", "chat_id", "update_id", "trigger", "task_generation",
    "predecessor_attempt_id", "inherited_outputs", "recovery"
  ],
  "properties": {
    "schema": { "const": "hive-dispatch-request" },
    "schema_version": { "const": 5 },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "project": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$" },
    "argv": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "requestor": {
      "type": "string",
      "enum": ["bot", "healer", "web", "tui", "cli", "action", "daemon", "recorder", "operator"]
    },
    "chat_id": { "type": ["integer", "null"] },
    "update_id": { "type": ["integer", "null"] },
    "trigger": { "type": ["string", "null"] },
    "task_generation": { "type": ["string", "null"] },
    "predecessor_attempt_id": { "type": ["string", "null"] },
    "task_id": { "type": ["string", "integer", "null"] },
    "expected_stage": { "type": ["string", "null"] },
    "expected_marker_name": {
      "type": ["string", "null"],
      "enum": ["error", "review_error", "review_stale", "review_ci_stale", null]
    },
    "expected_marker_id": { "type": ["string", "null"] },
    "inherited_outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/OutputReference" }
    },
    "recovery": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/RecoveryTransition" }
      ]
    }
  },
  "$defs": {
    "OutputReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "SourceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "receipt_version", "terminal_lease_version"],
      "properties": {
        "attempt_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "receipt_version": { "type": "integer", "minimum": 1 },
        "terminal_lease_version": { "type": "integer", "minimum": 1 }
      }
    },
    "RoutingIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "RoutingExclusionReason": {
      "type": "string",
      "enum": [
        "hard_pin_mismatch", "requirements_incompatible", "manual_block",
        "circuit_open", "circuit_cooldown", "half_open_probe_owned",
        "provider_concurrency_saturated", "health_state_unavailable"
      ]
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider_account_id", "model"],
      "properties": {
        "kind": { "type": "string", "enum": ["provider_account", "model"] },
        "provider_account_id": { "$ref": "#/$defs/RoutingIdentifier" },
        "model": { "type": ["string", "null"], "maxLength": 128 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "provider_account" } } },
          "then": { "properties": { "model": { "type": "null" } } },
          "else": { "properties": { "model": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "AdmissionPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": { "$ref": "#/$defs/RoutingIdentifier" },
        "model": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "AdmissionRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "quality", "tools", "permissions"],
      "properties": {
        "context": { "type": ["string", "null"], "enum": ["standard", "large", null] },
        "quality": { "type": ["string", "null"], "enum": ["standard", "high", null] },
        "tools": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "enum": ["browser", "filesystem", "mcp", "shell", "web"] }
        },
        "permissions": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "enum": ["network", "read", "write"] }
        }
      }
    },
    "AdmissionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "pin", "requirements"],
      "properties": {
        "stage": { "$ref": "#/$defs/RoutingIdentifier" },
        "pin": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/AdmissionPin" }]
        },
        "requirements": { "$ref": "#/$defs/AdmissionRequirements" }
      }
    },
    "AdmissionExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "reason", "detail", "scope", "observation"],
      "properties": {
        "route_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "$ref": "#/$defs/RoutingExclusionReason" },
        "detail": { "type": ["string", "null"], "maxLength": 240 },
        "scope": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Scope" }]
        },
        "observation": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "generation": { "type": "integer", "minimum": 0 },
                "journal_epoch": { "type": "integer", "minimum": 0 },
                "observed": { "type": "integer", "minimum": 0 },
                "max": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        }
      }
    },
    "AdmissionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id", "provider_account_id", "adapter", "model", "effort",
        "eligible", "exclusions", "capacity", "circuits"
      ],
      "properties": {
        "route_id": { "$ref": "#/$defs/RoutingIdentifier" },
        "provider_account_id": { "$ref": "#/$defs/RoutingIdentifier" },
        "adapter": { "$ref": "#/$defs/RoutingIdentifier" },
        "model": { "$ref": "#/$defs/RoutingIdentifier" },
        "effort": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/RoutingIdentifier" }]
        },
        "eligible": { "const": false },
        "exclusions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/AdmissionExclusion" }
        },
        "capacity": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["observed", "max"],
              "properties": {
                "observed": { "type": "integer", "minimum": 0 },
                "max": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "circuits": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/AdmissionCircuit" }
        }
      }
    },
    "AdmissionProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope", "journal_epoch", "observed_generation", "claim_generation",
        "attempt_id", "task_generation", "ownership_fence"
      ],
      "properties": {
        "scope": { "$ref": "#/$defs/Scope" },
        "journal_epoch": { "type": "integer", "minimum": 0 },
        "observed_generation": { "type": "integer", "minimum": 0 },
        "claim_generation": { "type": "integer", "minimum": 1 },
        "attempt_id": { "$ref": "#/$defs/RoutingIdentifier" },
        "task_generation": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "ownership_fence": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "AdmissionCircuit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope", "status", "generation", "journal_epoch", "state",
        "manual_block", "eligible_at", "probe_owner"
      ],
      "properties": {
        "scope": { "$ref": "#/$defs/Scope" },
        "status": { "type": "string", "enum": ["available", "unavailable"] },
        "generation": { "type": "integer", "minimum": 0 },
        "journal_epoch": { "type": "integer", "minimum": 0 },
        "state": { "type": "string", "enum": ["closed", "open", "half_open", "manual_block", "probe_owned", "health_state_unavailable"] },
        "manual_block": { "type": ["boolean", "null"] },
        "eligible_at": { "type": ["string", "null"], "format": "date-time" },
        "probe_owner": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/AdmissionProbe" }]
        }
      }
    },
    "AdmissionObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id", "decided_at", "task_generation", "policy_digest",
        "status", "reason", "next_action_owner", "policy", "selected_route",
        "candidates", "exclusions", "circuit_generations", "probe_requirements"
      ],
      "properties": {
        "decision_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "decided_at": { "type": "string", "format": "date-time" },
        "task_generation": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "policy_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": { "type": "string", "enum": ["capacity_saturated", "no_route"] },
        "reason": {
          "type": "string",
          "enum": ["capacity_saturated", "health_state_unavailable", "no_eligible_provider_route"]
        },
        "next_action_owner": {
          "type": "string",
          "enum": ["scheduler", "retry_authority", "operator"]
        },
        "policy": { "$ref": "#/$defs/AdmissionPolicy" },
        "selected_route": { "type": "null" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/AdmissionCandidate" }
        },
        "exclusions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/AdmissionExclusion" }
        },
        "circuit_generations": { "type": "array", "maxItems": 0 },
        "probe_requirements": { "type": "array", "maxItems": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "capacity_saturated" } } },
          "then": { "properties": { "reason": { "const": "capacity_saturated" } } },
          "else": {
            "properties": {
              "reason": {
                "enum": ["health_state_unavailable", "no_eligible_provider_route"]
              }
            }
          }
        }
      ]
    },
    "RecoveryTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant", "phase", "observed_marker_generation", "expected_marker_attrs",
        "canonical_task_folder", "expected_post_clear_progress_fingerprint",
        "dispatch_generation", "failure_origin", "next_eligible_at", "owner",
        "blocked_reason", "blocked_remediation", "policy_digest", "source_receipt",
        "admission_observation"
      ],
      "properties": {
        "variant": { "type": "string", "enum": ["marker", "admission_failure"] },
        "phase": {
          "type": "string",
          "enum": ["admitted", "cleared", "dispatched", "terminal"]
        },
        "observed_marker_generation": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_marker_attrs": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        },
        "canonical_task_folder": { "type": "string", "minLength": 1 },
        "expected_post_clear_progress_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dispatch_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "failure_origin": { "type": "string", "minLength": 1 },
        "next_eligible_at": { "type": ["string", "null"], "format": "date-time" },
        "owner": {
          "type": ["string", "null"],
          "enum": ["agent", "operator", "provider", "scheduler", "hive", "none", "unknown", null]
        },
        "blocked_reason": { "type": ["string", "null"] },
        "blocked_remediation": { "type": ["string", "null"] },
        "retry_count": { "type": "integer", "minimum": 0 },
        "provider_hint": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["retry_after", "display_only"],
          "properties": {
            "retry_after": { "type": "string", "minLength": 1 },
            "display_only": { "const": true }
          }
        },
        "attempt_id": { "type": ["string", "null"] },
        "terminal_outcome": { "type": ["string", "null"] },
        "terminal_at": { "type": ["string", "null"], "format": "date-time" },
        "policy_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "source_receipt": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/SourceReceipt" }]
        },
        "admission_observation": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/AdmissionObservation" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "variant": { "const": "marker" } } },
          "then": {
            "properties": {
              "observed_marker_generation": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "expected_marker_attrs": {
                "required": ["marker_id"],
                "properties": { "marker_id": { "type": "string", "minLength": 1 } }
              },
              "policy_digest": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "observed_marker_generation": { "type": "null" },
              "expected_marker_attrs": { "maxProperties": 0 },
              "policy_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "source_receipt": { "type": "null" },
              "admission_observation": { "$ref": "#/$defs/AdmissionObservation" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "variant": { "const": "marker" },
              "failure_origin": { "const": "provider_route_failed" }
            },
            "required": ["variant", "failure_origin"]
          },
          "then": {
            "properties": {
              "source_receipt": { "$ref": "#/$defs/SourceReceipt" }
            }
          }
        }
      ]
    }
  }
}
