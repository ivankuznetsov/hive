<?xml version="1.0" encoding="UTF-8"?>
<!-- hive-managed: job-schema-migration-retry/v1 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.hive-job-schema-migration</string>
  <key>ProgramArguments</key>
  <array>
    <string>@CLEAN_ENV@</string>
    <string>-i</string>
    <string>HOME=/var/root</string>
    <string>USER=root</string>
    <string>LOGNAME=root</string>
    <string>PATH=@SERVICE_PATH@</string>
    <string>LANG=C.UTF-8</string>
    <string>GEM_HOME=@GEM_HOME@</string>
    <string>GEM_PATH=@GEM_HOME@</string>
    <string>HIVE_INVOKED_BIN=@HIVE_BINARY@</string>
    <string>HIVE_ROOT_RUNTIME_LAUNCHER=1</string>
    <string>HIVE_ROOT_RUNTIME_MANIFEST=@MANIFEST@</string>
    <string>@RUBY@</string>
    <string>@SCRIPT@</string>
    <string>refactor-patrol-migrate-installed</string>
    <string>--all-users</string>
    <string>--resume</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
