<section class="narrow">
  <h1>Repos</h1>
  <form method="post" action="/repos">
    <%= csrf_tag %>
    <input name="url" placeholder="https://github.com/org/repo.git" required>
    <input name="name" placeholder="Optional name">
    <button type="submit">Clone and init</button>
  </form>
  <ul>
    <% @projects.each do |project| %>
      <li><%= h(project["name"]) %> <span><%= h(project["path"]) %></span></li>
    <% end %>
  </ul>
</section>
