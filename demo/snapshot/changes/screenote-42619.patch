diff --git a/.github/workflows/concurrency-qualification.yml b/.github/workflows/concurrency-qualification.yml
new file mode 100644
index 0000000..89f047d
--- /dev/null
+++ b/.github/workflows/concurrency-qualification.yml
@@ -0,0 +1,52 @@
+name: concurrency-qualification
+
+# The application and its portable contracts stay database-agnostic, so this
+# adapter-specific job lives outside ci.yml. It re-runs the image attachment
+# lifecycle suites against a server database whose row locks match hosted
+# production, proving lock ordering, atomic claim, and the aggregate races that
+# SQLite can only assert by outcome.
+on:
+  pull_request:
+  push:
+    branches: [main]
+
+permissions:
+  contents: read
+
+jobs:
+  image-attachment-lifecycle:
+    name: image-attachment-lifecycle
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    env:
+      RAILS_ENV: test
+      PARALLEL_WORKERS: "1"
+      # Fails the run if this job ever lands on SQLite instead of the server
+      # database whose locks it exists to exercise.
+      SCREENOTE_SERVER_DATABASE_QUALIFICATION: "1"
+      DATABASE_URL: postgresql://screenote@localhost:5432/screenote_test
+    services:
+      database:
+        image: postgres:17
+        env:
+          POSTGRES_USER: screenote
+          POSTGRES_DB: screenote_test
+          POSTGRES_HOST_AUTH_METHOD: trust
+        ports:
+          - 5432:5432
+        options: >-
+          --health-cmd "pg_isready -U screenote"
+          --health-interval 10s
+          --health-timeout 5s
+          --health-retries 10
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
+      - name: Install runtime packages
+        run: sudo apt-get update && sudo apt-get install --no-install-recommends -y libvips libpq-dev
+      - name: Set up Ruby
+        uses: ruby/setup-ruby@95ef2b042f9d7a56d8268cba8559e2842e2ad01b # v1 (2026-07-22)
+        with:
+          bundler-cache: true
+      - name: Exercise locks, constraints, and lifecycle races
+        run: script/release_test_matrix attachment-lifecycle
