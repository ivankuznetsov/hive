/.bundle/
/vendor/bundle/
/tmp/
*.gem
# Operator-local secrets (HIVE_TELEGRAM_BOT_TOKEN, etc). The bot loads
# ~/.config/hive/.env at startup; a repo-root .env is a common operator
# habit that must not leak into source.
/.env
!/test/e2e/sample-project/vendor/cache/*.gem
.byebug_history
/coverage/
/.qmd/
# Runtime registry of installed projects — machine-specific, not source.
# See config.example.yml for the schema.
/config.yml
# Per-developer Claude Code config and Codex CLI marker. Use the un-slashed
# form too so a symlink at /.claude (e.g. into a private overlay) is ignored.
/.claude
/.claude/
/.codex
# Internal planning artefacts (kept out of public repo). Both un-slashed and
# slashed forms so the patterns match either a directory or a symlink.
/docs/brainstorms
/docs/brainstorms/
/docs/plans
/docs/plans/
/raw/
# Per-skill scratchpad and run artefacts (e.g. .context/compound-engineering/
# ce-code-review/<run-id>/*.json from the /ce-code-review skill). These are
# locally-scoped runtime outputs, not source.
/.context
/.context/
# Local daemon runtime outputs.
/logs/
/.daemon.pid
/.daemon.pid.*
/daemon_dispatch_baselines.json
/daemon_dispatch_baselines.json.*
/test/e2e/runs/*
!/test/e2e/runs/.gitkeep
# Per-task hive runner state (markers, stages, logs, worktrees).
# Treated as runtime-only by GitOps#add_hive_state_to_master_gitignore!.
/.hive-state/
# Local daemon runtime artifacts.
/.daemon.pid
/daemon.pid
/logs/
.qmd/
/.llm-wiki/qmd-cache/
/.llm-wiki/post-commit-refresh.log
.worktrees/

# Telegram E2E headless client (Telethon) — local secrets/artifacts
test/e2e/tg/.venv/
test/e2e/tg/*.session
test/e2e/tg/*.session-journal
test/e2e/tg/.code_hash
**/__pycache__/

# Babysitter dry-run artifacts. The PR-repair daemon's preview mode
# (lib/hive/babysitter/dry_run_env.rb) writes a skip log + overlay-bin shims
# into the worktree; the stubs also fall back to a worktree-relative skip log
# when HIVE_BABYSITTER_DRY_RUN_LOG is unset. These are transient and must never
# be committed — otherwise a stage-exit CleanExit `git add -A` stages them and
# the auto-commit scope check rejects them as out-of-scope residue
# (:error reason=ensure_clean_on_exit_failed).
.babysitter-dry-run-skipped.log
.babysitter-dry-run-plan.md
.hive-babysitter-dry-run-bin/
