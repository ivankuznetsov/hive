{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:status:v5",
  "title": "hive status output (v5)",
  "oneOf": [
    { "$ref": "#/$defs/SuccessPayload" },
    { "$ref": "#/$defs/ErrorPayload" }
  ],
  "$defs": {
    "SuccessPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "ok", "generated_at", "projects"],
      "properties": {
        "schema": { "const": "hive-status" },
        "schema_version": { "const": 5 },
        "ok": { "const": true },
        "generated_at": { "type": "string", "format": "date-time" },
        "projects": { "type": "array", "items": { "$ref": "#/$defs/Project" } }
      }
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "ok", "error_class", "error_kind", "exit_code", "message"],
      "properties": {
        "schema": { "const": "hive-status" },
        "schema_version": { "const": 5 },
        "ok": { "const": false },
        "error_class": { "type": "string" },
        "error_kind": { "type": "string", "enum": ["config", "internal", "error"] },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "message": { "type": "string" },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["project", "stage", "folder"],
            "properties": {
              "project": { "type": "string" },
              "stage": { "type": "string" },
              "folder": { "type": "string" }
            }
          }
        },
        "id": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "hive_state_path", "tasks"],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "hive_state_path": { "type": "string" },
        "error": { "type": "string", "enum": ["missing_project_path", "not_initialised"] },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/Task" } },
        "legacy_stage_dirs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage_dir", "task_count"],
            "properties": {
              "stage_dir": { "type": "string" },
              "task_count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "legacy_migrate_command": { "type": ["string", "null"] }
      }
    },
    "AdmissionError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "offending_ref", "safe_correction"],
      "properties": {
        "reason_code": {
          "type": "string",
          "enum": [
            "dependency_metadata_unreadable",
            "dependency_metadata_invalid",
            "dependency_reference_invalid",
            "dependency_task_missing",
            "dependency_self_reference",
            "dependency_cycle",
            "dependency_gate_unknown",
            "dependency_gate_unreachable",
            "dependency_project_unknown",
            "dependency_repository_identity_missing",
            "dependency_repository_mismatch",
            "plan_dependency_invalid",
            "plan_dependency_missing",
            "plan_dependency_mismatch",
            "dependency_validation_failed"
          ]
        },
        "offending_ref": { "type": "string" },
        "safe_correction": { "type": "string" }
      }
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage", "slug", "id", "display_name", "depends_on", "blocked_by",
        "dependency_stage", "blocked", "admission_error", "folder", "state_file",
        "worktree_path", "pr_url", "marker", "attrs", "mtime", "folder_mtime",
        "age_seconds", "claude_pid", "claude_pid_alive", "live_task_lock",
        "unanswered_questions", "action", "action_label", "suggested_command",
        "next_action", "diagnostic"
      ],
      "properties": {
        "stage": { "type": "string", "pattern": "^[0-9]+-[a-z0-9][a-z0-9-]*$" },
        "slug": { "type": "string" },
        "id": { "type": ["integer", "null"] },
        "display_name": { "type": ["string", "null"] },
        "workflow": { "type": ["string", "null"] },
        "depends_on": { "type": ["string", "null"] },
        "blocked_by": { "type": ["string", "null"] },
        "dependency_stage": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+-[a-z0-9][a-z0-9-]*$"
        },
        "blocked": { "type": "boolean" },
        "admission_error": {
          "oneOf": [
            { "$ref": "#/$defs/AdmissionError" },
            { "type": "null" }
          ]
        },
        "folder": { "type": "string" },
        "state_file": { "type": "string" },
        "worktree_path": { "type": ["string", "null"] },
        "pr_url": { "type": ["string", "null"] },
        "marker": {
          "type": "string",
          "enum": [
            "none", "waiting", "complete", "agent_working", "manual_steering",
            "execute_waiting", "execute_complete", "execute_stale", "review_working",
            "review_waiting", "review_ci_stale", "review_stale", "review_complete",
            "review_error", "error"
          ]
        },
        "attrs": { "type": "object", "additionalProperties": true },
        "held": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "provider", "retry_after"],
          "properties": {
            "reason": { "const": "quota" },
            "provider": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]+$" },
            "retry_after": { "type": ["string", "null"], "format": "date-time" }
          }
        },
        "mtime": { "type": "string", "format": "date-time" },
        "folder_mtime": { "type": "string", "format": "date-time" },
        "age_seconds": { "type": "integer", "minimum": 0 },
        "claude_pid": { "type": ["integer", "null"], "minimum": 1 },
        "claude_pid_alive": { "type": ["boolean", "null"] },
        "live_task_lock": { "type": "boolean" },
        "unanswered_questions": { "type": "integer", "minimum": 0 },
        "action": {
          "type": "string",
          "enum": [
            "ready_to_brainstorm", "ready_to_plan", "ready_to_develop",
            "ready_to_open_pr", "ready_for_review", "ready_to_artifacts",
            "ready_to_finalize", "ready_to_archive", "ready_to_advance",
            "ready_to_run", "review_parked", "needs_input", "recover_execute",
            "recover_review", "agent_running", "archived", "manual_steering",
            "error", "admission_error"
          ]
        },
        "action_label": { "type": "string" },
        "suggested_command": { "type": ["string", "null"] },
        "next_action": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["edit", "mv", "approve", "run", "recover_stale", "no_op"]
            }
          }
        },
        "diagnostic": {
          "oneOf": [
            { "$ref": "#/$defs/Diagnostic" },
            { "type": "null" }
          ]
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary", "detail", "source", "source_path", "artifact_paths",
        "generated_by", "marker_signature", "suggested_next_action", "updated_at"
      ],
      "properties": {
        "summary": { "type": "string", "maxLength": 120 },
        "detail": { "type": "string", "maxLength": 4000 },
        "source": { "type": "string", "enum": ["marker", "artifact"] },
        "source_path": { "type": ["string", "null"] },
        "artifact_paths": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
        "generated_by": { "type": "string", "enum": ["local", "claude", "codex", "pi", "grok"] },
        "marker_signature": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "suggested_next_action": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "command"],
              "properties": {
                "kind": { "type": "string", "enum": ["retry", "clear_marker", "manual_fix"] },
                "command": { "type": ["string", "null"] }
              }
            },
            { "type": "null" }
          ]
        },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
