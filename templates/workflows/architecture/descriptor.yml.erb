<%# Architecture planning workflow: idea capture -> draft -> council review -> final architecture document. -%>
id: "<%= id %>"
# To publish this workflow, uncomment and complete this block:
# metadata:
#   version: 1.0.0
#   author: Your Name
#   description: What this workflow does
#   minimum_hive_version: <%= Hive::VERSION %>
#   # readme: ./<%= id %>/README.source.md
#   # assets: [./<%= id %>/assets/example.txt]
stages:
  - name: inbox
    kind: terminal
    state_file: idea.md
  - name: draft
    kind: agent
    state_file: draft.md
    instruction: ./<%= id %>/draft.md
    model: opus
    effort: high
  - name: review
    kind: council
    state_file: review.md
    input: draft.md
    council:
      quorum: 2
      max_rounds: 3
      exit_rule: consensus
      triage_output: reviews/triage.md
      revise:
        agent: claude
        instruction: ./<%= id %>/revise.md
    reviewers:
      - name: claude-doc
        agent: claude
        prompt: Review the architecture draft for clarity, feasibility, risks, and missing decisions.
        output_basename: claude-doc
      - name: codex-doc
        agent: codex
        prompt: Review the architecture draft for implementation risks, testability, and unresolved assumptions.
        output_basename: codex-doc
  - name: architecture
    kind: agent
    state_file: architecture.md
    deliverable: architecture.md
    instruction: ./<%= id %>/architecture.md
    model: opus
    effort: high
