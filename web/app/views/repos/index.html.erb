<% content_for(:title, "#{web_product_name} — repos") %>
<h1>Repos</h1>

<h2>Registered</h2>
<% if @projects.empty? %>
  <div class="empty-state">
    <p>No repositories registered yet.</p>
    <p class="hint">Pick one of your GitHub repositories below, or clone by URL.</p>
  </div>
<% else %>
  <div class="repo-list">
    <% @projects.each do |project| %>
      <article class="repo-row">
        <div>
          <span class="repo-name"><%= project["name"] %></span>
          <span class="repo-desc"><%= project["path"] %></span>
        </div>
        <span class="repo-actions">
          <%= link_to "Settings", new_repo_path(project: project["name"]), class: "btn btn-ghost btn-sm" %>
          <span class="tag tag-registered">registered</span>
        </span>
      </article>
    <% end %>
  </div>
<% end %>

<h2>Clone by URL</h2>
<%# GET to the setup questionnaire — the same questions `hive init` asks. %>
<%= form_with url: new_repo_path, method: :get, class: "repo-form" do |f| %>
  <%= f.text_field :url, placeholder: "https://github.com/org/repo or org/repo",
        required: true, aria: { label: "Repository URL" } %>
  <%= f.text_field :name, placeholder: "Name (optional)", aria: { label: "Local name" } %>
  <%= f.submit "Set up…" %>
<% end %>

<h2>Your GitHub repositories</h2>
<% if @github_error %>
  <div class="flash flash-alert"><%= @github_error %></div>
<% elsif @github_repos.nil? %>
  <% reconnecting = current_login.present? %>
  <p class="muted">
    <%= reconnecting ? "Reconnect GitHub to browse your repositories." : "Connect GitHub to browse your repositories." %>
    Clone by URL remains available without a GitHub connection.
  </p>
  <%= link_to reconnecting ? "Reconnect GitHub" : "Connect GitHub", login_path, class: "btn btn-secondary btn-sm" %>
<% elsif @github_repos.empty? %>
  <div class="empty-state"><p>No repositories on this GitHub account.</p></div>
<% else %>
  <div class="repo-list">
    <% @github_repos.each do |repo| %>
      <article class="repo-row">
        <div>
          <span class="repo-name"><%= repo["full_name"] %></span>
          <% if repo["description"].present? %>
            <span class="repo-desc"><%= repo["description"] %></span>
          <% end %>
          <span class="repo-tags">
            <% if repo["private"] %><span class="tag tag-private">private</span><% end %>
            <% if repo["language"].present? %><span class="tag"><%= repo["language"] %></span><% end %>
            <% if repo["pushed_at"].present? %>
              <span>pushed <%= relative_age(Time.now - Time.iso8601(repo["pushed_at"])) %></span>
            <% end %>
          </span>
        </div>
        <% if repo["registered"] %>
          <span class="tag tag-registered">registered</span>
        <% else %>
          <%= link_to "Add to hive", new_repo_path(url: repo["full_name"]), class: "btn btn-secondary btn-sm" %>
        <% end %>
      </article>
    <% end %>
  </div>
<% end %>
