#!/usr/bin/env ruby

require "fileutils"
require "English"
require "optparse"

SAFE_SCENARIO_BASENAME = /\A[A-Za-z0-9][A-Za-z0-9_-]{0,63}\z/

root = File.expand_path("..", __dir__)
options = {
  report: File.join(root, "tmp", "hive-eval-report.json"),
  scenario: nil,
  no_judge: false
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/hive-eval [--scenario NAME] [--report PATH] [--no-judge]"
  opts.on("--scenario NAME", "Run one scenario by basename, e.g. s1_status") do |value|
    options[:scenario] = value
  end
  opts.on("--report PATH", "Write JSON report to PATH") do |value|
    options[:report] = value
  end
  opts.on("--no-judge", "Skip Codex judge assertions") do
    options[:no_judge] = true
  end
end

begin
  remaining = parser.parse!
rescue OptionParser::ParseError => e
  warn "hive-eval: #{e.message}"
  warn parser
  exit 64
end

unless remaining.empty?
  warn "hive-eval: unexpected argument(s): #{remaining.join(" ")}"
  warn parser
  exit 64
end

def scenario_path(root, value)
  return nil if value.nil?
  if value.include?("/") || value.include?("\\")
    raise ArgumentError,
          "scenario must be a basename under test/eval/scenarios; scenario must be a safe basename matching " \
          "#{SAFE_SCENARIO_BASENAME.source} (got #{value.inspect})"
  end

  basename = File.basename(value, ".rb").sub(/_test\z/, "")
  unless SAFE_SCENARIO_BASENAME.match?(basename)
    raise ArgumentError,
          "scenario must be a safe basename matching #{SAFE_SCENARIO_BASENAME.source} (got #{value.inspect})"
  end

  File.join(scenario_root(root), "#{basename}_test.rb")
end

# The scenarios directory. HIVE_EVAL_SCENARIO_ROOT lets tests point at a
# throwaway tmpdir so a fixture scenario never has to be written into the
# real source tree (a SIGKILL between write and cleanup would otherwise
# leak a `*_test.rb` that a later full eval run would execute). The
# basename validation in `scenario_path` still applies, so this override
# cannot be used for path traversal — it only relocates the lookup root.
def scenario_root(root)
  env_root = ENV["HIVE_EVAL_SCENARIO_ROOT"].to_s
  env_root.empty? ? File.join(root, "test", "eval", "scenarios") : env_root
end

env = {
  "HIVE_EVAL_REPORT" => File.expand_path(options.fetch(:report), root),
  "HIVE_EVAL_SCENARIOS_ONLY" => "1",
  "TEST" => nil
}
env["HIVE_EVAL_NO_JUDGE"] = "1" if options[:no_judge]

begin
  path = scenario_path(root, options[:scenario])
rescue ArgumentError => e
  warn "hive-eval: #{e.message}"
  exit 64
end

if path
  unless File.exist?(path)
    warn "hive-eval: scenario not found: #{path}"
    exit 64
  end
  env["TEST"] = path
end

FileUtils.mkdir_p(File.dirname(env.fetch("HIVE_EVAL_REPORT")))
ok = system(env, "bundle", "exec", "rake", "test:eval", chdir: root)
exit($CHILD_STATUS&.exitstatus || (ok ? 0 : 1))
