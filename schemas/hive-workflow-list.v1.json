{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-workflow-list.v1.json",
  "title": "hive workflow list output (v1)",
  "oneOf": [
    { "$ref": "#/$defs/Success" },
    { "$ref": "#/$defs/Error" }
  ],
  "$defs": {
    "Row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha", "source", "update_available", "integrity", "permissions"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": ["string", "null"] },
        "sha": { "type": "string" },
        "source": { "const": "github.com/ivankuznetsov/honeycomb" },
        "update_available": { "type": ["boolean", "null"] },
        "integrity": { "type": ["string", "null"], "enum": ["clean", "dirty", "missing", "extra_file", null] },
        "permissions": { "type": ["string", "null"] }
      }
    },
    "Success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "ok", "mode", "workflows"],
      "properties": {
        "schema": { "const": "hive-workflow-list" },
        "schema_version": { "const": 1 },
        "ok": { "const": true },
        "mode": { "enum": ["local", "remote", "outdated"] },
        "workflows": { "type": "array", "items": { "$ref": "#/$defs/Row" } }
      }
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "ok", "error_class", "error_kind", "exit_code", "message"],
      "properties": {
        "schema": { "const": "hive-workflow-list" },
        "schema_version": { "const": 1 },
        "ok": { "const": false },
        "error_class": { "type": "string" },
        "error_kind": { "enum": ["usage", "config", "git", "concurrent_run", "network", "integrity", "collision", "approval", "partial", "error"] },
        "exit_code": { "type": "integer", "enum": [1, 64, 69, 70, 75, 78] },
        "message": { "type": "string" },
        "value": { "type": "string" },
        "expected": { "type": "array", "items": { "type": "string" } },
        "holder": { "type": "object", "additionalProperties": true },
        "lock_path": { "type": "string" }
      }
    }
  }
}
