<% content_for(:title, "#{web_product_name} — agents") %>
<h1>Agents</h1>
<p class="muted">Authenticate the agents the pipeline runs. Credentials persist in Hive's data home on this machine.</p>

<div class="agent-cards">
  <% @statuses.each do |agent, status| %>
    <% logged_in = status["logged_in"] %>
    <div class="card agent-card">
      <h3><%= agent %></h3>
      <p class="agent-state">
        <span class="status-dot <%= logged_in ? "status-dot-running" : "status-dot-idle" %>"></span>
        <%= logged_in ? "Logged in" : "Not logged in" %>
      </p>
      <% if %w[claude codex grok gh].include?(agent.to_s) %>
        <%= button_to logged_in ? "Log in again" : "Start login",
              agent_login_path(agent), class: logged_in ? "btn-ghost btn-sm" : "btn-secondary btn-sm",
              data: { turbo_submits_with: "Starting…" } %>
      <% else %>
        <p class="faint">Uses the token form below.</p>
      <% end %>
    </div>
  <% end %>
</div>

<% if defined?(@login_session) && @login_session %>
  <%# Keep polling while there is no URL yet, OR for an operator-ward
      (poll-type) agent whose CLI is still running — the operator enters the
      code at the provider and we refresh until the child exits. A paste-back
      agent stops polling once its URL is shown (it waits on the form). The
      poll controller reload()s the frame's OWN src, so a src is required
      whenever polling. %>
  <% poll_login = (defined?(@poll_login) && @poll_login) %>
  <% polling = !@login_session.done && (@session_url.nil? || poll_login) %>
  <%= turbo_frame_tag "agent-login",
        src: (polling ? agent_login_status_path(@login_session.agent, @login_session.id) : nil),
        data: ({ controller: "poll", poll_interval_value: 2000 } if polling) do %>
    <div class="card">
      <h2><%= @login_session.agent %> login</h2>
      <% if @login_session.done %>
        <% if @login_session.error %>
          <p>Login failed: <%= @login_session.error %></p>
        <% else %>
          <p><%= @login_session.agent %> is now logged in.</p>
        <% end %>
        <p><%= link_to "Back to agents", agents_path %></p>
      <% elsif @session_url %>
        <p>Open the provider page and authorize:</p>
        <p><%= link_to @session_url, @session_url, target: "_blank", rel: "noopener" %></p>
        <% if poll_login %>
          <p class="muted">Enter the one-time code shown in the CLI output below at the provider page. This page updates automatically when login completes.</p>
        <% else %>
          <%= form_with url: agent_login_complete_path(@login_session.agent, @login_session.id), class: "form-grid" do |f| %>
            <div class="form-row">
              <%= f.label :code, "Paste the code (or full callback URL) the provider returned" %>
              <%= f.text_field :code, required: true %>
            </div>
            <p><%= f.submit "Complete login", data: { turbo_submits_with: "Completing…" } %></p>
          <% end %>
        <% end %>
      <% else %>
        <p class="muted">Waiting for the login URL from the CLI…</p>
      <% end %>
      <% if @session_output.present? %>
        <details class="login-output">
          <summary class="muted">CLI output</summary>
          <pre><%= @session_output %></pre>
        </details>
      <% end %>
    </div>
  <% end %>
<% end %>

<section class="managed-skills" aria-labelledby="managed-skills-heading">
  <h2 id="managed-skills-heading">Managed skills</h2>
  <p class="muted">Check that each configured pipeline skill resolves through the agent that will run it. Hive checks one project at a time because native CLI inventory can take a few seconds.</p>

  <% if @projects.empty? %>
    <div class="empty-state">
      <p>Add a repository before checking its agent skills.</p>
      <p><%= link_to "Add a repository", repos_path %></p>
    </div>
  <% else %>
    <%= form_with url: agents_path, method: :get, class: "repo-form skill-check-form" do |f| %>
      <%= select_tag :project,
            options_for_select(@projects.map { |project| [project.fetch("name"), project.fetch("name")] },
                               @selected_project&.fetch("name", nil)),
            aria: { label: "Project to check" } %>
      <%= f.submit "Check skill health", data: { turbo_submits_with: "Checking…" } %>
    <% end %>
  <% end %>

  <% if @selected_project && @skill_health %>
    <% healthy_count = @skill_health.count { |row| row["health"] == "healthy" } %>
    <% attention_count = @skill_health.count { |row| %w[missing stale incompatible conflicting].include?(row["health"]) } %>
    <% unavailable_count = @skill_health.count { |row| row["health"] == "unavailable" } %>
    <% repairable = @skill_health.any? { |row| %w[missing stale].include?(row["health"]) && row["managed"] } %>

    <div class="skill-health-summary" role="status">
      <strong><%= @selected_project.fetch("name") %></strong>
      <span><%= healthy_count %> ready</span>
      <span><%= attention_count %> need attention</span>
      <% if unavailable_count.positive? %><span><%= unavailable_count %> unavailable</span><% end %>
    </div>

    <div class="skill-health-list">
      <% @skill_health.each do |row| %>
        <article class="skill-health-row" data-skill-health="<%= row["health"] %>">
          <div class="skill-health-title">
            <strong><%= row["capability"].presence || "custom skill" %></strong>
            <span class="tag tag-health-<%= row["health"] %>"><%= row["health"].to_s.humanize %></span>
          </div>
          <p class="skill-health-meta"><%= row["agent"] %> · <%= Array(row["surfaces"]).join(", ") %></p>
          <p><%= row["explanation"] %></p>
          <% unless row["health"] == "healthy" %>
            <p class="faint"><code><%= row["remediation"] %></code></p>
          <% end %>
        </article>
      <% end %>
    </div>

    <% if repairable %>
      <div class="skill-repair">
        <%= button_to "Repair safe changes", agent_skills_repair_path,
              params: { project: @selected_project.fetch("name"), consent: "repair_managed_skills" },
              class: "btn-secondary",
              data: {
                turbo_confirm: "Install or update Hive-managed skills for #{@selected_project.fetch('name')}?",
                turbo_submits_with: "Repairing…"
              } %>
        <p class="muted">Hive installs missing or stale managed packages and rechecks the result. Conflicting and custom skills stay untouched.</p>
      </div>
    <% end %>
  <% end %>
</section>

<h2>Pi token</h2>
<%= form_with url: agent_pi_token_path, class: "form-grid" do |f| %>
  <div class="form-row">
    <%= f.label :token_json, "Paste the pi auth JSON" %>
    <%= f.text_area :token_json, placeholder: '{"provider":"…"}', required: true %>
  </div>
  <p><%= f.submit "Save token", data: { turbo_submits_with: "Saving…" } %></p>
<% end %>
