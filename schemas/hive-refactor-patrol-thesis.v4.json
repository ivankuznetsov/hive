{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-refactor-patrol-thesis.v4.json",
  "title": "hive refactor patrol thesis record (v4)",
  "description": "Durable scoreless refactor thesis with anchored evidence, explicit architecture effects, and a fix/discuss/dismiss route.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "feature_id",
    "feature",
    "problem",
    "cost",
    "evidence",
    "proposed_refactor",
    "feature_boundary",
    "architecture_effects",
    "route",
    "confidence",
    "risk",
    "required_validation",
    "admissible",
    "admissibility_reason",
    "follow_up_approval_state",
    "fingerprint"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "feature_id": {
      "type": "string"
    },
    "feature": {
      "type": "string"
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "cost": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    },
    "proposed_refactor": {
      "type": "string",
      "minLength": 1
    },
    "feature_boundary": {
      "$ref": "#/$defs/FeatureBoundary"
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "risk": {
      "$ref": "#/$defs/Risk"
    },
    "required_validation": {
      "$ref": "#/$defs/RequiredValidation"
    },
    "admissible": {
      "type": "boolean"
    },
    "admissibility_reason": {
      "type": "string"
    },
    "follow_up_approval_state": {
      "enum": [
        "pending",
        "not_requested",
        "approved",
        "rejected"
      ]
    },
    "fingerprint": {
      "type": "string"
    },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "architecture_effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "route": {
      "enum": [
        "fix",
        "discuss",
        "dismiss"
      ]
    }
  },
  "$defs": {
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "snippet": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "FeatureBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owned_files",
        "entrypoints"
      ],
      "properties": {
        "owned_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caps",
        "public_api_impact",
        "public_api_details",
        "cross_feature_impact",
        "cross_feature_details",
        "flags"
      ],
      "properties": {
        "caps": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "single_feature"
          ],
          "properties": {
            "single_feature": {
              "type": "boolean"
            }
          }
        },
        "public_api_impact": {
          "type": "boolean"
        },
        "public_api_details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cross_feature_impact": {
          "type": "boolean"
        },
        "cross_feature_details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "advisories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "RequiredValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "characterization_first",
        "notes"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "characterization_first": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
