{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-workflow-publish.v2.json",
  "title": "hive workflow publish output v2",
  "oneOf": [
    {"$ref": "#/$defs/ValidatedPayload"},
    {"$ref": "#/$defs/CurrentLifecyclePayload"},
    {"$ref": "#/$defs/CachedLifecyclePayload"},
    {"$ref": "#/$defs/ErrorPayload"}
  ],
  "$defs": {
    "Digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "message"],
      "properties": {
        "rule_id": {"type": "string"},
        "path": {"type": "string"},
        "message": {"type": "string"},
        "detail": {"type": "string"},
        "severity": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "review_required": {"type": "boolean"},
        "suppression_allowed": {"type": "boolean"},
        "fingerprint": {"$ref": "#/$defs/Digest"},
        "suppression_requested": {"type": "boolean"}
      }
    },
    "SuccessProperties": {
      "type": "object",
      "properties": {
        "schema": {"const": "hive-workflow-publish"},
        "schema_version": {"const": 2},
        "ok": {"const": true},
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"},
        "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
        "package_digest": {"$ref": "#/$defs/Digest"},
        "release_digest": {"$ref": "#/$defs/Digest"},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/Warning"}}
      }
    },
    "ValidatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "ok", "name", "version", "package_digest", "release_digest", "warnings", "state", "freshness", "validated_at"],
      "properties": {
        "schema": {"const": "hive-workflow-publish"},
        "schema_version": {"const": 2},
        "ok": {"const": true},
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"},
        "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
        "package_digest": {"$ref": "#/$defs/Digest"},
        "release_digest": {"$ref": "#/$defs/Digest"},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/Warning"}},
        "state": {"const": "validated"},
        "freshness": {"const": "not_checked"},
        "validated_at": {"type": "string", "format": "date-time"}
      }
    },
    "CurrentLifecyclePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "ok", "name", "version", "package_digest", "release_digest", "warnings", "state", "freshness", "observed_at", "pr_url"],
      "properties": {
        "schema": {"const": "hive-workflow-publish"},
        "schema_version": {"const": 2},
        "ok": {"const": true},
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"},
        "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
        "package_digest": {"$ref": "#/$defs/Digest"},
        "release_digest": {"$ref": "#/$defs/Digest"},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/Warning"}},
        "state": {"enum": ["pending_review", "merged_pending_listing", "listed", "closed_unmerged"]},
        "freshness": {"const": "current"},
        "observed_at": {"type": "string", "format": "date-time"},
        "pr_url": {"type": ["string", "null"]}
      }
    },
    "CachedLifecyclePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "ok", "name", "version", "package_digest", "release_digest", "warnings", "state", "freshness", "observed_at", "pr_url"],
      "properties": {
        "schema": {"const": "hive-workflow-publish"},
        "schema_version": {"const": 2},
        "ok": {"const": true},
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"},
        "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
        "package_digest": {"$ref": "#/$defs/Digest"},
        "release_digest": {"$ref": "#/$defs/Digest"},
        "warnings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Warning"}},
        "state": {"enum": ["pending_review", "merged_pending_listing", "listed", "closed_unmerged"]},
        "freshness": {"const": "cached"},
        "observed_at": {"type": "string", "format": "date-time"},
        "pr_url": {"type": ["string", "null"]}
      }
    },
    "ErrorPayload": {
      "oneOf": [
        {"$ref": "#/$defs/ValidationErrorPayload"},
        {"$ref": "#/$defs/ConfigurationErrorPayload"},
        {"$ref": "#/$defs/OfflineErrorPayload"},
        {"$ref": "#/$defs/ImmutableConflictErrorPayload"},
        {"$ref": "#/$defs/RemoteAmbiguousErrorPayload"},
        {"$ref": "#/$defs/InternalErrorPayload"}
      ]
    },
    "ErrorBase": {
      "type": "object",
      "required": ["schema", "schema_version", "ok", "error_class", "error_kind", "exit_code", "message", "retryable"],
      "properties": {
        "schema": {"const": "hive-workflow-publish"},
        "schema_version": {"const": 2},
        "ok": {"const": false},
        "error_class": {"type": "string", "minLength": 1},
        "error_kind": {"type": "string"},
        "exit_code": {"type": "integer"},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"},
        "package_digest": {"$ref": "#/$defs/Digest"},
        "release_digest": {"$ref": "#/$defs/Digest"},
        "last_completed_step": {"enum": ["validated", "prepared", "fork_create_intent", "fork_verified", "push_intent", "pushed", "pr_create_intent", "pr_verified"]},
        "last_observed_state": {"enum": ["pending_review", "merged_pending_listing", "listed", "closed_unmerged"]},
        "pr_url": {"type": "string"}
      }
    },
    "ValidationErrorPayload": {
      "allOf": [
        {"$ref": "#/$defs/ErrorBase"},
        {
          "properties": {
            "error_kind": {"const": "validation"},
            "exit_code": {"const": 64},
            "retryable": {"const": false}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ConfigurationErrorPayload": {
      "allOf": [
        {"$ref": "#/$defs/ErrorBase"},
        {
          "properties": {
            "error_kind": {"enum": ["authentication", "configuration"]},
            "exit_code": {"const": 78},
            "retryable": {"const": false}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "OfflineErrorPayload": {
      "allOf": [
        {"$ref": "#/$defs/ErrorBase"},
        {
          "required": ["package_digest", "release_digest", "last_completed_step"],
          "properties": {
            "error_kind": {"const": "offline"},
            "exit_code": {"const": 69},
            "retryable": {"const": true}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ImmutableConflictErrorPayload": {
      "allOf": [
        {"$ref": "#/$defs/ErrorBase"},
        {
          "properties": {
            "error_kind": {"const": "immutable_conflict"},
            "exit_code": {"const": 1},
            "retryable": {"const": false}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "RemoteAmbiguousErrorPayload": {
      "allOf": [
        {"$ref": "#/$defs/ErrorBase"},
        {
          "required": ["package_digest", "release_digest", "last_completed_step"],
          "properties": {
            "error_kind": {"const": "remote_ambiguous"},
            "exit_code": {"const": 75},
            "retryable": {"const": true}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "InternalErrorPayload": {
      "allOf": [
        {"$ref": "#/$defs/ErrorBase"},
        {
          "properties": {
            "error_kind": {"const": "internal"},
            "exit_code": {"const": 70},
            "retryable": {"const": false}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
