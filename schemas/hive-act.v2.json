{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:act:v2",
  "title": "hive act output (v2)",
  "oneOf": [
    { "$ref": "#/$defs/SuccessPayload" },
    { "$ref": "#/$defs/ErrorPayload" }
  ],
  "$defs": {
    "SuccessPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "schema_version", "ok", "action_id", "target",
        "observation_token", "result"
      ],
      "properties": {
        "schema": { "const": "hive-act" },
        "schema_version": { "const": 2 },
        "ok": { "const": true },
        "action_id": { "type": "string", "enum": ["workflow.advance", "workflow.retry"] },
        "target": { "type": "string", "pattern": "^.+:.+$" },
        "observation_token": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_state", "stage", "marker"],
          "properties": {
            "task_state": { "type": "string" },
            "stage": { "type": ["string", "null"] },
            "marker": { "type": ["string", "null"] },
            "recovery": { "$ref": "#/$defs/Recovery" }
          }
        }
      }
    },
    "Recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "request_id", "attempt_id", "phase", "failure_origin",
        "next_eligible_at", "owner", "reason", "remediation", "retry_count",
        "provider_hint", "terminal_outcome", "terminal_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["queued", "cooldown", "running", "blocked", "terminal", "unavailable"]
        },
        "request_id": { "type": ["string", "null"] },
        "attempt_id": { "type": ["string", "null"] },
        "phase": {
          "type": ["string", "null"],
          "enum": ["admitted", "cleared", "dispatched", "terminal", null]
        },
        "failure_origin": { "type": ["string", "null"] },
        "next_eligible_at": { "type": ["string", "null"], "format": "date-time" },
        "owner": {
          "type": ["string", "null"],
          "enum": ["agent", "operator", "provider", "scheduler", "hive", "none", "unknown", null]
        },
        "reason": { "type": ["string", "null"] },
        "remediation": { "type": ["string", "null"] },
        "retry_count": { "type": ["integer", "null"], "minimum": 0 },
        "terminal_outcome": { "type": ["string", "null"] },
        "terminal_at": { "type": ["string", "null"], "format": "date-time" },
        "provider_hint": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["retry_after", "display_only"],
              "properties": {
                "retry_after": { "type": "string" },
                "display_only": { "const": true }
              }
            }
          ]
        }
      }
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "schema_version", "ok", "error_class", "error_kind",
        "exit_code", "message", "action_id", "target"
      ],
      "properties": {
        "schema": { "const": "hive-act" },
        "schema_version": { "const": 2 },
        "ok": { "const": false },
        "error_class": { "type": "string" },
        "error_kind": {
          "type": "string",
          "enum": [
            "usage", "stale_observation", "ambiguous_target", "concurrent_run",
            "dependency_wait", "admission_error", "config", "internal", "error"
          ]
        },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "message": { "type": "string" },
        "action_id": { "type": "string" },
        "target": { "type": "string" },
        "candidates": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "current_stage": { "type": "string" },
        "target_stage": { "type": "string" },
        "reason_code": { "type": "string" },
        "offending_ref": { "type": "string" },
        "safe_correction": { "type": "string" },
        "holder": { "type": ["object", "null"], "additionalProperties": true },
        "lock_path": { "type": "string" }
      }
    }
  }
}
