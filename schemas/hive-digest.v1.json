{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-digest.v1.json",
  "title": "Hive daily activity digest read envelope (v1)",
  "oneOf": [
    { "$ref": "#/$defs/Success" },
    { "$ref": "#/$defs/Error" }
  ],
  "$defs": {
    "Success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "schema_version", "ok", "reader_status", "record_id",
        "interval_id", "local_date", "sequence", "time_zone", "starts_at",
        "ends_at", "duration_seconds", "boundary_kind", "cutover", "lifecycle",
        "closed_at", "completeness", "content", "last_materialized_at", "stale",
        "selected_project", "projects", "attention", "items", "gaps",
        "amendments", "previous_date", "next_date", "coverage_started_at",
        "precoverage", "pruned_at", "web_url"
      ],
      "properties": {
        "schema": { "const": "hive-digest" },
        "schema_version": { "const": 1 },
        "ok": { "const": true },
        "reader_status": { "enum": ["ok", "missing", "pruned"] },
        "record_id": { "type": ["string", "null"] },
        "interval_id": { "type": ["string", "null"] },
        "local_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "sequence": { "type": ["integer", "null"], "minimum": 1 },
        "time_zone": { "type": ["string", "null"] },
        "starts_at": { "type": ["string", "null"], "format": "date-time" },
        "ends_at": { "type": ["string", "null"], "format": "date-time" },
        "duration_seconds": { "type": ["integer", "null"], "minimum": 1 },
        "boundary_kind": { "enum": ["calendar_day", "zone_cutover", null] },
        "cutover": { "anyOf": [{ "$ref": "#/$defs/Cutover" }, { "type": "null" }] },
        "lifecycle": { "enum": ["open", "closed", "missing", "pruned"] },
        "closed_at": { "type": ["string", "null"], "format": "date-time" },
        "completeness": { "enum": ["complete", "partial", "unknown"] },
        "content": { "enum": ["empty", "non_empty", "unknown"] },
        "last_materialized_at": { "type": ["string", "null"], "format": "date-time" },
        "stale": { "type": "boolean" },
        "selected_project": { "type": ["string", "null"] },
        "projects": { "type": "array", "items": { "$ref": "#/$defs/Project" } },
        "attention": { "type": "array", "items": { "$ref": "#/$defs/Attention" } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/Fact" } },
        "gaps": { "type": "array", "items": { "$ref": "#/$defs/Gap" } },
        "amendments": { "type": "array", "items": { "$ref": "#/$defs/Amendment" } },
        "previous_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "next_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "coverage_started_at": { "type": ["string", "null"], "format": "date-time" },
        "precoverage": { "type": "boolean" },
        "pruned_at": { "type": ["string", "null"], "format": "date-time" },
        "web_url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "schema_version", "ok", "error_class", "error_kind",
        "exit_code", "message"
      ],
      "properties": {
        "schema": { "const": "hive-digest" },
        "schema_version": { "const": 1 },
        "ok": { "const": false },
        "error_class": { "type": "string" },
        "error_kind": {
          "enum": [
            "usage", "config", "unknown_project", "invalid_date",
            "browser_unavailable", "digest_error", "internal"
          ]
        },
        "exit_code": { "type": "integer" },
        "message": { "type": "string" }
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": { "type": ["string", "null"] },
        "registration_id": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "repository_identity": { "type": ["string", "null"] },
        "historical": { "type": ["boolean", "null"] }
      }
    },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fact_id": { "type": ["string", "null"] },
        "kind": { "type": ["string", "null"] },
        "category": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] },
        "project_id": { "type": ["string", "null"] },
        "project": { "type": ["string", "null"] },
        "task_id": { "type": ["string", "integer", "null"] },
        "task_slug": { "type": ["string", "null"] },
        "stage": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "occurred_at": { "type": ["string", "null"] },
        "observed_at": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },
        "task_url": { "type": ["string", "null"] },
        "historical": { "type": ["boolean", "null"] },
        "details": { "$ref": "#/$defs/FactDetails" },
        "pr": { "anyOf": [{ "$ref": "#/$defs/PullRequest" }, { "type": "null" }] }
      }
    },
    "Attention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attention_id": { "type": ["string", "null"] },
        "kind": { "type": ["string", "null"] },
        "project_id": { "type": ["string", "null"] },
        "project": { "type": ["string", "null"] },
        "task_id": { "type": ["string", "integer", "null"] },
        "task_slug": { "type": ["string", "null"] },
        "stage": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "waiting_since": { "type": ["string", "null"] },
        "waiting_age_seconds": { "type": ["integer", "null"], "minimum": 0 },
        "task_url": { "type": ["string", "null"] },
        "historical": { "type": ["boolean", "null"] }
      }
    },
    "Gap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gap_id": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },
        "scope": { "type": ["string", "null"] },
        "reason_code": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "observed_at": { "type": ["string", "null"] },
        "freshness_at": { "type": ["string", "null"] },
        "project_id": { "type": ["string", "null"] },
        "task_slug": { "type": ["string", "null"] },
        "retry_state": { "type": ["string", "null"] }
      }
    },
    "Amendment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "attention", "gaps", "resolved_gap_ids", "resolved_gaps"],
      "properties": {
        "amendment_id": { "type": ["string", "null"] },
        "kind": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },
        "event_at": { "type": ["string", "null"] },
        "observed_at": { "type": ["string", "null"] },
        "amended_at": { "type": ["string", "null"] },
        "items": { "type": "array", "items": { "$ref": "#/$defs/Fact" } },
        "attention": { "type": "array", "items": { "$ref": "#/$defs/Attention" } },
        "gaps": { "type": "array", "items": { "$ref": "#/$defs/Gap" } },
        "resolved_gap_ids": { "type": "array", "items": { "type": "string" } },
        "resolved_gaps": { "type": "array", "items": { "$ref": "#/$defs/Gap" } }
      }
    },
    "FactDetails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transition": { "$ref": "#/$defs/DetailValue" },
        "marker": { "$ref": "#/$defs/DetailValue" },
        "to_stage": { "$ref": "#/$defs/DetailValue" },
        "question_id": { "$ref": "#/$defs/DetailValue" },
        "approval": { "$ref": "#/$defs/DetailValue" },
        "decision": { "$ref": "#/$defs/DetailValue" },
        "outcome": { "$ref": "#/$defs/DetailValue" },
        "retry_at": { "$ref": "#/$defs/DetailValue" },
        "hold_kind": { "$ref": "#/$defs/DetailValue" },
        "state": { "$ref": "#/$defs/DetailValue" },
        "provider": { "$ref": "#/$defs/DetailValue" },
        "resource_kind": { "$ref": "#/$defs/DetailValue" },
        "kind": { "$ref": "#/$defs/DetailValue" },
        "unit": { "$ref": "#/$defs/DetailValue" },
        "health": { "$ref": "#/$defs/DetailValue" },
        "timed_out": { "$ref": "#/$defs/DetailValue" },
        "actual_provider": { "$ref": "#/$defs/DetailValue" },
        "actual_model": { "$ref": "#/$defs/DetailValue" },
        "commit_oid": { "$ref": "#/$defs/DetailValue" },
        "branch": { "$ref": "#/$defs/DetailValue" },
        "pr_number": { "$ref": "#/$defs/DetailValue" },
        "pr_state": { "$ref": "#/$defs/DetailValue" },
        "pr_url": { "$ref": "#/$defs/DetailValue" },
        "head_oid": { "$ref": "#/$defs/DetailValue" },
        "draft": { "$ref": "#/$defs/DetailValue" },
        "check_state": { "$ref": "#/$defs/DetailValue" },
        "conclusion": { "$ref": "#/$defs/DetailValue" },
        "review_state": { "$ref": "#/$defs/DetailValue" },
        "merge_state": { "$ref": "#/$defs/DetailValue" },
        "merge_oid": { "$ref": "#/$defs/DetailValue" },
        "merged_at": { "$ref": "#/$defs/DetailValue" },
        "action": { "$ref": "#/$defs/DetailValue" },
        "corrected_fact_id": { "$ref": "#/$defs/DetailValue" },
        "correction_kind": { "$ref": "#/$defs/DetailValue" },
        "workflow": { "$ref": "#/$defs/DetailValue" }
      }
    },
    "DetailValue": { "type": ["string", "integer", "boolean", "null"] },
    "PullRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "number": { "type": ["integer", "string", "null"] },
        "url": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "draft": { "type": ["boolean", "null"] },
        "head_revision": { "type": ["string", "null"] },
        "checks": { "type": ["string", "null"] },
        "review": { "type": ["string", "null"] },
        "merged_at": { "type": ["string", "null"] }
      }
    },
    "Cutover": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested_at": { "type": ["string", "null"] },
        "effective_at": { "type": ["string", "null"] },
        "previous_time_zone": { "type": ["string", "null"] },
        "skipped_labels": {
          "type": "array", "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
