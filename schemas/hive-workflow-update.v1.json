{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-workflow-update.v1.json",
  "title": "hive workflow update output v1",
  "oneOf": [
    {"$ref": "#/$defs/SuccessPayload"},
    {"$ref": "#/$defs/ErrorPayload"}
  ],
  "$defs": {
    "SuccessPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "ok", "status", "name", "from_commit", "to_commit", "manifest_digest", "diff"],
      "properties": {
        "schema": {"const": "hive-workflow-update"},
        "schema_version": {"const": 1},
        "ok": {"const": true},
        "status": {"enum": ["dry_run", "updated", "cancelled", "already_current"]},
        "name": {"type": "string"},
        "from_commit": {"type": "string"},
        "to_commit": {"type": "string"},
        "manifest_digest": {"type": "string"},
        "diff": {"type": ["object", "null"]},
        "retained_commits": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "ok", "error_class", "error_kind", "exit_code", "message"],
      "properties": {
        "schema": {"const": "hive-workflow-update"},
        "schema_version": {"const": 1},
        "ok": {"const": false},
        "error_class": {"type": "string"},
        "error_kind": {"enum": ["consent_required", "ownership", "update_required", "concurrent_run", "git", "config", "registry", "error"]},
        "exit_code": {"enum": [1, 64, 69, 70, 75, 78]},
        "message": {"type": "string"},
        "holder": {"type": "object", "additionalProperties": true},
        "lock_path": {"type": "string"}
      }
    }
  }
}
