#!/usr/bin/env bash
# Minimal fake gh for tests. Reads scenario from HIVE_FAKE_GH_SCENARIO env.
set -u

LOG_DIR="${HIVE_FAKE_GH_LOG_DIR:-/tmp}"
mkdir -p "$LOG_DIR"
ARGV_LOG="${LOG_DIR}/fake-gh-argv.log"
{
  echo "---"
  date -u +"%Y-%m-%dT%H:%M:%SZ"
  printf 'cwd=%s\n' "$PWD"
  for a in "$@"; do
    printf 'arg=%s\n' "$a"
  done
} >> "$ARGV_LOG"

case "${1:-}" in
  auth)
    case "${2:-}" in
      status) exit "${HIVE_FAKE_GH_AUTH_EXIT:-0}" ;;
      *) exit 0 ;;
    esac
    ;;
  pr)
    case "${2:-}" in
      list)
        if [[ -n "${HIVE_FAKE_GH_PR_EXISTS:-}" ]]; then
          printf '[{"url":"https://example.com/pr/1","number":1,"state":"OPEN","isDraft":true}]\n'
        else
          printf '[]\n'
        fi
        exit 0
        ;;
      create)
        printf 'https://example.com/pr/2\n'
        exit "${HIVE_FAKE_GH_CREATE_EXIT:-0}"
        ;;
      view)
        if [[ "${*: -1}" == ".comments[].body" ]]; then
          printf '%s\n' "${HIVE_FAKE_GH_COMMENTS_BODY:-}"
        elif [[ "${*: -1}" == ".body" ]]; then
          printf '%s\n' "${HIVE_FAKE_GH_PR_BODY:-}"
        else
          printf '{"state":"%s","body":"%s"}\n' "${HIVE_FAKE_GH_STATE:-OPEN}" "${HIVE_FAKE_GH_PR_BODY:-}"
        fi
        exit "${HIVE_FAKE_GH_VIEW_EXIT:-0}"
        ;;
      comment)
        exit "${HIVE_FAKE_GH_COMMENT_EXIT:-0}"
        ;;
      ready)
        exit "${HIVE_FAKE_GH_READY_EXIT:-0}"
        ;;
      edit)
        exit "${HIVE_FAKE_GH_EDIT_EXIT:-0}"
        ;;
      *) exit 0 ;;
    esac
    ;;
  *) exit 0 ;;
esac
