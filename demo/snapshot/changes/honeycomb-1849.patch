diff --git a/script/honeycomb-listing-approval b/script/honeycomb-listing-approval
new file mode 100755
index 0000000..2fc78f8
--- /dev/null
+++ b/script/honeycomb-listing-approval
@@ -0,0 +1,97 @@
+#!/usr/bin/env ruby
+# frozen_string_literal: true
+
+require "optparse"
+$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
+require "honeycomb_security_lint"
+
+module HoneycombSecurityLint
+  module ListingApprovalCLI
+    module_function
+
+    def run(argv, out: $stdout, err: $stderr, env: ENV, default_root: nil)
+      command = argv.shift
+      case command
+      when "issue"
+        issue(argv, out: out, env: env, default_root: default_root)
+      when "export"
+        export(argv, out: out, default_root: default_root)
+      when "-h", "--help", nil
+        out.puts "Usage: honeycomb-listing-approval <issue|export> [options]"
+        command ? 0 : 2
+      else
+        raise HoneycombRegistry::InvocationError, "unknown command #{command.inspect}"
+      end
+    rescue OptionParser::ParseError, HoneycombRegistry::InvocationError,
+           ApprovalIssuer::Invalid, EvidenceStore::Invalid, EvidenceStore::Conflict,
+           EvidenceSnapshot::Invalid, Contracts::Invalid, KeyError => e
+      err.puts "honeycomb-listing-approval: #{Redactor.sanitize_text(e.message)}"
+      2
+    rescue StandardError => e
+      err.puts "honeycomb-listing-approval: internal failure: #{e.class}"
+      1
+    end
+
+    def issue(argv, out:, env:, default_root:)
+      options = {root: default_root}
+      parser = OptionParser.new do |opts|
+        opts.banner = "Usage: honeycomb-listing-approval issue --event PATH [--root PATH]"
+        opts.on("--event PATH", "Trusted workflow_dispatch event JSON") { |value| options[:event] = value }
+        opts.on("--root PATH", "Trusted default-branch checkout") { |value| options[:root] = value }
+        opts.on("-h", "--help", "Show help") { out.puts opts; return 0 }
+      end
+      arguments = parser.parse(argv)
+      raise HoneycombRegistry::InvocationError, "unexpected positional arguments" unless arguments.empty?
+      raise HoneycombRegistry::InvocationError, "--event PATH is required" unless options[:event]
+      root = File.expand_path(options[:root] || Dir.pwd)
+      event = Contracts.parse_json(File.binread(options.fetch(:event)))
+      repository = env.fetch("GITHUB_REPOSITORY")
+      client = GitHubClient.new(
+        repository: repository, token: env.fetch("GITHUB_TOKEN"),
+        api_url: env.fetch("GITHUB_API_URL", "https://api.github.com")
+      )
+      store = EvidenceStore.new(
+        client: client, base_branch: event.dig("repository", "default_branch")
+      )
+      approval = ApprovalIssuer.new(
+        event: event, client: client, store: store, repository: repository, root: root
+      ).issue
+      out.write(Contracts.canonical_json({"schema" => Contracts::APPROVAL_SCHEMA, "approvals" => [approval]}))
+      0
+    end
+
+    def export(argv, out:, default_root:)
+      options = {root: default_root, lint: []}
+      parser = OptionParser.new do |opts|
+        opts.banner = "Usage: honeycomb-listing-approval export --snapshot PATH --lint PATH --checked-at TIME --release-tier TIER --output PATH"
+        opts.on("--snapshot PATH", "Checked-out honeycomb-evidence branch") { |value| options[:snapshot] = value }
+        opts.on("--lint PATH", "Selected immutable lint record (repeatable)") { |value| options[:lint] << value }
+        opts.on("--checked-at TIME", "RFC 3339 lint audit time") { |value| options[:checked_at] = value }
+        opts.on("--release-tier TIER", "Immutable release tier") { |value| options[:release_tier] = value }
+        opts.on("--output PATH", "Normalized listing evidence output") { |value| options[:output] = value }
+        opts.on("-h", "--help", "Show help") { out.puts opts; return 0 }
+      end
+      arguments = parser.parse(argv)
+      raise HoneycombRegistry::InvocationError, "unexpected positional arguments" unless arguments.empty?
+      %i[snapshot checked_at release_tier output].each do |key|
+        raise HoneycombRegistry::InvocationError, "--#{key.to_s.tr('_', '-')} is required" unless options[key]
+      end
+      raise HoneycombRegistry::InvocationError, "at least one --lint PATH is required" if options[:lint].empty?
+
+      snapshot = File.expand_path(options.fetch(:snapshot), options[:root] || Dir.pwd)
+      lint_paths = options.fetch(:lint).map { |path| File.expand_path(path, snapshot) }
+      document = EvidenceSnapshot.export(
+        root: snapshot, lint_paths: lint_paths,
+        checked_at: options.fetch(:checked_at), release_tier: options.fetch(:release_tier)
+      )
+      output = File.expand_path(options.fetch(:output), options[:root] || Dir.pwd)
+      HoneycombRegistry::AtomicWrite.replace(output, Contracts.canonical_json(document))
+      out.puts "Wrote normalized listing evidence to #{output}"
+      0
+    end
+  end
+end
+
+exit HoneycombSecurityLint::ListingApprovalCLI.run(
+  ARGV, default_root: File.expand_path("..", __dir__)
+)
diff --git a/script/honeycomb-security-lint b/script/honeycomb-security-lint
new file mode 100755
index 0000000..fa917d1
--- /dev/null
+++ b/script/honeycomb-security-lint
@@ -0,0 +1,77 @@
+#!/usr/bin/env ruby
+# frozen_string_literal: true
+
+require "optparse"
+$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
+require "honeycomb_security_lint"
+
+module HoneycombSecurityLint
+  module CLI
+    module_function
+
+    def run(argv, out: $stdout, err: $stderr)
+      options = {root: File.expand_path("..", __dir__), run_attempt: 1}
+      parser = OptionParser.new do |opts|
+        opts.banner = "Usage: honeycomb-security-lint [options]"
+        opts.on("--root PATH", "Repository root") { |value| options[:root] = value }
+        opts.on("--base SHA", "Pull request base SHA") { |value| options[:base_sha] = value }
+        opts.on("--head SHA", "Pull request head SHA") { |value| options[:head_sha] = value }
+        opts.on("--pr NUMBER", Integer, "Pull request number") { |value| options[:pull_request] = value }
+        opts.on("--event-action ACTION", "Pull request event action") { |value| options[:action] = value }
+        opts.on("--gate STATE", "required, applied, expired, or unchanged") { |value| options[:gate] = value }
+        opts.on("--label-sha SHA", "Head SHA at maintainer label action") { |value| options[:label_sha] = value }
+        opts.on("--run-id NUMBER", Integer, "Workflow run ID") { |value| options[:run_id] = value }
+        opts.on("--run-attempt NUMBER", Integer, "Workflow run attempt") { |value| options[:run_attempt] = value }
+        opts.on("--repository OWNER/REPO", "Origin repository") { |value| options[:repository] = value }
+        opts.on("--approvals PATH", "Optional trusted listing-approval v1 record") { |value| options[:approvals] = value }
+        opts.on("--output PATH", "Write the JSON artifact") { |value| options[:output] = value }
+        opts.on("--comment-output PATH", "Write sticky-comment Markdown") { |value| options[:comment_output] = value }
+        opts.on("--summary-output PATH", "Write job-summary Markdown") { |value| options[:summary_output] = value }
+        opts.on("-h", "--help", "Show help") do
+          out.puts opts
+          return 0
+        end
+      end
+      arguments = parser.parse(argv)
+      raise ArgumentError, "unexpected positional arguments" unless arguments.empty?
+      require_options!(options)
+
+      approvals = if options[:approvals]
+                    Contracts.parse_approvals(File.binread(File.expand_path(options[:approvals], options[:root]))).fetch("approvals")
+                  else
+                    []
+                  end
+      context = options.slice(:pull_request, :base_sha, :head_sha, :action, :gate, :label_sha,
+                              :run_id, :run_attempt, :repository)
+      result = Runner.new(root: options[:root], context: context, approvals: approvals).run
+      renderer = Renderer.new(max_items: Policy.load(File.join(options[:root], "policy", "security-lint.yml")).limits.fetch("max_rendered_items"))
+      write_or_print(options[:output], result.json, out)
+      File.binwrite(options[:comment_output], renderer.comment(result.evidence)) if options[:comment_output]
+      File.binwrite(options[:summary_output], renderer.summary(result.evidence)) if options[:summary_output]
+      result.exit_status
+    rescue OptionParser::ParseError, ArgumentError, Contracts::Invalid, SystemCallError, IOError => e
+      err.puts "honeycomb-security-lint: #{Redactor.sanitize_text(e.message)}"
+      2
+    rescue StandardError => e
+      err.puts "honeycomb-security-lint: internal failure: #{e.class}"
+      2
+    end
+
+    def require_options!(options)
+      {
+        base_sha: "--base SHA", head_sha: "--head SHA", pull_request: "--pr NUMBER",
+        action: "--event-action ACTION", gate: "--gate STATE", run_id: "--run-id NUMBER",
+        repository: "--repository OWNER/REPO"
+      }.each do |key, label|
+        raise ArgumentError, "#{label} is required" unless options[key]
+      end
+      raise ArgumentError, "--gate is invalid" unless %w[required applied expired unchanged].include?(options[:gate])
+    end
+
+    def write_or_print(path, bytes, out)
+      path ? File.binwrite(path, bytes) : out.write(bytes)
+    end
+  end
+end
+
+exit HoneycombSecurityLint::CLI.run(ARGV)
diff --git a/script/honeycomb-security-lint-report b/script/honeycomb-security-lint-report
new file mode 100755
index 0000000..1606f20
