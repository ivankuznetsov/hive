{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-patrol.v3.json",
  "title": "hive patrol output (v3)",
  "description": "Stable contract emitted by `hive patrol PROJECT --json`.",
  "oneOf": [
    { "$ref": "#/$defs/SuccessPayload" },
    { "$ref": "#/$defs/ErrorPayload" }
  ],
  "$defs": {
    "SuccessPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "ok",
        "project",
        "project_root",
        "dry_run",
        "features_mapped",
        "features_review_attempted",
        "features_reviewed",
        "review_complete",
        "review_errors",
        "findings",
        "fix_candidates",
        "fixes_attempted",
        "fixes_validated",
        "prs_opened",
        "pr_urls",
        "review_handoff_errors",
        "fix_results",
        "skipped_findings",
        "last_scanned_sha"
      ],
      "properties": {
        "schema": { "const": "hive-patrol" },
        "schema_version": { "const": 3 },
        "ok": { "const": true },
        "project": { "type": "string" },
        "project_root": { "type": "string" },
        "dry_run": { "type": "boolean" },
        "features_mapped": { "type": "integer", "minimum": 0 },
        "features_review_attempted": { "type": "integer", "minimum": 0 },
        "features_reviewed": { "type": "integer", "minimum": 0 },
        "review_complete": { "type": "boolean" },
        "review_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["feature_id", "error", "message"],
            "properties": {
              "feature_id": { "type": "string" },
              "error": {
                "enum": ["agent_failed", "malformed_json", "schema_invalid", "review_error"]
              },
              "message": { "type": "string" },
              "details": { "type": "object" }
            }
          }
        },
        "findings": { "type": "integer", "minimum": 0 },
        "fix_candidates": { "type": "integer", "minimum": 0 },
        "fixes_attempted": { "const": 0 },
        "fixes_validated": { "const": 0 },
        "prs_opened": { "const": 0 },
        "pr_urls": {
          "type": "array",
          "maxItems": 0
        },
        "review_handoff_errors": {
          "type": "array",
          "maxItems": 0
        },
        "fix_results": {
          "type": "array",
          "maxItems": 0
        },
        "skipped_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["finding_id", "fingerprint", "reason"],
            "properties": {
              "finding_id": { "type": "string" },
              "fingerprint": { "type": "string" },
              "reason": {
                "enum": ["semantic_duplicate"]
              },
              "canonical_finding_id": { "type": "string" }
            }
          }
        },
        "last_scanned_sha": { "type": "string" }
      }
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "ok",
        "error_class",
        "error_kind",
        "exit_code",
        "message"
      ],
      "properties": {
        "schema": { "const": "hive-patrol" },
        "schema_version": { "const": 3 },
        "ok": { "const": false },
        "error_class": { "type": "string" },
        "error_kind": { "enum": ["config", "error"] },
        "exit_code": { "type": "integer" },
        "message": { "type": "string" }
      }
    }
  }
}
