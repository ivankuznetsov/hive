# hive-managed: job-schema-migration-retry/v1
[Unit]
Description=Retry Hive JobStore schema migration for every discovered user
Documentation=https://github.com/ivankuznetsov/hive
After=local-fs.target

[Service]
Type=oneshot
ExecStart=@CLEAN_ENV@ -i HOME=/root USER=root LOGNAME=root PATH=@SERVICE_PATH@ LANG=C.UTF-8 GEM_HOME=@GEM_HOME@ GEM_PATH=@GEM_HOME@ HIVE_INVOKED_BIN=@HIVE_BINARY@ HIVE_ROOT_RUNTIME_LAUNCHER=1 HIVE_ROOT_RUNTIME_MANIFEST=@MANIFEST@ @RUBY@ @SCRIPT@ refactor-patrol-migrate-installed --all-users --resume
TimeoutStartSec=@TIMEOUT_SEC@
KillMode=control-group
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
