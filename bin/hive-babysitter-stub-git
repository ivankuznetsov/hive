#!/usr/bin/env ruby
# frozen_string_literal: true

def log_skip(argv)
  path = ENV.fetch("HIVE_BABYSITTER_DRY_RUN_LOG", ".babysitter-dry-run-skipped.log")
  File.open(path, "a") { |file| file.puts("[dry-run] git #{argv.join(' ')} skipped") }
rescue SystemCallError => e
  warn "[dry-run] failed to record skipped git invocation: #{e.message}"
end

argv = ARGV.dup

def stripped_global_options(argv)
  rest = argv.dup
  loop do
    case rest.first
    when "-C", "-c", "--git-dir", "--work-tree"
      break if rest.length < 2

      rest.shift(2)
    when /\A--git-dir=/, /\A--work-tree=/
      rest.shift
    when /\A-/
      rest.shift
    else
      break
    end
  end
  rest
end

def read_only_remote?(rest)
  args = rest[1..] || []
  args.shift while ["-v", "--verbose"].include?(args.first)
  return true if args.empty?

  case args.first
  when "show"
    args.shift
    args.shift if args.first == "-n"
    args.all? { |arg| !arg.start_with?("-") }
  when "get-url"
    args.shift
    args.shift while ["--push", "--all"].include?(args.first)
    args.length == 1 && !args.first.start_with?("-")
  else
    false
  end
end

# Options that make real git execute an arbitrary command or write a file,
# regardless of the subcommand. These defeat the read-only guard if they reach
# real git, so they are screened across the entire invocation (including the
# leading global options that `stripped_global_options` discards) rather than
# trusting the stripped subcommand alone.
#
#   -c <key>=<cmd> / --config-env  inject diff.external, *.textconv, core.pager,
#                                  etc. — all of which spawn <cmd>.
#   -O / --open-files-in-pager     run the named pager as a command (git grep).
#   --output                       write the command's output to a file.
def dangerous_option?(arg)
  case arg
  when "-c", "--config-env"
    true
  else
    arg.start_with?("--config-env=", "--output", "--open-files-in-pager", "-O")
  end
end

def no_exec_or_write_options?(argv)
  argv.none? { |arg| dangerous_option?(arg) }
end

def read_only?(rest)
  case rest.first.to_s
  when "branch"
    rest.length == 1 || rest.include?("--show-current") || rest.include?("--contains")
  when "cat-file", "describe", "diff", "grep", "log", "ls-files", "ls-tree", "merge-base",
       "rev-list", "rev-parse", "show", "status"
    true
  when "remote"
    read_only_remote?(rest)
  when "config"
    rest.include?("--get") || rest.include?("--get-all") || rest.include?("--list")
  else
    false
  end
end

rest = stripped_global_options(argv)

unless no_exec_or_write_options?(argv) && read_only?(rest)
  log_skip(argv)
  warn "[dry-run] git #{argv.join(' ')} skipped"
  exit 0
end

real = ENV["HIVE_BABYSITTER_REAL_GIT"].to_s
if real.empty?
  warn "hive-babysitter dry-run: HIVE_BABYSITTER_REAL_GIT is unset; refusing to guess a path for the real git binary"
  exit 127
end
exec(real, *argv)
