post_install() {
  cat <<'MSG'
hive-bin installed.
Run `hive init` in a project to scaffold .hive-state and register the systemd-user daemon.
MSG
}

post_upgrade() {
  post_install
}

post_remove() {
  cat <<'MSG'
hive-bin removed.
pacman -R hive-bin alone does not touch project .hive-state directories.
Use `hive uninstall` flags deliberately for user config/cache or state cleanup.
MSG
}
