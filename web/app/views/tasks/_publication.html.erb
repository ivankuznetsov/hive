<% publication_state = publication["publication_state"].presence || "unavailable" %>
<section id="workspace-publication"
         class="workspace-panel publication-panel publication-<%= publication.fetch("state") %> workspace-state-<%= publication.fetch("state") %>"
         aria-labelledby="publication-heading">
  <%# Title and state read as one group; the PR and diff actions sit together
      below, and GitHub observation and Git facts stay secondary. %>
  <div class="workspace-panel-heading publication-heading">
    <div class="publication-title">
      <h2 id="publication-heading">Code changes</h2>
      <span class="status-text workspace-state-label"><%= { "not_configured" => "No pull request", "not_observed" => "Not checked on GitHub", "local_unpushed" => "Ahead of last fetched origin" }.fetch(publication_state) { publication_state.humanize } %></span>
    </div>
    <% if refresh_available %>
      <%= button_to "Refresh GitHub",
            task_publication_path(@project.name, @task.slug, source: @task_source),
            class: "btn-secondary btn-sm",
            form: { data: { turbo_frame: stable_dom_id("task-publication", @project.name, @task.slug) } } %>
    <% end %>
  </div>

  <% if refresh_notice.present? %>
    <p class="state-banner"><%= refresh_notice %></p>
  <% end %>

  <% pr = publication["pull_request"].is_a?(Hash) ? publication["pull_request"] : {} %>
  <% if pr["url"].present? && pr["title"].present? %><p class="publication-pr-title workspace-break-anywhere"><%= pr["title"] %></p><% end %>
  <% if pr["url"].present? || @task.worktree? %>
    <div class="publication-actions">
      <% if pr["url"].present? %>
        <%= link_to "PR ##{pr.fetch("number")}", pr.fetch("url"), rel: "noopener noreferrer", class: "btn btn-secondary btn-sm" %>
      <% end %>
      <%# The local diff reads the live task worktree only; once it is gone the
          pull request remains the historical diff. %>
      <% if @task.worktree? %>
        <%= link_to "View diff", task_diff_path(@project.name, @task.slug, source: @task_source), class: "btn btn-secondary btn-sm", data: { turbo_frame: "_top" } %>
      <% else %>
        <%= link_to "View diff on GitHub", "#{pr.fetch("url").delete_suffix("/")}/files", rel: "noopener noreferrer", class: "btn btn-secondary btn-sm" %>
      <% end %>
    </div>
  <% end %>

  <% remote = publication.dig("remote", "observation") %>
  <% if remote %>
    <% observed_at = publication.dig("remote", "observed_at") %>
    <%# The badge already names the state; repeat GitHub's only when it differs. %>
    <% remote_state = remote.fetch("state").to_s %>
    <% same_state = remote_state.casecmp?(publication_state) %>
    <p class="publication-observed">
      <% if same_state %>Checked on GitHub<% else %><%= remote_state.humanize %> on GitHub<% end %><% if observed_at %> · <%= "checked " unless same_state %><time datetime="<%= observed_at %>"><%= publication_observed_label(observed_at) %></time><% end %>
    </p>
    <% if Array(remote["checks"]).any? %>
      <div class="workspace-table-scroll" tabindex="0" role="region" aria-label="Bounded pull request checks">
        <table class="workspace-table">
          <caption>Checks</caption>
          <thead><tr><th scope="col">Check</th><th scope="col">Status</th><th scope="col">Conclusion</th></tr></thead>
          <tbody>
            <% Array(remote["checks"]).each do |check| %>
              <tr>
                <th scope="row"><%= check["name"] %></th>
                <td><%= check["status"].presence || "Unavailable" %></td>
                <td><%= check["conclusion"].presence || "Pending" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% elsif pr["url"].present? %>
    <p class="publication-observed">Pull request status has not been checked.</p>
  <% end %>
  <% if pr["body"].present? %>
    <details class="task-secondary" data-workspace-disclosure-key="publication-description">
      <summary>Pull request description</summary>
      <pre class="publication-body"><%= pr["body"] %></pre>
    </details>
  <% end %>

  <% local = publication["local"].is_a?(Hash) ? publication["local"] : {} %>
  <% repository = local["repository"].to_s %>
  <% repository_url = repository_web_url(repository) %>
  <% branch = local["branch"].presence || local["expected_branch"].presence %>
  <% head = local["head_oid"].to_s %>
  <% push_state = local.dig("push", "state").to_s %>
  <%# Missing values are omitted rather than shown as "Unavailable"; the
      reasons stay visible in Publication diagnostics below. Push compares
      only against the local refs/remotes/origin/<branch>; an absent tracking
      ref ("not_observed") proves nothing about the remote, so it is omitted. %>
  <% facts = [
       [ "Repository", repository.presence && (repository_url ? link_to(repository, repository_url, rel: "noopener noreferrer") : repository) ],
       [ "Branch", branch && (repository_url ? link_to(branch, repository_ref_url(repository_url, "tree", branch), rel: "noopener noreferrer") : branch) ],
       [ "Base", local["base_branch"].presence && (repository_url ? link_to(local["base_branch"], repository_ref_url(repository_url, "tree", local["base_branch"]), rel: "noopener noreferrer") : local["base_branch"]) ],
       [ "Head", head.presence && (repository_url && head.match?(/\A[0-9a-f]{7,40}\z/i) ? link_to(head.first(12), "#{repository_url}/commit/#{head}", rel: "noopener noreferrer") : tag.code(head.first(12))) ],
       [ "Push", { "pushed" => "Matches last fetched origin", "unpushed" => "Local commits ahead of last fetched origin", "behind" => "Behind last fetched origin", "divergent" => "Diverged from last fetched origin" }[push_state] ],
       [ "Working tree", local["dirty"].nil? ? nil : (local["dirty"] ? "Uncommitted changes" : "Clean") ]
     ].select { |_label, value| value.present? } %>
  <% if facts.any? %>
    <details class="task-secondary" data-workspace-disclosure-key="publication-technical">
      <summary>Git details</summary>
      <dl class="workspace-facts">
        <% facts.each do |label, value| %>
          <div><dt><%= label %></dt><dd><%= value %></dd></div>
        <% end %>
      </dl>
    </details>
  <% end %>

  <% if publication.fetch("diagnostics").any? %>
    <details class="workspace-diagnostics" data-workspace-disclosure-key="publication-diagnostics">
      <summary>Publication diagnostics (<%= publication.fetch("diagnostics").length %>)</summary>
      <ul>
        <% publication.fetch("diagnostics").each do |diagnostic| %>
          <li><%= diagnostic.fetch("reason").humanize %></li>
        <% end %>
      </ul>
    </details>
  <% end %>
</section>
