<% tasks = band["tasks"].select { |task| task["stage"] == stage["dir"] } %>
<section class="board-column" role="listitem" data-stage="<%= stage["dir"] %>"
         aria-label="<%= stage["name"].to_s.tr("_-", "  ").titleize %>, <%= pluralize(tasks.size, "task") %>">
  <header class="board-column-header">
    <h3><%= stage["name"].to_s.tr("_-", "  ").titleize %></h3>
    <span class="board-count" aria-label="<%= pluralize(tasks.size, "task") %>"><%= tasks.size %></span>
  </header>
  <div class="board-column-cards">
    <% active_filters = local_assigns.fetch(:filters, @filters) %>
    <% grouped_board_tasks(tasks, active_filters["group"], band["project"]["name"]).each do |lane, lane_tasks| %>
      <%= render "board/lane", lane: lane, tasks: lane_tasks, grouped: active_filters["group"] != "none",
                               project: band["project"] %>
    <% end %>
  </div>
</section>
