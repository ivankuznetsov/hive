{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive.local/schemas/hive-patrol-capture.v1.json",
  "title": "Hive Patrol Capture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "capture_id",
    "module",
    "occurrence_id",
    "project",
    "trigger",
    "reservation",
    "owner",
    "owner_epoch",
    "selection_input",
    "selection",
    "outcome_class",
    "outcome",
    "effect_ids",
    "occurred_at",
    "recorded_at"
  ],
  "properties": {
    "schema": {"const": "hive-patrol-capture"},
    "schema_version": {"const": 1},
    "capture_id": {"type": "string", "pattern": "^cap-[0-9a-f]{64}$"},
    "module": {"enum": ["patrol", "architecture-patrol"]},
    "occurrence_id": {"type": "string", "pattern": "^occ-[0-9a-f]{64}$"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "name", "repository"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "repository": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "trigger": {"$ref": "#/$defs/trigger"},
    "reservation": {"$ref": "#/$defs/reservation"},
    "owner": {"enum": ["legacy", "module"]},
    "owner_epoch": {"type": "integer", "minimum": 1},
    "selection_input": {"type": "object"},
    "selection": {"$ref": "#/$defs/decision_projection"},
    "outcome_class": {
      "anyOf": [
        {
          "enum": [
            "complete",
            "completed",
            "failed",
            "not_dispatched"
          ]
        },
        {"type": "null"}
      ]
    },
    "outcome": {
      "anyOf": [
        {"$ref": "#/$defs/capture_outcome"},
        {"type": "null"}
      ]
    },
    "effect_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 128,
      "items": {"type": "string", "minLength": 1}
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"module": {"const": "patrol"}},
        "required": ["module"]
      },
      "then": {
        "properties": {
          "selection_input": {"$ref": "#/$defs/patrol_selection_input"},
          "selection": {"$ref": "#/$defs/patrol_projection"}
        }
      }
    },
    {
      "if": {
        "properties": {"module": {"const": "architecture-patrol"}},
        "required": ["module"]
      },
      "then": {
        "properties": {
          "selection_input": {"$ref": "#/$defs/architecture_selection_input"},
          "selection": {"$ref": "#/$defs/architecture_projection"}
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "outcome_class": {"type": "null"},
            "outcome": {"type": "null"}
          },
          "required": ["outcome_class", "outcome"]
        },
        {
          "properties": {
            "outcome_class": {"type": "string", "minLength": 1},
            "outcome": {"type": "object"}
          },
          "required": ["outcome_class", "outcome"]
        }
      ]
    }
  ],
  "$defs": {
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": {"enum": ["manual", "direct"]},
            "id": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "schedule", "occurred_at"],
          "properties": {
            "kind": {"const": "schedule"},
            "id": {"type": "string", "minLength": 1},
            "schedule": {"type": "string", "minLength": 1},
            "occurred_at": {"type": "string", "format": "date-time"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "event_name", "occurred_at"],
          "properties": {
            "kind": {"const": "module_event"},
            "id": {"type": "string", "minLength": 1},
            "event_name": {"type": "string", "minLength": 1},
            "occurred_at": {"type": "string", "format": "date-time"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "manifest_digest", "merge_sha"],
          "properties": {
            "kind": {"const": "pull_request.merged"},
            "id": {"type": "string", "minLength": 1},
            "manifest_digest": {"type": "string", "minLength": 1},
            "merge_sha": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "reservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": {"const": "ordinary"},
            "id": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "window_started_at",
            "attempt_generation"
          ],
          "properties": {
            "kind": {"enum": ["ordinary", "module_hook"]},
            "id": {"type": "string", "minLength": 1},
            "window_started_at": {
              "type": "string",
              "format": "date-time"
            },
            "attempt_generation": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "job_id"],
          "properties": {
            "kind": {"const": "architecture"},
            "id": {"type": "string", "minLength": 1},
            "job_id": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "job_id",
            "window_started_at",
            "attempt_generation"
          ],
          "properties": {
            "kind": {"const": "architecture"},
            "id": {"type": "string", "minLength": 1},
            "job_id": {"type": "string", "minLength": 1},
            "window_started_at": {
              "type": "string",
              "format": "date-time"
            },
            "attempt_generation": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "capture_outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rationale": {"type": "string"},
        "ok": {"type": "boolean"},
        "exit_code": {"type": ["integer", "null"]},
        "features_mapped": {"type": "integer", "minimum": 0},
        "features_reviewed": {"type": "integer", "minimum": 0},
        "findings": {"type": "integer", "minimum": 0},
        "fixes_attempted": {"type": "integer", "minimum": 0},
        "prs_opened": {"type": "integer", "minimum": 0},
        "review_complete": {"type": "boolean"},
        "last_scanned_sha": {"type": ["string", "null"]},
        "finding_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "job_id": {"type": "string", "minLength": 1},
        "state": {"type": "string"},
        "complete": {"type": "boolean"},
        "zero_reason": {"type": ["string", "null"]},
        "action_count": {"type": "integer", "minimum": 0},
        "action_outcomes": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "string"}
        },
        "completion_status": {"type": "string"}
      },
      "anyOf": [
        {"required": ["rationale"]},
        {"required": ["job_id", "state", "complete"]}
      ]
    },
    "patrol_selection_input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "enabled", "trigger", "timer_due", "branch_changed"],
          "properties": {
            "kind": {"const": "schedule"},
            "enabled": {"type": "boolean"},
            "trigger": {"enum": ["continuous", "timer", "new_commits"]},
            "timer_due": {"type": ["boolean", "null"]},
            "branch_changed": {"type": ["boolean", "null"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "event_id"],
          "properties": {
            "kind": {"const": "module_event"},
            "event_id": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operation"],
          "properties": {
            "kind": {"const": "operation"},
            "operation": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "architecture_selection_input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "job_id", "phase"],
          "properties": {
            "kind": {"const": "candidate"},
            "job_id": {"type": "string", "minLength": 1},
            "phase": {"enum": ["discovery", "action"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "job_id", "phase", "operation"],
          "properties": {
            "kind": {"const": "operation"},
            "job_id": {"type": "string", "minLength": 1},
            "phase": {"enum": ["discovery", "action"]},
            "operation": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "patrol_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "rationale", "job_id", "phase"],
      "properties": {
        "module": {"const": "patrol"},
        "rationale": {"enum": ["disabled", "not_due", "due"]},
        "job_id": {"type": "null"},
        "phase": {"type": "null"}
      }
    },
    "architecture_projection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "rationale", "job_id", "phase"],
          "properties": {
            "module": {"const": "architecture-patrol"},
            "rationale": {"const": "due"},
            "job_id": {"type": "string", "minLength": 1},
            "phase": {"enum": ["discovery", "action"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "rationale", "job_id", "phase"],
          "properties": {
            "module": {"const": "architecture-patrol"},
            "rationale": {"const": "not_due"},
            "job_id": {"type": "null"},
            "phase": {"type": "null"}
          }
        }
      ]
    },
    "decision_projection": {
      "oneOf": [
        {"$ref": "#/$defs/patrol_projection"},
        {"$ref": "#/$defs/architecture_projection"}
      ]
    }
  }
}
