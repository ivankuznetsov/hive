      {
        "id": "architecture-templates-builtins-20260910T000556Z-ed068e3c-1",
        "feature_id": "architecture-templates-builtins",
        "category": "bug",
        "severity": "high",
        "confidence": "high",
        "title": "Runner entrypoint discards multi-argument commands",
        "description": "The isolation boundary passes the requested command as an argv vector after the image name, but the image entrypoint is `bash -lc`. Docker therefore invokes `bash -lc <argv[0]> <argv[1]> ...`; Bash treats only `argv[0]` as the command string and assigns the remaining elements to shell positional parameters instead of executing them. A gate request such as `bundle exec rake test` consequently runs only `bundle`, while `sh -c '...'` runs only `sh`.",
        "lifecycle_state": "active",
        "lifecycle_updated_at": "2026-09-10T00:12:07Z",
        "target_sha": null,
        "source_state": "active"
      },
      {
        "id": "architecture-templates-builtins-part-7-20260914T000031Z-9cbfb4f6-1",
        "feature_id": "architecture-templates-builtins-part-7",
        "category": "bug",
        "severity": "medium",
        "confidence": "high",
        "title": "Failed planners can produce scored pipeline candidates",
        "description": "Pipeline.call checks a planner result only for provider-limit text and then treats any non-empty plan file as success. If a planner times out or exits non-zero after writing a partial plan, the executor still runs and its successful diff is returned with status generated, so the benchmark can score a candidate whose required planning phase failed.",
        "lifecycle_state": "active",
        "lifecycle_updated_at": "2026-09-14T00:11:53Z",
        "target_sha": null,
        "source_state": "active"
      }
    ],
    "last_run_at": "2026-09-17T00:09:52Z"
  },
