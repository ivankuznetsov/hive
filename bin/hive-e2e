#!/usr/bin/env ruby

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
$LOAD_PATH.unshift(File.expand_path("../test/e2e/lib", __dir__))

require "json"
require "open3"
require "thor"
require "hive"
require "hive/cli_json_options"
require "coverage_catalog"
require "runner"
require "schemas"
require "path_safety"

# Mirror bin/hive: intercept `--version`/`-v` BEFORE Thor dispatch so the
# default_task `:run_scenarios` doesn't swallow it as a positional pattern.
if ARGV == [ "--version" ] || ARGV == [ "-v" ]
  puts Hive::VERSION
  exit 0
end

module Hive
  module E2E
    # Process exit-code contract for the e2e binary. Mirrors the inner
    # bin/hive routing: success / failure / config so wrapper scripts and
    # CI matrices can branch precisely.
    #
    #   0   = all scenarios passed
    #   1   = one or more scenarios failed
    #   64  = usage error (bad args, no matching scenarios)
    #   78  = preflight failure (missing tooling, bad config, missing repro)
    module BinaryExit
      SUCCESS = 0
      FAILURE = 1
      USAGE  = Hive::ExitCodes::USAGE # 64
      CONFIG  = Hive::ExitCodes::CONFIG # 78
    end

    class PreflightError < StandardError; end

    module Preflight
      module_function

      TMUX_INSTALL_HINT = "tmux not found. Install with: `brew install tmux` (macOS), " \
                          "`apt install tmux` (Debian/Ubuntu), or `pacman -S tmux` (Arch).".freeze

      def require_tmux!
        _out, _err, status = Open3.capture3("tmux", "-V")
        raise PreflightError, TMUX_INSTALL_HINT unless status.success?
      rescue Errno::ENOENT
        raise PreflightError, TMUX_INSTALL_HINT
      end
    end

    module JsonError
      module_function

      def payload(error_kind:, message:, exit_code:, command: nil)
        {
          "schema" => "hive-e2e-error",
          "schema_version" => Hive::E2E::Schemas.version_for("hive-e2e-error"),
          "ok" => false,
          "error_kind" => error_kind,
          "message" => message,
          "exit_code" => exit_code,
          "command" => command
        }.compact
      end
    end

    class Binary < Thor
      class_option :json, type: :boolean, default: false,
                          desc: "Emit structured JSON output where applicable"

      # Thor 1.3+ default is to print a deprecation warning and exit 0 on
      # unknown commands; opting in to non-zero exit lets CI / wrapper
      # scripts branch precisely on bad invocations. Thor starts in debug
      # mode below so Thor::Error re-raises and the outer rescue can map
      # usage failures to this binary's documented exit code.
      def self.exit_on_failure?
        true
      end

      default_task :run_scenarios

      desc "run [PATTERN]", "Run e2e scenarios"
      option :filter, type: :string, desc: "run scenarios with the given tag"
      option :profile, type: :string, desc: "run the required coverage for a semantic profile"
      option :coverage, type: :string, desc: "run the unique active primary for a coverage ID"
      option :keep_artifacts, type: :boolean, default: false, desc: "keep run-home directories after passing scenarios"
      def run_scenarios(pattern = nil)
        catalog = CoverageCatalog.load
        selection = semantic_selection(catalog, pattern)
        scenarios = if selection
                      catalog.scenarios_for(selection)
                    else
                      filter_scenarios(catalog.scenarios, pattern: pattern, tag: options[:filter])
                    end
        if scenarios.empty?
          target = if options[:coverage]
                     "no runnable scenario for coverage #{options[:coverage]}"
                   else
                     "no scenarios match #{pattern || options[:filter] || options[:profile] || 'all'}"
                   end
          exit_with_error(target,
                          error_kind: "no_scenarios", exit_code: BinaryExit::USAGE)
        end

        Preflight.require_tmux! if scenarios.any? { |scenario| tui_scenario?(scenario) }
        report = Runner.new.run_all(
          scenarios: scenarios,
          keep_artifacts: options[:keep_artifacts],
          selection: selection
        )
        if options[:json]
          puts JSON.pretty_generate(report)
        else
          pending = report.fetch("scenario_metadata").count { |entry| entry.fetch("pending") }
          summary = report.fetch("summary")
          puts "selected #{report.fetch('scenario_metadata').size}, executed #{summary.fetch('total')}, " \
               "pending #{pending}, passed #{summary.fetch('passed')}, " \
               "failed #{summary.fetch('failed') + summary.fetch('setup_failed', 0)}"
        end
        summary = report.fetch("summary")
        failed = summary.fetch("failed") + summary.fetch("setup_failed", 0)
        exit(failed.zero? ? BinaryExit::SUCCESS : BinaryExit::FAILURE)
      rescue CoverageCatalog::UnknownCoverage => e
        exit_with_error(e, error_kind: "no_scenarios", exit_code: BinaryExit::USAGE)
      rescue PreflightError, CoverageCatalog::InvalidCatalog, ScenarioParser::InvalidScenario, Psych::Exception => e
        exit_with_error(e, error_kind: "preflight", exit_code: BinaryExit::CONFIG)
      rescue StandardError => e
        exit_with_error(e, error_kind: "run_failed", exit_code: BinaryExit::FAILURE)
      end
      map "run" => :run_scenarios

      desc "version", "Print hive gem version"
      def version
        if options[:json]
          puts JSON.pretty_generate(
            "schema" => "hive-e2e-version",
            "schema_version" => Hive::E2E::Schemas.version_for("hive-e2e-version"),
            "version" => Hive::VERSION
          )
        else
          puts Hive::VERSION
        end
      end

      desc "list", "List available e2e scenarios"
      def list
        scenarios = CoverageCatalog.load.scenarios
        if options[:json]
          payload = {
            "schema" => "hive-e2e-scenarios",
            "schema_version" => Hive::E2E::Schemas.version_for("hive-e2e-scenarios"),
            "scenarios" => scenarios.map { |scenario| scenario_summary(scenario) }
          }
          puts JSON.pretty_generate(payload)
        else
          scenarios.each do |scenario|
            tags = scenario.tags.empty? ? "" : " [#{scenario.tags.join(', ')}]"
            pending = scenario.pending ? " (pending: #{scenario.sibling_task_id})" : ""
            puts "#{scenario.name}#{tags}#{pending}"
          end
        end
      rescue CoverageCatalog::InvalidCatalog, ScenarioParser::InvalidScenario, Psych::Exception => e
        exit_with_error(e, error_kind: "preflight", exit_code: BinaryExit::CONFIG)
      end

      desc "coverage", "Discover semantic e2e coverage"
      option :match, type: :string, required: true,
                     desc: "match a coverage ID or catalog/scenario metadata"
      option :profile, type: :string, desc: "limit discovery to a semantic profile"
      def coverage
        catalog = CoverageCatalog.load
        matches = catalog.search(options[:match], profile: options[:profile])
        if matches.empty?
          exit_with_error(
            "no coverage matches #{options[:match]}",
            error_kind: "no_scenarios",
            exit_code: BinaryExit::USAGE
          )
        end

        payload = catalog.discovery_payload(
          query: options[:match],
          profile: options[:profile],
          matches: matches
        )
        if options[:json]
          puts JSON.pretty_generate(payload)
        else
          render_coverage(matches)
        end
      rescue CoverageCatalog::InvalidCatalog, ScenarioParser::InvalidScenario, Psych::Exception => e
        exit_with_error(e, error_kind: "preflight", exit_code: BinaryExit::CONFIG)
      rescue ArgumentError => e
        exit_with_error(e, error_kind: "usage", exit_code: BinaryExit::USAGE)
      end

      desc "replay RUN_ID SCENARIO", "Replay a stored scenario repro script"
      def replay(run_id, scenario)
        run_id = PathSafety.safe_basename!(run_id, "run_id")
        scenario = PathSafety.safe_basename!(scenario, "scenario")
        runs_root = File.expand_path(Paths.runs_dir)
        run_dir = PathSafety.contained_path!(runs_root, run_id, "run dir")
        scenario_root = PathSafety.contained_path!(run_dir, "scenarios", "scenario root")
        scenario_dir = PathSafety.contained_path!(scenario_root, scenario, "scenario dir")
        script = PathSafety.contained_path!(scenario_dir, "repro.sh", "repro script")
        unless File.exist?(script) || File.symlink?(script)
          exit_with_error(
            "Run ##{run_id} scenario #{scenario} has no repro.sh; the run may have completed successfully (#{script})",
            error_kind: "missing_repro",
            exit_code: BinaryExit::CONFIG
          )
        end
        unless artifact_path_without_symlinks?(runs_root, run_dir, scenario_root, scenario_dir, script) &&
               File.lstat(script).file? && File.executable?(script)
          exit_with_error(
            "Run ##{run_id} scenario #{scenario} repro.sh is not executable (#{script})",
            error_kind: "unusable_repro",
            exit_code: BinaryExit::CONFIG
          )
        end

        exec([ script, File.basename(script) ])
      rescue ArgumentError => e
        exit_with_error(e, error_kind: "usage", exit_code: BinaryExit::USAGE)
      end

      desc "clean", "Remove old e2e run artifacts"
      option :retain_days, type: :string,
                           desc: "days to retain passing runs (env: HIVE_E2E_RUNS_RETAIN_DAYS)"
      option :retain_failed_days, type: :string,
                                  desc: "days to retain failed runs (env: HIVE_E2E_RUNS_RETAIN_FAILED_DAYS)"
      option :dry_run, type: :boolean, default: false, desc: "show which runs would be deleted without deleting them"
      def clean
        retain_days = parse_retention_window(
          retention_value(:retain_days, namespaced: "HIVE_E2E_RUNS_RETAIN_DAYS",
                                         legacy: "RUNS_RETAIN_DAYS", fallback: "7"),
          "retain_days"
        )
        retain_failed_days = parse_retention_window(
          retention_value(:retain_failed_days, namespaced: "HIVE_E2E_RUNS_RETAIN_FAILED_DAYS",
                                                legacy: "RUNS_RETAIN_FAILED_DAYS", fallback: "14"),
          "retain_failed_days"
        )
        result = Sandbox.cleanup_runs(retain_days: retain_days, retain_failed_days: retain_failed_days,
                                      dry_run: options[:dry_run])
        deleted = result.fetch("deleted")
        kept = result.fetch("kept")
        if options[:json]
          puts JSON.pretty_generate(
            "schema" => "hive-e2e-clean",
            "schema_version" => Hive::E2E::Schemas.version_for("hive-e2e-clean"),
            "deleted" => deleted,
            "kept" => kept,
            "dry_run" => options[:dry_run],
            "deleted_runs" => result.fetch("deleted_runs"),
            "kept_runs" => result.fetch("kept_runs")
          )
        else
          puts "deleted: #{deleted}, kept: #{kept}"
        end
      rescue ArgumentError => e
        exit_with_error(e, error_kind: "usage", exit_code: BinaryExit::USAGE)
      end

      private

      def semantic_selection(catalog, pattern)
        selectors = [ options[:profile], options[:coverage] ].compact
        if selectors.size > 1 || (selectors.any? && (pattern || options[:filter]))
          exit_with_error(
            "--profile and --coverage are mutually exclusive and cannot be combined with PATTERN or --filter",
            error_kind: "usage",
            exit_code: BinaryExit::USAGE
          )
        end
        return catalog.select_profile(options[:profile]) if options[:profile]
        return catalog.select_coverage(options[:coverage]) if options[:coverage]
      end

      def filter_scenarios(scenarios, pattern:, tag:)
        selected = scenarios
        if pattern && !pattern.empty?
          selected = selected.select do |scenario|
            scenario.name.include?(pattern.to_s) || File.basename(scenario.path).include?(pattern.to_s)
          end
        end
        selected = selected.select { |scenario| scenario.tags.include?(tag.to_s) } if tag && !tag.empty?
        selected
      end

      def render_coverage(matches)
        matches.each_with_index do |match, index|
          puts if index.positive?
          puts "#{match.fetch('id')} — #{match.fetch('title')} " \
               "(#{match.fetch('maturity')}; profiles: #{match.fetch('profiles').join(', ')})"
          puts "  #{match.fetch('description')}"
          primary = match.fetch("primary_scenario")
          puts "  primary: #{primary ? primary.fetch('name') : 'none'}#{primary&.fetch('pending') ? ' (pending)' : ''}"
          supporting = match.fetch("supporting_scenarios").map { |scenario| scenario.fetch("name") }
          puts "  supporting: #{supporting.empty? ? 'none' : supporting.join(', ')}"
          constraints = match.fetch("constraints").flat_map do |kind, values|
            values.map { |value| "#{kind}=#{value}" }
          end
          puts "  constraints: #{constraints.empty? ? 'none' : constraints.join(', ')}"
          puts "  docs: #{match.fetch('docs').join(', ')}"
          puts "  code: #{match.fetch('code').join(', ')}"
          puts "  run: #{match.fetch('runnable_command')}" if match.fetch("runnable_command")
        end
      end

      def scenario_summary(scenario)
        {
          "name" => scenario.name,
          "tags" => scenario.tags,
          "description" => scenario.description,
          "path" => scenario.path,
          "steps_count" => scenario.steps.size,
          "incident_id" => scenario.incident_id,
          "sibling_task_id" => scenario.sibling_task_id,
          "pending" => scenario.pending
        }
      end

      def tui_scenario?(scenario)
        !scenario.pending && scenario.steps.any? { |step| ScenarioParser::TMUX_STEP_KINDS.include?(step.kind) }
      end

      def artifact_path_without_symlinks?(*paths)
        paths.none? { |path| File.lstat(path).symlink? }
      rescue Errno::ENOENT
        false
      end

      def exit_with_error(error, error_kind:, exit_code:)
        message = error.respond_to?(:message) ? error.message : error.to_s
        if options[:json]
          puts JSON.pretty_generate(JsonError.payload(error_kind: error_kind, message: message,
                                                     exit_code: exit_code, command: invoked_command))
        else
          warn "hive-e2e: #{message}"
        end
        exit exit_code
      end

      def invoked_command
        command = current_command_chain.last
        command.to_s == "run_scenarios" ? "run" : command&.to_s
      end

      def parse_retention_window(value, label)
        days = begin
          Integer(value.to_s, 10)
        rescue ArgumentError
          raise ArgumentError, "#{label} must be a non-negative integer (got #{value.inspect})"
        end
        raise ArgumentError, "#{label} must be >= 0" if days.negative?

        days
      end

      def retention_value(option, namespaced:, legacy:, fallback:)
        explicit = options[option]
        return explicit unless explicit.nil?
        return ENV.fetch(namespaced) if ENV.key?(namespaced)
        return fallback unless ENV.key?(legacy)

        warn "hive-e2e: #{legacy} is deprecated; use #{namespaced} instead"
        ENV.fetch(legacy)
      end
    end
  end
end

def wrapper_option_argv(argv)
  Hive::CliJsonOptions.option_argv(argv)
end

def rewrite_help_flag!(argv)
  return if argv.empty?

  option_argv = wrapper_option_argv(argv)
  cmd_idx = option_argv.index { |arg| !arg.start_with?("-") }
  return unless cmd_idx

  help_idx = option_argv[(cmd_idx + 1)..]&.index { |arg| arg == "--help" || arg == "-h" }
  return unless help_idx

  command = argv[cmd_idx]
  known_commands = Hive::E2E::Binary.all_tasks.keys + [ "run" ]
  help_target = known_commands.include?(command) ? command : "run"
  argv.replace(argv[0...cmd_idx] + [ "help", help_target ])
end

JSON_BOOLEAN_OPTIONS = Hive::CliJsonOptions::BOOLEAN_OPTIONS
TOP_LEVEL_FLAGS = %w[--help -h --version -v].freeze

# Mirror Thor's boolean grammar for --json so the envelope/prose decision
# matches what the inner commands actually parse. Thor's truthy set for a
# boolean option value is the exact-match list `true`, `TRUE`, `t`, `T` (NOT
# case-insensitive — `True`/`tRuE` are not honored), so we accept bare `--json`
# plus exactly those spellings. False forms do not request JSON; unsupported
# `--json=<value>` assignments are rejected before Thor can use the value as a
# command or pattern.
def json_requested?(argv)
  Hive::CliJsonOptions.requested?(argv)
end

def reject_invalid_argv_encoding!(argv)
  idx = argv.index { |arg| !arg.dup.force_encoding(Encoding::UTF_8).valid_encoding? }
  return unless idx

  raise Thor::MalformattedArgumentError, "invalid byte sequence in argument #{idx + 1}"
end

def reject_unsupported_json_assignments!(argv)
  arg = Hive::CliJsonOptions.unsupported_assignment(argv)
  return unless arg

  raise Thor::MalformattedArgumentError, "invalid boolean value for --json: #{arg.split('=', 2).last.inspect}"
end

RETENTION_VALUE_OPTIONS = %w[--retain-days --retain-failed-days].freeze

def reject_missing_retention_values!(argv)
  return unless argv.first == "clean"

  wrapper_option_argv(argv).each_index do |idx|
    arg = argv[idx]
    next unless RETENTION_VALUE_OPTIONS.include?(arg)

    value = argv[idx + 1]
    next if value && !value.empty? && (!value.start_with?("-") || value.match?(/\A-\d+\z/))

    raise Thor::MalformattedArgumentError, "No value provided for option '#{arg}'"
  end
end

HELP_FLAGS = %w[--help -h].freeze

def normalize_leading_global_options!(argv)
  leading = []
  leading << argv.shift while JSON_BOOLEAN_OPTIONS.include?(argv.first)
  return if leading.empty?

  commands = Hive::E2E::Binary.all_tasks.keys + [ "run" ]

  # A *bare* top-level flag (`--json --version`, `--json -h`) is handled as
  # human-only version/help output, so the leading --json is irrelevant and
  # stays dropped. But when tokens trail the flag (`--json --version --filter
  # tui`) it is no longer a standalone top-level invocation: Thor consumes it
  # as a pattern and dispatches into `run_scenarios`, whose body reads
  # `options[:json]`. Restore --json there so the command honors the caller's
  # JSON request instead of emitting prose (the outer rescue's json_mode
  # snapshot only guards Thor-level errors, not the command body).
  if TOP_LEVEL_FLAGS.include?(argv.first)
    return if argv.length == 1

    # `--json --help <command>` / `--json -h <command>` requests that command's
    # help. Thor renders command help natively when a help flag leads and a
    # recognized command follows (exactly as `--help run` does) — but only while
    # the leading --json stays dropped. Restoring --json ahead of --help makes
    # Thor stop treating --help as the help switch and instead dispatch into
    # run_scenarios with [--help, <command>], exiting 64. Help output is human
    # prose, so the now-irrelevant --json can stay dropped. Non-command trailers
    # (`--json --help missing`, `--json --help --filter tui`) fall through to the
    # restore path so their usage errors still honor the JSON-envelope contract.
    return if HELP_FLAGS.include?(argv.first) && commands.include?(argv[1])

    return argv.unshift(*leading)
  end

  cmd_idx = argv.index { |arg| commands.include?(arg) }
  return argv.unshift(*leading) unless cmd_idx

  argv.insert(cmd_idx + 1, *leading)
end

# Snapshot the caller's JSON request from the pristine ARGV. Normalization can
# shift a leading `--json` out of ARGV and then return early without restoring
# it (e.g. `--json --help missing`, `--json --version extra`, where a top-level
# flag follows the class option). If Thor later raises a usage error, the rescue
# blocks below would otherwise consult a mutated ARGV that no longer carries the
# flag and emit prose on stderr instead of honoring the JSON-envelope contract.
json_mode = json_requested?(ARGV)

begin
  reject_invalid_argv_encoding!(ARGV)
  reject_unsupported_json_assignments!(ARGV)
  normalize_leading_global_options!(ARGV)
  if ARGV == [ "--version" ] || ARGV == [ "-v" ]
    puts Hive::VERSION
    exit 0
  end
  rewrite_help_flag!(ARGV)
  reject_missing_retention_values!(ARGV)
  # Thor::Base#start rescues Thor::Error internally and exits 1 when
  # exit_on_failure? is true. Passing `debug: true` makes Thor re-raise
  # instead so the rescue below can preserve human/JSON formatting while
  # mapping usage failures to BinaryExit::USAGE.
  Hive::E2E::Binary.start(ARGV, debug: true)
rescue Hive::E2E::PreflightError => e
  if json_mode
    puts JSON.pretty_generate(Hive::E2E::JsonError.payload(error_kind: "preflight", message: e.message,
                                                          exit_code: Hive::E2E::BinaryExit::CONFIG))
  else
    warn "hive-e2e: #{e.message}"
  end
  exit Hive::E2E::BinaryExit::CONFIG
rescue Thor::Error => e
  if json_mode
    puts JSON.pretty_generate(Hive::E2E::JsonError.payload(error_kind: "usage", message: e.message,
                                                          exit_code: Hive::E2E::BinaryExit::USAGE))
  else
    warn "hive-e2e: #{e.message}"
  end
  exit Hive::E2E::BinaryExit::USAGE
rescue StandardError => e
  if json_mode
    puts JSON.pretty_generate(Hive::E2E::JsonError.payload(error_kind: "error", message: e.message,
                                                          exit_code: Hive::E2E::BinaryExit::FAILURE))
  else
    warn "hive-e2e: #{e.message}"
  end
  exit Hive::E2E::BinaryExit::FAILURE
end
