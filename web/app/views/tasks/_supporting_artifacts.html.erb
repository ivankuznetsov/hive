<% records = Array(result["supporting"]) %>
<% if records.any? %>
  <section id="workspace-supporting-artifacts" class="workspace-panel workspace-wide"
           aria-labelledby="workspace-supporting-artifacts-heading">
    <div class="workspace-panel-heading">
      <div>
        <h2 id="workspace-supporting-artifacts-heading">Documents</h2>
      </div>
      <span class="workspace-state-label"><%= records.length %></span>
    </div>
    <div data-controller="artifacts">
      <% records.each do |record| %>
        <details class="artifact" data-artifact-name="<%= record.fetch("name") %>"
                 data-workspace-disclosure-key="supporting-artifact-<%= record.fetch("reference") %>">
          <summary><%= artifact_label(record) %><% if artifact_label(record) != record.fetch("name") %> <span class="artifact-file"><%= record.fetch("name") %></span><% end %><% if record["truncated"] %> <span class="workspace-state-label">Partial</span><% end %></summary>
          <div class="artifact-body">
            <% if record["binary"] %>
              <p class="workspace-empty">Binary content is not rendered.</p>
            <% elsif record["content"].nil? %>
              <p class="workspace-empty">This document could not be loaded.</p>
            <% elsif record.fetch("name").end_with?(".md") %>
              <div class="markdown"><%= render_markdown(record.fetch("content")) %></div>
            <% else %>
              <pre><%= record.fetch("content") %></pre>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
  </section>
<% end %>
