<% attempts = workspace.dig("panels", "attempts") %>
<% resources = workspace.dig("panels", "resources") %>
<% records = Array(attempts["records"]) %>
<% current = records.find { |attempt| attempt["current"] } %>

<section id="workspace-attempts" class="workspace-panel workspace-state-<%= attempts.fetch("state") %>"
         aria-labelledby="workspace-attempts-heading">
  <div class="workspace-panel-heading">
    <div>
      <h2 id="workspace-attempts-heading">Attempts and resources</h2>
      <p class="muted"><span class="workspace-state-label"><%= attempts.fetch("state").humanize %></span> attempt evidence</p>
    </div>
    <% if current %>
      <span class="workspace-chip">Current · <%= current.fetch("stage").presence || "stage unavailable" %></span>
    <% end %>
  </div>

  <% if records.empty? %>
    <p class="workspace-empty">No durable attempt binding is available for this task.</p>
  <% else %>
    <ol class="attempt-list">
      <% records.sort_by { |attempt| [attempt["current"] ? 0 : 1, attempt["accepted_at"].to_s] }.each do |attempt| %>
        <li id="<%= stable_dom_id("attempt", attempt.fetch("attempt_id")) %>"
            class="attempt-card<%= " attempt-current" if attempt["current"] %>">
          <div class="attempt-heading">
            <strong><%= attempt["current"] ? "Current attempt" : "Historical attempt" %></strong>
            <span class="workspace-state-label"><%= attempt.fetch("state").to_s.humanize.presence || "Unavailable" %></span>
          </div>
          <dl class="workspace-facts workspace-facts-compact">
            <div><dt>Identity</dt><dd><code><%= attempt.fetch("attempt_id").first(24) %></code></dd></div>
            <div><dt>Generation</dt><dd><%= attempt["task_generation"] || "Unavailable" %></dd></div>
            <div><dt>Provider</dt><dd><%= attempt.dig("requested_provider", "value").presence || "Unavailable" %></dd></div>
            <div><dt>Outcome</dt><dd><%= attempt["outcome"].to_s.humanize.presence || "Unavailable" %></dd></div>
          </dl>

          <% sessions = Array(attempt["sessions"]) %>
          <% if sessions.any? %>
            <h3>Sessions</h3>
            <ul class="session-list">
              <% sessions.each do |session| %>
                <li id="<%= stable_dom_id("session", session.fetch("session_id")) %>">
                  <div>
                    <strong><%= session["role"].to_s.humanize.presence || "Child session" %></strong>
                    <code><%= session.fetch("session_id").first(20) %></code>
                  </div>
                  <p>
                    <span class="workspace-state-label"><%= session["live"] ? "Live" : (session["health"].to_s.humanize.presence || "Completed") %></span>
                    · <%= session["provider"].presence || "provider unavailable" %>
                    · <%= session.dig("actual_model", "value").presence || session.dig("requested_model", "value").presence || "model unavailable" %>
                    <% if session["requested_effort"].present? %>· <%= session["requested_effort"] %> effort<% end %>
                  </p>
                  <p class="muted">
                    Started <%= session["started_at"].presence || "at an unavailable time" %>
                    <% if session["ended_at"].present? %>· ended <%= session["ended_at"] %><% end %>
                    <% if session["timed_out"] %>· timed out<% end %>
                  </p>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="muted">No session observations are attributed to this attempt.</p>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% end %>

  <div id="workspace-resources" class="workspace-subsection workspace-state-<%= resources.fetch("state") %>">
    <h3>Resource truth</h3>
    <% resource_records = Array(resources["records"]) %>
    <% if resource_records.empty? %>
      <p class="workspace-empty">Configured guards and attempt-attributed usage are unavailable.</p>
    <% else %>
      <div class="workspace-table-scroll" tabindex="0" role="region" aria-label="Resource guards and observed usage">
        <table class="workspace-table">
          <caption>Configured guards and separately observed usage</caption>
          <thead>
            <tr><th scope="col">Kind</th><th scope="col">Scope</th><th scope="col">Configured</th><th scope="col">Observed</th><th scope="col">Headroom</th><th scope="col">State</th></tr>
          </thead>
          <tbody>
            <% resource_records.each do |resource| %>
              <% if resource["record_kind"] == "guard" %>
                <tr>
                  <th scope="row"><%= resource["label"] %></th>
                  <td><%= resource["scope"].to_s.humanize.presence || "Unavailable" %></td>
                  <td><%= resource["configured"].nil? ? "Unavailable" : "#{resource['configured']} #{resource['unit']}" %></td>
                  <td><%= resource["observed"].nil? ? "Unavailable" : "#{resource['observed']} #{resource['unit']}" %></td>
                  <td><%= resource["headroom"].nil? ? "Not computable" : "#{resource['headroom']} #{resource['unit']}" %></td>
                  <td><span class="workspace-state-label"><%= resource.fetch("state").humanize %></span></td>
                </tr>
              <% else %>
                <tr>
                  <th scope="row">Observed token usage</th>
                  <td><%= Array(resource["sessions"]).length %> attributed sessions</td>
                  <td>Not a guard</td>
                  <td><%= resource.dig("totals", "tokens") || "Unavailable" %></td>
                  <td>Not applicable</td>
                  <td><span class="workspace-state-label"><%= resource.fetch("state").humanize %></span></td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <% diagnostics = (Array(attempts["diagnostics"]) + Array(resources["diagnostics"])).uniq %>
  <% if diagnostics.any? %>
    <details class="workspace-diagnostics" data-workspace-disclosure-key="attempt-diagnostics">
      <summary>Attempt and resource diagnostics (<%= diagnostics.length %>)</summary>
      <ul><% diagnostics.each do |row| %><li><%= row.fetch("reason").to_s.humanize %></li><% end %></ul>
    </details>
  <% end %>
</section>
