diff --git a/lib/honeycomb_registry/release_verification.rb b/lib/honeycomb_registry/release_verification.rb
new file mode 100644
index 0000000..ea3138e
--- /dev/null
+++ b/lib/honeycomb_registry/release_verification.rb
@@ -0,0 +1,17 @@
+# frozen_string_literal: true
+
+require "digest"
+
+module HoneycombRegistry
+  module ReleaseVerification
+    module_function
+
+    def archive_sha256(manifest)
+      projection = {
+        "release_sha256" => manifest.fetch("release_sha256"),
+        "files" => manifest.fetch("files").sort.to_h
+      }
+      Digest::SHA256.hexdigest(CanonicalJSON.dump(projection))
+    end
+  end
+end
