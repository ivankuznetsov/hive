+# frozen_string_literal: true
+
+require "json"
+require "open3"
+
+class HealthApp
+  VERSION = "0.1.0"
+
+  def self.call(environment)
+    return [404, { "content-type" => "text/plain" }, ["not found\n"]] unless environment["PATH_INFO"] == "/healthz"
+
+    body = JSON.generate(status: "ok", version: VERSION, revision: revision)
+    [
+      200,
+      { "content-type" => "application/json", "content-length" => body.bytesize.to_s },
+      [body]
+    ]
+  end
+
+  def self.revision(command_runner: Open3.method(:capture2))
+    output, status = command_runner.call("git", "rev-parse", "--short", "HEAD")
+    value = output.strip
+    status.success? && !value.empty? ? value : "unknown"
+  rescue Errno::ENOENT
+    "unknown"
+  end
+end
