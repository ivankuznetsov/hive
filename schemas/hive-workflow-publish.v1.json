{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-workflow-publish.v1.json",
  "title": "hive workflow publish output v1",
  "oneOf": [
    {"$ref": "#/$defs/SuccessPayload"},
    {"$ref": "#/$defs/ErrorPayload"}
  ],
  "$defs": {
    "SuccessPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "ok", "status", "name", "version", "manifest_digest", "warnings", "pr_url", "listed"],
      "properties": {
        "schema": {"const": "hive-workflow-publish"},
        "schema_version": {"const": 1},
        "ok": {"const": true},
        "status": {"const": "pending_review"},
        "name": {"type": "string"},
        "version": {"type": "string"},
        "manifest_digest": {"type": "string"},
        "warnings": {"type": "array", "items": {"type": "object"}},
        "pr_url": {"type": "string"},
        "listed": {"const": false}
      }
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "ok", "error_class", "error_kind", "exit_code", "message"],
      "properties": {
        "schema": {"const": "hive-workflow-publish"},
        "schema_version": {"const": 1},
        "ok": {"const": false},
        "error_class": {"type": "string"},
        "error_kind": {"enum": ["consent_required", "ownership", "update_required", "concurrent_run", "git", "config", "registry", "error"]},
        "exit_code": {"enum": [1, 64, 69, 70, 75, 78]},
        "message": {"type": "string"},
        "holder": {"type": "object", "additionalProperties": true},
        "lock_path": {"type": "string"}
      }
    }
  }
}
