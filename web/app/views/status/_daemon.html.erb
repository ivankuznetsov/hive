<% running = daemon_status["running"] %>
<% drift = daemon_status["binary_drift"].to_s %>
<% actionable_drift = Hive::Daemon::StatusReport::BINARY_DRIFT_ACTIONABLE.include?(drift) %>
<% panel_state = running ? (actionable_drift ? "warning" : "running") : "stopped" %>
<section class="daemon-panel daemon-panel-<%= panel_state %>" aria-label="Daemon status">
  <div class="daemon-summary">
    <span class="status-dot <%= running ? "status-dot-running" : "status-dot-error" %>" aria-hidden="true"></span>
    <strong>Daemon <%= running ? "running" : "stopped" %></strong>
  </div>
  <%#
    The Repair button only ENQUEUES a daemon-consumed dispatch request
    (Daemon#repair!); the web tier never shells out to start
    a daemon itself (KTD-4/U5). So the affordance can only work when the daemon
    is already running to drain the queue — gate on running==true. When the
    daemon is down or not installed (drift can't even be measured, or no unit
    exists), an enqueued repair would sit unconsumed forever, so show CLI
    guidance instead of a button that silently does nothing.
  %>
  <% if running && actionable_drift %>
    <div class="daemon-action">
      <span class="daemon-warning">Binary path differs</span>
      <%= button_to "Repair", daemon_repair_path, method: :post,
            class: "btn btn-sm",
            form: { data: { turbo_confirm: "Reinstall the daemon service with the current hive binary?" } } %>
    </div>
  <% elsif !running && (actionable_drift || daemon_status["service_installed"] == false) %>
    <span class="daemon-guidance">
      Run <code>hive daemon install --force</code> to repair the service.
    </span>
  <% elsif !running %>
    <span class="daemon-guidance">
      Run <code>hive daemon start --detach</code> to resume work.
    </span>
  <% end %>
</section>
