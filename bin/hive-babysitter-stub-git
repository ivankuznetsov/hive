#!/usr/bin/env ruby
# frozen_string_literal: true

def log_skip(argv)
  path = ENV.fetch("HIVE_BABYSITTER_DRY_RUN_LOG", ".babysitter-dry-run-skipped.log")
  File.open(path, "a") { |file| file.puts("[dry-run] git #{argv.join(' ')} skipped") }
rescue SystemCallError
  nil
end

argv = ARGV.dup

UNSAFE_CONFIG_KEYS = [
  "core.askpass",
  "core.editor",
  "core.fsmonitor",
  "core.hookspath",
  "core.pager",
  "core.sshcommand",
  "diff.external",
  "gpg.program",
  "include.path",
  "sequence.editor",
  "ssh.variant",
  "uploadpack.packobjectshook"
].freeze
# Environment-variable equivalents of the unsafe config keys above, plus the
# config-injection channels (GIT_CONFIG_COUNT/KEY_*/VALUE_*, GIT_CONFIG_PARAMETERS).
# Even an allowlisted read-only command would otherwise run these hooks/programs
# because git reads them from the inherited environment, not just argv.
UNSAFE_ENV_VARS = [
  "GIT_ASKPASS",
  "GIT_CONFIG",
  "GIT_CONFIG_COUNT",
  "GIT_CONFIG_GLOBAL",
  "GIT_CONFIG_PARAMETERS",
  "GIT_CONFIG_SYSTEM",
  "GIT_EDITOR",
  "GIT_EXTERNAL_DIFF",
  "GIT_PAGER",
  "GIT_PROXY_COMMAND",
  "GIT_SEQUENCE_EDITOR",
  "GIT_SSH",
  "GIT_SSH_COMMAND"
].freeze
UNSAFE_ENV_PREFIXES = [
  "GIT_CONFIG_KEY_",
  "GIT_CONFIG_VALUE_"
].freeze

def scrub_unsafe_env!
  UNSAFE_ENV_VARS.each { |name| ENV.delete(name) }
  ENV.keys.each do |name|
    ENV.delete(name) if UNSAFE_ENV_PREFIXES.any? { |prefix| name.start_with?(prefix) }
  end
end

UNSAFE_CONFIG_PREFIXES = [
  "alias.",
  "credential.",
  "filter.",
  "gpg.",
  "hook.",
  "hooks.",
  "includeif.",
  "pager.",
  "protocol.ext."
].freeze

def unsafe_config_key?(assignment)
  key = assignment.to_s.split("=", 2).first.to_s.downcase
  UNSAFE_CONFIG_KEYS.include?(key) ||
    UNSAFE_CONFIG_PREFIXES.any? { |prefix| key.start_with?(prefix) }
end

def unsafe_global_options?(argv)
  rest = argv.dup
  loop do
    case rest.first
    when "-C", "--git-dir", "--work-tree"
      rest.shift(2)
    when "-c"
      return true if unsafe_config_key?(rest[1])

      rest.shift(2)
    when /\A-c(.+)\z/
      return true if unsafe_config_key?(Regexp.last_match(1))

      rest.shift
    when "--config-env"
      return true if unsafe_config_key?(rest[1])

      rest.shift(2)
    when /\A--config-env=(.+)\z/
      return true if unsafe_config_key?(Regexp.last_match(1))

      rest.shift
    when "-p", "--paginate"
      return true
    when /\A--exec-path(?:=|\z)/
      return true
    when /\A--git-dir=/, /\A--work-tree=/
      rest.shift
    when /\A-/
      rest.shift
    else
      break
    end
  end
  false
end

def stripped_global_options(argv)
  rest = argv.dup
  loop do
    case rest.first
    when "-C", "-c", "--git-dir", "--work-tree"
      rest.shift(2)
    when /\A--git-dir=/, /\A--work-tree=/
      rest.shift
    when /\A-/
      rest.shift
    else
      break
    end
  end
  rest
end

def read_only_remote?(rest)
  args = rest[1..] || []
  args.shift while [ "-v", "--verbose" ].include?(args.first)
  return true if args.empty?

  case args.first
  when "show"
    args.shift
    args.shift if args.first == "-n"
    args.all? { |arg| !arg.start_with?("-") }
  when "get-url"
    args.shift
    args.shift while [ "--push", "--all" ].include?(args.first)
    args.length == 1 && !args.first.start_with?("-")
  else
    false
  end
end

def read_only?(rest)
  case rest.first.to_s
  when "branch"
    rest.length == 1 || rest.include?("--show-current") || rest.include?("--contains")
  when "cat-file", "describe", "diff", "grep", "log", "ls-files", "ls-tree", "merge-base",
       "rev-list", "rev-parse", "show", "status"
    true
  when "remote"
    read_only_remote?(rest)
  when "config"
    rest.include?("--get") || rest.include?("--get-all") || rest.include?("--list")
  else
    false
  end
end

# git grep short options that consume the rest of a bundled cluster as their
# value, so any "O" appearing after them is data, not the pager flag.
GREP_VALUE_SHORT_OPTS = %w[e f m A B C].freeze

def short_cluster_opens_pager?(arg)
  return false unless arg.start_with?("-") && !arg.start_with?("--")

  arg[1..].to_s.each_char do |char|
    return true if char == "O"

    break if GREP_VALUE_SHORT_OPTS.include?(char)
  end
  false
end

def unsafe_command_options?(rest)
  return false unless rest.first.to_s == "grep"

  rest[1..].to_a.any? do |arg|
    arg == "--open-files-in-pager" || arg.start_with?("--open-files-in-pager=") ||
      short_cluster_opens_pager?(arg)
  end
end

rest = stripped_global_options(argv)

if unsafe_global_options?(argv) || unsafe_command_options?(rest) || !read_only?(rest)
  log_skip(argv)
  warn "[dry-run] git #{argv.join(' ')} skipped"
  exit 0
end

real = ENV["HIVE_BABYSITTER_REAL_GIT"].to_s
if real.empty?
  warn "hive-babysitter dry-run: HIVE_BABYSITTER_REAL_GIT is unset; refusing to guess a path for the real git binary"
  exit 127
end
scrub_unsafe_env!
Kernel.exec(real, *argv)
