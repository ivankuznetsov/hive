    "selected_theses": [
      {
        "id": "make-worktree-lifecycle-boundary-authoritative",
        "route": "fix",
        "feature_id": "architecture-lib-hive-commands",
        "problem": "the ad-hoc review command compensates for a lossy Worktree boundary by classifying pointer failures itself and independently mirroring Babysitter's orphan-worktree cleanup policy",
        "proposed_refactor": "make Hive::Worktree's internal lifecycle API authoritative for typed pointer inspection and idempotent orphan cleanup with residue reporting, then have AdhocReview and Babysitter delegate while preserving CLI output, warnings, cleanup order, error envelopes, and pinned reuse behavior"
      },
      {
        "id": "make-routing-decision-own-selected-candidate",
        "route": "fix",
        "feature_id": "architecture-lib-hive-provider-routing-part-2",
        "problem": "ProviderRouting::Router selects a candidate, but Attempts::Dispatcher repeats the first-eligible search from the decision's diagnostic candidate collection to recover the selected health evaluation",
        "proposed_refactor": "have Router attach its chosen Candidate to Decision as internal selected-candidate state and make Dispatcher consume that state, while preserving Decision#to_h, persisted records, statuses, reasons, and dispatch outcomes"
      },
      {
        "id": "centralize-review-session-capability",
        "route": "fix",
        "feature_id": "architecture-lib-hive-reviewers",
        "problem": "the reviewer adapter, review orchestrator, triage, and browser-test boundaries independently decide whether a provider requires Claude-specific session-aware launching",
        "proposed_refactor": "make a provider-neutral review-session capability and launch strategy authoritative beside AgentProfile, then have reviewer execution, orchestration, triage, and browser testing delegate to it while preserving existing Claude tmux behavior, non-Claude headless behavior, errors, timeouts, and output contracts"
      }
    ],
