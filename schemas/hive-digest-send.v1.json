{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-digest-send.v1.json",
  "title": "Hive daily activity digest Telegram delivery envelope (v1)",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "schema_version", "ok", "local_date", "record_id",
        "amendment_frontier", "payload_hash", "outcome", "attempt",
        "deduplicated", "retry_requested", "web_url"
      ],
      "properties": {
        "schema": { "const": "hive-digest-send" },
        "schema_version": { "const": 1 },
        "ok": { "const": true },
        "local_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "record_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "amendment_frontier": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "payload_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "outcome": { "enum": ["sent", "suppressed_empty", "unknown", "failed"] },
        "attempt": { "type": "integer", "minimum": 1 },
        "deduplicated": { "type": "boolean" },
        "retry_requested": { "type": "boolean" },
        "web_url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    { "$ref": "#/$defs/Error" }
  ],
  "$defs": {
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "ok", "error_class", "error_kind", "exit_code", "message"],
      "properties": {
        "schema": { "const": "hive-digest-send" },
        "schema_version": { "const": 1 },
        "ok": { "const": false },
        "error_class": { "type": "string" },
        "error_kind": {
          "enum": ["usage", "missing", "pruned", "not_closed", "delivery_failed", "delivery_in_flight", "config", "digest_error", "internal"]
        },
        "exit_code": { "type": "integer" },
        "message": { "type": "string" }
      }
    }
  }
}
