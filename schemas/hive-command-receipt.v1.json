{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:command-receipt:v1",
  "title": "hive receipt maintenance output (v1)",
  "oneOf": [
    { "$ref": "#/$defs/SuccessPayload" },
    { "$ref": "#/$defs/ErrorPayload" }
  ],
  "$defs": {
    "SuccessPayload": {
      "type": "object",
      "required": ["schema", "schema_version", "ok", "operation", "preview", "confirmed"],
      "properties": {
        "schema": { "const": "hive-command-receipt" },
        "schema_version": { "const": 1 },
        "ok": { "const": true },
        "operation": {
          "type": "string",
          "enum": ["retire", "orphaned_owner", "release_pin", "abandon_batch", "enroll"]
        },
        "preview": { "type": "boolean" },
        "confirmed": { "type": "boolean" },
        "receipt_id": { "type": "string" },
        "pin_id": { "type": "string" },
        "batch_id": { "type": "string" },
        "generation": { "type": "integer", "minimum": 0 },
        "state": { "type": "string" },
        "outcome": { "type": "string" },
        "warning": { "type": "string" },
        "evidence": { "type": "object" },
        "prior_progress": { "type": "array" },
        "command_receipt": { "type": "object" },
        "retry_horizon_expires_at": { "type": ["string", "null"] },
        "observed_at": { "type": "string" },
        "horizon_evidence": { "type": "string" },
        "horizon_elapsed": { "type": "boolean" },
        "elapsed_seconds": { "type": "number", "minimum": 0 },
        "previous_identity": { "type": "string" },
        "expected_generation": { "type": "integer", "minimum": 0 },
        "namespace_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "ok", "error_class", "error_kind", "exit_code", "message"],
      "properties": {
        "schema": { "const": "hive-command-receipt" },
        "schema_version": { "const": 1 },
        "ok": { "const": false },
        "error_class": { "type": "string" },
        "error_kind": {
          "type": "string",
          "enum": [
            "usage", "config", "internal", "command_conflict", "command_in_progress",
            "command_unresolved_pending", "command_pin_horizon_elapsed",
            "command_capacity_exhausted", "command_nonterminal_limit",
            "command_concurrency_limit", "command_prune_busy",
            "command_prune_storage_unavailable", "command_prune_preview_unavailable",
            "command_orphaned_pin", "command_original_result_unavailable"
          ]
        },
        "exit_code": { "type": "integer", "enum": [1, 20, 21, 22, 64, 70, 75, 78] },
        "message": { "type": "string" },
        "reason": { "type": "string" },
        "state": { "type": "string" },
        "scope": { "type": "string" },
        "command_receipt": { "type": "object" }
      }
    }
  }
}
