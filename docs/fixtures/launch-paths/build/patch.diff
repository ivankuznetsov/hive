+# frozen_string_literal: true
+
+require "json"
+require "minitest/autorun"
+require_relative "../lib/health_app"
+
+class HealthAppTest < Minitest::Test
+  FakeStatus = Struct.new(:success?)
+
+  def test_health_response_contains_only_public_fields
+    HealthApp.stub(:revision, "7c9e12a") do
+      status, headers, chunks = HealthApp.call("PATH_INFO" => "/healthz")
+      body = JSON.parse(chunks.join)
+
+      assert_equal 200, status
+      assert_equal "application/json", headers.fetch("content-type")
+      assert_equal %w[revision status version], body.keys.sort
+      assert_equal "ok", body.fetch("status")
+      assert_equal "0.1.0", body.fetch("version")
+      assert_equal "7c9e12a", body.fetch("revision")
+    end
+  end
+
+  def test_revision_falls_back_when_git_metadata_is_unavailable
+    runner = ->(*) { ["", FakeStatus.new(false)] }
+
+    assert_equal "unknown", HealthApp.revision(command_runner: runner)
+  end
+
+  def test_other_paths_are_not_found
+    status, headers, chunks = HealthApp.call("PATH_INFO" => "/")
+
+    assert_equal 404, status
+    assert_equal "text/plain", headers.fetch("content-type")
+    assert_equal "not found\n", chunks.join
+  end
+end
