post_install() {
  cat <<'MSG'
hive-bin installed.
Run `hive init` in a project to scaffold .hive-state and register the systemd-user daemon.
MSG
}

post_upgrade() {
  post_install
}

post_remove() {
  cat <<'MSG'
hive-bin removed.
Project .hive-state directories and accumulated work are preserved.
MSG
}
