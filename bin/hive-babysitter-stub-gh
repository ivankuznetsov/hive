#!/usr/bin/env ruby
# frozen_string_literal: true

def log_skip(argv)
  path = ENV.fetch("HIVE_BABYSITTER_DRY_RUN_LOG", ".babysitter-dry-run-skipped.log")
  File.open(path, "a") { |file| file.puts("[dry-run] gh #{argv.join(' ')} skipped") }
rescue SystemCallError
  nil
end

argv = ARGV.dup

def stripped_global_options(argv)
  rest = argv.dup
  loop do
    case rest.first
    when "-R", "--repo", "--hostname"
      rest.shift(2)
    when /\A--repo=/
      rest.shift
    when /\A-/
      rest.shift
    else
      break
    end
  end
  rest
end

def api_read_only?(rest)
  return false unless rest.first == "api"

  method = nil
  payload = false
  input = false
  index = 1
  while index < rest.length
    arg = rest[index]
    case arg
    when "-X", "--method"
      method = rest[index + 1]
      index += 2
    when /\A--method=(.+)\z/
      method = Regexp.last_match(1)
      index += 1
    when /\A-X=?(.+)\z/
      method = Regexp.last_match(1)
      index += 1
    when "-f", "-F", "--raw-field", "--field"
      payload = true
      index += 2
    when "--input"
      input = true
      index += 2
    when /\A-f.+\z/, /\A-F.+\z/, /\A--raw-field=.+\z/, /\A--field=.+\z/
      payload = true
      index += 1
    when /\A--input=.+\z/
      input = true
      index += 1
    else
      index += 1
    end
  end

  return method.casecmp("GET").zero? && !input if method

  !payload && !input
end

def read_only?(rest)
  case rest[0]
  when "api"
    api_read_only?(rest)
  when "auth"
    rest[1] == "status"
  when "pr"
    %w[checks diff list status view].include?(rest[1])
  when "run"
    %w[list view watch].include?(rest[1])
  when "repo"
    rest[1] == "view"
  when "workflow"
    %w[list view].include?(rest[1])
  else
    false
  end
end

rest = stripped_global_options(argv)

unless read_only?(rest)
  log_skip(argv)
  warn "[dry-run] gh #{argv.join(' ')} skipped"
  exit 0
end

real = ENV["HIVE_BABYSITTER_REAL_GH"].to_s
if real.empty?
  warn "hive-babysitter dry-run: HIVE_BABYSITTER_REAL_GH is unset; refusing to guess a path for the real gh binary"
  exit 127
end
exec(real, *argv)
