<section class="narrow">
  <h1>Finish signing in</h1>
  <p>
    Open <a href="<%= h(device["verification_uri"]) %>" target="_blank" rel="noopener"><%= h(device["verification_uri"]) %></a>
    and enter this code:
  </p>
  <p class="device-code"><%= h(device["user_code"]) %></p>
  <p class="muted">
    Waiting for GitHub to confirm the authorization — this page refreshes
    itself automatically. Approve the request as the configured owner account.
  </p>
  <p><a href="/login">Start over</a></p>
</section>
