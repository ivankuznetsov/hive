{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-digest.v2.json",
  "title": "hive digest output (v2)",
  "description": "The sole live contract emitted by the PR-only `hive digest --json` pipeline. Success contains every represented repository and merged PR plus honest warnings and known metrics. Hard collection, generation, configuration, and usage failures emit ErrorPayload and send no successful changelist.",
  "oneOf": [
    { "$ref": "#/$defs/SuccessPayload" },
    { "$ref": "#/$defs/ErrorPayload" }
  ],
  "$defs": {
    "SuccessPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "ok",
        "date",
        "status",
        "dry_run",
        "resolved_repository_count",
        "collected_repository_count",
        "project_count",
        "pr_count",
        "projects",
        "warnings",
        "chat_id",
        "message"
      ],
      "properties": {
        "schema": { "const": "hive-digest" },
        "schema_version": { "const": 2 },
        "ok": { "const": true },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["empty", "sent"] },
        "dry_run": { "type": "boolean" },
        "resolved_repository_count": { "type": "integer", "minimum": 1 },
        "collected_repository_count": { "type": "integer", "minimum": 1 },
        "project_count": { "type": "integer", "minimum": 0 },
        "pr_count": { "type": "integer", "minimum": 0 },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "commits": { "type": "integer", "minimum": 0 },
        "projects": {
          "type": "array",
          "items": { "$ref": "#/$defs/Project" }
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/Warning" }
        },
        "chat_id": { "type": ["integer", "string", "null"] },
        "message": { "type": ["string", "null"] }
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "description", "pr_count", "prs"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "description": { "type": "string", "minLength": 1 },
        "pr_count": { "type": "integer", "minimum": 1 },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "commits": { "type": "integer", "minimum": 0 },
        "prs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/PullRequest" }
        }
      }
    },
    "PullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "url", "title", "merged_at", "bullets"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "merged_at": { "type": "string", "format": "date-time" },
        "bullets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "commits": { "type": "integer", "minimum": 0 }
      }
    },
    "Warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message", "repository"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "pr_number": { "type": "integer", "minimum": 1 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["additions", "deletions", "commits"] }
        }
      }
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "ok",
        "error_class",
        "error_kind",
        "exit_code",
        "message"
      ],
      "properties": {
        "schema": { "const": "hive-digest" },
        "schema_version": { "const": 2 },
        "ok": { "const": false },
        "error_class": { "type": "string", "minLength": 1 },
        "error_kind": { "type": "string", "enum": ["usage", "config", "internal"] },
        "exit_code": { "type": "integer", "enum": [1, 64, 70, 78] },
        "message": { "type": "string" }
      }
    }
  }
}
