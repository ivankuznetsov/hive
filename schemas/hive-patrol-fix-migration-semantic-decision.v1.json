{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hive-patrol-fix-migration-semantic-decision.v1.json",
  "title": "Hive Patrol Fix Migration Semantic Decision (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["left", "right", "decision", "receipt_digest", "candidate_set_digest", "current_head"],
  "properties": {
    "left": {"type": "string", "minLength": 1, "maxLength": 4096},
    "right": {"type": "string", "minLength": 1, "maxLength": 4096},
    "decision": {"enum": ["same_root", "distinct", "insufficient_evidence"]},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "candidate_set_digest": {"$ref": "#/$defs/digest"},
    "current_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
