<% transitions = Array(task["allowed_transitions"]) %>
<% drag_transitions = transitions.select { |transition| transition["confirmation"] == "none" } %>
<article class="board-card state-<%= task["dominant_state"] %>" id="card_<%= dom_id_for(project["name"], task["slug"]) %>"
         data-controller="card-menu"
         data-card-slug="<%= task["slug"] %>" data-state="<%= task["dominant_state"] %>"
         data-card-digest="<%= task["card_digest"] %>" data-board-navigation-target="card" tabindex="0"
         data-card-menu-url-value="<%= task_transition_path(project["name"], task["slug"]) %>"
         data-card-menu-fingerprint-value="<%= task["fingerprint"] %>"
         data-board-dnd-transitions="<%= drag_transitions.to_json %>"
         data-action="board:transition-request->card-menu#moveEvent">
  <div class="board-card-heading">
    <%= status_dot(task) %>
    <%= link_to task_title(task), task_path(project["name"], task["slug"]), class: "board-card-title",
          data: { turbo_frame: "task_drawer", action: "drawer#remember" } %>
  </div>
  <span class="task-slug"><%= task["slug"] %></span>
  <p class="board-card-state"><%= task["action_label"].presence || task["marker"].presence || "Idle" %></p>
  <%= render "board/card_chips", task: task, project: project %>
  <% if transitions.any? %>
    <details class="card-menu" data-card-menu-target="details" data-action="keydown->card-menu#keydown">
      <summary class="btn btn-ghost btn-sm">Move to</summary>
      <div class="card-menu-items" role="menu" aria-label="Move <%= task_title(task) %>">
        <% transitions.each do |transition| %>
          <% @board_authenticity_token ||= form_authenticity_token %>
          <form action="<%= task_transition_path(project["name"], task["slug"]) %>" method="post"
                data-action="submit->card-menu#submit">
            <input type="hidden" name="authenticity_token" value="<%= @board_authenticity_token %>" autocomplete="off">
            <input type="hidden" name="destination" value="<%= transition["destination"] %>">
            <input type="hidden" name="expected_fingerprint" value="<%= task["fingerprint"] %>">
            <% confirmation_id = dom_id_for("card", project["name"], task["slug"],
                                            transition["verb"], "confirmation") %>
            <% case transition["confirmation"] %>
            <% when "confirm" %>
              <label class="card-menu-confirmation">
                <%= check_box_tag :confirmation, "confirmed", false, required: true, id: confirmation_id %>
                Confirm <%= transition["label"] %>
              </label>
            <% when "reason" %>
              <%= text_field_tag :reason, nil, required: true, placeholder: "Reason",
                    id: confirmation_id, aria: { label: "Reason for #{transition['label']}" } %>
            <% when "slug" %>
              <%= text_field_tag :confirmation_slug, nil, required: true,
                    id: confirmation_id, placeholder: task["slug"],
                    aria: { label: "Type #{task['slug']} to confirm" } %>
            <% end %>
            <button type="submit" role="menuitem" class="card-menu-item"
                    data-card-menu-target="item" data-destination="<%= transition["destination"] %>"
                    data-confirmation="<%= transition["confirmation"] %>"
                    data-transition-label="<%= transition["label"] %>"><%= transition["label"] %></button>
          </form>
        <% end %>
      </div>
    </details>
  <% end %>
</article>
