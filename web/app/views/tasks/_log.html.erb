<% frame_parts = [project.name, task.slug] %>
<% frame_parts << reference_sha256 if reference_sha256.present? %>
<%= turbo_frame_tag stable_dom_id("task-log", *frame_parts) do %>
  <div class="log-pane">
    <% if log %>
      <%# data-tail-follow: the poll controller pins this pane to its bottom
          (tail -f) and pauses reloads while it is scrolled up for reading. %>
      <pre data-tail-follow><% log["tail"].each_line do |line| %><span class="<%= log_line_class(line) %>"><%= line %></span><% end %></pre>
      <p class="faint"><%= File.basename(log["path"]) %></p>
    <% else %>
      <p class="muted">No log yet for this task.</p>
    <% end %>
  </div>
<% end %>
