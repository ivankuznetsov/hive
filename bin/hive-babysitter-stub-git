#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require_relative "hive-babysitter-skip-log"

scrub_dynamic_loader_env!

require_relative "../lib/hive/babysitter/git_policy"
require_relative "../lib/hive/babysitter/passthrough_runner"

argv = ARGV.map(&:b)
decision = Hive::Babysitter::GitPolicy.classify(argv, environment: ENV)

prepare_environment = lambda do |environment|
  scrub_dynamic_loader_env!
  %w[
    GIT_ASKPASS GIT_EXEC_PATH GIT_EXTERNAL_DIFF GIT_PAGER GIT_PROXY_COMMAND
    GIT_SSH GIT_SSH_COMMAND PAGER SSH_ASKPASS
  ].each { |key| environment.delete(key) }
  environment.keys.grep(/\AGIT_CONFIG/).each { |key| environment.delete(key) }
  environment.keys.grep(/\AGIT_TRACE/).each { |key| environment.delete(key) }
  environment["HOME"] = File::NULL
  environment["XDG_CONFIG_HOME"] = File::NULL
  environment["GIT_CONFIG_NOSYSTEM"] = "1"
  environment["GIT_CONFIG_GLOBAL"] = File::NULL
  environment["GIT_CONFIG_SYSTEM"] = File::NULL
  environment["GIT_NO_LAZY_FETCH"] = "1"
  environment["GIT_OPTIONAL_LOCKS"] = "0"
  environment["PATH"] = "/usr/bin:/bin"
end

preflight = lambda do |real, _environment|
  next if system(real, "--no-lazy-fetch", "--version", out: File::NULL, err: File::NULL)

  warn "hive-babysitter dry-run: Git 2.45 or newer is required for safe read " \
       "passthrough (--no-lazy-fetch unavailable)"
  127
end

runner = Hive::Babysitter::PassthroughRunner.new(
  tool: "git",
  argv: argv,
  allowed: decision.allowed?,
  real_env_key: "HIVE_BABYSITTER_REAL_GIT",
  skip_reporter: -> { log_skip("git", argv) },
  prepare_environment: prepare_environment,
  command_argv: -> { Hive::Babysitter::GitPolicy.hardened_passthrough_argv(argv, decision.rest) },
  preflight: preflight
)
exit runner.call
