{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hivecli.sh/schemas/hive-patrol-evidence-receipt.v1.json",
  "title": "Hive Patrol Evidence Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "receipt_id",
    "run_id",
    "lane",
    "lane_result",
    "candidate",
    "control",
    "configuration_digests",
    "project",
    "module_selections",
    "scenario_manifest_digest",
    "decisions",
    "matrix",
    "faults",
    "effects",
    "artifacts",
    "reviewer",
    "generated_at",
    "reviewed_at",
    "observed"
  ],
  "properties": {
    "schema": {"const": "hive-patrol-evidence-receipt"},
    "schema_version": {"const": 1},
    "receipt_id": {
      "type": "string",
      "pattern": "^patrol-evidence-[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^patrol-[0-9a-f]{64}$"
    },
    "lane": {"enum": ["deterministic", "installed"]},
    "lane_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["passed", "blocked", "failed"]},
        "reason": {
          "anyOf": [
            {"type": "string", "minLength": 1, "maxLength": 32768},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "passed"}},
            "required": ["status"]
          },
          "then": {"properties": {"reason": {"type": "null"}}},
          "else": {"properties": {"reason": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "artifact_manifest_sha256",
        "source_archive_sha256",
        "candidate_gem_sha256",
        "skills_archive_sha256",
        "installed_tree_sha256"
      ],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_manifest_sha256": {"$ref": "#/$defs/digest"},
        "source_archive_sha256": {"$ref": "#/$defs/digest"},
        "candidate_gem_sha256": {"$ref": "#/$defs/digest"},
        "skills_archive_sha256": {"$ref": "#/$defs/digest"},
        "installed_tree_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "commit_sha",
        "tree_sha",
        "trust_scope",
        "catalog",
        "harness_manifest_sha256",
        "provenance"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^github\\.com/[a-z0-9][a-z0-9._-]{0,99}/[a-z0-9][a-z0-9._-]{0,99}$"
        },
        "ref": {
          "type": ["string", "null"],
          "pattern": "^refs/[a-zA-Z0-9][a-zA-Z0-9._/-]{0,4090}$"
        },
        "commit_sha": {"$ref": "#/$defs/sha"},
        "tree_sha": {"$ref": "#/$defs/sha"},
        "trust_scope": {"enum": ["local", "trusted_remote"]},
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "sha256"],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"
            },
            "sha256": {"$ref": "#/$defs/digest"}
          }
        },
        "harness_manifest_sha256": {"$ref": "#/$defs/digest"},
        "provenance": {"$ref": "#/$defs/control_provenance"}
      }
    },
    "configuration_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patrol", "architecture-patrol"],
      "properties": {
        "patrol": {"$ref": "#/$defs/digest"},
        "architecture-patrol": {"$ref": "#/$defs/digest"}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "name", "repository"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1, "maxLength": 32768},
        "name": {"type": "string", "minLength": 1, "maxLength": 32768},
        "repository": {
          "anyOf": [
            {"type": "string", "minLength": 1, "maxLength": 32768},
            {"type": "null"}
          ]
        }
      }
    },
    "module_selections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patrol", "architecture-patrol"],
      "properties": {
        "patrol": {"$ref": "#/$defs/module_selection"},
        "architecture-patrol": {"$ref": "#/$defs/module_selection"}
      }
    },
    "scenario_manifest_digest": {"$ref": "#/$defs/digest"},
    "decisions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "module",
          "decision_class",
          "repository",
          "repository_sha",
          "trigger_digest",
          "record_digest",
          "control"
        ],
        "properties": {
          "decision_id": {"$ref": "#/$defs/digest"},
          "module": {"enum": ["patrol", "architecture-patrol"]},
          "decision_class": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "repository_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "trigger_digest": {"$ref": "#/$defs/digest"},
          "record_digest": {"$ref": "#/$defs/digest"},
          "control": {
            "enum": [
              "none",
              "ordinary_positive_finding",
              "architecture_positive_thesis",
              "clean_negative"
            ]
          }
        }
      }
    },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 32768}
    },
    "faults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 32768}
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index_digest", "expected_legacy_keys"],
      "properties": {
        "index_digest": {
          "type": "string",
          "pattern": "^effect-index-[0-9a-f]{64}$"
        },
        "expected_legacy_keys": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^effect-[0-9a-f]{64}$"
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9_.-]*$"},
      "additionalProperties": {"$ref": "#/$defs/digest"}
    },
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 32768},
    "generated_at": {"type": "string", "format": "date-time"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "ended_at",
        "elapsed_seconds",
        "restart_count"
      ],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "elapsed_seconds": {"type": "integer", "minimum": 0},
        "restart_count": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "control_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_path",
        "workflow_sha",
        "run_id",
        "run_attempt",
        "action_lock_sha256"
      ],
      "properties": {
        "workflow_path": {
          "type": ["string", "null"]
        },
        "workflow_sha": {
          "oneOf": [
            {"$ref": "#/$defs/sha"},
            {"type": "null"}
          ]
        },
        "run_id": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "run_attempt": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "action_lock_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        }
      }
    },
    "module_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_epoch", "active"],
      "properties": {
        "selection_epoch": {"type": "integer", "minimum": 1},
        "active": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version", "catalog_commit", "source_commit",
            "manifest_digest", "configuration_digest"
          ],
          "properties": {
            "version": {"type": "string", "minLength": 1, "maxLength": 32768},
            "catalog_commit": {
              "type": "string", "pattern": "^[0-9a-f]{40}$"
            },
            "source_commit": {
              "type": "string", "pattern": "^[0-9a-f]{40}$"
            },
            "manifest_digest": {"$ref": "#/$defs/digest"},
            "configuration_digest": {"$ref": "#/$defs/digest"}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lane_result": {
            "properties": {
              "status": {"const": "passed"}
            },
            "required": ["status"]
          }
        },
        "required": ["lane_result"]
      },
      "then": {
        "properties": {
          "decisions": {"minItems": 1}
        }
      }
    }
  ]
}
