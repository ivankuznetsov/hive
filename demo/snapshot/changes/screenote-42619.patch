diff --git a/script/attachment_browser_evidence b/script/attachment_browser_evidence
new file mode 100755
index 0000000..9351aed
--- /dev/null
+++ b/script/attachment_browser_evidence
@@ -0,0 +1,118 @@
+#!/usr/bin/env bash
+
+# Records the image attachment browser flow and leaves reviewable artifacts.
+#
+#   script/attachment_browser_evidence [OUTPUT_DIRECTORY]
+#
+# Produces, per test, a watchable WebM of the run, the ordered filmstrip it was
+# built from, the Playwright trace both came out of, and, at the points the plan
+# names, a captured frame with the page facts a picture cannot show on its own —
+# which URL each thumbnail was fetched from, which component context rendered
+# it, and the measured overlay geometry.
+#
+# The video is encoded from the trace's screencast rather than recorded by the
+# browser. Playwright's own `record_video_dir` cannot be used here: this driver
+# asks the page for its video path while the page is still open, and that path
+# resolves through a future the page-close event rejects, so a run that sets the
+# option blocks forever with an empty file. The screencast carries the same
+# picture — it runs at roughly 20fps for the whole length of a test — and every
+# frame keeps the timestamp it was captured at, so the encode below reproduces
+# the run's real timing instead of a nominal frame rate.
+
+set -Eeuo pipefail
+umask 077
+
+readonly REPOSITORY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+readonly OUTPUT_DIRECTORY="$(cd "${REPOSITORY_ROOT}" && mkdir -p "${1:-tmp/evidence/attachments}" && cd "${1:-tmp/evidence/attachments}" && pwd)"
+readonly SUITE="test/system/image_attachments_test.rb"
+
+fail() {
+  printf 'attachment browser evidence: %s\n' "$*" >&2
+  exit 1
+}
+
+command -v unzip >/dev/null 2>&1 || fail "unzip is required to extract trace filmstrips"
+command -v ffmpeg >/dev/null 2>&1 || fail "ffmpeg is required to encode the filmstrips"
+
+cd "${REPOSITORY_ROOT}"
+[[ -f "${SUITE}" ]] || fail "required suite is missing: ${SUITE}"
+
+# The gate is only met by artifacts this run produced. Reusing a directory would
+# let a stale trace, or a partial run whose remaining tests never recorded,
+# satisfy it, so a non-empty target is refused rather than written over.
+if [[ -n "$(ls -A "${OUTPUT_DIRECTORY}" 2>/dev/null)" ]]; then
+  fail "${OUTPUT_DIRECTORY} already has contents; remove it so this run cannot inherit stale evidence"
+fi
+
+# One trace per declared test, counted from the suite itself so a test added
+# later cannot quietly go unrecorded.
+expected_traces="$(grep -cE '^[[:space:]]*test "' "${SUITE}")"
+(( expected_traces > 0 )) || fail "no tests were found in ${SUITE}"
+
+env RAILS_ENV=test CAPYBARA_RUN_SERVER=true PARALLEL_WORKERS=1 \
+  SCREENOTE_EVIDENCE_DIR="${OUTPUT_DIRECTORY}" \
+  bin/rails test "${SUITE}"
+
+shopt -s nullglob
+traces=("${OUTPUT_DIRECTORY}"/*.trace.zip)
+(( ${#traces[@]} == expected_traces )) ||
+  fail "expected ${expected_traces} traces, one per declared test, but the run wrote ${#traces[@]}"
+
+for trace in "${traces[@]}"; do
+  test_name="$(basename "${trace}" .trace.zip)"
+  filmstrip="${OUTPUT_DIRECTORY}/filmstrip/${test_name}"
+  rm -rf -- "${filmstrip}"
+  mkdir -p "${filmstrip}"
+  unzip -q -o -j "${trace}" 'resources/*.jpeg' -d "${filmstrip}" || true
+
+  # Each screencast frame is named `page@<page>-<capture-milliseconds>.jpeg`, so
+  # the numeric tail both orders the frames and dates them. Sorting has to run
+  # on the bare file name: the enclosing path is free to contain hyphens of its
+  # own, and sorting whole paths would key on one of those instead.
+  mapfile -t frames < <(
+    find "${filmstrip}" -maxdepth 1 -name 'page@*.jpeg' -printf '%f\n' |
+      awk -F- '{ print $NF, $0 }' | sort -n -k1,1 | cut -d' ' -f2-
+  )
+
+  if (( ${#frames[@]} == 0 )); then
+    fail "${test_name} recorded no screencast frames"
+  fi
+
+  timings=()
+  for index in "${!frames[@]}"; do
+    captured_at="${frames[index]##*-}"
+    timings+=("${captured_at%.jpeg}")
+    mv -- "${filmstrip}/${frames[index]}" "$(printf '%s/%04d.jpeg' "${filmstrip}" "$((index + 1))")"
+  done
+
+  # The concat demuxer holds each frame for the gap until the next one was
+  # captured, which is what makes the encode replay the run at its real pace.
+  # The final frame has no successor, so it gets a one-second tail, and the
+  # demuxer requires it listed once more for that duration to apply.
+  concat_list="${filmstrip}/frames.txt"
+  : >"${concat_list}"
+  for index in "${!timings[@]}"; do
+    frame="$(printf '%04d.jpeg' "$((index + 1))")"
+    if (( index + 1 < ${#timings[@]} )); then
+      duration="$(awk -v a="${timings[index]}" -v b="${timings[index + 1]}" 'BEGIN { printf "%.3f", (b - a) / 1000 }')"
+    else
+      duration="1.000"
+    fi
+    printf "file '%s'\nduration %s\n" "${frame}" "${duration}" >>"${concat_list}"
+  done
+  printf "file '%04d.jpeg'\n" "${#timings[@]}" >>"${concat_list}"
+
+  video="${OUTPUT_DIRECTORY}/${test_name}.webm"
+  ffmpeg -nostdin -loglevel error -y -f concat -safe 0 -i "${concat_list}" \
+    -r 30 -c:v libvpx-vp9 -b:v 0 -crf 34 -deadline realtime -cpu-used 5 \
+    -pix_fmt yuv420p "${video}" ||
+    fail "could not encode ${test_name}"
+
+  [[ -s "${video}" ]] || fail "${test_name} produced an empty video"
+
+  span="$(awk -v a="${timings[0]}" -v b="${timings[-1]}" 'BEGIN { printf "%.1f", (b - a) / 1000 }')"
+  printf '%s: %d frames over %ss, %d video bytes\n' \
+    "${test_name}" "${#frames[@]}" "${span}" "$(wc -c <"${video}")"
+done
+
+printf 'evidence written to %s\n' "${OUTPUT_DIRECTORY}"
diff --git a/script/attachment_object_store_qualification b/script/attachment_object_store_qualification
new file mode 100755
index 0000000..fdc5e70
--- /dev/null
+++ b/script/attachment_object_store_qualification
@@ -0,0 +1,97 @@
+#!/usr/bin/env bash
+
+# Runs the S3 delivery gate against a real object store.
+#
+# Disk storage has no presigned URL to leak and no remote host to redirect to,
+# so "the application streams the bytes itself" cannot be executed against it.
+# The container-s3 CI job supplies a real store as a service; this script
+# supplies the same thing on a developer or agent machine, so the object-store
+# half of the delivery claim can be executed anywhere rather than deferred to
+# an operator.
+#
+#   script/attachment_object_store_qualification
+#
+# Set SCREENOTE_S3_ENDPOINT and its companions to qualify against a store you
+# already run — the hosted Rabata endpoint, for instance; otherwise an ephemeral
+# MinIO container is started and removed.
+
+set -Eeuo pipefail
+umask 077
+
+readonly REPOSITORY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+readonly CONTAINER_ENGINE="${SCREENOTE_CONTAINER_ENGINE:-docker}"
+# The same immutable image the container-s3 workflow qualifies against, so a
+# local run and a CI run cannot be measuring different S3 implementations.
+readonly OBJECT_STORE_IMAGE="${SCREENOTE_OBJECT_STORE_IMAGE:-minio/minio:RELEASE.2025-05-24T17-08-30Z@sha256:a616cd8f37758b0296db62cc9e6af05a074e844cc7b5c0a0e62176d73828d440}"
+readonly CONTAINER_NAME="screenote-attachment-object-store-$$"
+readonly ACCESS_KEY_ID="screenote-qualification"
+readonly SECRET_ACCESS_KEY="screenote-qualification-secret"
+
+started_container=false
+
+fail() {
+  printf 'attachment object store qualification: %s\n' "$*" >&2
+  exit 1
+}
+
+cleanup() {
+  local exit_status=$?
+
+  if [[ "${started_container}" == true ]]; then
+    if (( exit_status != 0 )); then
+      "${CONTAINER_ENGINE}" logs "${CONTAINER_NAME}" >&2 2>&1 || true
+    fi
+    "${CONTAINER_ENGINE}" rm --force "${CONTAINER_NAME}" >/dev/null 2>&1 || true
+  fi
+}
+trap cleanup EXIT
+
+start_object_store() {
+  command -v "${CONTAINER_ENGINE}" >/dev/null 2>&1 ||
+    fail "${CONTAINER_ENGINE} is required, or configure SCREENOTE_S3_ENDPOINT"
+
+  # An ephemeral host port keeps a qualification run from colliding with a
+  # store the machine already publishes.
+  "${CONTAINER_ENGINE}" run --detach --name "${CONTAINER_NAME}" \
+    --publish "127.0.0.1::9000" \
+    --env "MINIO_ROOT_USER=${ACCESS_KEY_ID}" \
+    --env "MINIO_ROOT_PASSWORD=${SECRET_ACCESS_KEY}" \
+    "${OBJECT_STORE_IMAGE}" server /data >/dev/null
+  started_container=true
+
+  local host_port
+  host_port="$("${CONTAINER_ENGINE}" port "${CONTAINER_NAME}" 9000/tcp | head -1 | sed 's/.*://')"
+  [[ -n "${host_port}" ]] || fail "the object store published no host port"
+
+  export SCREENOTE_S3_ENDPOINT="http://127.0.0.1:${host_port}"
+  export SCREENOTE_S3_REGION="us-east-1"
+  export SCREENOTE_S3_BUCKET="screenote-qualification"
+  export SCREENOTE_S3_PREFIX="attachment-delivery"
+  export SCREENOTE_S3_ACCESS_KEY_ID="${ACCESS_KEY_ID}"
+  export SCREENOTE_S3_SECRET_ACCESS_KEY="${SECRET_ACCESS_KEY}"
+
+  local attempt
+  for attempt in $(seq 1 60); do
+    if curl --fail --silent "${SCREENOTE_S3_ENDPOINT}/minio/health/ready" >/dev/null; then
+      return 0
+    fi
+    sleep 1
+  done
+
+  fail "the object store did not become ready"
+}
+
+cd "${REPOSITORY_ROOT}"
+
+if [[ -n "${SCREENOTE_S3_ENDPOINT-}" ]]; then
+  for name in SCREENOTE_S3_REGION SCREENOTE_S3_BUCKET SCREENOTE_S3_PREFIX \
+    SCREENOTE_S3_ACCESS_KEY_ID SCREENOTE_S3_SECRET_ACCESS_KEY; do
+    [[ -n "${!name-}" ]] || fail "${name} must be set alongside SCREENOTE_S3_ENDPOINT"
+  done
+else
+  start_object_store
+fi
+
+# The s3 gate exports SCREENOTE_REQUIRE_S3, which turns the suite's "no store
+# configured" skip into a failure, so this run cannot pass by not running.
+script/release_test_matrix s3
diff --git a/script/attachment_server_database_qualification b/script/attachment_server_database_qualification
new file mode 100755
index 0000000..667b330
--- /dev/null
+++ b/script/attachment_server_database_qualification
@@ -0,0 +1,88 @@
+#!/usr/bin/env bash
+
+# Runs the image attachment lifecycle gate against a real server database.
+#
+# SQLite proves the constraint contracts and the deterministic interleavings,
+# but the aggregate races, the fixed lock order, and the atomic claim only have
+# production semantics under real row locks. The concurrency-qualification
+# workflow supplies that database as a CI service; this script supplies the same
+# thing on a developer or agent machine so the server-database half of the
+# lifecycle claim can be executed anywhere, not only in CI.
+#
+#   script/attachment_server_database_qualification
+#
+# Set SCREENOTE_SERVER_DATABASE_URL to qualify against a database you already
+# run; otherwise an ephemeral container is started and removed.
+
+set -Eeuo pipefail
+umask 077
+
+readonly REPOSITORY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+readonly CONTAINER_ENGINE="${SCREENOTE_CONTAINER_ENGINE:-docker}"
+readonly SERVER_IMAGE="${SCREENOTE_SERVER_DATABASE_IMAGE:-postgres:17}"
+readonly CONTAINER_NAME="screenote-attachment-qualification-$$"
+readonly DATABASE_USER="screenote"
+readonly DATABASE_NAME="screenote_test"
+
+started_container=false
+host_port=""
+
+fail() {
+  printf 'attachment server database qualification: %s\n' "$*" >&2
+  exit 1
+}
+
+cleanup() {
+  local exit_status=$?
+
+  if [[ "${started_container}" == true ]]; then
+    if (( exit_status != 0 )); then
+      "${CONTAINER_ENGINE}" logs "${CONTAINER_NAME}" >&2 2>&1 || true
+    fi
+    "${CONTAINER_ENGINE}" rm --force "${CONTAINER_NAME}" >/dev/null 2>&1 || true
+  fi
+}
+trap cleanup EXIT
+
+start_server_database() {
+  command -v "${CONTAINER_ENGINE}" >/dev/null 2>&1 ||
+    fail "${CONTAINER_ENGINE} is required, or set SCREENOTE_SERVER_DATABASE_URL"
+
+  # An ephemeral host port keeps a qualification run from colliding with a
+  # database the machine already publishes.
+  "${CONTAINER_ENGINE}" run --detach --name "${CONTAINER_NAME}" \
+    --publish "127.0.0.1::5432" \
+    --env "POSTGRES_USER=${DATABASE_USER}" \
+    --env "POSTGRES_DB=${DATABASE_NAME}" \
+    --env POSTGRES_HOST_AUTH_METHOD=trust \
+    "${SERVER_IMAGE}" >/dev/null
+  started_container=true
+  host_port="$("${CONTAINER_ENGINE}" port "${CONTAINER_NAME}" 5432/tcp | head -1 | sed 's/.*://')"
+  [[ -n "${host_port}" ]] || fail "the server database published no host port"
+
+  local attempt
+  for attempt in $(seq 1 60); do
+    if "${CONTAINER_ENGINE}" exec "${CONTAINER_NAME}" \
+      pg_isready --username "${DATABASE_USER}" --dbname "${DATABASE_NAME}" >/dev/null 2>&1; then
+      return 0
+    fi
+    sleep 1
+  done
+
+  fail "the server database did not become ready"
+}
+
+cd "${REPOSITORY_ROOT}"
+
+if [[ -n "${SCREENOTE_SERVER_DATABASE_URL-}" ]]; then
+  database_url="${SCREENOTE_SERVER_DATABASE_URL}"
+else
+  start_server_database
+  database_url="postgresql://${DATABASE_USER}@127.0.0.1:${host_port}/${DATABASE_NAME}"
+fi
+
+# SCREENOTE_SERVER_DATABASE_QUALIFICATION makes the suite assert the adapter it
+# claims to exercise, so this run cannot silently pass on SQLite behavior.
+env DATABASE_URL="${database_url}" \
+  SCREENOTE_SERVER_DATABASE_QUALIFICATION=1 \
+  script/release_test_matrix attachment-lifecycle
