#!/usr/bin/env ruby

require "fileutils"
require "English"
require "json"
require "optparse"
require "rake"
require "shellwords"
require "tmpdir"

root = File.expand_path("..", __dir__)
SAFE_SCENARIO_BASENAME = /\A[A-Za-z0-9_-]+\z/
REPORT_INLINE_OPTION = "--report="
# Keep the default report path in a standalone local: parse! overwrites
# options[:report] with whatever value follows --report, even an option-looking
# or empty token, so the usage-error cleanup below can no longer recover the
# default from options once that happens. Holding it separately lets the rescue
# fall back to the true default and still clear a stale report there.
default_report = File.join(root, "tmp", "hive-eval-report.json")
options = {
  report: default_report,
  scenario: nil,
  no_judge: false
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/hive-eval [--scenario NAME] [--report PATH] [--no-judge]"
  opts.on("--scenario NAME", "Run one scenario by basename, e.g. s1_status") do |value|
    options[:scenario] = value
  end
  opts.on("--report PATH", "Write JSON report to PATH") do |value|
    options[:report] = value
  end
  opts.on("--no-judge", "Skip Codex judge assertions") do
    options[:no_judge] = true
  end
  # Define help explicitly so it survives require_exact below; the officious -h
  # is otherwise rejected once exact matching is on. Printing to stdout and
  # exiting 0 inside parse! keeps --help/-h a read-only path.
  opts.on("-h", "--help", "Show this message") do
    puts opts
    exit
  end
end
# Reject abbreviated long options (e.g. --rep for --report). OptionParser accepts
# unambiguous prefixes by default, but the exact-only manual scan in
# selected_report_path only recognizes --report/--report=, so an abbreviation
# could select a report the usage-error cleanup below would fail to clear. Exact
# matching keeps both paths in agreement.
parser.require_exact = true

def expanded_report_path(root, value)
  return nil if value.to_s.empty?

  File.expand_path(value, root)
end

def remove_report!(path)
  File.unlink(path)
rescue Errno::ENOENT
  nil
end

def selected_report_path(root, argv, default_report)
  report = default_report
  index = 0

  while index < argv.length
    arg = argv[index]
    break if arg == "--"

    if arg == "--report"
      value = argv[index + 1]
      unless option_value_missing?(value)
        report = value
        index += 1
      end
    elsif arg.start_with?(REPORT_INLINE_OPTION)
      value = arg.byteslice(REPORT_INLINE_OPTION.bytesize, arg.bytesize)
      # An option-looking or empty inline value (--report=, --report=-x) is not a
      # real path: leave `report` on the default so the cleanup clears the stale
      # default rather than a junk token.
      report = value unless option_value_missing?(value)
    end

    index += 1
  end

  expanded_report_path(root, report)
end

def option_value_missing?(value)
  value.to_s.empty? || value.start_with?("-")
end

def inherited_rake_dry_run?(value)
  dry_run = false
  parser = OptionParser.new
  Rake::Application.new.standard_rake_options.each do |spec|
    declarations = spec.reject { |part| part.respond_to?(:call) }
    parser.on(*declarations) do
      dry_run = true if declarations.include?("--dry-run")
    end
  end

  parser.parse!(Shellwords.shellsplit(value.to_s))
  dry_run
rescue OptionParser::ParseError, ArgumentError
  # Invalid or ambiguously quoted Rake options are rejected instead of being
  # silently cleared before the child sees them.
  true
end

# Snapshot ARGV before parse! mutates it in place. The parser-error cleanup
# below uses the original tokens to tell when an unusable --report value should
# fall back to the default report.
argv_snapshot = ARGV.dup

begin
  remaining = parser.parse!
  raise OptionParser::MissingArgument, "--report" if option_value_missing?(options[:report])
  raise OptionParser::MissingArgument, "--scenario" if options[:scenario] && option_value_missing?(options[:scenario])
rescue OptionParser::ParseError, ArgumentError => e
  raise if e.is_a?(ArgumentError) && !e.message.include?("invalid byte sequence")

  # A parser-level usage error may still clear the default report, but custom
  # report paths must not be deleted until all validation passes and eval is
  # about to run. We can't clear before parsing, because the --help/-h switch
  # prints help and exits 0 inside parse!, and that read-only path must not
  # delete the report.
  # Cover both ways the default report can be selected:
  #   * OptionParser captured it into options (exact --report only; abbreviations
  #     are rejected via require_exact, matching the manual scan). When --report's
  #     value was option-looking or empty (e.g. `--report --no-judge`, `--report=`),
  #     parse! has already overwritten options[:report] with that junk token, so we
  #     fall back to the true default and clear the stale report there instead.
  #   * the report token never reached options - an invalid option raised before
  #     it, or --scenario consumed it as its value - leaving it in the pre-parse
  #     ARGV snapshot (the manual scan recognizes the exact --report/--report=
  #     forms and likewise falls back to the default for junk values). Custom
  #     paths found there are preserved by the default_report guard below.
  captured_report = options.fetch(:report)
  captured_report = default_report if option_value_missing?(captured_report)
  [ expanded_report_path(root, captured_report),
    selected_report_path(root, argv_snapshot, default_report) ].compact.each do |path|
    FileUtils.rm_f(path) if path == default_report
  end
  warn "hive-eval: #{e.message}"
  warn parser
  exit 64
end

report_path = expanded_report_path(root, options.fetch(:report))

unless remaining.empty?
  unexpected = remaining.join(" ")
  label = remaining.length == 1 ? "argument" : "arguments"
  FileUtils.rm_f(report_path) if report_path == default_report
  warn "hive-eval: unexpected #{label}: #{unexpected}"
  warn parser
  exit 64
end

def scenario_path(scenario_root, value)
  return nil if value.nil?
  raise ArgumentError, "scenario basename must not contain path separators: #{value}" if value.match?(%r{[\\/]})

  basename = value.sub(/_test\z/, "")
  unless basename.match?(SAFE_SCENARIO_BASENAME)
    raise ArgumentError, "scenario must be a safe basename under test/eval/scenarios"
  end

  File.join(scenario_root, "#{basename}_test.rb")
end

def validate_report!(report_path, requested_scenario_path, require_passing:)
  report = JSON.parse(File.read(report_path))
  scenarios = report["scenarios"] if report.is_a?(Hash)
  unless report.is_a?(Hash) &&
      report["schema"] == "hive-eval-report" &&
      report["schema_version"] == 1 &&
      scenarios.is_a?(Array)
    raise ArgumentError, "unexpected hive-eval-report schema"
  end
  raise ArgumentError, "hive-eval-report contains no scenarios" if scenarios.empty?

  required_arrays = %w[failures assertions captured_messages captured_log_events]
  valid_entries = scenarios.all? do |scenario|
    scenario.is_a?(Hash) &&
      !scenario["scenario_name"].to_s.empty? &&
      !scenario["file"].to_s.empty? &&
      %w[pass fail].include?(scenario["status"]) &&
      required_arrays.all? { |key| scenario[key].is_a?(Array) }
  end
  raise ArgumentError, "hive-eval-report contains an invalid scenario entry" unless valid_entries
  if require_passing && !scenarios.all? { |scenario| scenario["status"] == "pass" }
    raise ArgumentError, "hive-eval-report contains a failed scenario after a successful child exit"
  end

  return unless requested_scenario_path

  requested_scenario_path = File.expand_path(requested_scenario_path)
  reported = scenarios.any? do |scenario|
    File.expand_path(scenario.fetch("file")) == requested_scenario_path
  end
  raise ArgumentError, "hive-eval-report does not contain the requested scenario" unless reported
rescue Errno::ENOENT
  raise ArgumentError, "hive-eval-report was not created"
rescue JSON::ParserError
  raise ArgumentError, "hive-eval-report is not valid JSON"
end

def validate_report_directory!(path)
  stat = File.stat(path)
  raise ArgumentError, "hive-eval report parent is not a directory" unless stat.directory?

  unsafe_writes = (stat.mode & 0o022) != 0
  sticky = (stat.mode & 0o1000) != 0
  return unless unsafe_writes && !sticky

  raise ArgumentError, "hive-eval report directory is group/world-writable without the sticky bit"
end

scenario_root = File.expand_path(
  ENV.fetch("HIVE_EVAL_SCENARIO_ROOT", File.join(root, "test", "eval", "scenarios")),
  root
)

env = {
  "HIVE_EVAL_SCENARIOS_ONLY" => "1",
  "HIVE_EVAL_NO_JUDGE" => (options[:no_judge] ? "1" : nil),
  "RAKEOPT" => nil,
  "TEST" => nil
}

begin
  path = scenario_path(scenario_root, options[:scenario])
rescue ArgumentError => e
  FileUtils.rm_f(report_path) if report_path == default_report
  warn "hive-eval: #{e.message}"
  exit 64
end

if path
  unless File.exist?(path)
    FileUtils.rm_f(report_path) if report_path == default_report
    warn "hive-eval: scenario not found: #{path}"
    exit 64
  end
  env["TEST"] = path
end

if inherited_rake_dry_run?(ENV["RAKEOPT"])
  warn "hive-eval: inherited RAKEOPT may not enable rake dry-run"
  exit 1
end

report_dir = File.dirname(report_path)
FileUtils.mkdir_p(report_dir)
begin
  validate_report_directory!(report_dir)
rescue ArgumentError, SystemCallError => e
  warn "hive-eval: #{e.message}"
  exit 1
end
FileUtils.rm_f(report_path)
run_dir = Dir.mktmpdir(".hive-eval-run-", report_dir)
run_report_path = File.join(run_dir, "report.json")
env["HIVE_EVAL_REPORT"] = run_report_path

begin
  ok = system(env, "bundle", "exec", "rake", "test:eval", chdir: root)
  child_exit = $CHILD_STATUS&.exitstatus || (ok ? 0 : 1)
  if child_exit.zero?
    validate_report!(run_report_path, path, require_passing: true)
    File.rename(run_report_path, report_path)
  else
    begin
      validate_report!(run_report_path, path, require_passing: false)
      File.rename(run_report_path, report_path)
    rescue ArgumentError, SystemCallError => e
      warn "hive-eval: #{e.message}"
    end
    exit(child_exit)
  end
rescue ArgumentError, SystemCallError => e
  warn "hive-eval: #{e.message}"
  exit 1
ensure
  begin
    FileUtils.remove_entry_secure(run_dir) if File.exist?(run_dir)
  rescue ArgumentError, SystemCallError => e
    warn "hive-eval: could not remove private report directory: #{e.message}"
  end
end
