{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-dispatch-request.v3.json",
  "title": "hive dispatch request (v3)",
  "description": "Delivery request for the shared durable task-attempt dispatcher. v3 adds task-generation intent, predecessor identity, and inherited output references. Consumers continue accepting pending v2 files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "request_id", "created_at", "project", "slug",
    "argv", "requestor", "chat_id", "update_id", "trigger", "task_generation",
    "predecessor_attempt_id", "inherited_outputs"
  ],
  "properties": {
    "schema": { "const": "hive-dispatch-request" },
    "schema_version": { "const": 3 },
    "request_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "project": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$" },
    "argv": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "requestor": { "type": "string", "enum": ["bot", "healer"] },
    "chat_id": { "type": ["integer", "null"] },
    "update_id": { "type": ["integer", "null"] },
    "trigger": { "type": ["string", "null"] },
    "task_generation": { "type": ["string", "null"] },
    "predecessor_attempt_id": { "type": ["string", "null"] },
    "inherited_outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/OutputReference" }
    }
  },
  "$defs": {
    "OutputReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "ALLOWED_VERBS": {
      "type": "array",
      "items": {
        "enum": [
          "run", "develop", "brainstorm", "plan", "review", "open-pr",
          "artifacts", "finalize", "archive", "markers", "daemon"
        ]
      }
    }
  }
}
