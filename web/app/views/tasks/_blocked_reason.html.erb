<% if reason.present? %>
  <section class="blocked-explanation" aria-labelledby="blocked_explanation_title">
    <h2 id="blocked_explanation_title"><%= reason["summary"] %></h2>
    <% if reason["detail"].present? %><p><%= reason["detail"] %></p><% end %>
    <% if reason.fetch("remedies", []).any? %>
      <ol class="remedy-list">
        <% reason.fetch("remedies", []).each do |remedy| %>
          <li>
            <% case remedy["kind"] %>
            <% when "open_task" %>
              <% if (path = dependency_task_path(project["name"], row, fallback_slug: remedy["task"])) %>
                <%= link_to "Open prerequisite #{remedy["task"]}", path,
                      data: { turbo_frame: "_top" } %>
              <% else %>
                Inspect prerequisite <%= remedy["task"] %>.
              <% end %>
            <% when "command" %>
              <code><%= remedy["command"] %></code>
            <% else %>
              <%= remedy["text"].presence || remedy["command"].presence || "Manual inspection required." %>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% end %>
  </section>
<% end %>
