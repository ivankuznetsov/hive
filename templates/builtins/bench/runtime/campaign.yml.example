# v3 campaign pre-registration.
# Copy this file into a bench task folder as campaign.yml, edit it, and commit it
# in the hive-state checkout before the generate stage runs.

campaign_id: v3-example
source: /home/user/Dev/hive
corpus_version: v3

# Corpus slugs. Each must exist at corpus/<slug>/manifest.yml.
tasks:
  - fix-claude-tmux-ready-detector-260629-50cc

# Historical ids from harness/profiles/candidates.rb, or campaign-owned ids
# declared in candidate_profiles below. Never redefine a historical id.
candidates:
  - all-opus-4.8

# New models need no edits to the harness registry. These routes become native
# Hive stage/model configuration. Single-model profiles disable plan review
# unless explicitly enabled; ordinary code review still runs.
# candidate_profiles:
#   deepseek-single:
#     model_version: deepseek-v4.1-flash
#     credential_env: [OPENCODE_API_KEY] # names only; export values before Hive starts
#     stages:
#       plan: {agent: opencode, model: opencode-go/deepseek-v4.1-flash}
#       execute: {agent: opencode, model: opencode-go/deepseek-v4.1-flash}
#       review: {agent: opencode, model: opencode-go/deepseek-v4.1-flash}
#     plan_review: {enabled: false}
#
# Mixed profiles may give each stage its own agent/model/effort. To enable plan
# review, supply plan_review.enabled: true and all three native routes under
# plan_review.routes: primary, adversarial, verification. Each needs agent,
# model and family (plus optional effort/route); no production default model
# may silently enter a benchmark. Optional reviewers uses native Hive reviewer
# specifications and overrides the default code reviewer on stages.review.
#
# Pi custom providers may additionally declare pi_catalog using Pi's native
# models.json format. Provider apiKey must be a $ENV reference listed in
# credential_env; never commit a token or a secret-manager command.
# pi_catalog:
#   providers:
#     zai-coding:
#       baseUrl: https://api.z.ai/api/coding/paas/v4
#       api: openai-completions
#       apiKey: $ZAI_API_KEY
#       models: [{id: glm-5.3-flash, reasoning: true}]
# Supply the provider's verified context/token limits and thinkingLevelMap in
# the registered catalog when using non-default reasoning levels.

# Candidate-id -> effort. Today effort pins live in candidate profiles; this is
# a review contract rather than a hive_run.rb flag.
effort_pins: {}

# Opt in when a benchmark row is valid only if every cell completes Hive's
# execute stage normally. Failed cells with preserved patches are rerun and
# cannot enter judging. The default keeps paid-patch recovery compatibility.
require_successful_execution: false

# Publication-grade local campaigns seal the controller runtime from the model,
# use a base-only shallow repository, and attach to a provider-only Docker
# network. The runner image must be built from the exact active Hive commit.
isolation:
  sealed_agent_runtime: true
  require_provider_egress: true
  docker_network: hive-bench-provider-only
  https_proxy: http://hive-bench-egress-proxy:3128
  # Optional native-stage setup: creates only campaign-labeled resources and
  # refuses to replace shared resources. Choose unique names per campaign.
  # managed_network: true
  # proxy_image: sha256:<64-hex image ID from docker image inspect>
  # provider_hosts: [api.z.ai, opencode.ai] # selected candidate APIs only

# Judge samples. Use at least 3 for published results.
seeds: 3

# Judge backends and exact invocation provenance. The default mirrors the
# maintained campaign: Fable plus GPT-5.6 Sol at ultra. Set a backend to null
# to disable it; keep at least two enabled for blind cross-checking and
# deliberation. A separate OpenRouter judge is optional and disabled by default;
# the Codex judge also has an explicit OpenRouter transport fallback below.
judges:
  claude:
    model: claude-fable-5
  codex:
    model: gpt-5.6-sol
    reasoning_effort: ultra
    # Default: chatgpt. To preserve the judge identity while routing the Codex
    # CLI through OpenRouter, set provider: openrouter and explicitly pin the
    # provider_model (for example openai/gpt-5.6-sol).
    provider: chatgpt
  openrouter:

# Review-enforced caps. The current harness does not enforce these as per-run
# flags.
budgets:
  per_cell_usd: 25

# Timeout declarations. `hive_seconds` IS enforced: the generate stage exports
# it as HB_HIVE_TIMEOUT for every hive_run.rb invocation. Use `timeouts: {}`
# to let harness defaults apply — the `timeouts` key itself is required by the
# generate contract, so removing it entirely parks generate at WAITING.
timeouts:
  hive_seconds: 14400

# Cells intentionally excluded from the campaign matrix.
# Example:
#   - task: fix-claude-tmux-ready-detector-260629-50cc
#     candidate: all-opus-4.8
#     reason: documented reason
exclusions: []

aggregation: >
  Gate pass_rate on gated subset; judge mean with cross-family judge emphasis;
  efficiency is reported, not ranked.
