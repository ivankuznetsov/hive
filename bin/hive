#!/usr/bin/env ruby

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "hive"
require "hive/cli"
require "hive/thor_usage_json"

if ARGV == [ "--version" ] || ARGV == [ "-v" ]
  puts Hive::VERSION
  exit 0
end

# Thor only honours `--help` *before* the subcommand name (`hive help approve`);
# `hive approve --help` would be consumed as the TARGET positional. Intercept
# the help flag before Thor dispatch so the convention agents try first works.
def rewrite_help_flag!(argv)
  return if argv.empty?

  cmd_idx = argv.index { |a| !a.start_with?("-") }
  return unless cmd_idx

  help_idx = argv[(cmd_idx + 1)..]&.index { |a| a == "--help" || a == "-h" }
  return unless help_idx

  cmd = argv[cmd_idx]
  argv.replace(argv[0...cmd_idx] + [ "help", cmd ])
end

rewrite_help_flag!(ARGV)

begin
  Hive::CLI.start(ARGV, debug: true)
rescue Thor::Error => e
  if Hive::ThorUsageJson.json_requested?(ARGV)
    Hive::ThorUsageJson.emit(ARGV, e)
  else
    warn e.message
  end
  exit Hive::ExitCodes::USAGE
rescue Hive::Error => e
  exit_code = e.respond_to?(:exit_code) ? e.exit_code : Hive::ExitCodes::GENERIC
  if Hive::ThorUsageJson.json_requested?(ARGV)
    # `hive bot --json` / `hive daemon --bogus --json` raise a Hive::Error
    # that bypasses the Thor parse path, so without this an agent that
    # learned `hive run --json` returns a parseable stdout envelope would
    # get empty stdout + free-form stderr. Emit the same schema-less generic
    # envelope shape the unknown-command branch uses, carrying the error's
    # own exit code.
    Hive::ThorUsageJson.emit_generic(e, error_kind: "usage", exit_code: exit_code)
  else
    warn "hive: #{e.message}"
  end
  exit exit_code
rescue StandardError => e
  # `Hive::CLI.start(..., debug: true)` makes Thor re-raise the original
  # exception, so a plain StandardError from a command body escapes both
  # rescues above. Without this it would dump a multi-line backtrace (exit 1)
  # where pre-`debug` Thor printed one line. Emit a one-line message (or an
  # `internal`/SOFTWARE envelope under --json); the full backtrace is gated
  # behind HIVE_DEBUG for when a developer actually wants it.
  if Hive::ThorUsageJson.json_requested?(ARGV)
    Hive::ThorUsageJson.emit_generic(e, error_kind: "internal", exit_code: Hive::ExitCodes::SOFTWARE)
  else
    warn "hive: internal error: #{e.class}: #{e.message}"
    warn e.backtrace.join("\n") if ENV["HIVE_DEBUG"]
  end
  exit Hive::ExitCodes::SOFTWARE
end
