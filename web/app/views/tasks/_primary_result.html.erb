<% primary = result["primary"] %>
<section id="workspace-primary-result" class="workspace-panel workspace-wide primary-work-product"
         aria-labelledby="workspace-primary-result-heading"
         <% if primary %>data-primary-artifact="<%= primary.fetch("reference") %>"<% end %>>
  <div class="workspace-panel-heading">
    <div>
      <h2 id="workspace-primary-result-heading"><%= primary ? artifact_label(primary) : "Work product" %></h2>
    </div>
  </div>

  <% if result["warning"].present? %>
    <p class="state-banner" role="status"><%= result.fetch("warning") %></p>
  <% end %>

  <% if primary.nil? %>
    <p class="workspace-empty">No document is available to display.</p>
  <% elsif primary["binary"] %>
    <p class="workspace-empty">This file cannot be previewed as text.</p>
  <% elsif primary["content"].nil? %>
    <p class="workspace-empty">This document could not be loaded.</p>
  <% elsif primary.fetch("name").end_with?(".md") %>
    <% document = render_markdown_document(primary.fetch("content")) %>
    <% if document.fetch(:outline).any? %>
      <details class="document-outline" aria-label="Document outline" data-workspace-disclosure-key="document-outline">
        <summary class="document-outline-title">On this page</summary>
        <ol>
          <% document.fetch(:outline).each do |heading| %>
            <li><a href="#<%= heading.fetch(:id) %>"><%= heading.fetch(:label) %></a></li>
          <% end %>
        </ol>
      </details>
    <% end %>
    <% if document.fetch(:empty) %>
      <p class="workspace-empty">Nothing has been written here yet.</p>
    <% else %>
      <article class="markdown primary-markdown"><%= document.fetch(:html) %></article>
    <% end %>
  <% else %>
    <details data-workspace-disclosure-key="primary-file">
      <summary>View file contents</summary>
      <pre><%= primary.fetch("content") %></pre>
    </details>
  <% end %>
</section>
