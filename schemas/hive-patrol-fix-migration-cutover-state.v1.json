{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hive-patrol-fix-migration-cutover-state.v1.json",
  "title": "Hive Patrol Fix Migration Cutover State (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "status", "manifest_digest",
    "source_epochs", "source_ownership", "fenced_source_epochs", "groups",
    "new_authority_effect", "acknowledgement_count", "final_verification",
    "created_at", "updated_at"
  ],
  "properties": {
    "schema": {"const": "hive-patrol-fix-migration-cutover-state"},
    "schema_version": {"const": 1},
    "status": {"enum": ["preflight", "fenced", "applying", "committed"]},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "source_epochs": {"$ref": "#/$defs/epochs"},
    "source_ownership": {"$ref": "#/$defs/ownership"},
    "fenced_source_epochs": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/epochs"}]},
    "groups": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/group"},
      "maxProperties": 16384
    },
    "new_authority_effect": {"type": "boolean"},
    "acknowledgement_count": {"type": "integer", "minimum": 0},
    "final_verification": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/verification"}]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "epochs": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinary_patrol", "architecture_patrol"],
      "properties": {
        "ordinary_patrol": {"type": "integer", "minimum": 1},
        "architecture_patrol": {"type": "integer", "minimum": 1}
      }
    },
    "mode": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "admission"],
      "properties": {
        "owner": {"enum": ["legacy", "module"]},
        "admission": {"type": "boolean"}
      }
    },
    "ownership": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinary_patrol", "architecture_patrol"],
      "properties": {
        "ordinary_patrol": {"$ref": "#/$defs/mode"},
        "architecture_patrol": {"$ref": "#/$defs/mode"}
      }
    },
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["group_id", "candidate_set_digest", "route", "canonical_identity", "members"],
      "properties": {
        "group_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "candidate_set_digest": {"$ref": "#/$defs/digest"},
        "route": {"type": "string", "minLength": 1, "maxLength": 128},
        "canonical_identity": {"type": ["string", "null"], "maxLength": 4096},
        "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["slug", "generation", "evidence_digest"],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
        "generation": {"type": "integer", "minimum": 1},
        "evidence_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "intent", "task", "acknowledgements"],
      "properties": {
        "status": {"enum": ["intent", "effect_armed", "task_bound", "acknowledging", "complete"]},
        "intent": {"$ref": "#/$defs/intent"},
        "task": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/task"}]},
        "acknowledgements": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 512}}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_digest", "completed_group_count", "disposition_count", "inventory_count", "inventory_root_digest"],
      "properties": {
        "authority_digest": {"$ref": "#/$defs/digest"},
        "completed_group_count": {"type": "integer", "minimum": 0},
        "disposition_count": {"type": "integer", "minimum": 0},
        "inventory_count": {"type": "integer", "minimum": 0},
        "inventory_root_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
