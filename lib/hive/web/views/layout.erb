<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>hivebox</title>
    <link rel="stylesheet" href="/css/app.css">
    <script src="/js/sse.js" defer></script>
    <%# Per-page <head> extras (e.g. the agents-page meta-refresh) are %>
    <%# rendered here, in the document head, where http-equiv refresh is %>
    <%# valid — never inside <body>. Set @head in the view that needs it. %>
    <%= @head if defined?(@head) && @head %>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">hivebox</a>
      <nav>
        <a href="/">Status</a>
        <a href="/agents">Agents</a>
        <a href="/repos">Repos</a>
        <a href="/telegram">Telegram</a>
      </nav>
      <% if session[:github_login] %>
        <form method="post" action="/logout">
          <%= csrf_tag %>
          <button type="submit">Log out</button>
        </form>
      <% end %>
    </header>
    <main>
      <%= yield %>
    </main>
  </body>
</html>
