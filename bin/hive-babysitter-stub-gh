#!/bin/sh

unset RUBYOPT RUBYLIB BUNDLE_GEMFILE BUNDLE_BIN_PATH GEM_HOME GEM_PATH
unset BUNDLER_SETUP BUNDLER_VERSION
unset BUNDLER_ORIG_RUBYOPT BUNDLER_ORIG_RUBYLIB
unset BUNDLER_ORIG_BUNDLE_GEMFILE BUNDLER_ORIG_BUNDLE_BIN_PATH
unset BUNDLER_ORIG_GEM_HOME BUNDLER_ORIG_GEM_PATH
unset BUNDLER_ORIG_BUNDLER_SETUP BUNDLER_ORIG_BUNDLER_VERSION
unset LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
unset DYLD_INSERT_LIBRARIES DYLD_LIBRARY_PATH DYLD_FRAMEWORK_PATH
unset DYLD_FALLBACK_LIBRARY_PATH DYLD_FALLBACK_FRAMEWORK_PATH
unset DYLD_VERSIONED_LIBRARY_PATH DYLD_VERSIONED_FRAMEWORK_PATH DYLD_PRINT_TO_FILE

case "$0" in
  */*) script_dir=${0%/*} ;;
  *) script_dir=. ;;
esac

exec ruby "$script_dir/hive-babysitter-stub-gh.rb" "$@"
