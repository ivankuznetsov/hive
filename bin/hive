#!/usr/bin/env ruby

source_agent_runtime_lib = File.expand_path(
  "../components/agent-cli-runtime/lib",
  __dir__
)
if File.file?(File.join(source_agent_runtime_lib, "agent_cli_runtime.rb"))
  $LOAD_PATH.unshift(source_agent_runtime_lib)
end
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "hive"
require "hive/llm_wiki_bootstrap"

# The workflow creator owns two strict observation routes. They must stay
# byte-for-byte no-write even when an upgraded binary would otherwise repair
# scheduler units during process startup.
init_index = ARGV.index("init")
workflow_index = ARGV.index("workflow")
strict_no_write_route =
  if init_index && (!workflow_index || init_index < workflow_index)
    ARGV.drop(init_index + 1).any? do |arg|
      arg == "--preview" || arg.match?(/\A--preview=true\z/i)
    end
  elsif workflow_index
    workflow_subcommands = %w[new validate commit install list update remove publish].freeze
    workflow_subcommand = ARGV.drop(workflow_index + 1).find do |arg|
      workflow_subcommands.include?(arg)
    end
    workflow_subcommand == "validate"
  else
    false
  end

# Repair legacy path-keyed LLM-wiki timers as soon as an upgraded Hive binary
# is invoked, including `hive --version`. The reconciliation is idempotent and
# touches only Hive-managed units.
unless strict_no_write_route
  begin
    Hive::LlmWikiBootstrap::Scheduler.reconcile_existing!
  rescue StandardError => e
    warn "hive: warning: could not reconcile LLM-wiki scheduler units: #{e.message}"
  end
end

if ENV["HIVE_ATTEMPT_INTERNAL"] == "1"
  require "hive/attempts/context"
  begin
    Hive::Attempts::Context.install_from_env!(argv: [ "hive", *ARGV ])
  rescue Hive::Error => e
    warn "hive: #{e.message}"
    exit e.exit_code
  end
end

require "hive/cli"
require "hive/cli_argv_policy"
require "hive/cli_json_options"
require "hive/refactor_patrol/reporter"
require "json"

# Private detached-wrapper route. It is deliberately handled before Thor so
# it never appears as a public workflow verb and cannot recurse through normal
# admission. DetachedLauncher is the only producer.
if ARGV.first == "__attempt-supervise"
  require "hive/commands/attempt_supervise"
  begin
    exit Hive::Commands::AttemptSupervise.from_argv(ARGV.drop(1)).call
  rescue Hive::Error => e
    warn "hive: #{e.message}"
    exit e.exit_code
  end
end

# Private module-hook worker route. Only the durable attempt supervisor emits
# this argv after admission; keeping it ahead of Thor prevents a public bypass
# around previewed installation and hook state.
if ARGV.first == "__module-hook"
  require "hive/commands/module_hook"
  begin
    unless Hive::Attempts::Context.active?
      raise Hive::ConfigError, "module hook requires authenticated durable attempt context"
    end
    exit Hive::Commands::ModuleHook.from_argv(ARGV.drop(1)).call
  rescue Hive::Error => e
    warn "hive: #{e.message}"
    exit e.exit_code
  end
end

if ARGV == [ "--version" ] || ARGV == [ "-v" ]
  puts Hive::VERSION
  exit 0
end

JSON_BOOLEAN_OPTIONS = Hive::CliJsonOptions::BOOLEAN_OPTIONS
STAGE_ACTION_USAGE_COMMANDS = %w[brainstorm plan develop open-pr review artifacts finalize archive].freeze
NEW_VALUE_OPTIONS = %w[--base --depends-on --workflow --idempotency-key].freeze
JSON_USAGE_ERROR_CONTRACTS = {
  "run" => { schema: "hive-run", error_kind: "invalid_task_path" },
  "rebase-status" => { schema: "hive-rebase-status", schema_version: 1, error_kind: "invalid_task_path" },
  "approve" => { schema: "hive-approve", error_kind: "invalid_task_path" },
  "drop" => { schema: "hive-drop", error_kind: "invalid_task_path" },
  "findings" => { schema: "hive-findings", error_kind: "invalid_task_path" },
  "patrol" => { schema: "hive-patrol", error_kind: "error" },
  "refactor-patrol" => { reporter: :refactor_patrol, error_kind: "error" },
  "setup" => { schema: "hive-setup", error_kind: "usage" },
  "connect" => { error_kind: "usage", extras: { "service" => "screenote" } },
  "disconnect" => { error_kind: "usage", extras: { "service" => "screenote" } },
  "accept-finding" => {
    schema: "hive-findings",
    error_kind: "invalid_task_path",
    extras: { "operation" => "accept" }
  },
  "reject-finding" => {
    schema: "hive-findings",
    error_kind: "invalid_task_path",
    extras: { "operation" => "reject" }
  },
  "markers" => { schema: "hive-markers-clear", error_kind: "invalid_task_path" },
  "status" => { schema: "hive-running-status", error_kind: "error" },
  "circuits" => { schema: "hive-circuits", error_kind: "usage" },
  "act" => { schema: "hive-act", error_kind: "usage" },
  "prune" => { schema: "hive-prune", error_kind: "usage" },
  "forget" => { schema: "hive-forget", error_kind: "usage" },
  "metrics" => {
    schema: "hive-metrics-rollback-rate",
    error_kind: "error",
    omit_error_class: true
  },
  "answer-digest" => { schema: "hive-answer-digest", error_kind: "usage" },
  "answer" => { schema: "hive-answer", error_kind: "usage" },
  # Residual workflow argv-shape errors raised by Thor before command dispatch
  # (for example too many positionals) must ride the same JSON envelope as the
  # command's own UsageError. Bare `hive workflow` is handled in-command.
  "workflow" => { schema: "hive-workflow-new", error_kind: "usage" },
  "worktree" => { schema: "hive-worktree", error_kind: "invalid_arguments" },
  "module" => { schema: "hive-module-lifecycle", error_kind: "usage" },
  "pr" => {
    schema: "hive-stage-action",
    error_kind: "invalid_task_path",
    extras: { "verb" => "open-pr" }
  }
}.merge(
  STAGE_ACTION_USAGE_COMMANDS.to_h do |command|
    [ command, { schema: "hive-stage-action", error_kind: "invalid_task_path", extras: { "verb" => command } } ]
  end
).freeze

def json_requested?(argv)
  Hive::CliArgvPolicy.json_requested?(argv)
end

def json_usage_option_region(argv, command_index)
  argv.drop(command_index + 1).take_while { |arg| arg != "--" }
end

def json_usage_subcommand(argv, command_index, value_options: [])
  skip_value = false
  options = true
  argv.drop(command_index + 1).each do |arg|
    if skip_value
      skip_value = false
      next
    end
    return unless arg.valid_encoding?

    if options && arg == "--"
      options = false
    elsif options && value_options.include?(arg)
      skip_value = true
    elsif options && arg.start_with?("-")
      next
    else
      return arg
    end
  end
  nil
end

def json_usage_positionals(argv, command_index, value_options: [])
  positionals = []
  skip_value = false
  options = true
  argv.drop(command_index + 1).each do |arg|
    if skip_value
      skip_value = false
      next
    end
    next unless arg.valid_encoding?

    if options && arg == "--"
      options = false
    elsif options && value_options.include?(arg)
      skip_value = true
    elsif options && value_options.any? { |option| arg.start_with?("#{option}=") }
      next
    elsif options && arg.start_with?("-")
      next
    else
      positionals << arg
    end
  end
  positionals
end

def json_usage_error_contract(argv)
  command_index = argv.index { |arg| !arg.b.start_with?("-") }
  return unless command_index

  command = argv.fetch(command_index)
  return unless command.valid_encoding?
  option_argv = json_usage_option_region(argv, command_index)

  case command
  when "act"
    action_id, target = json_usage_positionals(
      argv, command_index, value_options: %w[--observation]
    ).first(2)
    return {
      schema: "hive-act",
      error_kind: "usage",
      extras: { "action_id" => action_id.to_s, "target" => target.to_s }
    }
  when "status"
    diagnose = option_argv.any? do |arg|
      arg.valid_encoding? && (arg == "--diagnose" || arg.start_with?("--diagnose="))
    end
    return { schema: "hive-status-diagnose", error_kind: "error" } if diagnose
    operational = option_argv.any? do |arg|
      arg.valid_encoding? && (arg == "--operational" || arg.start_with?("--operational="))
    end
    return { schema: "hive-operational-status", error_kind: "error" } if operational
    internal_task_graph = option_argv.any? do |arg|
      arg.valid_encoding? &&
        (arg == "--internal-task-graph" || arg.start_with?("--internal-task-graph="))
    end
    daemon_task = option_argv.any? do |arg|
      arg.valid_encoding? && (arg == "--daemon-task" || arg.start_with?("--daemon-task="))
    end
    return { schema: "hive-status", error_kind: "error" } if internal_task_graph || daemon_task
  when "web"
    subcommand = json_usage_subcommand(argv, command_index, value_options: %w[--bind --port])
    return unless %w[install status].include?(subcommand)

    return {
      schema: "hive-web-#{subcommand}",
      error_kind: "invalid_task_path"
    }
  when "bot"
    # hive-bot-status is deliberately the usage-error contract for the whole
    # bot surface; the stop/reload schemas only describe lifecycle results.
    return { schema: "hive-bot-status", error_kind: "extra_arguments" }
  when "pairing"
    subcommand = json_usage_subcommand(argv, command_index)
    schema = subcommand == "approve" ? "hive-pairing-approve" : "hive-pairing-list"
    return { schema: schema, error_kind: "invalid_arguments" }
  when "decide"
    return { schema: "hive-decide", error_kind: "invalid_task_path" }
  when "refactor-patrol"
    if (jobs = refactor_patrol_jobs_argv(option_argv))
      return {
        schema: "hive-refactor-patrol-jobs", error_kind: "usage",
        extras: { "action" => jobs.fetch(:action) }
      }
    end
  when "workflow"
    subcommand = json_usage_subcommand(argv, command_index)
    schema = case subcommand
    when "install" then "hive-workflow-install"
    when "list" then "hive-workflow-list"
    when "remove" then "hive-workflow-remove"
    when "update" then "hive-workflow-update"
    when "publish" then "hive-workflow-publish"
    when "validate" then "hive-workflow-validate"
    else "hive-workflow-new"
    end
    if Hive::Schemas::SCHEMA_VERSIONS.key?(schema)
      extras = if subcommand == "validate"
        id = json_usage_positionals(argv, command_index).fetch(1, "")
        { "valid" => false, "id" => id }
      else
        {}
      end
      return { schema: schema, error_kind: "usage", extras: extras }
    end
  when "module"
    subcommand = json_usage_subcommand(
      argv, command_index,
      value_options: %w[
        --receipt --setting --hook --grant --mapping --input-binding
        --event --schedule --occurred-at
      ]
    )
    schema = case subcommand
    when "list" then "hive-module-list"
    when "inspect", "status" then "hive-module-status"
    when "doctor" then "hive-module-doctor"
    when "dry-run" then "hive-module-dry-run"
    else "hive-module-lifecycle"
    end
    return { schema: schema, error_kind: "usage" }
  end

  JSON_USAGE_ERROR_CONTRACTS[command]
end

def refactor_patrol_jobs_argv(argv)
  archive = false
  list = nil
  full = nil
  show = false
  modifier = argv.any? do |arg|
    arg == "--limit" || arg.start_with?("--limit=") ||
      arg == "--cursor" || arg.start_with?("--cursor=")
  end
  argv.each do |arg|
    if arg == "--archive" || arg.start_with?("--archive=")
      archive = true
    elsif arg == "--show" || arg.start_with?("--show=")
      show = true
    elsif %w[--no-list --skip-list].include?(arg)
      list = false
    elsif arg == "--list"
      list = true
    elsif arg.start_with?("--list=")
      value = arg.split("=", 2).last.to_s.downcase
      list = !%w[false f no n 0].include?(value)
    elsif %w[--no-full --skip-full].include?(arg)
      full = false
    elsif arg == "--full"
      full = true
    elsif arg.start_with?("--full=")
      value = arg.split("=", 2).last.to_s.downcase
      full = !%w[false f no n 0].include?(value)
    end
  end
  action = if archive
    "show"
  elsif list == true
    "list"
  elsif show
    "show"
  end
  return unless action || full == true || modifier

  { action: action }
end

def native_web_error_context(schema, argv)
  require "hive/commands/web"
  if schema == "hive-web-status"
    return Hive::Commands::Web.status_error_context(environment: ENV)
  end
  context = Hive::Commands::Web.error_context(environment: ENV)
  return context unless schema == "hive-setup"

  mode = if argv.any? { |arg| %w[--no-bootstrap --skip-bootstrap --bootstrap=false].include?(arg) }
    "diagnose_only"
  elsif argv.any? { |arg| %w[--no-service --skip-service --service=false].include?(arg) }
    "service_opt_out"
  else
    "managed_service"
  end
  {
    "mode" => mode,
    "url" => context.fetch("url"),
    "service" => context.slice(
      "platform", "unit_path", "service_installed", "service_enabled",
      "service_running", "service_manager_available", "url", "ready", "readiness"
    ),
    "warnings" => context.fetch("warnings")
  }
end

def json_usage_error_payload(contract, error, argv: [])
  if contract[:reporter] == :refactor_patrol
    return Hive::RefactorPatrol::Reporter.error_envelope(
      error,
      version: Hive::RefactorPatrol::Reporter::V4_SCHEMA_VERSION,
      error_kind: contract.fetch(:error_kind)
    )
  end

  schema = contract[:schema]
  error_kind = contract.fetch(:error_kind)
  extras = contract.fetch(:extras, {})
  if schema && Hive::Schemas::SCHEMA_VERSIONS.key?(schema)
    if %w[hive-setup hive-web-status hive-web-install].include?(schema)
      extras = extras.merge(native_web_error_context(schema, argv))
    end
    payload = Hive::Schemas::ErrorEnvelope.build(
      schema: schema,
      error: error,
      error_kind: error_kind,
      extras: extras
    )
    if schema == "hive-workflow-validate"
      payload["diagnostics"] = [ { "message" => error.message } ]
    end
    payload.delete("error_class") if contract[:omit_error_class]
    return payload
  end

  payload = {}
  if schema
    payload["schema"] = schema
    payload["schema_version"] = contract.fetch(:schema_version, 1) unless contract[:schema_version] == false
  end

  payload.merge!(
    "ok" => false,
    "error_class" => error.class.name.split("::").last,
    "error_kind" => error_kind,
    "exit_code" => error.respond_to?(:exit_code) ? error.exit_code : Hive::ExitCodes::GENERIC,
    "message" => error.message
  ).merge(extras)
end

def emit_json_usage_error(argv, error)
  contract = json_usage_error_contract(argv)
  return false unless contract && json_requested?(argv)

  puts JSON.generate(json_usage_error_payload(contract, error, argv: argv))
  true
rescue Errno::EPIPE
  true
rescue JSON::GeneratorError
  false
end

def thor_usage_error(argv, error)
  contract = json_usage_error_contract(argv)
  klass = if contract&.fetch(:error_kind, nil) == "invalid_task_path"
    Hive::InvalidTaskPath
  else
    Hive::UsageError
  end
  klass.new(error.message)
end

original_argv = ARGV.dup

begin
  ARGV.replace(Hive::CliArgvPolicy.validate_encoding(ARGV))
  text_start = Hive::CliArgvPolicy.new_text_start_index(ARGV, value_options: NEW_VALUE_OPTIONS)
  ARGV.replace(Hive::CliArgvPolicy.reject_unsupported_json_assignments(ARGV, before_index: text_start))
  ARGV.replace(Hive::CliArgvPolicy.normalize_leading_json_options(ARGV))
  text_start = Hive::CliArgvPolicy.new_text_start_index(ARGV, value_options: NEW_VALUE_OPTIONS)
  ARGV.replace(Hive::CliArgvPolicy.rewrite_help(ARGV, text_start_index: text_start))
  ARGV.replace(Hive::CliArgvPolicy.lift_new_options(ARGV, value_options: NEW_VALUE_OPTIONS))
  Hive::CLI.start(ARGV, debug: true)
rescue Thor::Error => e
  error = thor_usage_error(original_argv, e)
  emitted_json = emit_json_usage_error(original_argv, error)
  warn(emitted_json ? "hive: #{error.message}" : error.message)
  exit(error.exit_code)
rescue Hive::Error => e
  warn "hive: #{e.message}"
  exit(e.respond_to?(:exit_code) ? e.exit_code : 1)
end
