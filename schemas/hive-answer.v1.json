{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-answer.v1.json",
  "title": "hive answer output (v1)",
  "description": "Transport-neutral read-only brainstorm inventory and identity-bound literal answer result. The command never dispatches a stage.",
  "oneOf": [
    { "$ref": "#/$defs/InventoryPayload" },
    { "$ref": "#/$defs/WritePayload" },
    { "$ref": "#/$defs/ErrorPayload" }
  ],
  "$defs": {
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "id", "slug", "stage", "folder", "generation"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "id": { "type": ["integer", "null"], "minimum": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "stage": { "const": "2-brainstorm" },
        "folder": { "type": "string", "minLength": 1 },
        "generation": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "Slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "round", "question_number", "text", "answered",
        "answer", "fingerprint", "binding"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "round": { "type": ["integer", "null"], "minimum": 1 },
        "question_number": { "type": "integer", "minimum": 1 },
        "text": { "type": "string" },
        "answered": { "type": "boolean" },
        "answer": { "type": ["string", "null"] },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "binding": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]+$" },
        "suggestion": {
          "oneOf": [
            { "$ref": "#/$defs/Suggestion" },
            { "type": "null" }
          ]
        }
      }
    },
    "Suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state", "text", "rationale", "provenance", "safe_reason",
        "retryable", "dismissed", "input_binding", "suggestion_binding"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["loading", "fresh", "stale", "no_safe_suggestion", "unavailable", "failed"]
        },
        "text": { "type": ["string", "null"], "maxLength": 1000 },
        "rationale": { "type": ["string", "null"], "maxLength": 320 },
        "provenance": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["request", "repository", "project_wiki", "main_wiki", "settled_answers"]
          }
        },
        "safe_reason": { "type": ["string", "null"], "maxLength": 240 },
        "retryable": { "type": "boolean" },
        "dismissed": { "type": "boolean" },
        "input_binding": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "suggestion_binding": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "InventoryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "schema_version", "ok", "operation", "task",
        "slot_count", "unanswered_count", "complete", "slots"
      ],
      "properties": {
        "schema": { "const": "hive-answer" },
        "schema_version": { "const": 1 },
        "ok": { "const": true },
        "operation": { "const": "inventory" },
        "task": { "$ref": "#/$defs/Task" },
        "slot_count": { "type": "integer", "minimum": 0 },
        "unanswered_count": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" },
        "slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/Slot" }
        }
      }
    },
    "WritePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "schema_version", "ok", "operation", "outcome", "reason",
        "written", "relocated", "task", "slot", "unanswered_count",
        "complete", "acknowledgement"
      ],
      "properties": {
        "schema": { "const": "hive-answer" },
        "schema_version": { "const": 1 },
        "ok": { "const": true },
        "operation": { "const": "write" },
        "outcome": {
          "type": "string",
          "enum": ["written", "idempotent", "stale", "ambiguous", "conflict", "lock_busy"]
        },
        "reason": {
          "type": "string",
          "enum": [
            "exact_match", "unique_relocation", "already_answered_same",
            "already_answered_different", "question_changed", "question_missing",
            "multiple_matches", "task_missing", "task_moved", "identity_changed",
            "generation_changed", "task_lock_busy"
          ]
        },
        "written": { "type": "boolean" },
        "relocated": { "type": "boolean" },
        "task": { "$ref": "#/$defs/Task" },
        "slot": {
          "oneOf": [
            { "$ref": "#/$defs/Slot" },
            { "type": "null" }
          ]
        },
        "unanswered_count": { "type": ["integer", "null"], "minimum": 0 },
        "complete": { "type": ["boolean", "null"] },
        "acknowledgement": { "type": "string", "minLength": 1 }
      }
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "schema_version", "ok", "error_class", "error_kind",
        "exit_code", "message"
      ],
      "properties": {
        "schema": { "const": "hive-answer" },
        "schema_version": { "const": 1 },
        "ok": { "const": false },
        "error_class": { "type": "string" },
        "error_kind": {
          "type": "string",
          "enum": [
            "invalid_binding", "invalid_answer", "wrong_stage", "stale",
            "ambiguous_slug", "invalid_task_path", "config", "usage", "internal"
          ]
        },
        "exit_code": { "type": "integer", "enum": [1, 4, 64, 70, 75, 78] },
        "message": { "type": "string" },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["project", "stage", "folder"],
            "additionalProperties": true,
            "properties": {
              "project": { "type": "string" },
              "stage": { "type": "string" },
              "folder": { "type": "string" }
            }
          }
        },
        "current_stage": { "type": ["string", "null"] },
        "target_stage": { "type": ["string", "null"] }
      }
    }
  }
}
