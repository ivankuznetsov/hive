{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-refactor-patrol.v4.json",
  "title": "hive refactor patrol output (v4)",
  "description": "Current-only local and PR-scoped architecture patrol output with explicit scoreless routes.",
  "oneOf": [
    {
      "$ref": "#/$defs/LocalSuccessPayload"
    },
    {
      "$ref": "#/$defs/SuccessPayload"
    },
    {
      "$ref": "#/$defs/LocalErrorPayload"
    },
    {
      "$ref": "#/$defs/ErrorPayload"
    }
  ],
  "$defs": {
    "SourcePr": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "url",
        "number",
        "repository",
        "registration",
        "base_branch",
        "base_sha",
        "merge_sha",
        "merged_at",
        "changed_paths",
        "manifest_checksum"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "repository": {
          "type": "string"
        },
        "registration": {
          "type": "string"
        },
        "base_branch": {
          "type": "string"
        },
        "base_sha": {
          "type": "string"
        },
        "merge_sha": {
          "type": "string"
        },
        "merged_at": {
          "type": "string"
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manifest_checksum": {
          "type": "string"
        }
      }
    },
    "Disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "feature_id",
        "fingerprint",
        "route",
        "admissible",
        "reasons",
        "thesis"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "feature_id": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "admissible": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "thesis": {
          "$ref": "#/$defs/ThesisSnapshot"
        },
        "route": {
          "enum": [
            "fix",
            "discuss",
            "dismiss"
          ]
        }
      }
    },
    "ThesisSnapshot": {
      "type": "object",
      "description": "Immutable normalized thesis consumed by later action workers.",
      "additionalProperties": false,
      "required": [
        "id",
        "feature_id",
        "feature",
        "problem",
        "cost",
        "evidence",
        "proposed_refactor",
        "feature_boundary",
        "architecture_effects",
        "route",
        "confidence",
        "risk",
        "required_validation",
        "admissible",
        "admissibility_reason",
        "follow_up_approval_state",
        "fingerprint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "feature_id": {
          "type": "string",
          "minLength": 1
        },
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "cost": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ThesisEvidence"
          }
        },
        "proposed_refactor": {
          "type": "string",
          "minLength": 1
        },
        "feature_boundary": {
          "$ref": "#/$defs/ThesisFeatureBoundary"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "risk": {
          "$ref": "#/$defs/ThesisRisk"
        },
        "required_validation": {
          "$ref": "#/$defs/ThesisRequiredValidation"
        },
        "admissible": {
          "type": "boolean"
        },
        "admissibility_reason": {
          "type": "string"
        },
        "follow_up_approval_state": {
          "enum": [
            "pending",
            "not_requested",
            "approved",
            "rejected"
          ]
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "collision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reference"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "reference": {
              "type": "string"
            }
          }
        },
        "architecture_effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "route": {
          "enum": [
            "fix",
            "discuss",
            "dismiss"
          ]
        }
      }
    },
    "ThesisEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "snippet": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ThesisFeatureBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owned_files",
        "entrypoints"
      ],
      "properties": {
        "owned_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ThesisRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caps",
        "public_api_impact",
        "public_api_details",
        "cross_feature_impact",
        "cross_feature_details",
        "flags"
      ],
      "properties": {
        "caps": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "single_feature"
          ],
          "properties": {
            "single_feature": {
              "type": "boolean"
            }
          }
        },
        "public_api_impact": {
          "type": "boolean"
        },
        "public_api_details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cross_feature_impact": {
          "type": "boolean"
        },
        "cross_feature_details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "advisories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ThesisRequiredValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "characterization_first",
        "notes"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "characterization_first": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "ReviewError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "error"
      ],
      "properties": {
        "feature_id": {
          "type": "string"
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "FeatureResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "complete",
        "thesis_ids",
        "errors"
      ],
      "properties": {
        "feature_id": {
          "type": "string",
          "minLength": 1
        },
        "complete": {
          "type": "boolean"
        },
        "thesis_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReviewError"
          }
        }
      }
    },
    "Attempt": {
      "type": "object",
      "additionalProperties": true
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_action_id",
        "thesis_id",
        "thesis_fingerprint",
        "kind",
        "owner_job_id",
        "outcome",
        "terminal",
        "receipts"
      ],
      "properties": {
        "canonical_action_id": {
          "type": "string",
          "minLength": 1
        },
        "thesis_id": {
          "type": "string",
          "minLength": 1
        },
        "thesis_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "fix",
            "issue"
          ]
        },
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_job_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "terminal": {
          "type": "boolean"
        },
        "receipts": {
          "type": "object"
        }
      }
    },
    "SuccessPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "ok",
        "job_id",
        "project",
        "project_root",
        "dry_run",
        "source_pr",
        "analysis_sha",
        "complete",
        "features_mapped",
        "fix",
        "discuss",
        "dismiss",
        "review_errors",
        "feature_results",
        "zero_reason",
        "attempts",
        "actions"
      ],
      "properties": {
        "schema": {
          "const": "hive-refactor-patrol"
        },
        "schema_version": {
          "const": 4
        },
        "ok": {
          "const": true
        },
        "job_id": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "project_root": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "source_pr": {
          "$ref": "#/$defs/SourcePr"
        },
        "analysis_sha": {
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        },
        "features_mapped": {
          "type": "integer",
          "minimum": 0
        },
        "review_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReviewError"
          }
        },
        "feature_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FeatureResult"
          }
        },
        "zero_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "no_mapped_slice",
            "no_theses",
            "all_dismissed",
            null
          ]
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attempt"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        "action_status": {
          "type": "object",
          "additionalProperties": true
        },
        "fix": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/Disposition"
              },
              {
                "properties": {
                  "route": {
                    "const": "fix"
                  }
                },
                "required": [
                  "route"
                ]
              }
            ]
          }
        },
        "discuss": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/Disposition"
              },
              {
                "properties": {
                  "route": {
                    "const": "discuss"
                  }
                },
                "required": [
                  "route"
                ]
              }
            ]
          }
        },
        "dismiss": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/Disposition"
              },
              {
                "properties": {
                  "route": {
                    "const": "dismiss"
                  }
                },
                "required": [
                  "route"
                ]
              }
            ]
          }
        }
      }
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "ok",
        "job_id",
        "source_pr",
        "complete",
        "error_class",
        "error_kind",
        "exit_code",
        "message"
      ],
      "properties": {
        "schema": {
          "const": "hive-refactor-patrol"
        },
        "schema_version": {
          "const": 4
        },
        "ok": {
          "const": false
        },
        "job_id": {
          "type": "string"
        },
        "source_pr": {
          "$ref": "#/$defs/SourcePr"
        },
        "complete": {
          "const": false
        },
        "error_class": {
          "type": "string"
        },
        "error_kind": {
          "enum": [
            "config",
            "error"
          ]
        },
        "exit_code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "LocalSuccessPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "ok",
        "project",
        "project_root",
        "dry_run",
        "review_complete",
        "review_errors",
        "feature_results",
        "features_mapped",
        "fix",
        "discuss",
        "dismiss",
        "last_scanned_sha"
      ],
      "properties": {
        "schema": {
          "const": "hive-refactor-patrol"
        },
        "schema_version": {
          "const": 4
        },
        "ok": {
          "const": true
        },
        "project": {
          "type": "string"
        },
        "project_root": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "review_complete": {
          "type": "boolean"
        },
        "review_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReviewError"
          }
        },
        "feature_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FeatureResult"
          }
        },
        "features_mapped": {
          "type": "integer",
          "minimum": 0
        },
        "fix": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/Disposition"
              },
              {
                "properties": {
                  "route": {
                    "const": "fix"
                  }
                },
                "required": [
                  "route"
                ]
              }
            ]
          }
        },
        "discuss": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/Disposition"
              },
              {
                "properties": {
                  "route": {
                    "const": "discuss"
                  }
                },
                "required": [
                  "route"
                ]
              }
            ]
          }
        },
        "dismiss": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/Disposition"
              },
              {
                "properties": {
                  "route": {
                    "const": "dismiss"
                  }
                },
                "required": [
                  "route"
                ]
              }
            ]
          }
        },
        "last_scanned_sha": {
          "type": "string"
        }
      }
    },
    "LocalErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "ok",
        "error_class",
        "error_kind",
        "exit_code",
        "message"
      ],
      "properties": {
        "schema": {
          "const": "hive-refactor-patrol"
        },
        "schema_version": {
          "const": 4
        },
        "ok": {
          "const": false
        },
        "error_class": {
          "type": "string"
        },
        "error_kind": {
          "enum": [
            "config",
            "error"
          ]
        },
        "exit_code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
