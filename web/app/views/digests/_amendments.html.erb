<% if digest.amendments.any? %>
  <section class="digest-amendments" aria-labelledby="digest-amendments-heading">
    <div class="digest-section-heading">
      <div>
        <p class="digest-kicker">Observed after close</p>
        <h2 id="digest-amendments-heading">Late amendments</h2>
      </div>
      <span class="digest-count"><%= digest.amendments.length %></span>
    </div>
    <ol class="digest-amendment-list">
      <% digest.amendments.each do |amendment| %>
        <li>
          <div class="digest-card-heading">
            <strong><%= amendment["kind"].to_s.humanize %></strong>
            <%= digest_time_tag(amendment["amended_at"]) if amendment["amended_at"] %>
          </div>
          <p>
            <%= pluralize(Array(amendment["items"]).length, "late item") %> ·
            <%= pluralize(Array(amendment["resolved_gap_ids"]).length, "resolved gap") %>
          </p>
          <% if Array(amendment["items"]).any? %>
            <ul class="digest-amendment-details">
              <% Array(amendment["items"]).each do |item| %>
                <li>
                  Late: <%= item["summary"].presence || item["kind"].to_s.humanize %>
                  <% if item["project"] || item["task_slug"] %>
                    · <%= [item["project"], item["task_slug"]].compact.join(":") %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
          <% resolved = Array(amendment["resolved_gaps"]) %>
          <% if resolved.any? %>
            <ul class="digest-amendment-details">
              <% resolved.each do |gap| %>
                <li>Recovered: <%= gap["source"].to_s.humanize %> · <%= gap["scope"].presence || "global" %></li>
              <% end %>
            </ul>
          <% elsif Array(amendment["resolved_gap_ids"]).any? %>
            <ul class="digest-amendment-details">
              <% Array(amendment["resolved_gap_ids"]).each do |gap_id| %>
                <li>Recovered gap: <%= gap_id %></li>
              <% end %>
            </ul>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>
