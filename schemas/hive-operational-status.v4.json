{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:operational-status:v4",
  "title": "hive operational status output (v4)",
  "oneOf": [
    { "$ref": "#/$defs/SuccessPayload" },
    { "$ref": "#/$defs/ErrorPayload" }
  ],
  "$defs": {
    "SuccessPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "schema_version", "ok", "generated_at", "completeness",
        "source", "summary", "daemon", "attempt_storage", "scheduler", "archive", "issues", "tasks"
      ],
      "properties": {
    "schema": { "const": "hive-operational-status" },
    "schema_version": { "const": 4 },
    "ok": { "const": true },
    "generated_at": { "type": "string", "format": "date-time" },
    "completeness": { "$ref": "#/$defs/Completeness" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_graph", "scheduler"],
      "properties": {
        "task_graph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "schema_version", "generated_at", "status", "projects_total", "projects_healthy"],
          "properties": {
            "schema": { "const": "hive-status" },
            "schema_version": { "type": "integer", "minimum": 1 },
            "generated_at": { "type": "string", "format": "date-time" },
            "status": { "$ref": "#/$defs/Completeness" },
            "projects_total": { "type": "integer", "minimum": 0 },
            "projects_healthy": { "type": "integer", "minimum": 0 }
          }
        },
        "scheduler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "observed_at"],
          "properties": {
            "status": { "$ref": "#/$defs/SchedulerStatus" },
            "observed_at": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_state", "active", "archived", "hidden_archived_task_count",
        "projects_total", "projects_healthy", "states"
      ],
      "properties": {
        "overall_state": { "$ref": "#/$defs/State" },
        "active": { "type": "integer", "minimum": 0 },
        "archived": { "type": "integer", "minimum": 0 },
        "hidden_archived_task_count": { "type": "integer", "minimum": 0 },
        "projects_total": { "type": "integer", "minimum": 0 },
        "projects_healthy": { "type": "integer", "minimum": 0 },
        "states": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unknown", "running", "needs_repair", "waiting_on_you",
            "waiting_on_provider_or_scheduler", "completion_ready", "idle"
          ],
          "properties": {
            "unknown": { "type": "integer", "minimum": 0 },
            "running": { "type": "integer", "minimum": 0 },
            "needs_repair": { "type": "integer", "minimum": 0 },
            "waiting_on_you": { "type": "integer", "minimum": 0 },
            "waiting_on_provider_or_scheduler": { "type": "integer", "minimum": 0 },
            "completion_ready": { "type": "integer", "minimum": 0 },
            "idle": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "daemon": { "$ref": "#/$defs/Daemon" },
    "attempt_storage": { "$ref": "#/$defs/AttemptStorage" },
    "scheduler": { "$ref": "#/$defs/Scheduler" },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "by_project", "closures"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "by_project": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["project", "count"],
            "properties": {
              "project": { "type": "string" },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "closures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "project", "slug", "reason", "authority",
              "receipt_digest", "evidence"
            ],
            "properties": {
              "project": { "type": "string" },
              "slug": { "type": "string" },
              "reason": { "type": "string", "enum": ["already_delivered", "superseded"] },
              "authority": { "type": "string", "enum": ["remote_merge", "operator_attestation"] },
              "receipt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
            }
          }
        }
      }
    },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/Issue" } },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/Task" } }
      }
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "ok", "error_class", "error_kind", "exit_code", "message"],
      "properties": {
        "schema": { "const": "hive-operational-status" },
        "schema_version": { "const": 4 },
        "ok": { "const": false },
        "error_class": { "type": "string" },
        "error_kind": { "type": "string", "enum": ["config", "internal", "error"] },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "message": { "type": "string" },
        "candidates": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "id": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "Completeness": { "type": "string", "enum": ["complete", "partial", "unknown"] },
    "State": {
      "type": "string",
      "enum": [
        "unknown", "running", "needs_repair", "waiting_on_you",
        "waiting_on_provider_or_scheduler", "completion_ready", "idle"
      ]
    },
    "SchedulerStatus": {
      "type": "string",
      "enum": ["not_applicable", "unavailable", "current", "stale", "invalid"]
    },
    "Daemon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "generation", "pid", "process_start_time", "phase", "observed_at"],
      "properties": {
        "status": { "type": "string", "enum": ["not_applicable", "healthy", "degraded", "stopped", "unknown"] },
        "generation": { "type": ["string", "null"] },
        "pid": { "type": ["integer", "null"], "minimum": 1 },
        "process_start_time": { "type": ["string", "null"] },
        "phase": { "type": ["string", "null"], "enum": ["started", "failed", "complete", null] },
        "observed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "AttemptStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "layout", "hot", "maintenance", "last_error", "degraded_reason"],
      "properties": {
        "status": { "type": "string", "enum": ["healthy", "degraded", "unknown"] },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation", "migration"],
          "properties": {
            "generation": { "const": 4 },
            "migration": { "type": "string", "enum": ["complete", "failed", "unknown"] },
            "last_migrated_at": { "type": ["string", "null"], "format": "date-time" },
            "last_result": { "type": ["object", "null"], "additionalProperties": { "type": "integer", "minimum": 0 } }
          }
        },
        "hot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["records", "invalid"],
          "properties": {
            "records": { "type": ["integer", "null"], "minimum": 0 },
            "invalid": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "maintenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["last_started_at", "last_completed_at", "last_result"],
          "properties": {
            "last_started_at": { "type": ["string", "null"], "format": "date-time" },
            "last_completed_at": { "type": ["string", "null"], "format": "date-time" },
            "last_result": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["promoted", "deleted", "cold_examined"],
              "properties": {
                "promoted": { "type": "integer", "minimum": 0 },
                "deleted": { "type": "integer", "minimum": 0 },
                "cold_examined": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "last_error": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "class"],
              "properties": {
                "operation": { "type": "string", "enum": ["maintenance", "migration", "status"] },
                "class": { "type": "string", "maxLength": 120 },
                "observed_at": { "type": "string", "format": "date-time" }
              }
            }
          ]
        },
        "degraded_reason": { "type": ["string", "null"] }
      }
    },
    "Scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "reason", "observed_at", "valid_until", "tick_sequence",
        "capacity", "queue", "provider_holds"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/SchedulerStatus" },
        "reason": { "type": ["string", "null"] },
        "observed_at": { "type": ["string", "null"], "format": "date-time" },
        "valid_until": { "type": ["string", "null"], "format": "date-time" },
        "tick_sequence": { "type": ["integer", "null"], "minimum": 0 },
        "capacity": { "type": ["object", "null"], "additionalProperties": true },
        "queue": { "type": ["object", "null"], "additionalProperties": true },
        "provider_holds": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    },
    "Issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "source", "project", "task", "message", "remediation"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warning", "error"] },
        "source": { "type": "string" },
        "project": { "type": ["string", "null"] },
        "task": { "type": ["string", "null"] },
        "message": { "type": "string" },
        "remediation": { "type": "string" }
      }
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity", "workflow", "position", "liveness", "state", "blocker_owner",
        "reason", "reasons", "provider", "routing", "retry", "recovery", "closure", "plan_review",
        "dependency", "freshness", "evidence", "action"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project", "slug", "id", "display_name", "folder"],
          "properties": {
            "project": { "type": "string" },
            "slug": { "type": "string" },
            "id": { "type": ["integer", "null"] },
            "display_name": { "type": ["string", "null"] },
            "folder": { "type": "string" }
          }
        },
        "workflow": { "type": ["string", "null"] },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "marker", "allowed_outcomes"],
          "properties": {
            "stage": { "type": "string" },
            "marker": { "type": "string" },
            "allowed_outcomes": {
              "type": "array",
              "items": { "$ref": "#/$defs/HumanOutcome" }
            }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "pid", "attempt_id", "task_generation"],
          "properties": {
            "status": { "type": "string", "enum": ["running", "not_running", "stale"] },
            "pid": { "type": ["integer", "null"], "minimum": 1 },
            "attempt_id": { "type": ["string", "null"] },
            "task_generation": { "type": ["string", "null"] }
          }
        },
        "state": { "$ref": "#/$defs/State" },
        "blocker_owner": {
          "type": "string",
          "enum": ["agent", "operator", "provider", "scheduler", "hive", "none", "unknown"]
        },
        "reason": { "type": "string" },
        "reasons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Reason" } },
        "provider": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "retry_after"],
              "properties": {
                "name": { "type": ["string", "null"] },
                "retry_after": { "type": ["string", "null"], "format": "date-time" }
              }
            }
          ]
        },
        "routing": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/RoutingDecision" }
          ]
        },
        "retry": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["due", "retry_at", "safe", "safety_reason"],
              "properties": {
                "due": { "type": "boolean" },
                "retry_at": { "type": ["string", "null"], "format": "date-time" },
                "safe": { "type": "boolean" },
                "safety_reason": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "recovery": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/Recovery" }
          ]
        },
        "closure": { "$ref": "#/$defs/Closure" },
        "plan_review": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/PlanReviewSummary" }
          ]
        },
        "dependency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocked", "blocked_by", "dependency_stage", "admission_error"],
          "properties": {
            "blocked": { "type": "boolean" },
            "blocked_by": { "type": ["string", "null"] },
            "dependency_stage": { "type": ["string", "null"] },
            "admission_error": { "type": ["object", "null"], "additionalProperties": true }
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_observed_at", "scheduler_status"],
          "properties": {
            "task_observed_at": { "type": "string", "format": "date-time" },
            "scheduler_status": { "$ref": "#/$defs/SchedulerStatus" }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_action", "task_action_label", "marker_attrs", "diagnostic", "condition_warning", "held"],
          "properties": {
            "task_action": { "type": "string" },
            "task_action_label": { "type": "string" },
            "marker_attrs": { "type": "object", "additionalProperties": true },
            "diagnostic": { "type": ["object", "null"], "additionalProperties": true },
            "condition_warning": { "type": ["string", "null"] },
            "held": { "type": ["object", "null"], "additionalProperties": true }
          }
        },
        "action": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/Action" }
          ]
        }
      }
    },
    "RoutingIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "RoutingExclusionReason": {
      "type": "string",
      "enum": [
        "hard_pin_mismatch", "requirements_incompatible", "manual_block",
        "circuit_open", "circuit_cooldown", "half_open_probe_owned",
        "provider_concurrency_saturated", "health_state_unavailable"
      ]
    },
    "RoutingScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider_account_id", "model"],
      "properties": {
        "kind": { "type": "string", "enum": ["provider_account", "model"] },
        "provider_account_id": { "$ref": "#/$defs/RoutingIdentifier" },
        "model": { "type": ["string", "null"] }
      }
    },
    "RoutingProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "journal_epoch", "observed_generation", "claim_generation", "attempt_id", "task_generation", "ownership_fence"],
      "properties": {
        "scope": { "$ref": "#/$defs/RoutingScope" },
        "journal_epoch": { "type": "integer", "minimum": 0 },
        "observed_generation": { "type": "integer", "minimum": 0 },
        "claim_generation": { "type": "integer", "minimum": 1 },
        "attempt_id": { "$ref": "#/$defs/RoutingIdentifier" },
        "task_generation": { "$ref": "#/$defs/RoutingIdentifier" },
        "ownership_fence": { "$ref": "#/$defs/RoutingIdentifier" }
      }
    },
    "RoutingPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": { "$ref": "#/$defs/RoutingIdentifier" },
        "model": { "type": ["string", "null"] }
      }
    },
    "RoutingRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "quality", "tools", "permissions"],
      "properties": {
        "context": { "type": ["string", "null"] },
        "quality": { "type": ["string", "null"] },
        "tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "RoutingObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generation": { "type": "integer", "minimum": 0 },
        "journal_epoch": { "type": "integer", "minimum": 0 },
        "observed": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 1 }
      }
    },
    "RoutingExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "reason", "detail", "scope", "observation"],
      "properties": {
        "route_id": { "$ref": "#/$defs/RoutingIdentifier" },
        "reason": { "$ref": "#/$defs/RoutingExclusionReason" },
        "detail": { "type": ["string", "null"] },
        "scope": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/RoutingScope" }] },
        "observation": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/RoutingObservation" }] }
      }
    },
    "RoutingCircuitObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "status", "generation", "journal_epoch", "state", "manual_block", "eligible_at", "probe_owner"],
      "properties": {
        "scope": { "$ref": "#/$defs/RoutingScope" },
        "status": { "type": "string", "enum": ["available", "unavailable"] },
        "generation": { "type": "integer", "minimum": 0 },
        "journal_epoch": { "type": "integer", "minimum": 0 },
        "state": { "type": "string", "enum": ["closed", "open", "half_open", "manual_block", "probe_owned", "health_state_unavailable"] },
        "manual_block": { "type": ["boolean", "null"] },
        "eligible_at": { "type": ["string", "null"], "format": "date-time" },
        "probe_owner": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/RoutingProbe" }] }
      }
    },
    "RoutingCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "provider_account_id", "adapter", "model", "effort", "eligible", "exclusions", "capacity", "circuits"],
      "properties": {
        "route_id": { "$ref": "#/$defs/RoutingIdentifier" },
        "provider_account_id": { "$ref": "#/$defs/RoutingIdentifier" },
        "adapter": { "$ref": "#/$defs/RoutingIdentifier" },
        "model": { "$ref": "#/$defs/RoutingIdentifier" },
        "effort": { "type": ["string", "null"] },
        "eligible": { "type": "boolean" },
        "exclusions": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/RoutingExclusion" } },
        "capacity": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["observed", "max"], "properties": { "observed": { "type": "integer", "minimum": 0 }, "max": { "type": "integer", "minimum": 1 } } }
          ]
        },
        "circuits": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/RoutingCircuitObservation" } }
      }
    },
    "RoutingCircuitGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "journal_epoch", "observed_generation"],
      "properties": {
        "scope": { "$ref": "#/$defs/RoutingScope" },
        "journal_epoch": { "type": "integer", "minimum": 0 },
        "observed_generation": { "type": "integer", "minimum": 0 }
      }
    },
    "RoutingDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id", "decided_at", "task_generation", "policy_digest",
        "status", "reason", "next_action_owner", "policy", "selected_route",
        "candidates", "exclusions", "circuit_generations", "probe_requirements"
      ],
      "properties": {
        "decision_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "decided_at": { "type": "string", "format": "date-time" },
        "task_generation": { "$ref": "#/$defs/RoutingIdentifier" },
        "policy_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": { "type": "string", "enum": ["selected", "capacity_saturated", "no_route"] },
        "reason": { "type": "string" },
        "next_action_owner": { "type": "string", "enum": ["attempt", "scheduler", "retry_authority", "operator"] },
        "policy": { "type": "object", "additionalProperties": false, "required": ["stage", "pin", "requirements"], "properties": { "stage": { "type": "string" }, "pin": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/RoutingPin" }] }, "requirements": { "$ref": "#/$defs/RoutingRequirements" } } },
        "selected_route": { "type": ["string", "null"] },
        "candidates": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/RoutingCandidate" } },
        "exclusions": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/RoutingExclusion" } },
        "circuit_generations": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/RoutingCircuitGeneration" } },
        "probe_requirements": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/RoutingCircuitGeneration" } }
      }
    },
    "HumanOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "complete", "artifact", "to"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "complete": { "type": "boolean" },
        "artifact": { "type": ["string", "null"] },
        "to": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*$" }
      }
    },
    "Reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "source", "freshness"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "source": { "type": "string" },
        "freshness": { "type": "string", "enum": ["current", "stale", "unavailable"] }
      }
    },
    "Recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "request_id", "attempt_id", "phase", "failure_origin",
        "next_eligible_at", "owner", "reason", "remediation", "retry_count",
        "provider_hint", "terminal_outcome", "terminal_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["queued", "cooldown", "running", "blocked", "terminal", "unavailable"]
        },
        "request_id": { "type": ["string", "null"] },
        "attempt_id": { "type": ["string", "null"] },
        "phase": {
          "type": ["string", "null"],
          "enum": ["admitted", "cleared", "dispatched", "terminal", null]
        },
        "failure_origin": { "type": ["string", "null"] },
        "next_eligible_at": { "type": ["string", "null"], "format": "date-time" },
        "owner": {
          "type": ["string", "null"],
          "enum": ["agent", "operator", "provider", "scheduler", "hive", "none", "unknown", null]
        },
        "reason": { "type": ["string", "null"] },
        "remediation": { "type": ["string", "null"] },
        "retry_count": { "type": ["integer", "null"], "minimum": 0 },
        "failure_fingerprint": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "identical_failure_count": { "type": ["integer", "null"], "minimum": 0 },
        "escalation_tier": {
          "type": ["string", "null"],
          "enum": ["silent_retry", "degraded", "parked", null]
        },
        "terminal_outcome": { "type": ["string", "null"] },
        "terminal_at": { "type": ["string", "null"], "format": "date-time" },
        "provider_hint": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["retry_after", "display_only"],
              "properties": {
                "retry_after": { "type": "string" },
                "display_only": { "const": true }
              }
            }
          ]
        }
      }
    },
    "Closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "reason", "authority", "receipt_digest", "evidence",
        "diagnostic", "quarantine_path", "action"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["operator_required", "confirmed_pending_transition", "blocked"]
        },
        "reason": {
          "type": ["string", "null"],
          "enum": ["already_delivered", "superseded", null]
        },
        "authority": {
          "type": ["string", "null"],
          "enum": ["remote_merge", "operator_attestation", null]
        },
        "receipt_digest": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "object", "additionalProperties": true }
        },
        "diagnostic": {
          "type": ["string", "null"],
          "maxLength": 240
        },
        "quarantine_path": {
          "type": ["string", "null"],
          "maxLength": 4096
        },
        "action": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/ClosureAction" }
          ]
        }
      }
    },
    "PlanReviewSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable", "review_id", "version", "observation_digest", "task_generation", "plan_digest",
        "policy_fingerprint", "computed_level", "effective_level", "state", "outcome",
        "degraded", "degradation_reason", "attempt_count", "current_attempt_id",
        "coverage_counts", "finding_counts", "blockers", "blocker_owner", "blocker_reason",
        "required_action", "retry_at", "routes", "artifacts", "freshness", "execution_allowed"
      ],
      "properties": {
        "applicable": { "const": true },
        "review_id": { "type": ["string", "null"], "pattern": "^pr-[0-9a-f]{64}$" },
        "version": { "type": ["integer", "null"], "minimum": 1 },
        "observation_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "task_generation": { "type": ["string", "integer", "null"] },
        "plan_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "policy_fingerprint": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "computed_level": { "enum": ["skip", "standard", "mandatory", null] },
        "effective_level": { "enum": ["skip", "standard", "mandatory", null] },
        "state": {
          "enum": [
            "uninitialized", "skipped", "reviewing", "retry_scheduled", "awaiting_decision",
            "revising", "verifying", "cleared", "degraded_cleared", "blocked"
          ]
        },
        "outcome": { "enum": ["skipped", "cleared", "degraded_cleared", "blocked", null] },
        "degraded": { "type": "boolean" },
        "degradation_reason": {
          "enum": ["partial_coverage", "review_unavailable", "terminal_failure", null]
        },
        "attempt_count": { "type": "integer", "minimum": 0 },
        "current_attempt_id": { "type": ["string", "null"], "pattern": "^pra-[0-9a-f]{64}$" },
        "coverage_counts": { "$ref": "#/$defs/PlanReviewCoverageCounts" },
        "finding_counts": { "$ref": "#/$defs/PlanReviewFindingCounts" },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/PlanReviewBlocker" } },
        "blocker_owner": {
          "enum": ["agent", "operator", "provider", "reviewer", "planner", "scheduler", "hive", "none", "unknown"]
        },
        "blocker_reason": { "type": ["string", "null"] },
        "required_action": { "type": ["string", "object", "null"] },
        "retry_at": { "type": ["string", "null"], "format": "date-time" },
        "routes": { "type": "array", "items": { "$ref": "#/$defs/PlanReviewRoute" } },
        "artifacts": {
          "type": "object", "additionalProperties": { "$ref": "#/$defs/PlanReviewArtifact" }
        },
        "freshness": { "$ref": "#/$defs/PlanReviewFreshness" },
        "execution_allowed": { "type": "boolean" }
      }
    },
    "PlanReviewCoverageCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["requested", "completed", "failed", "unsupported", "waived"],
      "properties": {
        "requested": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "waived": { "type": "integer", "minimum": 0 }
      }
    },
    "PlanReviewFindingCounts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "open", "approved", "answered", "incorporated", "verified", "resolved", "waived",
        "total", "open_gated", "open_manual", "fyi"
      ],
      "properties": {
        "open": { "type": "integer", "minimum": 0 },
        "approved": { "type": "integer", "minimum": 0 },
        "answered": { "type": "integer", "minimum": 0 },
        "incorporated": { "type": "integer", "minimum": 0 },
        "verified": { "type": "integer", "minimum": 0 },
        "resolved": { "type": "integer", "minimum": 0 },
        "waived": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "open_gated": { "type": "integer", "minimum": 0 },
        "open_manual": { "type": "integer", "minimum": 0 },
        "fyi": { "type": "integer", "minimum": 0 }
      }
    },
    "PlanReviewBlocker": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object", "additionalProperties": false, "required": ["owner", "reason"],
          "properties": {
            "owner": { "type": "string" }, "reason": { "type": "string" },
            "coverage": { "type": "string" },
            "finding_fingerprint": { "type": "string", "pattern": "^prf-[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "PlanReviewRouteIdentity": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" }, "model": { "type": "string" },
        "family": { "type": ["string", "null"] }, "effort": { "type": "string" },
        "route": { "type": "string" }, "reconstructed": { "type": "boolean" }
      }
    },
    "PlanReviewRoute": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "requested", "actual", "independence_verified"],
      "properties": {
        "role": { "type": "string" },
        "requested": { "$ref": "#/$defs/PlanReviewRouteIdentity" },
        "actual": { "$ref": "#/$defs/PlanReviewRouteIdentity" },
        "capability_result": { "type": ["string", "null"] },
        "independence_verified": { "type": "boolean" },
        "independence_reason": { "type": ["string", "null"] },
        "attempt_id": { "type": ["string", "null"], "pattern": "^pra-[0-9a-f]{64}$" },
        "outcome": {
          "enum": ["success", "partial_coverage", "unsupported", "provider_limit", "timeout", "retryable_failure", "terminal_failure", null]
        },
        "retry_at": { "type": ["string", "null"], "format": "date-time" },
        "recovery_reset": { "type": "boolean" },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["candidate", "status"],
            "properties": {
              "candidate": { "$ref": "#/$defs/PlanReviewRouteIdentity" },
              "status": { "type": "string" },
              "diagnostic": { "type": "string" }
            }
          }
        }
      }
    },
    "PlanReviewArtifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "PlanReviewFreshness": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["current", "stale", "not_initialized", "invalid", "unknown"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "ClosureAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id", "target", "risk_class", "confirmation_required",
        "supported_reasons", "provenance"
      ],
      "properties": {
        "action_id": { "const": "workflow.close_with_evidence" },
        "target": { "type": "string", "pattern": "^.+:.+$" },
        "risk_class": { "const": "operator_attested" },
        "confirmation_required": { "const": true },
        "supported_reasons": {
          "type": "array",
          "const": ["already_delivered", "superseded"]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "task_action"],
          "properties": {
            "source": { "const": "hive-operational-status" },
            "task_action": { "type": "string" }
          }
        }
      }
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id", "target", "observation_token", "risk_class",
        "confirmation_required", "provenance"
      ],
      "properties": {
        "action_id": { "type": "string", "enum": ["workflow.advance", "workflow.retry"] },
        "target": { "type": "string", "pattern": "^.+:.+$" },
        "observation_token": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "risk_class": { "const": "routine_idempotent" },
        "confirmation_required": { "const": false },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "task_action"],
          "properties": {
            "source": { "const": "hive-operational-status" },
            "task_action": { "type": "string" }
          }
        }
      }
    }
  }
}
