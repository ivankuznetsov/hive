<div id="status-grid">
  <% if projects.empty? %>
    <div class="empty-state">
      <p>No projects yet.</p>
      <p class="hint"><%= link_to "Add a repository", repos_path %> to start the pipeline.</p>
    </div>
  <% else %>
    <% projects.each do |project| %>
      <section class="project-section" data-project-name="<%= project.name %>">
        <div class="project-title">
          <h2><%= project.name %></h2>
          <span class="muted"><%= project.active_tasks.size %> tasks</span>
        </div>
        <% if project.hidden_archived_task_count.positive? %>
          <p class="archive-summary">
            <%= link_to hidden_archive_summary(project.hidden_archived_task_count),
                  archive_path(project: project.name) %>
          </p>
        <% end %>
        <% if project["error"].present? %>
          <div class="state-banner state-banner-error" role="status">
            Project status unavailable: <%= project["error"].humanize.downcase %>.
          </div>
        <% end %>
        <% tasks = project.active_tasks %>
        <% if tasks.empty? %>
          <div class="empty-state">
            <p>Nothing in flight.</p>
            <p class="hint">Drop an idea above to start a task.</p>
          </div>
        <% else %>
          <div class="task-list">
            <% tasks.each do |task| %>
              <article class="task-row">
                <div class="task-name">
                  <%= link_to task.title, task_path(project.name, task.slug) %>
                  <% display = TaskDisplay.new(task, fresh: @status_fresh) %>
                  <% if display.detail.present? && !%w[running completed paused].include?(display.state) %><p class="task-state-detail"><%= truncate(display.detail, length: 180) %></p><% end %>
                </div>
                <%= stage_badge(task["stage"]) %>
                <span class="task-meta">
                  <%= status_dot(task, fresh: @status_fresh) %>
                  <%= display.label %>
                </span>
                <span class="task-meta faint">Updated <%= relative_age(task["age_seconds"]) %></span>
              </article>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>
  <% end %>
</div>
